// Модуль управляемого приложения «ПерфТест».
//
// ВАЖНО: клиентский контекст этого модуля урезан - здесь недоступны
// Метаданные, СистемнаяИнформация, ВерсияПриложения, ТекущаяДатаСеанса.
// Всё, что требует этих глобалов, выполняется в ПерфСценарии (сервер).
// Паспорт клиента для автопрогона собирается только через WMI (COM).
//
// Интерактивный запуск: открывается начальная страница с HTML-описанием
// (техника статьи «Используем поле HTML-документа в качестве начальной страницы
// конфигурации», infostart.ru/1c/articles/2675965).
//
// Автономный запуск: параметр /C «ПерфАвтоПрогон;<стенд>;<чанков>» - выполняются все
// сценарии, медианы пишутся в регистр сведений ПерфРезультаты, паспорт стенда -
// в регистр ПерфСтенды; сеанс закрывается без вопросов. Результаты в файл не пишутся.
//
// Стенд - произвольное имя сборки для сравнения («вендор 8.3.27», «тест 8.3.27+libs»,
// «8.5.4.1306»); пустое значение = версия платформы.

Процедура ПриНачалеРаботыСистемы()

	Если ЭтоАвтоПрогон() Тогда
		ВыполнитьАвтоПрогон();
		Возврат;
	КонецЕсли;

	Если Найти(НРег(СокрЛП(ПараметрЗапуска)), "перфсмоукформ") > 0 Тогда
		ВыполнитьСмоукФорм();
		Возврат;
	КонецЕсли;

	ОткрытьФорму("ОбщаяФорма.НачальнаяСтраница");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Признак автопрогона: в параметре /C есть «ПерфАвтоПрогон».
Функция ЭтоАвтоПрогон()
	Возврат Найти(НРег(СокрЛП(ПараметрЗапуска)), "перфавтопрогон") > 0;
КонецФункции

// Смоук-режим отчётов и дашборда: открыть каждую форму (серверный код отрисовки
// выполняется в ПриСозданииНаСервере) и закрыть. Маркеры: form-ok / form-error.
Процедура ВыполнитьСмоукФорм()
	Имена = СтрРазделить("НачальнаяСтраница,ПерфДашборд,ПерфТопКонфигураций,ПерфСравнениеСтендов,ПерфИсторияЗамеров", ",");
	Для Каждого Имя Из Имена Цикл
		Попытка
			Форма = ОткрытьФорму("ОбщаяФорма." + Имя);
			Длина = 0;
			Признак = "nofield";
			Попытка
				Текст = Форма.ОтчетHTML;
				Длина = СтрДлина(Текст);
				Признак = ?(Найти(Текст, "<table") > 0, "table", "notable");
				Признак = Признак + ";tr=" + Строка(КоличествоСтрокHTML(Текст));
			Исключение
				Признак = "readonly";
			КонецПопытки;
			ЗаписатьМаркер("form-ok:" + Имя + ":" + Строка(Длина) + ":" + Признак);
			Попытка
				ПутьHTML = КаталогВременныхФайлов() + "perftest_" + Имя + ".html";
				ЗаписьHTML = Новый ЗаписьТекста(ПутьHTML, КодировкаТекста.UTF8);
				ЗаписьHTML.Записать(Текст);
				ЗаписьHTML.Закрыть();
			Исключение
				ЗаписатьМаркер("html-write-error");
			КонецПопытки;
		Исключение
			ЗаписатьМаркер("form-error:" + Имя + ":"
				+ ОписаниеОшибки()); // КраткоеПредставлениеОшибки устарел (замечание EDT)
		КонецПопытки;
	КонецЦикла;
	ЗаписатьМаркер("smoke-done");
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

// Число строк таблиц в готовом HTML (маркер смоука вида «table;tr=N»).
Функция КоличествоСтрокHTML(Текст)
	Возврат СтрЧислоВхождений(Текст, "<tr>");
КонецФункции
// Паспорт клиента только через WMI (COM): СистемнаяИнформация в модуле приложения недоступна.
Функция WMIПервыйКлиент(Сервис, ЗапросWMI)
	Попытка
		Выборка = Сервис.ExecQuery(ЗапросWMI);
		Для Каждого Элемент Из Выборка Цикл
			Возврат Элемент;
		КонецЦикла;
	Исключение
		Возврат Неопределено; // WMI-запрос не выполнен
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция АптаймКлиента(WMIDate)
	Попытка
		С = Лев(СокрЛП(WMIDate), 14);
		Если СтрДлина(С) < 14 Тогда
			Возврат "";
		КонецЕсли;
		ДатаЗагрузки = Дата(Число(Лев(С, 4)), Число(Сред(С, 5, 2)), Число(Сред(С, 7, 2)),
			Число(Сред(С, 9, 2)), Число(Сред(С, 11, 2)), Число(Сред(С, 13, 2)));
		ВсегоСек = ТекущаяДата() - ДатаЗагрузки; // BSLLS:DeprecatedCurrentDate-off (ТекущаяДатаСеанса в модуле приложения недоступна - проверено на этом хосте)
		Возврат Цел(ВсегоСек / 86400) + " дн "
			+ Цел((ВсегоСек % 86400) / 3600) + " ч "
			+ Цел((ВсегоСек % 3600) / 60) + " мин";
	Исключение
		Возврат ""; // WMI-дату не разобрали
	КонецПопытки;
КонецФункции

// Паспорт клиента строкой «Ключ=Значение;...»: СистемнаяИнформация (если
// доступна в этом контексте) плюс WMI. Недоступное помечается признаком,
// чтобы отсутствие данных не путали с пустыми значениями.
Функция СобратьПаспортКлиента()
	Части = Новый Массив;
	Попытка
		СИ = Новый СистемнаяИнформация;
		Части.Добавить("Платформа=" + Строка(СИ.ТипПлатформы));
	Исключение
		Части.Добавить("СИНедоступен=1"); // тип недоступен в модуле приложения - платформа заполнится при интерактивном замере
	КонецПопытки;
	Попытка
		Локатор = Новый COMОбъект("WbemScripting.SWbemLocator"); // BSLLS:UsingObjectNotAvailableUnix-off (конфигурация только Windows)
		Сервис = Локатор.ConnectServer(".", "root\cimv2");
		ОС = WMIПервыйКлиент(Сервис, "SELECT Caption, Version, BuildNumber, FreePhysicalMemory, LastBootUpTime FROM Win32_OperatingSystem");
		ЦПУ = WMIПервыйКлиент(Сервис, "SELECT Name, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed, LoadPercentage FROM Win32_Processor");
		ПК = WMIПервыйКлиент(Сервис, "SELECT Name, Manufacturer, Model, TotalPhysicalMemory FROM Win32_ComputerSystem");
		Если ОС <> Неопределено Тогда
			Части.Добавить("ОС=" + СокрЛП(ОС.Caption) + " v" + СокрЛП(ОС.Version) + " build " + СокрЛП(ОС.BuildNumber));
			Части.Добавить("СвободнаМб=" + Формат(Окр(ОС.FreePhysicalMemory / 1024, 0), "ЧГ=0"));
			Части.Добавить("Аптайм=" + АптаймКлиента(ОС.LastBootUpTime));
		КонецЕсли;
		Если ЦПУ <> Неопределено Тогда
			Части.Добавить("ЦПУ=" + СокрЛП(ЦПУ.Name));
			Части.Добавить("ЦПУПотоки=" + ЦПУ.NumberOfCores + " ядер / " + ЦПУ.NumberOfLogicalProcessors + " потоков");
			Части.Добавить("ЦПУМГц=" + Формат(ЦПУ.MaxClockSpeed, "ЧГ=0"));
			Части.Добавить("ЦПУЗагрузкаПроц=" + Формат(ЦПУ.LoadPercentage, "ЧГ=0"));
		КонецЕсли;
		Если ПК <> Неопределено Тогда
			ПКМодель = СокрЛП(ПК.Manufacturer) + ?(ПустаяСтрока(СокрЛП(ПК.Model)), "", " " + СокрЛП(ПК.Model));
			Части.Добавить("ПК=" + СокрЛП(ПК.Name) + ?(ПустаяСтрока(ПКМодель), "", " (" + ПКМодель + ")"));
			Части.Добавить("ПамятьМб=" + Формат(Окр(ПК.TotalPhysicalMemory / 1048576, 0), "ЧГ=0"));
		КонецЕсли;
	Исключение
		Части.Добавить("WМИКлиентНедоступен=1"); // COM на клиенте не работает
	КонецПопытки;
	Возврат СтрСоединить(Части, ";");
КонецФункции

// Автопрогон: параметр /C «ПерфАвтоПрогон;<стенд>;<чанков>;<повторов>»,
// все сценарии подряд, медианы в регистры, маркеры в perftest_marker.log,
// затем закрытие сеанса без вопросов.
Процедура ВыполнитьАвтоПрогон()
	ЗаписатьМаркер("started");
	Попытка
		Части = СтрРазделить(СокрЛП(ПараметрЗапуска), ";");
		Стенд = "";
		Если Части.Количество() > 1 Тогда
			Стенд = СокрЛП(Части[1]);
		КонецЕсли;
		Чанков = 0;
		Если Части.Количество() > 2 Тогда
			Попытка
				Чанков = Число(СокрЛП(Части[2]));
			Исключение
				Чанков = 0;
			КонецПопытки;
		КонецЕсли;
		// Число прогонов на сценарий: для отладки 1, для замеров 3 и больше.
		Повторов = 1;
		Если Части.Количество() > 3 Тогда
			Попытка
				Повторов = Число(СокрЛП(Части[3]));
			Исключение
				Повторов = 1;
			КонецПопытки;
		КонецЕсли;
		Если Повторов < 1 Тогда
			Повторов = 1;
		КонецЕсли;
		ЗаписатьМаркер("param:[" + ПараметрЗапуска + "] stand:[" + Стенд + "] chunk:[" + Строка(Чанков) + "]");
		ЗаписатьМаркер("before-run");
		ПаспортКлиента = СобратьПаспортКлиента(); // вне замера, до первого сценария
		// Паспорт стенда и его имя считаются один раз на прогон: внутри цикла
		// каждый расчёт уходил в WMI и добавлял по несколько секунд к сценарию.
		ПерфСценарии.ЗаписатьПаспортСтенда(Стенд, ПаспортКлиента);
		СтендПрогона = ПерфСценарии.ИмяСтендаДляЗаписи(Стенд);
		СписокСценариев = ПерфСценарии.СписокСценариев();
		Для Каждого Сценарий Из СписокСценариев Цикл
			Прогоны = ПерфСценарии.ВыполнитьСценарий(Сценарий.Имя, Сценарий.Порция, Повторов, Чанков);
			ВремяСтрока = "";
			Для Каждого СтрокаПрогона Из Прогоны Цикл
				ВремяСтрока = ВремяСтрока + ?(ПустаяСтрока(ВремяСтрока), "", ";")
					+ Формат(СтрокаПрогона.ВремяМс, "ЧГ=0");
				ЗаписатьМаркер("run:" + Сценарий.Имя + ":" + СтрокаПрогона.Прогон + ":"
					+ Формат(СтрокаПрогона.ВремяМс, "ЧГ=0"));
			КонецЦикла;
			Единица = "";
			Если Прогоны.Количество() > 0 Тогда
				Единица = Прогоны[0].Единица;
			КонецЕсли;
			ПерфСценарии.ЗаписатьРезультат(СтендПрогона, Сценарий.Имя, Сценарий.Представление,
				Сценарий.Порция, Единица, ВремяСтрока, Повторов, ПаспортКлиента);
			ЗаписатьМаркер("ok:" + Сценарий.Имя);
		КонецЦикла;
		ЗаписатьМаркер("reg-rows:" + ПерфСценарии.КоличествоЗаписейРезультатов(СтендПрогона));
		ЗаписатьМаркер("history-rows:" + ПерфСценарии.КоличествоЗаписейИстории(СтендПрогона));
		ЗаписатьМаркер("passport-rows:" + ПерфСценарии.КоличествоЗаписейПаспортов(СтендПрогона));
		ЗаписатьМаркер("passport:" + ПерфСценарии.ПрочитатьПаспортСтенда(СтендПрогона));
// Экспорт для портала отключён в автопрогоне: выполняется отдельной командой (портал - отдельная задача).
	Исключение
		ФайлОшибки = КаталогВременныхФайлов() + "perftest_auto_error.log";
		Запись = Новый ЗаписьТекста(ФайлОшибки, КодировкаТекста.UTF8);
		Запись.ЗаписатьСтроку(ОписаниеОшибки());
		Запись.Закрыть();
	КонецПопытки;
	ЗаписатьМаркер("done");
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

// Строка маркера с отметкой в миллисекундах: журнал прогона для проверок
// (started / run / ok / reg-rows / done). Ошибка записи не прерывает прогон.
Процедура ЗаписатьМаркер(Текст)
	ФайлМаркера = КаталогВременныхФайлов() + "perftest_marker.log";
	Попытка
		ЗаписьМ = Новый ЗаписьТекста(ФайлМаркера, КодировкаТекста.UTF8, , Истина);
		ЗаписьМ.ЗаписатьСтроку(Текст + " @" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"));
		ЗаписьМ.Закрыть();
	Исключение
		ОписаниеОшибкиМаркера = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
