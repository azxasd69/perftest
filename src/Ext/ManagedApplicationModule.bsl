// Модуль управляемого приложения «ПерфТест».
//
// ВАЖНО: клиентский контекст этого модуля урезан - здесь недоступны
// Метаданные, СистемнаяИнформация, ВерсияПриложения, ТекущаяДатаСеанса.
// Все, что требует этих глобалов, выполняется в ПерфСценарии (сервер).
// Паспорт клиента для автопрогона собирается только через WMI (COM).
//
// Интерактивный запуск: открывается начальная страница с HTML-описанием
// (техника статьи «Используем поле HTML-документа в качестве начальной страницы
// конфигурации», infostart.ru/1c/articles/2675965).
//
// Автономный запуск: параметр /C «ПерфАвтоПрогон;<стенд>;<чанков>» - выполняются все
// сценарии, медианы пишутся в регистр сведений ПерфРезультаты, паспорт стенда -
// в регистр ПерфСтенды; сеанс закрывается без вопросов. Результаты в файл не пишутся.
//
// Стенд - произвольное имя сборки для сравнения («вендор 8.3.27», «тест 8.3.27+libs»,
// «8.5.4.1306»); пустое значение = версия платформы.

Процедура ПриНачалеРаботыСистемы()

	Если ЭтоАвтоПрогон() Тогда
		ВыполнитьАвтоПрогон();
		Возврат;
	КонецЕсли;

	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфсмоукформ") > 0 Тогда
		ВыполнитьСмоукФорм();
		Возврат;
	КонецЕсли;

	// Режим самотеста журнала: /C "ПерфЖурналТест" пишет тестовую запись
	// и проверяет, что она дошла до регистра ПерфОшибки.
	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфжурналтест") > 0 Тогда
		ВыполнитьСамотестЖурнала();
		Возврат;
	КонецЕсли;

	// Служебный режим проверки обмена без сети: /C "ПерфОбменСамотест".
	// Проверяет векторы HMAC, сборку конверта и разбор ответа (ТЗ, § 15.2).
	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфобменсамотест") > 0 Тогда
		ВыполнитьСамотестОбмена();
		Возврат;
	КонецЕсли;

	// Служебный режим настройки: /C "ПерфОбменНастройка:https://host".
	// Включает обмен и задаёт адрес; используется при проверках на копии базы.
	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфобменнастройка") > 0 Тогда
		Попытка
			ПараметрСтрокой = СокрЛП(ПараметрЗапуска);
			Позиция = СтрНайти(ПараметрСтрокой, ":");
			// Адрес может содержать схему (https://host), поэтому берём всё после первого двоеточия.
			Остаток = ?(Позиция > 0, Сред(ПараметрСтрокой, Позиция + 1), "https://testib.ru");
			// Второй параметр через точку с запятой - базовый путь API (у стенда /perf).
			ЧастиАдреса = СтрРазделить(Остаток, ";", Ложь);
			Адрес = ЧастиАдреса[0];
			БазовыйПуть = ?(ЧастиАдреса.Количество() > 1, ЧастиАдреса[1], "");
			// Настройки применяет серверный модуль: константы не трогаем с клиента.
			ПерфОбмен.ПрименитьНастройку(Адрес, БазовыйПуть, 443, 50, 30);
			ЗаписатьМаркер("exchange-config:ok:" + Адрес + " path=" + БазовыйПуть);
		Исключение
			ЗаписатьМаркер("exchange-config:error " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	// Служебные режимы сертификата: загрузка из obmen-ca-in.pem, показ, удаление.
	// /C "ПерфОбменСертификат" - загрузить; "ПерфОбменСертификатПоказать" - отпечаток;
	// "ПерфОбменСертификатУдалить" - убрать из базы.
	ПараметрНРег = НРег(СокрЛП(ПараметрЗапуска));
	Если СтрНайти(ПараметрНРег, "перфобмен") > 0 И СтрНайти(ПараметрНРег, "сертификат") > 0 Тогда
		Попытка
			Если СтрНайти(ПараметрНРег, "показать") > 0 Тогда
				Сертификат = ПерфОбмен.ПрочитатьСертификат();
				ЗаписатьМаркер("exchange-cert:"
					+ ?(Сертификат.Есть, "есть", "нет")
					+ ":" + ?(Сертификат.Есть, Лев(Сертификат.Отпечаток, 12), "-")
					+ ":" + Сертификат.Комментарий);
			ИначеЕсли СтрНайти(ПараметрНРег, "удалить") > 0 Тогда
				ПерфОбмен.УдалитьСертификат();
				ЗаписатьМаркер("exchange-cert:cleared");
			Иначе
				Загружен = ПерфОбмен.ИмпортироватьСертификат("CA портала из файла");
				ЗаписатьМаркер("exchange-cert-load:" + ?(Загружен, "ok", "нет файла obmen-ca-in.pem"));
			КонецЕсли;
		Исключение
			ЗаписатьМаркер("exchange-cert:error " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	// Служебный режим: полная очистка очереди (смена формата конверта, диагностика).
	// /C "ПерфОбменОчистить" - удаляет все записи регистра очереди.
	Если СтрНайти(ПараметрНРег, "перфобмен") > 0 И СтрНайти(ПараметрНРег, "чист") > 0 Тогда
		Попытка
			УдаленоЗаписей = ПерфОбмен.ОчиститьОчередь();
			ЗаписатьМаркер("exchange-clear:" + Строка(УдаленоЗаписей));
		Исключение
			ЗаписатьМаркер("exchange-clear:error " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	// Служебный режим: перенос секретов обмена из файла подготовки.
	// /C "ПерфОбменСекрет" - читает obmen-secrets-in.json и удаляет источник.
	// Служебный режим: /C "ПерфОбменКаталог:<путь>" задаёт каталог файла секретов.
	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфобменкаталог") > 0 Тогда
		Попытка
			ПараметрСтрокой = СокрЛП(ПараметрЗапуска);
			Позиция = СтрНайти(ПараметрСтрокой, ":");
			Путь = ?(Позиция > 0, Сред(ПараметрСтрокой, Позиция + 1), "");
			ПерфОбмен.ЗадатьКаталогСекрета(Путь);
			ЗаписатьМаркер("exchange-dir:ok:" + ПерфОбмен.КаталогСекрета());
		Исключение
			ЗаписатьМаркер("exchange-dir:error " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	// Служебный режим: /C "ПерфОбменПроба" проверяет связь и состояние очереди.
	// Служебный режим: /C "ПерфОбменОтправить" - один цикл отправки с маркерами.
	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфобменотправить") > 0 Тогда
		Попытка
			Итог = ПерфОбмен.ОтправитьОчередь(50, 262144);
			ЗаписатьМаркер("exchange-run:code=" + Строка(Итог.Код)
				+ ";sent=" + Строка(Итог.Отправлено)
				+ ";err=" + Строка(Итог.Ошибок)
				+ ";left=" + Строка(Итог.Осталось)
				+ ";" + Лев(Итог.Текст, 150));
		Исключение
			ЗаписатьМаркер("exchange-run:error " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	// Служебный режим: /C "ПерфОбменСброс" - вернуть ошибочные конверты в очередь.
	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфобменсброс") > 0 Тогда
		Попытка
			Сброшено = ПерфОбмен.СброситьОшибки();
			ЗаписатьМаркер("exchange-reset-done:" + Строка(Сброшено));
		Исключение
			ЗаписатьМаркер("exchange-reset:error " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфобменпроба") > 0 Тогда
		Попытка
			Связь = ПерфОбмен.ПроверитьСвязь();
			ЗаписатьМаркер("exchange-probe:" + ?(Связь.Есть, "ok", "fail")
				+ ":" + Строка(Связь.Код) + ":" + Связь.Уровень + ":" + Связь.Текст);
			Состояние = ПерфОбмен.СостояниеОбмена();
			Секрет = ПерфОбмен.СостояниеСекрета();
			ЗаписатьМаркер("exchange-secret:" + ?(Секрет.Есть, Секрет.Маска, "нет")
				+ ";hmac=" + ?(Секрет.КлючHMACЕсть, "есть", "нет"));
			ЗаписатьМаркер("exchange-state:" + ?(Состояние.Включен, "on", "off")
				+ ";queue=" + Строка(Состояние.ВОчереди)
				+ ";errors=" + Строка(Состояние.Ошибок));
		Исключение
			ЗаписатьМаркер("exchange-probe:error " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфобменсекрет") > 0 Тогда
		Попытка
			Импортирован = ПерфОбмен.ИмпортироватьСекреты();
			ЗаписатьМаркер("exchange-secrets:" + ?(Импортирован, "ok", "нет входного файла"));
		Исключение
			ЗаписатьМаркер("exchange-secrets:error " + ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	// Служебный режим очистки: /C "ПерфОчистка" удаляет накопленные данные.
	// Операция необратима, запускается только вручную и с копией файла базы.
	Если СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфочистка") > 0 Тогда
		ВыполнитьОчистку();
		Возврат;
	КонецЕсли;

	// Режим проверки: /C "ПерфФорма:<Имя общей формы>" открывает форму и оставляет ее
	// на экране (в отличие от смоука, где форма закрывается сразу и HTML не успевает отрисоваться).
	ИндексФормы = СтрНайти(НРег(ПараметрЗапуска), "перфформа:");
	Если ИндексФормы > 0 Тогда
		ИмяФормы = Сред(ПараметрЗапуска, ИндексФормы + СтрДлина("перфформа:"));
		ИмяФормы = СтрЗаменить(ИмяФормы, """", ""); // кавычки из командной строки
		// Для снимков страниц в нужной теме: "ПерфФорма:ПерфДашборд;light".
		// Тема уходит параметром формы, настройки приложения не меняются.
		// Дополнительные флаги через ";": тема (light/dark) и collapse.
		ТемаСнимка = "";
		ФлагСвернута = Ложь;
		ЧастиИмени = СтрРазделить(ИмяФормы, ";");
		ИмяФормы = СокрЛП(ЧастиИмени[0]);
		Для ИндексЧасти = 1 По ЧастиИмени.Количество() - 1 Цикл
			ЗначениеФлага = НРег(СокрЛП(ЧастиИмени[ИндексЧасти]));
			Если ЗначениеФлага = "light" ИЛИ ЗначениеФлага = "dark" Тогда
				ТемаСнимка = ЗначениеФлага;
			ИначеЕсли ЗначениеФлага = "collapse" Тогда
				ФлагСвернута = Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ПустаяСтрока(ИмяФормы) Тогда
			ПараметрыОткрытия = Неопределено;
			НастройкиСнимка = Новый Структура;
			Если ТемаСнимка = "light" ИЛИ ТемаСнимка = "dark" Тогда
				НастройкиСнимка.Вставить("Тема", ТемаСнимка);
			КонецЕсли;
			Если ФлагСвернута Тогда
				НастройкиСнимка.Вставить("Свернута", Истина);
			КонецЕсли;
			Если НастройкиСнимка.Количество() > 0 Тогда
				ПараметрыОткрытия = Новый Структура("Настройки", НастройкиСнимка);
			КонецЕсли;
			Попытка
				ОткрытьФорму("ОбщаяФорма." + ИмяФормы, ПараметрыОткрытия);
			Исключение
				// Опечатка в имени формы не должна ронять клиент: режим служебный.
				Сообщить("ПерфФорма: форма не открыта - " + ИмяФормы);
			КонецПопытки;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Интерактивный старт: кокпит открывается всегда, независимо от настроек
	// начальной страницы клиента. Панели клиента (разделы, открытые формы)
	// скрываются пользователем в «Редакторе панелей», тогда форма занимает все окно.
	ОткрытьФорму("ОбщаяФорма.НачальнаяСтраница");

	// Если остались неотправленные конверты (сайт был недоступен, сеанс закрыли),
	// досылаем их фоном. Ошибка не должна мешать открытию кокпита.
	Попытка
		Если ПерфОбмен.КоличествоВОчереди() > 0 Тогда
			ПерфОбмен.ОтправитьОчередьФон();
			ЗаписатьМаркер("exchange-start");
		КонецЕсли;
	Исключение
		ЗаписатьМаркер("exchange-start-error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Признак автопрогона: в параметре /C есть «ПерфАвтоПрогон».
Функция ЭтоАвтоПрогон()
	Возврат СтрНайти(НРег(СокрЛП(ПараметрЗапуска)), "перфавтопрогон") > 0;
КонецФункции

// Смоук-режим отчетов и дашборда: открыть каждую форму (серверный код отрисовки
// выполняется в ПриСозданииНаСервере) и закрыть. Маркеры: form-ok / form-error.
Процедура ВыполнитьСмоукФорм()
	Имена = СтрРазделить("НачальнаяСтраница,ПерфДашборд,ПерфСтенды,ПерфТопКонфигураций,ПерфСравнениеСтендов,ПерфИсторияЗамеров", ",");
	ОткрытыеФормы = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Попытка
			Форма = ОткрытьФорму("ОбщаяФорма." + Имя);
			ОткрытыеФормы.Добавить(Форма);
			// У кокпита поле называется ШапкаHTML, у отчетов - ОтчетHTML.
			Текст = "";
			Попытка
				Текст = Форма.ОтчетHTML;
			Исключение
				Текст = "";
			КонецПопытки;
			Если ПустаяСтрока(Текст) Тогда
				Попытка
					Текст = Форма.ШапкаHTML;
				Исключение
					Текст = "";
				КонецПопытки;
			КонецЕсли;
			Длина = СтрДлина(Текст);
			Признак = ?(СтрНайти(Текст, "<table") > 0, "table", "notable");
			Признак = Признак + ";tr=" + Строка(КоличествоСтрокHTML(Текст));
			ЗаписатьМаркер("form-ok:" + Имя + ":" + Строка(Длина) + ":" + Признак);
			Попытка
				ПутьHTML = КаталогВременныхФайлов() + "perftest_" + Имя + ".html";
				ЗаписьHTML = Новый ЗаписьТекста(ПутьHTML, КодировкаТекста.UTF8);
				ЗаписьHTML.Записать(Текст);
				ЗаписьHTML.Закрыть();
			Исключение
				ЗаписатьМаркер("html-write-error");
			КонецПопытки;
		Исключение
			ЗаписатьМаркер("form-error:" + Имя + ":"
				+ ОписаниеОшибки()); // КраткоеПредставлениеОшибки устарел (замечание EDT)
		КонецПопытки;
	КонецЦикла;
	// Формы закрываются перед проверкой фильтра: повторное ОткрытьФорму той же
	// общей формы возвращает уже открытую, и параметры не применяются.
	Для Каждого ОткрытаяФорма Из ОткрытыеФормы Цикл
		Попытка
			ОткрытаяФорма.Закрыть();
		Исключение
			ЗаписатьМаркер("close-error:" + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	ВыполнитьСмоукФильтраВерсий();
	ЗаписатьМаркер("smoke-done");
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

// Смоук фильтра по версии платформы: та же форма открывается с заданной версией.
// Пустое поле фильтра показывает все версии, это проверяет основной проход смоука;
// здесь - режим «только одна версия», по нему видно, что отбор реально работает.
Процедура ВыполнитьСмоукФильтраВерсий()
	Попытка
		Версии = ПерфОтчетыHTML.СписокВерсийПлатформМассив();
		Если Версии.Количество() = 0 Тогда
			ЗаписатьМаркер("filter-skip:нет версий в регистре");
			Возврат;
		КонецЕсли;
		Версия = Версии[0];
		ФормаФильтр = ОткрытьФорму("ОбщаяФорма.ПерфДашборд",
			Новый Структура("ВерсияПлатформы", Версия));
		ТекстФильтр = ФормаФильтр.ОтчетHTML;
		ЗаписатьМаркер("form-ok:ПерфДашбордФильтр:" + Строка(СтрДлина(ТекстФильтр)) + ":"
			+ ?(СтрНайти(ТекстФильтр, "<table") > 0, "table", "notable")
			+ ";tr=" + Строка(КоличествоСтрокHTML(ТекстФильтр)) + ";ver=" + Версия);
		ПутьHTML = КаталогВременныхФайлов() + "perftest_ПерфДашбордФильтр.html";
		ЗаписьHTML = Новый ЗаписьТекста(ПутьHTML, КодировкаТекста.UTF8);
		ЗаписьHTML.Записать(ТекстФильтр);
		ЗаписьHTML.Закрыть();
	Исключение
		ЗаписатьМаркер("filter-error:" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Число строк таблиц в готовом HTML (маркер смоука вида «table;tr=N»).
Функция КоличествоСтрокHTML(Текст)
	Возврат СтрЧислоВхождений(Текст, "<tr>");
КонецФункции
// Паспорт клиента только через WMI (COM): СистемнаяИнформация в модуле приложения недоступна.
Функция СобратьПаспортКлиента(СПодробностями = Истина)

	// Вся логика - в общем клиентском модуле: одинаково для формы и автопрогона.
	Попытка
		Возврат ПерфПаспортКлиент.СтрокаКлиента(СПодробностями);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Автопрогон: параметр /C «ПерфАвтоПрогон;<стенд>;<чанков>;<повторов>»,
// все сценарии подряд, медианы в регистры, маркеры в perftest_marker.log,
// затем закрытие сеанса без вопросов.
// Служебный режим: удалить накопленные данные и закрыть сеанс.
Процедура ВыполнитьОчистку()
	ЗаписатьМаркер("cleanup-started");
	Попытка
		Итог = ПерфСценарии.ОчиститьДанные();
		ЗаписатьМаркер("cleanup:results=" + Итог.Результаты + ";history=" + Итог.История
			+ ";passports=" + Итог.Паспорта + ";documents=" + Итог.Документы
			+ ";nomenclature=" + Итог.Номенклатура);
		ЗаписатьМаркер("cleanup-done");
	Исключение
		ЗаписатьМаркер("cleanup-error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

Процедура ВыполнитьАвтоПрогон()
	ЗаписатьМаркер("started");
	// Журнал ошибок ограничивается на старте: на каждой ошибке счетчик не считаем.
	ПерфЖурнал.ОграничитьЖурнал();
	Попытка
		Части = СтрРазделить(СокрЛП(ПараметрЗапуска), ";");
		Стенд = "";
		Если Части.Количество() > 1 Тогда
			Стенд = СокрЛП(Части[1]);
		КонецЕсли;
		Чанков = 0;
		Если Части.Количество() > 2 Тогда
			Попытка
				Чанков = Число(СокрЛП(Части[2]));
			Исключение
				Чанков = 0;
			КонецПопытки;
		КонецЕсли;
		// Число прогонов на сценарий: для отладки 1, для замеров 3 и больше.
		Повторов = 1;
		Если Части.Количество() > 3 Тогда
			Попытка
				Повторов = Число(СокрЛП(Части[3]));
			Исключение
				Повторов = 1;
			КонецПопытки;
		КонецЕсли;
		Если Повторов < 1 Тогда
			Повторов = 1;
		КонецЕсли;
		ЗаписатьМаркер("param:[" + ПараметрЗапуска + "] stand:[" + Стенд + "] chunk:[" + Строка(Чанков) + "]");
		ЗаписатьМаркер("before-run");
		ПаспортКлиента = СобратьПаспортКлиента(); // вне замера, до первого сценария
		ЗаписатьМаркер("client:[" + ПаспортКлиента + "]");
		// Паспорт стенда собирается фоновым заданием: WMI может зависнуть, и тогда
		// прогон не должен ждать его дольше таймаута. Барьер ждет не более 30 с,
		// затем пишет быструю фазу и продолжает замер.
		// Каждый шаг - в своей обертке: сбой любого из них не отменяет остальные
		// и не останавливает прогон (паспорт - вспомогательная сущность).
		Попытка
			ПерфПаспорт.ЗапуститьСборФон(ПаспортКлиента);
		Исключение
			СведенияОбОшибке = ИнформацияОбОшибке();
			ЗаписатьМаркер("passport-fon:" + СведенияОбОшибке.Описание);
		КонецПопытки;
		Попытка
			ПерфПаспорт.Обеспечить(Стенд, ПаспортКлиента, 30);
		Исключение
			СведенияОбОшибке = ИнформацияОбОшибке();
			ЗаписатьМаркер("passport-barrier:" + СведенияОбОшибке.Описание);
		КонецПопытки;
		Попытка
			// Если паспорт уже был актуален, запись обновит только клиентские поля
			// (режим клиента, браузер, WMI рабочего места) - без повторного сбора.
			// Перезапись гарантирует, что паспорт несет клиентскую строку именно этого
			// запуска (толстый/тонкий/веб). Полный сбор - около секунды и только один раз
			// на прогон, до первого сценария.
			ПерфСценарии.ЗаписатьПаспортСтенда(Стенд, ПаспортКлиента, Истина);
		Исключение
			СведенияОбОшибке = ИнформацияОбОшибке();
			ЗаписатьМаркер("passport-write:" + СведенияОбОшибке.Описание);
		КонецПопытки;
		// Цикл сценариев выполняется на сервере и возвращает только строки-маркеры:
		// тонкий и веб-клиент не могут принимать таблицы значений с сервера.
		СтрокиМаркеров = ПерфСценарии.АвтопрогонСервер(Стенд, Чанков, Повторов, ПаспортКлиента);
		Для Каждого СтрокаМаркера Из СтрокиМаркеров Цикл
			ЗаписатьМаркер(СтрокаМаркера);
		КонецЦикла;
		// Кэш страниц проверяется на каждом прогоне: попадание по своей метке,
		// промах по чужой и детерминированный ключ.
		ЗаписатьМаркер("cache-selftest:" + ?(ПерфОтчетыHTML.СамопроверкаКэша(), "ok", "fail"));
	// Экспорт для портала отключен в автопрогоне: выполняется отдельной командой (портал - отдельная задача).
	Исключение
		ФайлОшибки = КаталогВременныхФайлов() + "perftest_auto_error.log";
		Запись = Новый ЗаписьТекста(ФайлОшибки, КодировкаТекста.UTF8);
		Запись.ЗаписатьСтроку(ОписаниеОшибки());
		Запись.Закрыть();
		ПерфЖурнал.ЗаписатьИсключение("МодульПриложения.ВыполнитьАвтоПрогон", ИнформацияОбОшибке());
	КонецПопытки;
	ЗаписатьМаркер("done");
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

// Строка маркера с отметкой в миллисекундах: журнал прогона для проверок
// (started / run / ok / reg-rows / done). Ошибка записи не прерывает прогон.
Процедура ЗаписатьМаркер(Текст)
	ФайлМаркера = КаталогВременныхФайлов() + "perftest_marker.log";
	Попытка
		ЗаписьМ = Новый ЗаписьТекста(ФайлМаркера, КодировкаТекста.UTF8, , Истина);
		ЗаписьМ.ЗаписатьСтроку(Текст + " @" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"));
		ЗаписьМ.Закрыть();
	Исключение
		ОписаниеОшибкиМаркера = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

// Самотест обмена: векторы HMAC, сборка конверта, разбор ответа. Без сети и без записи.
// Маркеры: hmac-vectors:<K>/4, exchange-build:ok|fail, exchange-json:ok|fail,
// exchange-sign:ok|fail, exchange-selftest:ok|fail:<N>.
Процедура ВыполнитьСамотестОбмена()

	Попытка
		Итог = ПерфОбмен.СамоТест();
		ЗаписатьМаркер("hmac-vectors:" + Итог.Векторы + "/4");
		ЗаписатьМаркер("exchange-build:" + ?(Итог.Сборка, "ok", "fail"));
		ЗаписатьМаркер("exchange-json:" + ?(Итог.Разбор, "ok", "fail"));
		ЗаписатьМаркер("exchange-sign:" + ?(Итог.Подпись, "ok", "fail"));
		ЗаписатьМаркер("exchange-batch:" + ?(Итог.Пакет, "ok", "fail"));
		Если ПустаяСтрока(Итог.Ошибки) Тогда
			ЗаписатьМаркер("exchange-selftest:ok");
		Иначе
			ЗаписатьМаркер("exchange-selftest:fail:" + Итог.Ошибки);
		КонецЕсли;
	Исключение
		ЗаписатьМаркер("exchange-selftest:error " + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

// Самотест журнала ошибок: пишет тестовую запись и проверяет, что она дошла
// до регистра. Запуск: 1cv8.exe ENTERPRISE /F<база> /CПерфЖурналТест
// Маркеры: journal-write:ok|fail, journal-rows:<N> delta:<D>, journal-selftest:ok|fail.
Процедура ВыполнитьСамотестЖурнала()
	Попытка
		До = ПерфЖурнал.КоличествоЗаписей();
		Записалось = ПерфЖурнал.ЗаписатьОшибку("Самотест", "Проверка журнала: тестовая запись",
			"запись создана самотестом /CПерфЖурналТест", "Событие", "", "", "самотест");
		После = ПерфЖурнал.КоличествоЗаписей();
		ЗаписатьМаркер("journal-write:" + ?(Записалось, "ok", "fail"));
		ЗаписатьМаркер("journal-rows:" + После + " delta:" + (После - До));
		ЗаписатьМаркер("journal-selftest:" + ?((После > До), "ok", "fail"));
	Исключение
		ЗаписатьМаркер("journal-selftest:error " + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

#КонецОбласти
