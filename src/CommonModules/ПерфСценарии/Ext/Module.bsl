// ПерфСценарии - серверные синтетические сценарии измерения производительности платформы 1С.
//
// Каждый сценарий выполняется как несколько прогонов одинаковой «порции» работы.
// Подготовка данных перед прогоном и очистка после него в замер не входят.
// Замер: сумма времён чанков; каждый чанк замеряется отдельно
// (ТекущаяУниверсальнаяДатаВМиллисекундах() до и после рабочей части чанка).
//
// Машина чанков: состояние сценария (буферы, открытая транзакция, открытый файл,
// созданные запросы) живёт в структуре Контекст между чанками одного вызова,
// поэтому суммарная работа чанков идентична монолитному прогону.
// Фоновое задание (ВыполнитьСценарийФон) выполняет тот же цикл чанков
// с сообщениями прогресса Сообщить("Чанк k/m: X мс").
//
// Все сценарии выполняются в серверном контексте; вызов из клиента разрешён (ServerCall).

// Кэш WMI-паспорта сервера на время сеанса не используется: переменные модуля
// в общем модуле платформой не поддерживаются. Вместо кэша паспорт стенда
// перезаписывается не чаще раза в 10 минут (см. ЗаписатьПаспортСтенда).
#Область ПрограммныйИнтерфейс

// Версия платформы строкой. СистемнаяИнформация - тип с конструктором по умолчанию:
// глобальной функции/переменной нет ни в клиентах, ни в сервере.
Функция ВерсияПлатформы() Экспорт
	Инфо = Новый СистемнаяИнформация;
	Возврат СокрЛП(Инфо.ВерсияПриложения);
КонецФункции

// Заголовок CSV-файла прогона. Считается на сервере: в модуле управляемого
// приложения недоступны ни Метаданные, ни СистемнаяИнформация, ни ТекущаяДатаСеанса.
// Чанков > 0 фиксируется в заголовке - для сравнения чанковых и монолитных прогонов.
Функция ЗаголовокCSV(Чанков = 0) Экспорт
	Заголовок = "# ПерфТест; версия платформы=" + ВерсияПлатформы()
		+ "; конфигурация=" + Метаданные.Версия
		+ "; дата=" + Формат(ТекущаяДатаСеанса(), "ДФ=ггггММддЧЧммсс");
	Если Чанков > 0 Тогда
		Заголовок = Заголовок + "; чанков=" + Чанков;
	КонецЕсли;
	Возврат Заголовок;
КонецФункции

// Возвращает таблицу каталога сценариев.
// Колонки: Имя, Представление, Описание, Порция, Единица, Повторов.
Функция СписокСценариев() Экспорт

	Список = Новый ТаблицаЗначений;
	Список.Колонки.Добавить("Имя");
	Список.Колонки.Добавить("Представление");
	Список.Колонки.Добавить("Описание");
	Список.Колонки.Добавить("Порция");
	Список.Колонки.Добавить("Единица");
	Список.Колонки.Добавить("Повторов");

	// ОБЪЁМ: минимальный (отладка). Порция подобрана так, чтобы сценарий
	// укладывался в доли секунды; полный профиль объёмов - отдельный режим.
	ДобавитьСценарий(Список, "CPU_Арифметика",
		"ЦПУ: арифметический цикл",
		"50 тысяч итераций: умножение, деление, сравнение.",
		50000, "итераций", 1);
	ДобавитьСценарий(Список, "CPU_Строки",
		"ЦПУ: строковые операции",
		"2 тысячи конкатенаций с буфером и 500 поисков подстроки.",
		2000, "сегментов", 1);
	ДобавитьСценарий(Список, "CPU_Коллекции",
		"ЦПУ: коллекции",
		"20 тысяч добавлений в массив и соответствие плюс обход.",
		20000, "элементов", 1);
	ДобавитьСценарий(Список, "Запись_СправочникБезТранзакции",
		"Запись ИБ: справочник, по одному",
		"20 элементов справочника, каждый - отдельная запись в файловую ИБ.",
		20, "записей", 1);
	ДобавитьСценарий(Список, "Запись_СправочникВТранзакции",
		"Запись ИБ: справочник, в одной транзакции",
		"Те же 20 записей внутри одной транзакции.",
		20, "записей", 1);
	ДобавитьСценарий(Список, "Запись_ДокументыСПроведением",
		"Запись ИБ: документы с проведением",
		"5 документов Поступление по 5 строк с проведением.",
		5, "документов", 1);
	ДобавитьСценарий(Список, "Запросы_Чтение",
		"Запросы: чтение и группировки",
		"2 пакета по два запроса: остатки и группировка.",
		2, "пакетов", 1);
	ДобавитьСценарий(Список, "Сериализация_JSON",
		"Сериализация: JSON",
		"Запись и чтение JSON: 500 структур.",
		500, "структур", 1);
	ДобавитьСценарий(Список, "Сериализация_ЗначениеВСтроку",
		"Сериализация: ЗначениеВСтрокуВнутр",
		"Цикл сериализации/десериализации массива из 2 000 чисел.",
		2000, "элементов", 1);
	ДобавитьСценарий(Список, "Память_Коллекции",
		"Память: коллекция строк",
		"20 тысяч коротких строк в массиве и освобождение.",
		20000, "элементов", 1);
	ДобавитьСценарий(Список, "Файлы_IO",
		"Файлы: запись и чтение текста",
		"2 000 строк по ~120 символов (~240 КБ): запись, затем чтение.",
		2000, "строк", 1);

	Возврат Список;

КонецФункции

// Выполняет ОДИН прогон сценария по чанкам (подготовка/очистка данных вне замера).
// СообщатьПрогресс: после каждого чанка Сообщить("Чанк k/m: X мс (NN%)") и
// финальное "ЗАВЕРШЕНО: ... мс" - режим для фонового задания.
// Возвращает структуру: ВремяМс, Порция, Единица.
Функция ВыполнитьПрогон(ИмяСценария, Порция = 0, СообщатьПрогресс = Ложь, Чанков = 0) Экспорт

	Если Порция <= 0 Тогда
		Порция = ПорцияПоУмолчанию(ИмяСценария);
	КонецЕсли;
	Если Чанков <= 0 Тогда
		Чанков = ЧанковПоУмолчанию();
	КонецЕсли;

	ПодготовитьСценарий(ИмяСценария);
	Контекст = КонтекстСценария(ИмяСценария, Порция);

	// Транзакционный сценарий: транзакция живёт через весь цикл чанков,
	// поэтому пара Начать/Зафиксировать/Отменить обязана быть в одной процедуре.
	Если ИмяСценария = "Запись_СправочникВТранзакции" Тогда
		НачатьТранзакцию();
		Попытка
			ВремяМс = ЦиклЧанков(ИмяСценария, Контекст, Порция, Чанков, СообщатьПрогресс);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Иначе
		Попытка
			ВремяМс = ЦиклЧанков(ИмяСценария, Контекст, Порция, Чанков, СообщатьПрогресс);
		Исключение
			КонецСценария(ИмяСценария, Контекст);
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	КонецСценария(ИмяСценария, Контекст);

	Если СообщатьПрогресс Тогда
		Сообщить("ЗАВЕРШЕНО: " + ИмяСценария + " " + ВремяМс + " мс");
	КонецЕсли;

	Возврат Новый Структура("ВремяМс, Порция, Единица", ВремяМс, Порция, ЕдиницаПоУмолчанию(ИмяСценария));

КонецФункции

// Метод фонового задания: один прогон сценария с сообщениями прогресса по чанкам.
// Параметры передаются массивом через ФоновыеЗадания.Выполнить:
// [ИмяСценария, Порция, Чанков]. Результат уходит клиенту сообщением
// "РЕЗУЛЬТАТ:<время>;<порция>;<единица>" - временное хранилище из фонового задания
// не использовать (адрес привязан к сеансу формы, из задания падает
// "Неправильный путь к файлу").
Функция ВыполнитьСценарийФон(ИмяСценария, Порция, Чанков) Экспорт
	Результат = ВыполнитьПрогон(ИмяСценария, Порция, Истина, Чанков);
	Сообщить("РЕЗУЛЬТАТ:" + Формат(Результат.ВремяМс, "ЧГ=0") + ";"
		+ Формат(Результат.Порция, "ЧГ=0") + ";" + Результат.Единица);
	Возврат Истина;
КонецФункции

// Запускает фоновый прогон сценария; возвращает УИД фонового задания (строка).
// Вызывается из клиента (ServerCall) - форма не зависит от режима клиента.
Функция ЗапуститьСценарийФон(ИмяСценария, Порция = 0, Чанков = 0) Экспорт
	КлючЗадания = Строка(Новый УникальныйИдентификатор);
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ИмяСценария);
	ПараметрыЗадания.Добавить(Порция);
	ПараметрыЗадания.Добавить(Чанков);
	Задание = ФоновыеЗадания.Выполнить("ПерфСценарии.ВыполнитьСценарийФон", ПараметрыЗадания, КлючЗадания);
	// Возвращаем УИД задания: третий аргумент Выполнить() - это КЛЮЧ задания,
	// а не его УникальныйИдентификатор; по ключу задание не найти.
	Возврат Строка(Задание.УникальныйИдентификатор);
КонецФункции

// Отменяет текущее фоновое задание прогона (кнопка «Остановить»).
// Возвращает Истина, если активное задание отменено.
Функция ОтменитьСценарийФон(УИДЗадания) Экспорт
	Если ПустаяСтрока(УИДЗадания) Тогда
		Возврат Ложь;
	КонецЕсли;
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(УИДЗадания));
	Если Задание = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Задание.Отменить();
		Возврат Истина;
	Исключение
		Возврат Ложь; // задание уже завершено/не активно
	КонецПопытки;
КонецФункции

// Состояние фонового прогона для клиентского опроса.
// Возвращает структуру: Состояние (Активно/Завершено/Аварийно), Сообщения (массив строк
// прогресса и результата), Ошибка (при аварии). Сам результат прогона приходит
// сообщением "РЕЗУЛЬТАТ:..." и разбирается клиентом.
Функция СостояниеСценарийФон(УИДЗадания) Экспорт

	Сообщения = Новый Массив;
	Состояние = "Активно";
	Ошибка = "";

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(УИДЗадания));
	Если Задание = Неопределено Тогда
		Возврат Новый Структура("Состояние, Сообщения, Ошибка", Состояние, Сообщения, Ошибка);
	КонецЕсли;

	Для Каждого Сообщение Из Задание.ПолучитьСообщенияПользователю() Цикл
		Сообщения.Добавить(СокрЛП(Сообщение.Текст));
	КонецЦикла;

	Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Состояние = "Завершено";
	ИначеЕсли Задание.ИнформацияОбОшибке <> Неопределено Тогда
		Состояние = "Аварийно";
		Ошибка = Задание.ИнформацияОбОшибке.Описание;
	КонецЕсли;

	Возврат Новый Структура("Состояние, Сообщения, Ошибка", Состояние, Сообщения, Ошибка);

КонецФункции

// Выполняет сценарий целиком (Повторов прогонов). Обёртка над ВыполнитьПрогон.
// Возвращает таблицу значений: Прогон, ВремяМс, Порция, Единица.
Функция ВыполнитьСценарий(ИмяСценария, Порция = 0, Повторов = 1, Чанков = 0) Экспорт

	Если Порция <= 0 Тогда
		Порция = ПорцияПоУмолчанию(ИмяСценария);
	КонецЕсли;
	Если Повторов <= 0 Тогда
		Повторов = 3;
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Прогон");
	Результат.Колонки.Добавить("ВремяМс");
	Результат.Колонки.Добавить("Порция");
	Результат.Колонки.Добавить("Единица");

	Для Прогон = 1 По Повторов Цикл
		Один = ВыполнитьПрогон(ИмяСценария, Порция, Ложь, Чанков);
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.Прогон = Прогон;
		СтрокаРезультата.ВремяМс = Один.ВремяМс;
		СтрокаРезультата.Порция = Один.Порция;
		СтрокаРезультата.Единица = Один.Единица;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Выполняет все сценарии подряд. Возвращает общую таблицу:
// Сценарий, Представление, Прогон, ВремяМс, Порция, Единица.
Функция ВыполнитьВсе(Повторов = 1, Чанков = 0) Экспорт

	Результаты = Новый ТаблицаЗначений;
	Результаты.Колонки.Добавить("Сценарий");
	Результаты.Колонки.Добавить("Представление");
	Результаты.Колонки.Добавить("Прогон");
	Результаты.Колонки.Добавить("ВремяМс");
	Результаты.Колонки.Добавить("Порция");
	Результаты.Колонки.Добавить("Единица");

	Для Каждого Сценарий Из СписокСценариев() Цикл
		Прогоны = ВыполнитьСценарий(Сценарий.Имя, Сценарий.Порция, Повторов, Чанков);
		Для Каждого СтрокаПрогона Из Прогоны Цикл
			НоваяСтрока = Результаты.Добавить();
			НоваяСтрока.Сценарий = Сценарий.Имя;
			НоваяСтрока.Представление = Сценарий.Представление;
			НоваяСтрока.Прогон = СтрокаПрогона.Прогон;
			НоваяСтрока.ВремяМс = СтрокаПрогона.ВремяМс;
			НоваяСтрока.Порция = СтрокаПрогона.Порция;
			НоваяСтрока.Единица = СтрокаПрогона.Единица;
		КонецЦикла;
	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Медиана массива чисел (сортировка копии, средний элемент; для чётного - среднее двух центральных).
Функция Медиана(Числа) Экспорт

	Копия = Новый Массив;
	Для Каждого Значение Из Числа Цикл
		Копия.Добавить(Значение);
	КонецЦикла;
	Копия.Сортировать();
	Количество = Копия.Количество();
	Если Количество = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если Количество % 2 = 1 Тогда
		Возврат Копия[(Количество - 1) / 2];
	КонецЕсли;
	Возврат (Копия[Количество / 2 - 1] + Копия[Количество / 2]) / 2;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСценарий(Список, Имя, Представление, Описание, Порция, Единица, Повторов)
	Строка = Список.Добавить();
	Строка.Имя = Имя;
	Строка.Представление = Представление;
	Строка.Описание = Описание;
	Строка.Порция = Порция;
	Строка.Единица = Единица;
	Строка.Повторов = Повторов;
КонецПроцедуры

Функция ЧанковПоУмолчанию()
	Возврат 1;
КонецФункции

// Цикл чанков одного прогона; возвращает суммарное время чанков (мс).
Функция ЦиклЧанков(ИмяСценария, Контекст, Порция, Чанков, СообщатьПрогресс)
	ВремяМс = 0;
	Для НомерЧанка = 1 По Чанков Цикл
		Границы = ГраницыЧанка(Порция, НомерЧанка, Чанков);
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ШагСценария(ИмяСценария, Контекст, Границы.От, Границы.До, Порция, НомерЧанка = Чанков);
		ВремяЧанка = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		ВремяМс = ВремяМс + ВремяЧанка;
		Если СообщатьПрогресс Тогда
			Сообщить("Чанк " + НомерЧанка + "/" + Чанков + ": " + ВремяЧанка + " мс ("
				+ Цел(НомерЧанка * 100 / Чанков) + "%)");
		КонецЕсли;
	КонецЦикла;
	Возврат ВремяМс;
КонецФункции

Функция ПорцияПоУмолчанию(ИмяСценария)
	Для Каждого Сценарий Из СписокСценариев() Цикл
		Если Сценарий.Имя = ИмяСценария Тогда
			Возврат Сценарий.Порция;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Неизвестный сценарий: " + ИмяСценария;
КонецФункции

Функция ЕдиницаПоУмолчанию(ИмяСценария)
	Для Каждого Сценарий Из СписокСценариев() Цикл
		Если Сценарий.Имя = ИмяСценария Тогда
			Возврат Сценарий.Единица;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Неизвестный сценарий: " + ИмяСценария;
КонецФункции

// Границы рабочего диапазона чанка: [От, До] внутри порции.
Функция ГраницыЧанка(Порция, НомерЧанка, Чанков)
	От = Цел((НомерЧанка - 1) * Порция / Чанков) + 1;
	До = Цел(НомерЧанка * Порция / Чанков);
	Если НомерЧанка = Чанков Тогда
		До = Порция;
	КонецЕсли;
	Возврат Новый Структура("От, До", От, До);
КонецФункции

// ---------------------------------------------------------------------------
// Контексты сценариев (состояние между чанками одного вызова)

Функция КонтекстСценария(ИмяСценария, Порция)

	Если ИмяСценария = "CPU_Арифметика" Тогда
		Возврат Новый Структура("Х", 1);
	ИначеЕсли ИмяСценария = "CPU_Строки" Тогда
		Возврат Новый Структура("Буфер, Стр, СуммаПозиций", Новый Массив(Порция), "", 0);
	ИначеЕсли ИмяСценария = "CPU_Коллекции" Тогда
		Возврат Новый Структура("Массив, Соответствие, Сумма", Новый Массив, Новый Соответствие, 0);
	ИначеЕсли ИмяСценария = "Запись_СправочникБезТранзакции" Тогда
		Возврат Новый Структура("Пусто", 0);
	ИначеЕсли ИмяСценария = "Запись_СправочникВТранзакции" Тогда
		Возврат Новый Структура("Пусто", 0);
	ИначеЕсли ИмяСценария = "Запись_ДокументыСПроведением" Тогда
		Склад = НайтиИлиСоздатьСклад();
		Номенклатура = ВыгрузитьТестовуюНоменклатуру(50);
		Если Номенклатура.Количество() < 5 Тогда
			ПодготовитьНоменклатуруДляДокументов();
			Номенклатура = ВыгрузитьТестовуюНоменклатуру(50);
		КонецЕсли;
		Возврат Новый Структура("Склад, Номенклатура, СмещениеДаты", Склад, Номенклатура, 0);
	ИначеЕсли ИмяСценария = "Запросы_Чтение" Тогда
		Возврат Новый Структура("ЗапросОстатков, ЗапросКаталога, Итог, Готовы", Неопределено, Неопределено, 0, Ложь);
	ИначеЕсли ИмяСценария = "Сериализация_JSON" Тогда
		Возврат Новый Структура("Данные, Восстановлено", Новый Массив, 0);
	ИначеЕсли ИмяСценария = "Сериализация_ЗначениеВСтроку" Тогда
		Возврат Новый Структура("Массив, Сумма", Новый Массив(Порция), 0);
	ИначеЕсли ИмяСценария = "Память_Коллекции" Тогда
		Возврат Новый Структура("Массив, Размер", Новый Массив, 0);
	ИначеЕсли ИмяСценария = "Файлы_IO" Тогда
		Возврат Новый Структура("ИмяФайла, Запись, ЗаписьОткрыта, СуммаСимволов",
			"", Неопределено, Ложь, 0);
	Иначе
		ВызватьИсключение "Неизвестный сценарий: " + ИмяСценария;
	КонецЕсли;

КонецФункции

// ---------------------------------------------------------------------------
// Диспетчеризация шагов чанков

Процедура ШагСценария(ИмяСценария, Контекст, От, До, Порция, ПоследнийЧанк)
	Если ИмяСценария = "CPU_Арифметика" Тогда
		ШагАрифметика(Контекст, От, До);
	ИначеЕсли ИмяСценария = "CPU_Строки" Тогда
		ШагСтроки(Контекст, От, До, ПоследнийЧанк);
	ИначеЕсли ИмяСценария = "CPU_Коллекции" Тогда
		ШагКоллекции(Контекст, От, До, ПоследнийЧанк);
	ИначеЕсли ИмяСценария = "Запись_СправочникБезТранзакции" Тогда
		ШагЗаписьСправочника(Контекст, От, До, ПоследнийЧанк, Ложь);
	ИначеЕсли ИмяСценария = "Запись_СправочникВТранзакции" Тогда
		ШагЗаписьСправочника(Контекст, От, До, ПоследнийЧанк, Истина);
	ИначеЕсли ИмяСценария = "Запись_ДокументыСПроведением" Тогда
		ШагЗаписьДокументов(Контекст, От, До);
	ИначеЕсли ИмяСценария = "Запросы_Чтение" Тогда
		ШагЗапросы(Контекст, От, До);
	ИначеЕсли ИмяСценария = "Сериализация_JSON" Тогда
		ШагJSON(Контекст, От, До, ПоследнийЧанк);
	ИначеЕсли ИмяСценария = "Сериализация_ЗначениеВСтроку" Тогда
		ШагЗначениеВСтроку(Контекст, От, До, ПоследнийЧанк);
	ИначеЕсли ИмяСценария = "Память_Коллекции" Тогда
		ШагПамять(Контекст, От, До, ПоследнийЧанк);
	ИначеЕсли ИмяСценария = "Файлы_IO" Тогда
		ШагФайлы(Контекст, От, До, ПоследнийЧанк);
	Иначе
		ВызватьИсключение "Неизвестный сценарий: " + ИмяСценария;
	КонецЕсли;
КонецПроцедуры

// Завершение сценария: освобождение состояния; откат транзакции, если она не зафиксирована.
Процедура КонецСценария(ИмяСценария, Контекст)

	Если ИмяСценария = "CPU_Строки" Тогда
		Контекст.Буфер = Неопределено;
		Контекст.Стр = "";
	ИначеЕсли ИмяСценария = "CPU_Коллекции" Тогда
		Контекст.Массив = Неопределено;
		Контекст.Соответствие = Неопределено;
	ИначеЕсли ИмяСценария = "Сериализация_JSON" Тогда
		Контекст.Данные = Неопределено;
	ИначеЕсли ИмяСценария = "Сериализация_ЗначениеВСтроку" Тогда
		Контекст.Массив = Неопределено;
	ИначеЕсли ИмяСценария = "Память_Коллекции" Тогда
		Контекст.Массив = Неопределено;
	ИначеЕсли ИмяСценария = "Файлы_IO" Тогда
		Если Контекст.ЗаписьОткрыта Тогда
			Попытка
				Контекст.Запись.Закрыть();
			Исключение
				ИгнорируемаяОшибка = ИнформацияОбОшибке();
			КонецПопытки;
			Контекст.ЗаписьОткрыта = Ложь;
		КонецЕсли;
		Контекст.Запись = Неопределено;
	КонецЕсли;

КонецПроцедуры

// ---------------------------------------------------------------------------
// Подготовка данных (вне замера)

Процедура ПодготовитьСценарий(ИмяСценария)
	Если ИмяСценария = "Запись_СправочникБезТранзакции"
		Или ИмяСценария = "Запись_СправочникВТранзакции" Тогда
		УдалитьТестовуюНоменклатуру();
	ИначеЕсли ИмяСценария = "Запись_ДокументыСПроведением"
		Или ИмяСценария = "Запросы_Чтение" Тогда
		УдалитьТестовыеДокументы();
		УдалитьТестовуюНоменклатуру();
	ИначеЕсли ИмяСценария = "CPU_Строки" Тогда
		ПрогревСтрок();
	ИначеЕсли ИмяСценария = "CPU_Арифметика" Тогда
		ПрогревАрифметики();
	ИначеЕсли ИмяСценария = "CPU_Коллекции" Тогда
		ПрогревКоллекций();
	КонецЕсли;
КонецПроцедуры

Процедура ПрогревАрифметики()
	Х = 1;
	Для Сч = 1 По 10000 Цикл
		Х = Х + Сч * 3 - Сч / 2;
		Если Х > 1000000000 Тогда
			Х = 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПрогревКоллекций()
	Массив = Новый Массив;
	Соответствие = Новый Соответствие;
	Для Сч = 1 По 10000 Цикл
		Массив.Добавить(Сч);
		Соответствие.Вставить(Сч, Сч * 2);
	КонецЦикла;
	Массив = Неопределено;
	Соответствие = Неопределено;
КонецПроцедуры

Процедура ПрогревСтрок()
	Буфер = Новый Массив(1000);
	Для Сч = 1 По 1000 Цикл
		Буфер[Сч - 1] = "0123456789" + Строка(Сч);
	КонецЦикла;
	СтрСоединить(Буфер, " ");
КонецПроцедуры

// ---------------------------------------------------------------------------
// Машины чанков сценариев

Процедура ШагАрифметика(Контекст, От, До)
	Х = Контекст.Х;
	Для Сч = От По До Цикл
		Х = Х + Сч * 3 - Сч / 2;
		Если Х > 1000000000 Тогда
			Х = 1;
		КонецЕсли;
	КонецЦикла;
	Контекст.Х = Х;
КонецПроцедуры

Процедура ШагСтроки(Контекст, От, До, ПоследнийЧанк)
	Базовая = "0123456789abcdef";
	Буфер = Контекст.Буфер;
	Для Сч = От По До Цикл
		Буфер[Сч - 1] = Базовая + Строка(Сч);
	КонецЦикла;
	Если ПоследнийЧанк Тогда
		Стр = СтрСоединить(Буфер, " ");
		Контекст.Стр = Стр;
		// Число и позиции поиска привязаны к длине строки: при малых порциях
		// фиксированные 50 000 поисков уходили за конец строки (исключение платформы).
		СуммаПозиций = 0;
		Длина = СтрДлина(Стр);
		Поисков = Цел(Длина / 10);
		Если Поисков < 1 Тогда
			Поисков = 1;
		КонецЕсли;
		Для Сч = 1 По Поисков Цикл
			Позиция = (Сч - 1) * 10 + 1;
			Если Позиция > Длина Тогда
				Прервать;
			КонецЕсли;
			СуммаПозиций = СуммаПозиций + СтрНайти(Стр, "abcde", НаправлениеПоиска.СНачала, Позиция);
		КонецЦикла;
		Контекст.СуммаПозиций = СуммаПозиций;
	КонецЕсли;
КонецПроцедуры

Процедура ШагКоллекции(Контекст, От, До, ПоследнийЧанк)
	Массив = Контекст.Массив;
	Соответствие = Контекст.Соответствие;
	Для Сч = От По До Цикл
		Массив.Добавить(Сч);
		Соответствие.Вставить(Сч, Сч * 2);
	КонецЦикла;
	Если ПоследнийЧанк Тогда
		// полный обход соответствия
		Сумма = 0;
		Для Каждого Пара Из Соответствие Цикл
			Сумма = Сумма + Пара.Значение;
		КонецЦикла;
		Контекст.Сумма = Сумма;
	КонецЕсли;
КонецПроцедуры

Процедура ШагЗаписьСправочника(Контекст, От, До, ПоследнийЧанк, ВТранзакции)
	// Транзакция (для варианта ВТранзакции) открывается и фиксируется в ВыполнитьПрогон,
	// здесь только записи - поэтому пара Начать/Зафиксировать живёт в одной процедуре.
	Для Сч = От По До Цикл
		ЗаписатьЭлементНоменклатуры(Сч);
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьЭлементНоменклатуры(Сч)
	Элемент = Справочники.ПерфНоменклатура.СоздатьЭлемент();
	Элемент.Наименование = "АвтоТест-" + Формат(Сч, "ЧГ=0");
	Элемент.Цена = Сч * 1.37;
	Элемент.Записать();
КонецПроцедуры

Процедура ШагЗаписьДокументов(Контекст, От, До)
	Для Д = От По До Цикл
		Документ = Документы.ПерфПоступление.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса() + Контекст.СмещениеДаты;
		Контекст.СмещениеДаты = Контекст.СмещениеДаты + 1;
		Документ.Склад = Контекст.Склад;
		Для С = 1 По 5 Цикл
			СтрокаТовары = Документ.Товары.Добавить();
			СтрокаТовары.Номенклатура = Контекст.Номенклатура[С - 1];
			СтрокаТовары.Количество = С * 10;
			СтрокаТовары.Цена = С * 100;
		КонецЦикла;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
КонецПроцедуры

Процедура ШагЗапросы(Контекст, От, До)
	Если Не Контекст.Готовы Тогда
		ПодготовитьДанныеДляЗапросов();
		Контекст.ЗапросОстатков = Новый Запрос(
			"ВЫБРАТЬ
			|	Рег.Номенклатура КАК Номенклатура,
			|	Рег.Склад КАК Склад,
			|	СУММА(Рег.КоличествоОстаток) КАК Остаток
			|ИЗ
			|	РегистрНакопления.ПерфОстаткиТоваров.Остатки(&Момент) КАК Рег
			|СГРУППИРОВАТЬ ПО
			|	Рег.Номенклатура,
			|	Рег.Склад");
		Контекст.ЗапросОстатков.УстановитьПараметр("Момент", ТекущаяДатаСеанса());
		Контекст.ЗапросКаталога = Новый Запрос(
			"ВЫБРАТЬ
			|	Ном.Наименование КАК Наименование,
			|	КОЛИЧЕСТВО(*) КАК Счет
			|ИЗ
			|	Справочник.ПерфНоменклатура КАК Ном
			|СГРУППИРОВАТЬ ПО
			|	Ном.Наименование");
		Контекст.Готовы = Истина;
	КонецЕсли;
	Для Сч = От По До Цикл
		Выборка = Контекст.ЗапросОстатков.Выполнить().Выбрать(); // BSLLS:CreateQueryInCycle-off
		Контекст.Итог = Контекст.Итог + Выборка.Количество();
		Выборка = Контекст.ЗапросКаталога.Выполнить().Выбрать(); // BSLLS:CreateQueryInCycle-off
		Контекст.Итог = Контекст.Итог + Выборка.Количество();
	КонецЦикла;
КонецПроцедуры

Процедура ШагJSON(Контекст, От, До, ПоследнийЧанк)
	Данные = Контекст.Данные;
	Для Сч = От По До Цикл
		Данные.Добавить(Новый Структура("Имя, Цена, Активно", "ТестТовар-" + Формат(Сч, "ЧГ=0"), Сч, Истина));
	КонецЦикла;
	Если ПоследнийЧанк Тогда
		ФиналJSON(Контекст);
	КонецЕсли;
КонецПроцедуры

Процедура ФиналJSON(Контекст)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Контекст.Данные);
	Текст = Запись.Закрыть();
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Восстановлено = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Контекст.Восстановлено = Восстановлено.Количество();
КонецПроцедуры

Процедура ШагЗначениеВСтроку(Контекст, От, До, ПоследнийЧанк)
	Массив = Контекст.Массив;
	Для Сч = От По До Цикл
		Массив[Сч - 1] = Сч * 7;
	КонецЦикла;
	Если ПоследнийЧанк Тогда
		Сумма = 0;
		Для Сч = 1 По 3 Цикл
			СтрокаСериализации = ЗначениеВСтрокуВнутр(Массив);
			Копия = ЗначениеИзСтрокиВнутр(СтрокаСериализации);
			Сумма = Сумма + Копия.Количество();
		КонецЦикла;
		Контекст.Сумма = Сумма;
	КонецЕсли;
КонецПроцедуры

Процедура ШагПамять(Контекст, От, До, ПоследнийЧанк)
	Массив = Контекст.Массив;
	Для Сч = От По До Цикл
		Массив.Добавить("элемент-" + Формат(Сч, "ЧГ=0"));
	КонецЦикла;
	Если ПоследнийЧанк Тогда
		Контекст.Размер = Массив.Количество();
	КонецЕсли;
КонецПроцедуры

Процедура ШагФайлы(Контекст, От, До, ПоследнийЧанк)
	Если Не Контекст.ЗаписьОткрыта Тогда
		Контекст.ИмяФайла = КаталогВременныхФайлов() + "perftest_io.txt";
		Контекст.Запись = Новый ЗаписьТекста(Контекст.ИмяФайла, КодировкаТекста.UTF8);
		Контекст.ЗаписьОткрыта = Истина;
	КонецЕсли;
	Линия = "012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";
	Для Сч = От По До Цикл
		Контекст.Запись.ЗаписатьСтроку("строка-" + Формат(Сч, "ЧГ=0") + " | " + Линия);
	КонецЦикла;
	Если ПоследнийЧанк Тогда
		Контекст.Запись.Закрыть();
		Контекст.ЗаписьОткрыта = Ложь;
		СуммаСимволов = 0;
		Чтение = Новый ЧтениеТекста(Контекст.ИмяФайла, КодировкаТекста.UTF8);
		Пока Истина Цикл
			СтрокаТекста = Чтение.ПрочитатьСтроку();
			Если СтрокаТекста = Неопределено Тогда
				Прервать;
			КонецЕсли;
			СуммаСимволов = СуммаСимволов + СтрДлина(СтрокаТекста);
		КонецЦикла;
		Чтение.Закрыть();
		УдалитьФайлы(Контекст.ИмяФайла);
		Контекст.СуммаСимволов = СуммаСимволов;
	КонецЕсли;
КонецПроцедуры

// ---------------------------------------------------------------------------
// Вспомогательные данные (не замеряются)

Процедура УдалитьТестовуюНоменклатуру()
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Ном.Ссылка КАК Ссылка ИЗ Справочник.ПерфНоменклатура КАК Ном ГДЕ Ном.Наименование ПОДОБНО ""АвтоТест-%""");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Удалить();
	КонецЦикла;
КонецПроцедуры

Процедура УдалитьТестовыеДокументы()
	Выборка = Документы.ПерфПоступление.Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Попытка
			// непроведённый удаляется сразу; у проведённого сначала отменяем проведение
			Объект.Удалить();
		Исключение
			Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Объект.Удалить();
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция НайтиИлиСоздатьСклад()
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Склад.Ссылка КАК Ссылка ИЗ Справочник.ПерфСклады КАК Склад ГДЕ Склад.Наименование = ""ТестовыйСклад""");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Элемент = Справочники.ПерфСклады.СоздатьЭлемент();
	Элемент.Наименование = "ТестовыйСклад";
	Элемент.Записать();
	Возврат Элемент.Ссылка;
КонецФункции

Процедура ПодготовитьНоменклатуруДляДокументов()
	Существующие = ВыгрузитьТестовуюНоменклатуру(50);
	Если Существующие.Количество() >= 50 Тогда
		Возврат;
	КонецЕсли;
	Для Сч = Существующие.Количество() + 1 По 50 Цикл
		ЗаписатьЭлементНоменклатуры(Сч);
	КонецЦикла;
КонецПроцедуры

Функция ВыгрузитьТестовуюНоменклатуру(Лимит)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ " + Лимит + " Ном.Ссылка КАК Ссылка ИЗ Справочник.ПерфНоменклатура КАК Ном ГДЕ Ном.Наименование ПОДОБНО ""АвтоТест-%""");
	Массив = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Процедура ПодготовитьДанныеДляЗапросов()
	ЗапросКоличества = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Счет ИЗ Документ.ПерфПоступление КАК Док");
	Выборка = ЗапросКоличества.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Счет >= 100 Тогда
		Возврат;
	КонецЕсли;
	ПодготовитьНоменклатуруДляДокументов();
	Склад = НайтиИлиСоздатьСклад();
	Номенклатура = ВыгрузитьТестовуюНоменклатуру(50);
	Для Д = 1 По 100 Цикл
		Документ = Документы.ПерфПоступление.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса() + Д;
		Документ.Склад = Склад;
		Для С = 1 По 5 Цикл
			СтрокаТовары = Документ.Товары.Добавить();
			СтрокаТовары.Номенклатура = Номенклатура[С - 1];
			СтрокаТовары.Количество = С * 10;
			СтрокаТовары.Цена = С * 100;
		КонецЦикла;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

// Записывает результат сценария (медиана по прогонам) в регистр сведений ПерфРезультаты.
// ВремяПрогонов - строка вида "4501;4499;4520" (мс, без группировки разрядов).
// Запись перезаписывается по комбинации Стенд + ВерсияПлатформы + Сценарий (независимый регистр).
// Возвращает структуру МедианаМс / НаЕдиницуМс для отображения на форме.
Функция ЗаписатьРезультат(Стенд, ИмяСценария, Представление, Порция, Единица, ВремяПрогонов, Повторов = 0, ПаспортКлиента = "") Экспорт

	Времена = Новый Массив;
	Части = СтрРазделить(ВремяПрогонов, ";", Ложь);
	Для Каждого Часть Из Части Цикл
		Если НЕ ПустаяСтрока(Часть) Тогда
			Значение = Число(СокрЛП(Часть));
			Позиция = 0;
			Пока Позиция < Времена.Количество() И Времена[Позиция] < Значение Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Времена.Вставить(Позиция, Значение);
		КонецЕсли;
	КонецЦикла;
	Если Времена.Количество() = 0 Тогда
		ВызватьИсключение "Нет прогонов для записи результата";
	КонецЕсли;
	Количество = Времена.Количество();
	Если Количество % 2 = 1 Тогда
		МедианаМс = Времена[(Количество - 1) / 2];
	Иначе
		МедианаМс = (Времена[Количество / 2 - 1] + Времена[Количество / 2]) / 2;
	КонецЕсли;
	НаЕдиницуМс = 0;
	Если Порция > 0 Тогда
		НаЕдиницуМс = МедианаМс / Порция * 1000;
	КонецЕсли;

	СтендЗапись = ИмяСтендаДляЗаписи(Стенд);
	Набор = РегистрыСведений.ПерфРезультаты.СоздатьНаборЗаписей();
	Набор.Отбор.Стенд.Установить(СтендЗапись);
	Набор.Отбор.ВерсияПлатформы.Установить(ВерсияПлатформы());
	Набор.Отбор.Сценарий.Установить(СокрЛП(ИмяСценария));
	Запись = Набор.Добавить();
	Запись.Стенд = СтендЗапись;
	Запись.ВерсияПлатформы = ВерсияПлатформы();
	Запись.Сценарий = СокрЛП(ИмяСценария);
	Запись.МедианаМс = МедианаМс;
	Запись.НаЕдиницуМс = Окр(НаЕдиницуМс, 3);
	Запись.Единица = СокрЛП(Единица);
	Запись.Порция = Порция;
	Запись.Повторов = ?(Повторов > 0, Повторов, Количество);
	Запись.МинМс = Времена[0];
	Запись.МаксМс = Времена[Количество - 1];
	Запись.ДатаЗамера = ТекущаяДатаСеанса();
	Запись.ВремяПрогонов = СокрЛП(ВремяПрогонов);
	Набор.Записать(Истина);
	// Паспорт пишется здесь для ручных прогонов из панели; для уже описанного
	// стенда вызов сразу возвращается (проверка по отпечатку и версии).
	ЗаписатьПаспортСтенда(Стенд, ПаспортКлиента);
	ЗаписатьИсториюЗамера(Стенд, ИмяСценария, МедианаМс, Окр(НаЕдиницуМс, 3), Порция,
		?(Повторов > 0, Повторов, Количество), Времена[0], Времена[Количество - 1], Единица, ВремяПрогонов);

	Возврат Новый Структура("МедианаМс, НаЕдиницуМс, МинМс, МаксМс", МедианаМс, Окр(НаЕдиницуМс, 3), Времена[0], Времена[Количество - 1]);

КонецФункции

// Количество записей результатов для стенда (маркер автопрогона reg-rows).
Функция КоличествоЗаписейРезультатов(Стенд) Экспорт

	СтендЗапись = ИмяСтендаДляЗаписи(Стенд);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Счет
		|ИЗ
		|	РегистрСведений.ПерфРезультаты
		|ГДЕ
		|	Стенд = &Стенд");
	Запрос.УстановитьПараметр("Стенд", СтендЗапись);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Счет;
	КонецЕсли;
	Возврат 0;

КонецФункции

#Область ПаспортСтенда

// Режим ИБ определяется по строке соединения: File="..." - файловая, Srvr=... - серверная.
Функция РежимИнформационнойБазыСтрокой()
	Строка = ВРег(СокрЛП(СтрокаСоединенияИнформационнойБазы()));
	Возврат ?(СтрНайти(Строка, "FILE=") > 0, "Файловый", "Серверный");
КонецФункции

// WMI-сервис (COM) или Неопределено, если COM недоступен.
Функция WMIСервис()
	Попытка
		Локатор = Новый COMОбъект("WbemScripting.SWbemLocator"); // BSLLS:UsingObjectNotAvailableUnix-off (конфигурация только Windows)
		Возврат Локатор.ConnectServer(".", "root\cimv2");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Первый объект WMI-выборки или Неопределено.
Функция WMIПервый(Сервис, ЗапросWMI)
	Если Сервис = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Выборка = Сервис.ExecQuery(ЗапросWMI);
		Для Каждого Элемент Из Выборка Цикл
			Возврат Элемент;
		КонецЦикла;
	Исключение
		Возврат Неопределено; // WMI-запрос не выполнен
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// Аптайм из WMI-даты LastBootUpTime ("20261105100422.500000+180") в виде "N дн H ч M мин".
Функция АптаймСтрокой(WMIDate)
	Попытка
		С = Лев(СокрЛП(WMIDate), 14);
		Если СтрДлина(С) < 14 Тогда
			Возврат "";
		КонецЕсли;
		ДатаЗагрузки = Дата(Число(Лев(С, 4)), Число(Сред(С, 5, 2)), Число(Сред(С, 7, 2)),
			Число(Сред(С, 9, 2)), Число(Сред(С, 11, 2)), Число(Сред(С, 13, 2)));
		ВсегоСек = ТекущаяДатаСеанса() - ДатаЗагрузки;
		Возврат Цел(ВсегоСек / 86400) + " дн "
			+ Цел((ВсегоСек % 86400) / 3600) + " ч "
			+ Цел((ВсегоСек % 3600) / 60) + " мин";
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Поля серверного паспорта: платформенные строка соединения/пользователь/имя компьютера + характеристики
// машины. СистемнаяИнформация - ТИП (конструктор по умолчанию), а не глобальное свойство: как глобальное
// свойство в серверном модуле не определено (проверено живым прогоном). Недоступное - пусто/0.
#Область ИдентификацияСтенда

// Версия схемы идентификации: при изменении набора ключевых параметров - увеличить.
Функция ВерсияСхемыИдентификации() Экспорт
	Возврат 2;
КонецФункции

// Вариант развёртывания: файловый или клиент-сервер.
Функция ВариантРазвёртывания() Экспорт
	Возврат ?(РежимИнформационнойБазыСтрокой() = "Файловый", "Файловый", "Клиент-сервер");
КонецФункции

// Нормализованный отпечаток профиля: только то, что влияет на скорость выполнения.
// Порядок и формат частей фиксированы - иначе идентификаторы "поплывут".
Функция ОтпечатокСтенда() Экспорт
	С = ПаспортСервераПоля();
	Части = Новый Массив;
	Части.Добавить("схема:" + Строка(ВерсияСхемыИдентификации()));
	Части.Добавить("пк:" + СокрЛП(С.Компьютер));
	Части.Добавить("ос:" + СокрЛП(С.ОС));
	Части.Добавить("цпу:" + СокрЛП(С.ЦПУ));
	Части.Добавить("ядра:" + Строка(С.Ядер) + "/" + Строка(С.Потоков));
	Части.Добавить("мгц:" + Строка(С.ЦПУМГц));
	Части.Добавить("озу:" + Формат(С.ПамятьМб, "ЧГ=0"));
	Части.Добавить("платформа:" + СокрЛП(С.ВерсияПлатформы) + "/" + СокрЛП(С.Платформа));
	Части.Добавить("режим:" + СокрЛП(С.РежимИБ));
	Возврат СтрСоединить(Части, "|");
КонецФункции

// Идентификатор стенда: читаемый ключ профиля "ПК-платформа-потоки-ОЗУГБ-режим".
// Пример: KOMP-8327-22-63-F. Стабилен при неизменном профиле, различает машины,
// версии платформы, число потоков, объём ОЗУ и вариант развёртывания (F/S).
// Криптостойкость не нужна: это ключ группировки, а не защита.
Функция ИдентификаторСтенда() Экспорт
	С = ПаспортСервераПоля();
	ПК = ВРег(СокрЛП(С.Компьютер));
	Если ПустаяСтрока(ПК) Тогда
		ПК = "ПК";
	КонецЕсли;
	Платформа = СтрЗаменить(СокрЛП(С.ВерсияПлатформы), ".", "");
	Потоки = ?(С.Потоков > 0, Формат(С.Потоков, "ЧГ=0"), "0");
	ОЗУ = Формат(Окр(С.ПамятьМб / 1024, 0), "ЧГ=0");
	Режим = ?(ВариантРазвёртывания() = "Файловый", "F", "S");
	Возврат ПК + "-" + Платформа + "-" + Потоки + "-" + ОЗУ + "-" + Режим;
КонецФункции

// Канонический отпечаток профиля для слияния баз на портале.
// Это НЕ отображаемое имя: строка нормализована (регистр, пробелы, разделители),
// чтобы одинаковое железо давало одинаковый отпечаток в разных базах.
// В отпечаток НЕ входят версия конфигурации, объём базы, порция и повторы:
// это условия замера, иначе один стенд дробился бы на десятки.
Функция ОтпечатокСтендаКанонический() Экспорт
	С = ПаспортСервераПоля();
	Части = Новый Массив;
	Части.Добавить("schema=" + Строка(ВерсияСхемыИдентификации()));
	Части.Добавить("computer=" + Нормализовать(С.Компьютер));
	Части.Добавить("os=" + Нормализовать(С.ОС));
	Части.Добавить("cpu=" + Нормализовать(С.ЦПУ));
	Части.Добавить("cores=" + Строка(С.Ядер));
	Части.Добавить("threads=" + Строка(С.Потоков));
	Части.Добавить("mhz=" + Строка(С.ЦПУМГц));
	Части.Добавить("ram_mb=" + Формат(С.ПамятьМб, "ЧГ=0"));
	Части.Добавить("platform=" + Нормализовать(С.ВерсияПлатформы) + "/" + Нормализовать(С.Платформа));
	Части.Добавить("deploy=" + ВариантРазвёртывания());
	Части.Добавить("dbms=" + Нормализовать(С.СУБД));
	Возврат СтрСоединить(Части, ";");
КонецФункции

// Нормализация значения отпечатка: нижний регистр, ё->е, схлопывание пробелов,
// удаление символов, которые различаются между локалями/сборками.
Функция Нормализовать(Значение) Экспорт
	Результат = НРег(СокрЛП(Строка(Значение)));
	Результат = СтрЗаменить(Результат, "ё", "е");
	Пока Найти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Результат = СтрЗаменить(Результат, "(", " ");
	Результат = СтрЗаменить(Результат, ")", " ");
	Результат = СтрЗаменить(Результат, ",", " ");
	Результат = СтрЗаменить(Результат, ";", " ");
	Результат = СтрЗаменить(Результат, ":", " ");
	Пока Найти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Результат);
КонецФункции

// Глобальный идентификатор стенда: UUID, присваивается один раз и хранится в паспорте.
// Портал сверяет стенды по отпечатку и, если стенд уже известен, возвращает свой UUID;
// тогда клиент принимает его (слияние без дублей).
Функция ГлобальныйИдентификаторСтенда(Стенд = "") Экспорт
	СтендЗапись = ИмяСтендаДляЗаписи(Стенд);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.ГлобальныйИдентификатор КАК ГлобальныйИдентификатор
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т
		|ГДЕ
		|	Т.Стенд = &Стенд");
	Запрос.УстановитьПараметр("Стенд", СтендЗапись);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И НЕ ПустаяСтрока(СокрЛП(Выборка.ГлобальныйИдентификатор)) Тогда
		Возврат СокрЛП(Выборка.ГлобальныйИдентификатор);
	КонецЕсли;
	Возврат "";
КонецФункции

// Выдать стенду глобальный идентификатор, если его ещё нет (или заменить на серверный).
Функция ПрисвоитьГлобальныйИдентификатор(Стенд, Идентификатор = "") Экспорт
	СтендЗапись = ИмяСтендаДляЗаписи(Стенд);
	Если ПустаяСтрока(Идентификатор) Тогда
		Идентификатор = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	Менеджер = РегистрыСведений.ПерфСтенды.СоздатьМенеджерЗаписи();
	Менеджер.Стенд = СтендЗапись;
	Менеджер.Прочитать();
	Если НЕ Менеджер.Прочитан() Тогда
		Возврат ""; // паспорт ещё не записан - выдадим при записи паспорта
	КонецЕсли;
	Менеджер.ГлобальныйИдентификатор = СокрЛП(Идентификатор);
	Менеджер.Записать();
	Возврат СокрЛП(Идентификатор);
КонецФункции

// Человекочитаемое имя стенда: компьютер / версия платформы / вариант развёртывания.
// Именно оно пишется в измерения Стенд: разные машины и варианты развёртывания
// различаются автоматически, без ручных имён.
Функция ИмяСтенда() Экспорт
	С = ПаспортСервераПоля();
	ПК = ?(ПустаяСтрока(С.Компьютер), "ПК", СокрЛП(С.Компьютер));
	Версия = ?(ПустаяСтрока(С.ВерсияПлатформы), "?", СокрЛП(С.ВерсияПлатформы));
	Вариант = ?(ВариантРазвёртывания() = "Файловый", "файловая", "клиент-сервер");
	Возврат ПК + " / " + Версия + " / " + Вариант;
КонецФункции

// Имя стенда для записи: явное имя сохраняется, пустое - вычисляется из профиля.
Функция ИмяСтендаДляЗаписи(Заданное) Экспорт
	Если НЕ ПустаяСтрока(Заданное) Тогда
		Возврат СокрЛП(Заданное);
	КонецЕсли;
	Возврат ИмяСтенда();
КонецФункции

// Краткая расшифровка профиля для шапки отчёта.
Функция ОписаниеПрофиляСтенда() Экспорт
	С = ПаспортСервераПоля();
	Части = Новый Массив;
	Части.Добавить(С.Компьютер);
	Части.Добавить(С.ОС);
	Части.Добавить(С.ЦПУ + ?(ПустаяСтрока(С.ЦПУПотоки), "", " (" + С.ЦПУПотоки + ")"));
	Части.Добавить(Формат(С.ПамятьМб, "ЧГ=0") + " МБ ОЗУ");
	Части.Добавить("платформа " + С.ВерсияПлатформы);
	Части.Добавить(ВариантРазвёртывания());
	Части.Добавить("конфигурация " + Метаданные.Версия);
	Возврат СтрСоединить(Части, "; ");
КонецФункции

#КонецОбласти

Функция ПаспортСервераПоля()
	Возврат ПаспортСервераПоляСобрать();
КонецФункции

// Фактический сбор паспорта (WMI, COM): вызывается один раз за сеанс.
Функция ПаспортСервераПоляСобрать()
	С = Новый Структура;
	С.Вставить("ВерсияПлатформы", ВерсияПлатформы());
	С.Вставить("Платформа", ""); // в файловом режиме заполним из паспорта клиента (клиент = сервер)
	С.Вставить("ВерсияКонфигурации", Метаданные.Версия);
	С.Вставить("РежимИБ", РежимИнформационнойБазыСтрокой());
	С.Вставить("СтрокаСоединенияИБ", СокрЛП(СтрокаСоединенияИнформационнойБазы()));
	С.Вставить("СоединениеИБ", Строка(НомерСоединенияИнформационнойБазы()));
	С.Вставить("Пользователь", СокрЛП(ИмяПользователя()));
	С.Вставить("Компьютер", СокрЛП(ИмяКомпьютера()));
	С.Вставить("ОС", "");
	С.Вставить("ЦПУ", "");
	С.Вставить("ЦПУПотоки", "");
	С.Вставить("Ядер", 0);
	С.Вставить("Потоков", 0);
	С.Вставить("ЦПУМГц", 0);
	С.Вставить("Диск", "");
	С.Вставить("СУБД", "");
	С.Вставить("ПамятьМб", 0);
	С.Вставить("СвободнаПамятьМб", 0);
	С.Вставить("ПК", "");
	С.Вставить("ЗагрузкаЦПУПроц", 0);
	С.Вставить("Аптайм", "");
	С.Вставить("ОшибкаWMI", "");
	Попытка
		СИ = Новый СистемнаяИнформация;
		С.Платформа = Строка(СИ.ТипПлатформы);
		С.ОС = СокрЛП(СИ.ВерсияОС);
		С.ЦПУ = СокрЛП(СИ.Процессор);
		С.ПамятьМб = Окр(СИ.ОперативнаяПамять / 1048576, 0); // в байтах
	Исключение
		С.ОшибкаWMI = "СИ: " + Лев(ИнформацияОбОшибке().Описание, 120);
	КонецПопытки;
	Попытка
		Сервис = WMIСервис();
		ОС = WMIПервый(Сервис, "SELECT Caption, Version, BuildNumber, FreePhysicalMemory, LastBootUpTime FROM Win32_OperatingSystem");
		ЦПУ = WMIПервый(Сервис, "SELECT Name, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed, LoadPercentage FROM Win32_Processor");
		ПК = WMIПервый(Сервис, "SELECT Name, Manufacturer, Model, TotalPhysicalMemory FROM Win32_ComputerSystem");
		Если ОС <> Неопределено Тогда
			С.ОС = СокрЛП(ОС.Caption) + " v" + СокрЛП(ОС.Version) + " build " + СокрЛП(ОС.BuildNumber);
			С.СвободнаПамятьМб = Окр(ОС.FreePhysicalMemory / 1024, 0);
			С.Аптайм = АптаймСтрокой(ОС.LastBootUpTime);
		КонецЕсли;
		Если ЦПУ <> Неопределено Тогда
			С.ЦПУ = СокрЛП(ЦПУ.Name);
			С.ЦПУПотоки = Строка(ЦПУ.NumberOfCores) + " ядер / " + Строка(ЦПУ.NumberOfLogicalProcessors) + " потоков";
			С.Ядер = ЦПУ.NumberOfCores;
			С.Потоков = ЦПУ.NumberOfLogicalProcessors;
			С.ЦПУМГц = ЦПУ.MaxClockSpeed;
			С.ЗагрузкаЦПУПроц = ЦПУ.LoadPercentage;
		КонецЕсли;
		Если ПК <> Неопределено Тогда
			ПКМодель = СокрЛП(ПК.Manufacturer) + ?(ПустаяСтрока(СокрЛП(ПК.Model)), "", " " + СокрЛП(ПК.Model));
			С.ПК = СокрЛП(ПК.Name) + ?(ПустаяСтрока(ПКМодель), "", " (" + ПКМодель + ")");
			С.ПамятьМб = Окр(ПК.TotalPhysicalMemory / 1048576, 0); // WMI отдаёт байты
		КонецЕсли;
	Исключение
		С.ОшибкаWMI = ?(ПустаяСтрока(С.ОшибкаWMI), "", С.ОшибкаWMI + "; ")
			+ "WMI: " + Лев(ИнформацияОбОшибке().Описание, 120);
	КонецПопытки;
	С.Диск = ДискСтрокой();
	С.СУБД = СУБДСтрокой();
	Возврат С;
КонецФункции

// Модель и объём системного диска (WMI); при недоступности - пустая строка.
Функция ДискСтрокой()
	Попытка
		Сервис = WMIСервис();
		Диски = WMIПервый(Сервис, "SELECT Model, Size, MediaType FROM Win32_DiskDrive");
		Лог = WMIПервый(Сервис, "SELECT FreeSpace, Size FROM Win32_LogicalDisk WHERE DeviceID = 'C:'");
		Если Диски = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Тип = ?(Диски.MediaType = Неопределено, "", " / " + СокрЛП(Строка(Диски.MediaType)));
		Объём = ?(Диски.Size = Неопределено, 0, Окр(Диски.Size / 1073741824, 0));
		Свободно = 0;
		Если Лог <> Неопределено Тогда
			Свободно = Окр(Лог.FreeSpace / 1073741824, 0);
		КонецЕсли;
		Возврат СокрЛП(Строка(Диски.Model)) + Тип + ", " + Объём + " ГБ (C: свободно " + Свободно + " ГБ)";
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// СУБД: в файловом режиме её нет; в клиент-серверном режиме платформа её не сообщает.
Функция СУБДСтрокой()
	Если РежимИнформационнойБазыСтрокой() = "Файловый" Тогда
		Возврат "файловая (1CD)";
	КонецЕсли;
	Возврат "не определена (клиент-сервер)";
КонецФункции

// Объём файловой ИБ в МБ; в клиент-серверном режиме 0.
Функция ОбъёмИБМб()
	Попытка
		Строка = СтрокаСоединенияИнформационнойБазы();
		Поз = СтрНайти(ВРег(Строка), "FILE=");
		Если Поз = 0 Тогда
			Возврат 0;
		КонецЕсли;
		Путь = Сред(Строка, Поз + 5);
		Если Найти(Путь, ";") > 0 Тогда
			Путь = Лев(Путь, Найти(Путь, ";") - 1);
		КонецЕсли;
		Путь = СтрЗаменить(СтрЗаменить(Путь, Символы.Кавычка, ""), "'", "");
		Ф = Новый Файл(Путь);
		Если Ф.ЭтоКаталог() Тогда
			Ф = Новый Файл(Путь + "\1Cv8.1CD");
		КонецЕсли;
		Если Ф.Существует() Тогда
			Возврат Окр(Ф.Размер() / 1048576, 2);
		КонецЕсли;
	Исключение
		Возврат 0;
	КонецПопытки;
	Возврат 0;
КонецФункции

Функция ПолеПаспорта(Поля, Ключ)
	Значение = Поля.Получить(Ключ);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

Функция ЧислоПаспорта(Поля, Ключ)
	Значение = Поля.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Разбирает строку паспорта вида "ОС=...;ЦПУ=...;..." в соответствие ключ->значение.
Функция РазобратьПаспорт(СтрокаПаспорта)
	Результат = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(СтрокаПаспорта, ";", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция > 1 Тогда
			Результат.Вставить(СокрЛП(Лев(Часть, Позиция - 1)), СокрЛП(Сред(Часть, Позиция + 1)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Перезаписывает паспорт стенда в регистре сведений ПерфСтенды по ключу Стенд.
// ПаспортКлиента - строка вида "ОС=...;ЦПУ=...;ПамятьМб=..." от клиента (форма/автопрогон).
Функция ЗаписатьПаспортСтенда(Стенд, ПаспортКлиента = "") Экспорт

	// Паспорт нужен для группировки, но не для каждого замера: если он моложе
	// 10 минут и версия конфигурации не менялась, повторная запись не нужна
	// (иначе WMI-сбор добавлял по несколько секунд на каждый сценарий).
	СтендКлюч = ИмяСтендаДляЗаписи(Стенд);
	ПроверкаЗапрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Отпечаток КАК Отпечаток,
		|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т
		|ГДЕ
		|	Т.Стенд = &Стенд");
	ПроверкаЗапрос.УстановитьПараметр("Стенд", СтендКлюч);
	ПроверкаВыборка = ПроверкаЗапрос.Выполнить().Выбрать();
	Если ПроверкаВыборка.Следующий() Тогда
		// Паспорт уже есть и описывает тот же стенд той же версии конфигурации:
		// пересборка через WMI (секунды) не нужна. Сравнение по дате не годится:
		// ДатаПаспорта хранится без времени, граница "10 минут" по ней не работает.
		Если ЗначениеЗаполнено(ПроверкаВыборка.Отпечаток)
			И СокрЛП(ПроверкаВыборка.ВерсияКонфигурации) = СокрЛП(Метаданные.Версия) Тогда
			Возврат ЗначениеЗаполнено(ПроверкаВыборка.Отпечаток);
		КонецЕсли;
	КонецЕсли;

	СтендЗапись = ИмяСтендаДляЗаписи(Стенд);
	С = ПаспортСервераПоля();
	К = РазобратьПаспорт(ПаспортКлиента);
	Если С.РежимИБ = "Файловый" Тогда
		С.Платформа = ПолеПаспорта(К, "Платформа"); // в файловом режиме клиент = сервер
	КонецЕсли;

	Запись = РегистрыСведений.ПерфСтенды.СоздатьМенеджерЗаписи();
	Запись.Стенд = СтендЗапись;
	Запись.ВерсияПлатформыСервер = С.ВерсияПлатформы;
	Запись.ПлатформаСервер = С.Платформа;
	Запись.ВерсияКонфигурации = С.ВерсияКонфигурации;
	Запись.РежимИБ = С.РежимИБ;
	Запись.СтрокаСоединенияИБ = С.СтрокаСоединенияИБ;
	Запись.СоединениеИБ = С.СоединениеИБ;
	Запись.Пользователь = С.Пользователь;
	Запись.СерверКомпьютер = С.Компьютер;
	Запись.СерверОС = С.ОС;
	Запись.СерверЦПУ = С.ЦПУ;
	Запись.СерверЦПУПотоки = С.ЦПУПотоки;
	Запись.СерверЦПУМГц = С.ЦПУМГц;
	Запись.СерверПамятьМб = С.ПамятьМб;
	Запись.СерверСвободнаПамятьМб = С.СвободнаПамятьМб;
	Запись.СерверПК = С.ПК;
	Запись.СерверЗагрузкаЦПУПроц = С.ЗагрузкаЦПУПроц;
	Запись.СерверАптайм = С.Аптайм;
	Запись.КлиентОС = ПолеПаспорта(К, "ОС");
	Запись.КлиентЦПУ = ПолеПаспорта(К, "ЦПУ");
	Запись.КлиентЦПУПотоки = ПолеПаспорта(К, "ЦПУПотоки");
	Запись.КлиентЦПУМГц = ЧислоПаспорта(К, "ЦПУМГц");
	Запись.КлиентПамятьМб = ЧислоПаспорта(К, "ПамятьМб");
	Запись.КлиентСвободнаПамятьМб = ЧислоПаспорта(К, "СвободнаМб");
	Запись.КлиентПК = ПолеПаспорта(К, "ПК");
	Запись.КлиентЗагрузкаЦПУПроц = ЧислоПаспорта(К, "ЦПУЗагрузкаПроц");
	Запись.КлиентАптайм = ПолеПаспорта(К, "Аптайм");
	Запись.КлиентПлатформа = ПолеПаспорта(К, "Платформа");
	Запись.ИдентификаторСтенда = ИдентификаторСтенда();
	Запись.СхемаИдентификации = ВерсияСхемыИдентификации();
	Запись.ВариантРазвёртывания = ВариантРазвёртывания();
	Запись.ВерсияСервера = С.ВерсияПлатформы;
	Запись.СУБД = С.СУБД;
	Запись.СерверЯдер = С.Ядер;
	Запись.СерверПотоков = С.Потоков;
	Запись.Диск = Лев(С.Диск, 200);
	Запись.ОбъёмИБМб = ОбъёмИБМб();
	Запись.Отпечаток = Лев(ОтпечатокСтендаКанонический(), 500);
	Если ПустаяСтрока(Запись.ГлобальныйИдентификатор) Тогда
		Существующий = ГлобальныйИдентификаторСтенда(СтендЗапись);
		Запись.ГлобальныйИдентификатор = ?(ПустаяСтрока(Существующий),
			Строка(Новый УникальныйИдентификатор()), Существующий);
	КонецЕсли;
	Запись.ДатаПаспорта = ТекущаяДатаСеанса();
	Примечание = "";
	Если С.ОшибкаWMI <> "" Тогда
		Примечание = "WMI сервера: " + СтрЗаменить(Лев(С.ОшибкаWMI, 120), Символы.ПС, " ");
	ИначеЕсли С.ПК = "" Тогда
		Примечание = "WMI недоступен на сервере";
	КонецЕсли;
	Если ПаспортКлиента = "" Тогда
		Примечание = ?(Примечание = "", "", Примечание + "; ") + "паспорт клиента не передан";
	ИначеЕсли ПолеПаспорта(К, "СвободнаМб") = "" Тогда
		Примечание = ?(Примечание = "", "", Примечание + "; ") + "WMI клиента недоступен";
	КонецЕсли;
	Запись.Примечание = Примечание + "; t=" + Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss");
	Запись.Записать();
	Возврат Истина;

КонецФункции

// Краткий паспорт стенда строкой - для маркеров автопрогона и диагностики.
// Читается запросом: набор с отбором не гарантирует чтение всех реквизитов.
Функция ПрочитатьПаспортСтенда(Стенд) Экспорт
	СтендЗапись = ИмяСтендаДляЗаписи(Стенд);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.ГлобальныйИдентификатор КАК ГлобальныйИдентификатор,
		|	Т.Отпечаток КАК Отпечаток,
		|	Т.ИдентификаторСтенда КАК ИдентификаторСтенда,
		|	Т.СхемаИдентификации КАК СхемаИдентификации,
		|	Т.ВариантРазвёртывания КАК ВариантРазвёртывания,
		|	Т.СУБД КАК СУБД,
		|	Т.СерверЯдер КАК СерверЯдер,
		|	Т.СерверПотоков КАК СерверПотоков,
		|	Т.Диск КАК Диск,
		|	Т.ОбъёмИБМб КАК ОбъёмИБМб,
		|	Т.РежимИБ КАК РежимИБ,
		|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации,
		|	Т.ПлатформаСервер КАК ПлатформаСервер,
		|	Т.СерверОС КАК СерверОС,
		|	Т.СерверЦПУ КАК СерверЦПУ,
		|	Т.СерверЦПУПотоки КАК СерверЦПУПотоки,
		|	Т.СерверПамятьМб КАК СерверПамятьМб,
		|	Т.Примечание КАК Примечание
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т
		|ГДЕ
		|	Т.Стенд = &Стенд");
	Запрос.УстановитьПараметр("Стенд", СтендЗапись);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат "паспорт не записан";
	КонецЕсли;
	Возврат "GUID=" + Выборка.ГлобальныйИдентификатор
		+ "; Отпечаток=" + Лев(Выборка.Отпечаток, 120)
		+ "; ID=" + Выборка.ИдентификаторСтенда
		+ "; Схема=" + Выборка.СхемаИдентификации
		+ "; Вариант=" + Выборка.ВариантРазвёртывания
		+ "; СУБД=" + Выборка.СУБД
		+ "; Ядер=" + Выборка.СерверЯдер + "/" + Выборка.СерверПотоков
		+ "; Диск=" + Выборка.Диск
		+ "; ИБ,МБ=" + Выборка.ОбъёмИБМб
		+ "; РежимИБ=" + Выборка.РежимИБ
		+ "; Конфигурация=" + Выборка.ВерсияКонфигурации
		+ "; Платформа=" + Выборка.ПлатформаСервер
		+ "; СерверОС=" + Выборка.СерверОС
		+ "; СерверЦПУ=" + Выборка.СерверЦПУ + " (" + Выборка.СерверЦПУПотоки + ")"
		+ "; СерверПамятьМб=" + Выборка.СерверПамятьМб
		+ "; Примечание=" + Выборка.Примечание;
КонецФункции

// Количество паспортов стенда (маркер автопрогона passport-rows).
Функция КоличествоЗаписейПаспортов(Стенд) Экспорт
	СтендЗапись = ИмяСтендаДляЗаписи(Стенд);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Счет
		|ИЗ
		|	РегистрСведений.ПерфСтенды
		|ГДЕ
		|	Стенд = &Стенд");
	Запрос.УстановитьПараметр("Стенд", СтендЗапись);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Счет;
	КонецЕсли;
	Возврат 0;
КонецФункции

#КонецОбласти

#Область ЭкспортДляПортала

// Выгрузка замеров в JSON для портала глобального рейтинга.
// Формат: { schema, exported, stands: [ { guid, fingerprint, id, name, profile{}, runs[] } ] }
// Дедупликацию выполняет портал: по fingerprint (хеш отпечатка), затем по guid.
Функция ЭкспортЗамеровJSON(Путь = "") Экспорт

	Если ПустаяСтрока(Путь) Тогда
		Путь = КаталогВременныхФайлов() + "perftest_export.json";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	Т.ГлобальныйИдентификатор КАК ГлобальныйИдентификатор,
		|	Т.Отпечаток КАК Отпечаток,
		|	Т.ИдентификаторСтенда КАК ИдентификаторСтенда,
		|	Т.СхемаИдентификации КАК СхемаИдентификации,
		|	Т.ВариантРазвёртывания КАК ВариантРазвёртывания,
		|	Т.СУБД КАК СУБД,
		|	Т.ВерсияСУБД КАК ВерсияСУБД,
		|	Т.ВерсияПлатформыСервер КАК ВерсияПлатформы,
		|	Т.ПлатформаСервер КАК Платформа,
		|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации,
		|	Т.РежимИБ КАК РежимИБ,
		|	Т.СерверКомпьютер КАК Компьютер,
		|	Т.СерверОС КАК ОС,
		|	Т.СерверЦПУ КАК ЦПУ,
		|	Т.СерверЯдер КАК Ядер,
		|	Т.СерверПотоков КАК Потоков,
		|	Т.СерверЦПУМГц КАК ЦПУМГц,
		|	Т.СерверПамятьМб КАК ПамятьМб,
		|	Т.Диск КАК Диск,
		|	Т.ОбъёмИБМб КАК ОбъёмИБМб,
		|	Т.ДатаПаспорта КАК ДатаПаспорта
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т");
	Паспорта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Копируем значения: курсор выборки переиспользуется и «уезжает» к последней строке.
		Паспорта.Вставить(СокрЛП(Выборка.Стенд), Новый Структура(
			"ГлобальныйИдентификатор, Отпечаток, ИдентификаторСтенда, СхемаИдентификации,"
			+ "ВариантРазвёртывания, СУБД, ВерсияСУБД, ВерсияПлатформы, Платформа,"
			+ "ВерсияКонфигурации, РежимИБ, Компьютер, ОС, ЦПУ, Ядер, Потоков, ЦПУМГц,"
			+ "ПамятьМб, Диск, ОбъёмИБМб, ДатаПаспорта",
			СокрЛП(Выборка.ГлобальныйИдентификатор), СокрЛП(Выборка.Отпечаток),
			СокрЛП(Выборка.ИдентификаторСтенда), Выборка.СхемаИдентификации,
			СокрЛП(Выборка.ВариантРазвёртывания), СокрЛП(Выборка.СУБД), СокрЛП(Выборка.ВерсияСУБД),
			СокрЛП(Выборка.ВерсияПлатформы), СокрЛП(Выборка.Платформа),
			СокрЛП(Выборка.ВерсияКонфигурации), СокрЛП(Выборка.РежимИБ), СокрЛП(Выборка.Компьютер),
			СокрЛП(Выборка.ОС), СокрЛП(Выборка.ЦПУ), Выборка.Ядер, Выборка.Потоков,
			Выборка.ЦПУМГц, Выборка.ПамятьМб, СокрЛП(Выборка.Диск), Выборка.ОбъёмИБМб,
			Выборка.ДатаПаспорта));
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	Т.Сценарий КАК Сценарий,
		|	Т.МедианаМс КАК МедианаМс,
		|	Т.НаЕдиницуМс КАК НаЕдиницуМс,
		|	Т.Единица КАК Единица,
		|	Т.Порция КАК Порция,
		|	Т.Повторов КАК Повторов,
		|	Т.МинМс КАК МинМс,
		|	Т.МаксМс КАК МаксМс,
		|	Т.ДатаЗамера КАК ДатаЗамера
		|ИЗ
		|	РегистрСведений.ПерфРезультаты КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.Стенд, Т.Сценарий");
	ПоСтендам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стенд = СокрЛП(Выборка.Стенд);
		Замеры = ПоСтендам.Получить(Стенд);
		Если Замеры = Неопределено Тогда
			Замеры = Новый Массив;
			ПоСтендам.Вставить(Стенд, Замеры);
		КонецЕсли;
		Замеры.Добавить(Новый Структура(
			"Сценарий, МедианаМс, НаЕдиницуМс, Единица, Порция, Повторов, МинМс, МаксМс, ДатаЗамера",
			СокрЛП(Выборка.Сценарий), Выборка.МедианаМс, Выборка.НаЕдиницуМс, СокрЛП(Выборка.Единица),
			Выборка.Порция, Выборка.Повторов, Выборка.МинМс, Выборка.МаксМс, Выборка.ДатаЗамера));
	КонецЦикла;

	Файл = Новый ЗаписьJSON;
	Файл.ОткрытьФайл(Путь, "UTF-8");
	Файл.ЗаписатьНачалоОбъекта();
	Файл.ЗаписатьИмяСвойства("schema");
	Файл.ЗаписатьЗначение(2);
	Файл.ЗаписатьИмяСвойства("exported");
	Файл.ЗаписатьЗначение(Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Файл.ЗаписатьИмяСвойства("stands");
	Файл.ЗаписатьНачалоМассива();
	Для Каждого СтендК Из ПоСтендам Цикл
		П = Паспорта.Получить(СтендК.Ключ);
		Файл.ЗаписатьНачалоОбъекта();
		Файл.ЗаписатьИмяСвойства("name");
		Файл.ЗаписатьЗначение(СокрЛП(СтендК.Ключ));
		Файл.ЗаписатьИмяСвойства("guid");
		Файл.ЗаписатьЗначение(?(П = Неопределено, "", СокрЛП(П.ГлобальныйИдентификатор)));
		Файл.ЗаписатьИмяСвойства("fingerprint");
		Файл.ЗаписатьЗначение(?(П = Неопределено, "", СокрЛП(П.Отпечаток)));
		Файл.ЗаписатьИмяСвойства("localId");
		Файл.ЗаписатьЗначение(?(П = Неопределено, "", СокрЛП(П.ИдентификаторСтенда)));
		Файл.ЗаписатьИмяСвойства("profile");
		Файл.ЗаписатьНачалоОбъекта();
		Для Каждого Поле Из СтрРазделить("СхемаИдентификации,ВариантРазвёртывания,СУБД,ВерсияСУБД,"
			+ "ВерсияПлатформы,Платформа,ВерсияКонфигурации,РежимИБ,Компьютер,ОС,ЦПУ,Ядер,Потоков,"
			+ "ЦПУМГц,ПамятьМб,Диск,ОбъёмИБМб", ",") Цикл
			Файл.ЗаписатьИмяСвойства(Поле);
			Файл.ЗаписатьЗначение(?(П = Неопределено, "", Строка(П[Поле])));
		КонецЦикла;
		Файл.ЗаписатьКонецОбъекта();
		Файл.ЗаписатьИмяСвойства("runs");
		Файл.ЗаписатьНачалоМассива();
		Для Каждого Замер Из СтендК.Значение Цикл
			Файл.ЗаписатьНачалоОбъекта();
			Файл.ЗаписатьИмяСвойства("scenario");
			Файл.ЗаписатьЗначение(СокрЛП(Замер.Сценарий));
			Файл.ЗаписатьИмяСвойства("medianMs");
			Файл.ЗаписатьЗначение(?(Замер.МедианаМс = Неопределено, 0, Замер.МедианаМс));
			Файл.ЗаписатьИмяСвойства("perUnitMs");
			Файл.ЗаписатьЗначение(?(Замер.НаЕдиницуМс = Неопределено, 0, Замер.НаЕдиницуМс));
			Файл.ЗаписатьИмяСвойства("unit");
			Файл.ЗаписатьЗначение(СокрЛП(Замер.Единица));
			Файл.ЗаписатьИмяСвойства("portion");
			Файл.ЗаписатьЗначение(?(Замер.Порция = Неопределено, 0, Замер.Порция));
			Файл.ЗаписатьИмяСвойства("repeats");
			Файл.ЗаписатьЗначение(?(Замер.Повторов = Неопределено, 0, Замер.Повторов));
			Файл.ЗаписатьИмяСвойства("minMs");
			Файл.ЗаписатьЗначение(?(Замер.МинМс = Неопределено, 0, Замер.МинМс));
			Файл.ЗаписатьИмяСвойства("maxMs");
			Файл.ЗаписатьЗначение(?(Замер.МаксМс = Неопределено, 0, Замер.МаксМс));
			Файл.ЗаписатьИмяСвойства("measuredAt");
			Файл.ЗаписатьЗначение(Формат(Замер.ДатаЗамера, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			Файл.ЗаписатьКонецОбъекта();
		КонецЦикла;
		Файл.ЗаписатьКонецМассива();
		Файл.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Файл.ЗаписатьКонецМассива();
	Файл.ЗаписатьКонецОбъекта();
	Файл.Закрыть();

	Возврат Путь;

КонецФункции

#КонецОбласти

#Область ИсторияЗамеров

// Добавляет запись в журнал ПерфИстория (без перезаписи - история замеров).
Функция ЗаписатьИсториюЗамера(Стенд, ИмяСценария, МедианаМс, НаЕдиницуМс, Порция,
	Повторов, МинМс, МаксМс, Единица, ВремяПрогонов) Экспорт
	СтендЗапись = ИмяСтендаДляЗаписи(Стенд);
	МоментЗамера = ТекущаяДатаСеанса();
	НаборИстории = РегистрыСведений.ПерфИстория.СоздатьНаборЗаписей();
	НаборИстории.Отбор.Стенд.Установить(СтендЗапись);
	НаборИстории.Отбор.Сценарий.Установить(СокрЛП(ИмяСценария));
	НаборИстории.Отбор.ДатаЗамера.Установить(МоментЗамера);
	Запись = НаборИстории.Добавить();
	Запись.ДатаЗамера = МоментЗамера;
	Запись.Стенд = СтендЗапись;
	Запись.Сценарий = СокрЛП(ИмяСценария);
	Запись.МедианаМс = МедианаМс;
	Запись.НаЕдиницуМс = Окр(НаЕдиницуМс, 3);
	Запись.Порция = Порция;
	Запись.Повторов = Повторов;
	Запись.МинМс = МинМс;
	Запись.МаксМс = МаксМс;
	Запись.Единица = СокрЛП(Единица);
	Запись.ВремяПрогонов = СокрЛП(ВремяПрогонов);
	НаборИстории.Записать(Истина); // отбор по Стенд+Сценарий+ДатаЗамера: та же секунда перезаписывается, иная - добавляется
	Возврат Истина;
КонецФункции

// Количество записей истории стенда (маркер автопрогона history-rows).
Функция КоличествоЗаписейИстории(Стенд) Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Счет
		|ИЗ
		|	РегистрСведений.ПерфИстория
		|ГДЕ
		|	Стенд = &Стенд");
	Запрос.УстановитьПараметр("Стенд", ИмяСтендаДляЗаписи(Стенд));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Счет;
	КонецЕсли;
	Возврат 0;
КонецФункции

#КонецОбласти
