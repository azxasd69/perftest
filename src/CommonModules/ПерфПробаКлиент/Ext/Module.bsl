// Проба каналов обмена с рабочего места.
//
// Модуль клиентский (управляемое и обычное приложение): HTTPСоединение и
// ЗащищенноеСоединениеOpenSSL в клиентском контексте доступны - проверено на
// 8.3.27 (толстый клиент 65 мс, тонкий 62 мс, код 200). FTP, SMTP, SFTP и DNS
// с клиента не проверить: нужных клиентов в управляемом приложении нет.
// Настройки читает и результат пишет сервер (ПерфОбмен), здесь только запросы.

// Проба всех каналов узла "Клиент" и запись результата одной кнопкой страницы.
Функция ПроверитьИЗаписать() Экспорт

	Настройки = Параметры();
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результаты = Проверить(Настройки);
	Записать(Результаты);
	Возврат Результаты;

КонецФункции

// Настройки приёма: адрес, прокси, таймаут и ресурсы HTTP-каналов (готовит сервер).
Функция Параметры() Экспорт

	Возврат ПерфОбмен.ПараметрыПробыКлиента();

КонецФункции

// Запросы по всем каналам списка: массив структур результата.
Функция Проверить(Настройки) Экспорт

	Результаты = Новый Массив;
	Для Каждого Канал Из Настройки.Каналы Цикл
		Результаты.Добавить(ПробаКанала(Канал, Настройки));
	КонецЦикла;
	Возврат Результаты;

КонецФункции

// Запись пробы узла "Клиент": узел, срок годности и подпись процесса ставит сервер.
Процедура Записать(Результаты) Экспорт

	ИмяПК = "";
	Попытка
		// В веб-клиенте имени компьютера нет: тогда подпись ставит сервер.
		ИмяПК = ИмяКомпьютера();
	Исключение
		ИмяПК = "";
	КонецПопытки;
	// Глобальная функция ТипПлатформы() в клиентском модуле недоступна, а свойство
	// у выражения "Новый ..." язык не принимает (ошибка 10:08:14): нужна переменная.
	Процесс = "1cv8";
	Попытка
		СИ = Новый СистемнаяИнформация;
		Тип = Строка(СИ.ТипПлатформы);
		Процесс = ?(СтрНайти(НРег(Тип), "тонкий") > 0, "1cv8c", "1cv8");
	Исключение
		// Тип платформы не определен - подпись остается общей.
		Процесс = "1cv8";
	КонецПопытки;
	ПерфОбмен.ЗаписатьПробуКлиента(Результаты, ИмяПК, Процесс);

КонецПроцедуры

// Один канал: GET на тот же ресурс, что проверяет сервер. Проверка сертификата
// не цель пробы - важно, доходит ли запрос; доверие к сертификату и подпись
// проверяет серверная отправка.
Функция ПробаКанала(Канал, Настройки)

	Результат = Новый Структура("Канал, Доступен, Код, Ответ, Мс, Причина",
		Канал.Канал, Ложь, 0, "", 0, "");
	Защита = Неопределено;
	Если Канал.Порт <> 80 Тогда
		Защита = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Соединение = Новый HTTPСоединение(Настройки.Хост, Канал.Порт, "", "",
			Настройки.Прокси, Настройки.Таймаут, Защита);
		Ответ = Соединение.Получить(Новый HTTPЗапрос(Канал.Ресурс));
		Результат.Код = Ответ.КодСостояния;
		Результат.Ответ = Строка(Ответ.КодСостояния);
		// WEBDAV отвечает на каталог 200/207/301/401 - канал при этом живой.
		Если Канал.Канал = "WEBDAV" Тогда
			Результат.Доступен = Ответ.КодСостояния = 200 ИЛИ Ответ.КодСостояния = 207
				ИЛИ Ответ.КодСостояния = 301 ИЛИ Ответ.КодСостояния = 401;
		Иначе
			Результат.Доступен = (Ответ.КодСостояния = 200);
		КонецЕсли;
	Исключение
		Результат.Причина = ОписаниеОшибки();
	КонецПопытки;
	Результат.Мс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Возврат Результат;

КонецФункции
