// Журнал ошибок и предупреждений PerfTest.
//
// Зачем: причины сбоев терялись в Попытке - аудит 08.11.2026 показал 133 блока
// и 15 перехваченных ошибок, текст которых никто не читал (история: Символы.Кавычка,
// литеральные \t в запросах). Теперь такая точка пишет запись в регистр ПерфОшибки:
// место, текст, контекст, стенд и сценарий.
//
// Контракт:
// - ЗаписатьОшибку никогда не бросает исключений. Если запись в регистр не удалась,
//   текст уходит в файл КаталогВременныхФайлов() + "perftest_errors.log" (append).
// - Ключ записи ДатаВремя + УИД: две ошибки в одну секунду не перезаписывают друг друга.
// - Журнал не растёт бесконечно: ОграничитьЖурнал вызывается на старте прогона и панели.

#Область ПрограммныйИнтерфейс

// Пишет запись в журнал ошибок. Исключений не бросает.
//
// Параметры:
//   Контекст       - Строка - модуль, процедура или этап: "ПерфПаспорт.СобратьПоляWindows".
//   Сообщение      - Строка - текст ошибки.
//   Дополнительно  - Строка - значения, стек, причина; может быть пустой.
//   Тяжесть        - Строка - "Ошибка" (по умолчанию), "Предупреждение", "Событие".
//   Сценарий       - Строка - код сценария замера, если ошибка привязана к нему.
//   Стенд          - Строка - стенд, если известен.
//   Источник       - Строка - "сервер", "клиент", "фон", "мост", "внешнее соединение".
//
// Возвращает:
//   Булево - Истина, если запись попала в регистр.
Функция ЗаписатьОшибку(Контекст, Сообщение, Дополнительно = "", Тяжесть = "Ошибка",
	Сценарий = "", Стенд = "", Источник = "сервер") Экспорт

	Попытка
		Набор = РегистрыСведений.ПерфОшибки.СоздатьНаборЗаписей();
		Запись = Набор.Добавить();
		Запись.ДатаВремя = ТекущаяДатаСеанса();
		Запись.УИД = Строка(Новый УникальныйИдентификатор);
		Запись.Тяжесть = Лев(СокрЛП(Тяжесть), 20);
		Запись.Контекст = Лев(СокрЛП(Контекст), 200);
		Запись.Сообщение = Лев(СокрЛП(Сообщение), 1000);
		Запись.Дополнительно = Лев(СокрЛП(Дополнительно), 2000);
		Запись.Стенд = Лев(СокрЛП(Стенд), 100);
		Запись.Сценарий = Лев(СокрЛП(Сценарий), 100);
		Запись.Источник = Лев(СокрЛП(Источник), 30);
		Запись.Пользователь = Лев(ИмяПользователя(), 100);
		// Без параметра: Записать(Истина) на наборе без отбора стёр бы весь журнал.
		Набор.Записать();
		Возврат Истина;
	Исключение
		ЗаписатьВФайл(Контекст, Сообщение, Дополнительно, ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Короткая форма для предупреждений: та же запись, тяжесть "Предупреждение".
Процедура ЗаписатьПредупреждение(Контекст, Сообщение, Дополнительно = "",
	Сценарий = "", Стенд = "") Экспорт

	ЗаписатьОшибку(Контекст, Сообщение, Дополнительно, "Предупреждение", Сценарий, Стенд);

КонецПроцедуры

// Запись из блока Попытка: собирает текст ошибки и стек в одну запись.
//
// Параметры:
//   Контекст          - Строка - где перехвачено.
//   ИнформацияОбОшибке - ИнформацияОбОшибке - сведения об исключении.
//   Дополнительно     - Строка - что-то поверх текста (значение, сценарий).
Процедура ЗаписатьИсключение(Контекст, ИнформацияОбОшибке, Дополнительно = "",
	Сценарий = "", Стенд = "") Экспорт

	Текст = "";
	Стек = "";
	Попытка
		Текст = ИнформацияОбОшибке.Описание;
		Стек = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	Исключение
		Текст = "" + ИнформацияОбОшибке;
	КонецПопытки;
	Если Не ПустаяСтрока(Стек) Тогда
		Дополнительно = ?(ПустаяСтрока(Дополнительно), Стек, Дополнительно + "; " + Стек);
	КонецЕсли;
	ЗаписатьОшибку(Контекст, Текст, Дополнительно, "Ошибка", Сценарий, Стенд);

КонецПроцедуры

// Количество записей журнала.
Функция КоличествоЗаписей() Экспорт

	Попытка
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрСведений.ПерфОшибки");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.К;

	Исключение
		ЗаписатьВФайл("КоличествоЗаписей", "не удалось посчитать записи журнала", "", ИнформацияОбОшибке().Описание);
		Возврат 0;
	КонецПопытки;

КонецФункции

// Держит журнал в границах лимита: удаляет самые старые записи.
// Вызывается на старте прогона и при открытии панели, а не на каждой ошибке.
//
// Параметры:
//   Лимит - Число - сколько записей оставлять (по умолчанию 5000).
//
// Возвращает:
//   Число - сколько записей удалено.
Функция ОграничитьЖурнал(Лимит = 5000) Экспорт

	Попытка
	Лишних = КоличествоЗаписей() - Лимит;
	Если Лишних <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лишних, "ЧГ=0") + "
		|	Т.ДатаВремя КАК ДатаВремя,
		|	Т.УИД КАК УИД
		|ИЗ
		|	РегистрСведений.ПерфОшибки КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаВремя,
		|	Т.УИД");
	Выборка = Запрос.Выполнить().Выбрать();
	Удалено = 0;
	Пока Выборка.Следующий() Цикл
		Попытка
			Набор = РегистрыСведений.ПерфОшибки.СоздатьНаборЗаписей();
			Набор.Отбор.ДатаВремя.Установить(Выборка.ДатаВремя);
			Набор.Отбор.УИД.Установить(Выборка.УИД);
			// Пустой набор с отбором по ключу удаляет одну запись.
			Набор.Записать();
			Удалено = Удалено + 1;
		Исключение
			// Молчание здесь осознанно: процедура вызывается на старте, а не в замере.
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Удалено;

	Исключение
		ЗаписатьВФайл("ОграничитьЖурнал", "не удалось ограничить журнал", "", ИнформацияОбОшибке().Описание);
		Возврат 0;
	КонецПопытки;

КонецФункции

// Полная очистка журнала. Только для отладки и самотеста.
Процедура Очистить() Экспорт

	Попытка
	Набор = РегистрыСведений.ПерфОшибки.СоздатьНаборЗаписей();
	Набор.Записать();

	Исключение
		ЗаписатьВФайл("Очистить", "не удалось очистить журнал", "", ИнформацияОбОшибке().Описание);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Резервный канал: если регистр недоступен (нет прав, база только для чтения),
// текст ошибки дописывается в файл, чтобы не потеряться совсем.
Процедура ЗаписатьВФайл(Контекст, Сообщение, Дополнительно, ПричинаЗаписи)

	Попытка
		ИмяФайла = КаталогВременныхФайлов() + "perftest_errors.log"; // BSLLS:UsingHardcodePath-off
		Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку(Формат(ТекущаяДатаСеанса(), "ДФ=ггггММддЧЧммсс") + " [" + Контекст + "] "
			+ Сообщение + ?(ПустаяСтрока(Дополнительно), "", " | " + Дополнительно)
			+ " | регистр недоступен: " + ПричинаЗаписи);
		Запись.Закрыть();
	Исключение
		// Даже файл не записался: молчать, чтобы не сломать вызвавший код.
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
