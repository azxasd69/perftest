// Клиентская часть паспорта стенда.
//
// Собирает строку «Ключ=Значение;...» о рабочем месте и режиме запуска. Модуль
// клиентский (управляемое и обычное приложение), серверных вызовов не делает:
// его вызывают форма НачальнаяСтраница и модуль приложения.
//
// СПодробностями = Ложь - без COM/WMI: быстрая часть для старта приложения.
// Любая недоступность источника - это отсутствие ключа, а не исключение.

// Строка о клиенте: ОС, ЦПУ, память, платформа, режим клиента и запуска, браузер,
// имя компьютера; при СПодробностями = Истина добавляются данные WMI (толстый клиент).
Функция СтрокаКлиента(СПодробностями = Истина) Экспорт

	Части = Новый Массив;

	Попытка
		СИ = Новый СистемнаяИнформация;
		Части.Добавить("ОС=" + СокрЛП(СИ.ВерсияОС));
		Части.Добавить("ЦПУ=" + СокрЛП(СИ.Процессор));
		Части.Добавить("ПамятьМб=" + Формат(Окр(СИ.ОперативнаяПамять / 1048576, 0), "ЧГ=0"));
		Части.Добавить("Платформа=" + Строка(СИ.ТипПлатформы));
		Попытка
			Части.Добавить("КлиентИдентификатор=" + СокрЛП(СИ.ИдентификаторКлиента));
		Исключение
			ИгнорируемаяОшибка = ИнформацияОбОшибке();
		КонецПопытки;
		Попытка
			Браузер = СокрЛП(СИ.ИнформацияПрограммыПросмотра);
			Если НЕ ПустаяСтрока(Браузер) Тогда
				Части.Добавить("Браузер=" + Лев(Браузер, 280));
			КонецЕсли;
		Исключение
			ИгнорируемаяОшибка = ИнформацияОбОшибке();
		КонецПопытки;
	Исключение
		Части.Добавить("СИНедоступен=1");
	КонецПопытки;

	Попытка
		Части.Добавить("РежимКлиента=" + РежимКлиентаСтрокой());
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	Попытка
		Части.Добавить("РежимЗапуска=" + СокрЛП(Строка(ТекущийРежимЗапуска())));
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	Попытка
		Части.Добавить("Компьютер=" + СокрЛП(ИмяКомпьютера()));
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	Если СПодробностями Тогда
		Части = ДобавитьWMI(Части);
	КонецЕсли;

	Возврат СтрСоединить(Части, ";");

КонецФункции

// Режим клиента определяется препроцессором: это единственный способ, который
// не зависит от доступности COM и работает во всех клиентах, включая веб.
Функция РежимКлиентаСтрокой() Экспорт

	#Если ВебКлиент Тогда
		Возврат "веб-клиент";
	#ИначеЕсли ТонкийКлиент Тогда
		Возврат "тонкий клиент";
	#ИначеЕсли ТолстыйКлиентУправляемоеПриложение Тогда
		Возврат "толстый клиент (управляемое)";
	#ИначеЕсли ТолстыйКлиентОбычноеПриложение Тогда
		Возврат "толстый клиент (обычное)";
	#Иначе
		Возврат "клиент";
	#КонецЕсли

КонецФункции

// WMI рабочего места: только толстый клиент (в тонком и веб COM недоступен),
// и только под Попыткой - сбой WMI не должен ломать паспорт.
Функция ДобавитьWMI(Части)

	#Если ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Попытка
			// BSLLS:UsingObjectNotAvailableUnix-off (COM есть только в толстом клиенте Windows)
			Локатор = Новый COMОбъект("WbemScripting.SWbemLocator");
			Сервис = Локатор.ConnectServer(".", "root\cimv2");
			ОС = WMIПервый(Сервис, "SELECT Caption, Version, BuildNumber, FreePhysicalMemory, LastBootUpTime FROM Win32_OperatingSystem");
			ЦПУ = WMIПервый(Сервис, "SELECT Name, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed, LoadPercentage FROM Win32_Processor");
			ПК = WMIПервый(Сервис, "SELECT Name, Manufacturer, Model, TotalPhysicalMemory FROM Win32_ComputerSystem");
			Если ОС <> Неопределено Тогда
				Части.Добавить("ОС=" + СокрЛП(ОС.Caption) + " v" + СокрЛП(ОС.Version) + " build " + СокрЛП(ОС.BuildNumber));
				Части.Добавить("СвободнаМб=" + Формат(Окр(ОС.FreePhysicalMemory / 1024, 0), "ЧГ=0"));
				Части.Добавить("Аптайм=" + АптаймСтрокой(ОС.LastBootUpTime));
			КонецЕсли;
			Если ЦПУ <> Неопределено Тогда
				Части.Добавить("ЦПУ=" + СокрЛП(ЦПУ.Name));
				Части.Добавить("ЦПУПотоки=" + ЦПУ.NumberOfCores + " ядер / " + ЦПУ.NumberOfLogicalProcessors + " потоков");
				Части.Добавить("ЦПУМГц=" + Формат(ЦПУ.MaxClockSpeed, "ЧГ=0"));
				Части.Добавить("ЦПУЗагрузкаПроц=" + Формат(ЦПУ.LoadPercentage, "ЧГ=0"));
			КонецЕсли;
			Если ПК <> Неопределено Тогда
				ПКМодель = СокрЛП(ПК.Manufacturer) + ?(ПустаяСтрока(СокрЛП(ПК.Model)), "", " " + СокрЛП(ПК.Model));
				Части.Добавить("ПК=" + СокрЛП(ПК.Name) + ?(ПустаяСтрока(ПКМодель), "", " (" + ПКМодель + ")"));
				Части.Добавить("ПамятьМб=" + Формат(Окр(ПК.TotalPhysicalMemory / 1048576, 0), "ЧГ=0"));
			КонецЕсли;
		Исключение
			Части.Добавить("WМИКлиентНедоступен=1");
		КонецПопытки;
	#КонецЕсли

	Возврат Части;

КонецФункции

// Первая запись WMI-запроса; недоступность запроса - Неопределено.
Функция WMIПервый(Сервис, ЗапросWMI)

	Попытка
		Выборка = Сервис.ExecQuery(ЗапросWMI);
		Для Каждого Элемент Из Выборка Цикл
			Возврат Элемент;
		КонецЦикла;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

// Аптайм из WMI-даты вида 20261105093000.000000+180.
Функция АптаймСтрокой(WMIDate)

	Попытка
		С = Лев(СокрЛП(WMIDate), 14);
		Если СтрДлина(С) < 14 Тогда
			Возврат "";
		КонецЕсли;
		ДатаЗагрузки = Дата(Число(Лев(С, 4)), Число(Сред(С, 5, 2)), Число(Сред(С, 7, 2)),
			Число(Сред(С, 9, 2)), Число(Сред(С, 11, 2)), Число(Сред(С, 13, 2)));
		ВсегоСек = ТекущаяДата() - ДатаЗагрузки; // BSLLS:DeprecatedCurrentDate-off (в клиенте нет ТекущаяДатаСеанса)
		Возврат Цел(ВсегоСек / 86400) + " дн "
			+ Цел((ВсегоСек % 86400) / 3600) + " ч "
			+ Цел((ВсегоСек % 3600) / 60) + " мин";
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции
