// ПерфПаспортКлиент - клиентская часть паспорта стенда.
//
// Всё, что видно только с клиентской машины (версия и тип клиентской платформы,
// режим клиента, браузер, железо рабочего места), собирается здесь и передаётся
// на сервер одной строкой «Ключ=Значение;...». Формат строки намеренно простой:
// он переживает передачу через параметры фонового задания и вызовы сервера.
//
// Правила те же, что в серверной части: каждый блок в своей Попытке, недоступное
// (COM в тонком/веб-клиенте, WMI на Linux) просто не попадает в строку.

#Область ПрограммныйИнтерфейс

// Сведения о клиенте строкой. Ошибки не пробрасываются: при сбое возвращается
// то, что удалось собрать (возможно, пустая строка).
Функция СтрокаКлиента() Экспорт

	Части = Новый Массив;
	Попытка
		Добавить(Части, "РежимКлиента", РежимКлиентаСтрокой());
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	Попытка
		Добавить(Части, "РежимЗапуска", Строка(ТекущийРежимЗапуска()));
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	Попытка
		СИ = Новый СистемнаяИнформация;   // это тип с конструктором, а не глобальное свойство
		Добавить(Части, "ВерсияПриложения", СокрЛП(СИ.ВерсияПриложения));
		Добавить(Части, "ТипПлатформы", СокрЛП(Строка(СИ.ТипПлатформы)));
		Добавить(Части, "ИдентификаторКлиента", СокрЛП(СИ.ИдентификаторКлиента));
		Добавить(Части, "ОС", СокрЛП(СИ.ВерсияОС));
		Добавить(Части, "ЦПУ", СокрЛП(СИ.Процессор));
		Добавить(Части, "ПамятьМб", Формат(Окр(СИ.ОперативнаяПамять / 1048576, 0), "ЧГ=0"));
		Добавить(Части, "Платформа", СокрЛП(Строка(СИ.ТипПлатформы)));
		// В веб-клиенте это User-Agent браузера; в остальных режимах пусто.
		Добавить(Части, "Браузер", СокрЛП(СИ.ИнформацияПрограммыПросмотра));
	Исключение
		Добавить(Части, "СИНедоступен", "1");
	КонецПопытки;

	Попытка
		Добавить(Части, "ИмяКомпьютера", СокрЛП(ИмяКомпьютера()));
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	СобратьПоляWMI(Части);

	Возврат СтрСоединить(Части, ";");

КонецФункции

// Строка режима клиента: определяется препроцессором, поэтому верна и там,
// где ТекущийРежимЗапуска() возвращает Неопределено (внешнее соединение, сервер).
Функция РежимКлиентаСтрокой() Экспорт

#Если ВебКлиент Тогда
	Возврат "веб-клиент";
#ИначеЕсли ТонкийКлиент Тогда
	Возврат "тонкий клиент";
#ИначеЕсли ТолстыйКлиентУправляемоеПриложение Тогда
	Возврат "толстый клиент (управляемое приложение)";
#ИначеЕсли ТолстыйКлиентОбычноеПриложение Тогда
	Возврат "толстый клиент (обычное приложение)";
#ИначеЕсли ВнешнееСоединение Тогда
	Возврат "внешнее соединение";
#Иначе
	Возврат "неизвестно";
#КонецЕсли

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавление пары «ключ=значение»; пустые значения пропускаются, чтобы строка
// не разрасталась, а отсутствие данных оставалось явным.
Процедура Добавить(Части, Ключ, Значение)
	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	Части.Добавить(Ключ + "=" + СтрЗаменить(СтрЗаменить(Текст, ";", ","), Символы.ПС, " "));
КонецПроцедуры

// Железо рабочего места. COM доступен только в толстом клиенте: в тонком и
// веб-клиенте блок просто не выполняется (данные останутся пустыми).
Процедура СобратьПоляWMI(Части)

#Если ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
	Попытка
		Локатор = Новый COMОбъект("WbemScripting.SWbemLocator"); // BSLLS:UsingObjectNotAvailableUnix-off (конфигурация только Windows)
		Сервис = Локатор.ConnectServer(".", "root\cimv2");
	Исключение
		Добавить(Части, "WMIКлиент", "недоступен");
		Возврат;
	КонецПопытки;

	Попытка
		ОС = ПервыйWMI(Сервис, "SELECT Caption, Version, BuildNumber, FreePhysicalMemory, LastBootUpTime FROM Win32_OperatingSystem");
		Если ОС <> Неопределено Тогда
			Добавить(Части, "ОС", СокрЛП(ОС.Caption) + " v" + СокрЛП(ОС.Version) + " build " + СокрЛП(ОС.BuildNumber));
			Добавить(Части, "СвободнаМб", Формат(Окр(Число(ОС.FreePhysicalMemory) / 1024, 0), "ЧГ=0"));
			Добавить(Части, "Аптайм", АптаймСтрокой(ОС.LastBootUpTime));
		КонецЕсли;
	Исключение
		Добавить(Части, "WMIОС", "ошибка");
	КонецПопытки;

	Попытка
		ЦПУ = ПервыйWMI(Сервис, "SELECT Name, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed, LoadPercentage FROM Win32_Processor");
		Если ЦПУ <> Неопределено Тогда
			Добавить(Части, "ЦПУ", СокрЛП(ЦПУ.Name));
			Добавить(Части, "ЦПУПотоки", Строка(ЦПУ.NumberOfCores) + " ядер / " + Строка(ЦПУ.NumberOfLogicalProcessors) + " потоков");
			Добавить(Части, "ЦПУМГц", Формат(ЦПУ.MaxClockSpeed, "ЧГ=0"));
			Добавить(Части, "ЦПУЗагрузкаПроц", Формат(ЦПУ.LoadPercentage, "ЧГ=0"));
		КонецЕсли;
	Исключение
		Добавить(Части, "WMIЦПУ", "ошибка");
	КонецПопытки;

	Попытка
		ПК = ПервыйWMI(Сервис, "SELECT Name, Manufacturer, Model, TotalPhysicalMemory FROM Win32_ComputerSystem");
		Если ПК <> Неопределено Тогда
			Модель = СокрЛП(ПК.Manufacturer) + ?(ПустаяСтрока(СокрЛП(ПК.Model)), "", " " + СокрЛП(ПК.Model));
			Добавить(Части, "ПК", СокрЛП(ПК.Name) + ?(ПустаяСтрока(Модель), "", " (" + Модель + ")"));
			Добавить(Части, "ПамятьМб", Формат(Окр(Число(ПК.TotalPhysicalMemory) / 1048576, 0), "ЧГ=0"));
		КонецЕсли;
	Исключение
		Добавить(Части, "WMIПК", "ошибка");
	КонецПопытки;
#endif

КонецПроцедуры

// Первый объект WMI-выборки или Неопределено.
Функция ПервыйWMI(Сервис, ЗапросWMI)
	Попытка
		Выборка = Сервис.ExecQuery(ЗапросWMI);
		Для Каждого Элемент Из Выборка Цикл
			Возврат Элемент;
		КонецЦикла;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// Аптайм из WMI-даты загрузки. ТекущаяДата() намеренно: ТекущаяДатаСеанса()
// в клиентском контексте недоступна.
Функция АптаймСтрокой(WMIDate)
	Попытка
		С = Лев(СокрЛП(WMIDate), 14);
		Если СтрДлина(С) < 14 Тогда
			Возврат "";
		КонецЕсли;
		ДатаЗагрузки = Дата(Число(Лев(С, 4)), Число(Сред(С, 5, 2)), Число(Сред(С, 7, 2)),
			Число(Сред(С, 9, 2)), Число(Сред(С, 11, 2)), Число(Сред(С, 13, 2)));
		ВсегоСек = ТекущаяДата() - ДатаЗагрузки; // BSLLS:DeprecatedCurrentDate-off (ТекущаяДатаСеанса недоступна в клиенте)
		Возврат Цел(ВсегоСек / 86400) + " дн "
			+ Цел((ВсегоСек % 86400) / 3600) + " ч "
			+ Цел((ВсегоСек % 3600) / 60) + " мин";
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

#КонецОбласти
