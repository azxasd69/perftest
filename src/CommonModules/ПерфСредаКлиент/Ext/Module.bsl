// Среда исполнения: клиентская часть.
//
// Определяет то, что видно только из клиентского процесса: режим клиента
// (толстый, тонкий, веб) и вариант запуска (интерактив, автопрогон, служебный
// режим). Серверных объектов не использует, поэтому вызывается из модуля
// приложения и из форм до любых серверных вызовов.

#Область ПрограммныйИнтерфейс

// Параметры клиента для ПерфСреда.Определить().
// ПараметрЗапуска - строка /C (в интерактиве пустая).
Функция Параметры(ПараметрЗапуска = "") Экспорт

	Результат = Новый Структура("РежимКлиента, ТипПлатформы, ВариантЗапуска, ПробаДоступна",
		"Неизвестно", "", "Интерактив", Ложь);

	Тип = "";
	Попытка
		// Тип платформы есть и в толстом, и в тонком, и в веб-клиенте.
		СИ = Новый СистемнаяИнформация;
		Тип = СокрЛП(Строка(СИ.ТипПлатформы));
	Исключение
		Тип = "";
	КонецПопытки;
	Результат.ТипПлатформы = Тип;

	Верх = ВРег(Тип);
	Если СтрНайти(Верх, "ВЕБ") > 0 ИЛИ СтрНайти(Верх, "WEB") > 0 Тогда
		Результат.РежимКлиента = "Веб";
	ИначеЕсли СтрНайти(Верх, "ТОНК") > 0 ИЛИ СтрНайти(Верх, "THIN") > 0 Тогда
		Результат.РежимКлиента = "Тонкий";
	ИначеЕсли НЕ ПустаяСтрока(Тип) Тогда
		Результат.РежимКлиента = "Толстый";
	КонецЕсли;

	// Клиентская проба каналов делает HTTP-запросы: в веб-клиенте их нет.
	Результат.ПробаДоступна = (Результат.РежимКлиента = "Толстый"
		ИЛИ Результат.РежимКлиента = "Тонкий");

	Результат.ВариантЗапуска = ВариантЗапускаПоСтроке(ПараметрЗапуска);
	Возврат Результат;

КонецФункции

// Доступна ли проба каналов из этого клиента (в веб-клиенте - нет).
Функция ПробаДоступна(ПараметрЗапуска = "") Экспорт

	Возврат Параметры(ПараметрЗапуска).ПробаДоступна;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВариантЗапускаПоСтроке(ПараметрЗапуска)

	СтрокаЗапуска = НРег(СокрЛП(ПараметрЗапуска));
	Если ПустаяСтрока(СтрокаЗапуска) Тогда
		Возврат "Интерактив";
	ИначеЕсли СтрНайти(СтрокаЗапуска, "перфавтопрогон") > 0 Тогда
		Возврат "Автопрогон";
	КонецЕсли;
	// Остальные параметры /C - служебные режимы (смоук, самотест, проба, спул).
	Возврат "Служебный режим";

КонецФункции

#КонецОбласти
