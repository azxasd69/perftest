// ПерфПаспорт - расширенный паспорт стенда: максимум сведений о среде замера.
//
// Задача паспорта - объяснить, ПОЧЕМУ стенд получил такой результат: железо, ОС,
// режим клиента, СУБД, размер данных. Поэтому паспорт собирается «с запасом»:
// каждый блок данных добывается отдельно и под собственной Попыткой. Если на
// конкретном стенде чего-то нет (Linux без WMI, веб-клиент без COM, MSSQL без
// доступа к структуре хранения) - соответствующее поле остается пустым, а причина
// попадает в ЗамечанияСбора. Ошибка сбора не должна ломать ни паспорт, ни замер.
//
// Источники данных:
//   * платформа (кроссплатформенно): СистемнаяИнформация, ЧасовойПоясСеанса,
//     КаталогПрограммы, КаталогВременныхФайлов, СтрокаСоединенияИнформационнойБазы,
//     ПолучитьРазмерДанныхБазыДанных;
//   * Windows-сервер: WMI через COM (Win32_*) - только там, где COM доступен;
//   * Linux-сервер: виртуальные файлы /proc и /sys (WMI и COM там нет);
//   * клиент: ВЕРСИЯ и тип платформы, режим клиента, браузер (User-Agent),
//     WMI в толстом клиенте. Передается строкой «Ключ=Значение;...».
//
// Модуль вызывается из ПерфПаспортКлиент (клиентская часть), модуля приложения
// (фоновый сбор при старте) и форм (барьер перед запуском теста).

#Область ПрограммныйИнтерфейс

// Версия состава паспорта: увеличивается, когда меняется набор полей.
Функция ВерсияСхемыПаспорта() Экспорт
	Возврат 3;
КонецФункции

// Среда исполнения: от нее зависит, какие запросы вообще применимы.
// Только безопасные вызовы: без COM и без обхода файловых систем (кроме проверки
// /proc, которая выполняется лишь когда платформа сообщила Linux).
// Возвращает структуру: СемействоОС, ЭтоЛинукс, ЭтоВиндовс, ЕстьProc, ВариантИБ,
// ВерсияПлатформы.
Функция ОпределитьСреду() Экспорт

	Среда = Новый Структура;
	Среда.Вставить("СемействоОС", "Неизвестно");
	Среда.Вставить("ЭтоЛинукс", Ложь);
	Среда.Вставить("ЭтоВиндовс", Ложь);
	Среда.Вставить("ЕстьProc", Ложь);
	Среда.Вставить("ВариантИБ", "Неизвестно");
	Среда.Вставить("ВерсияПлатформы", "");

	Попытка
		СИ = Новый СистемнаяИнформация;
		Тип = ВРег(Строка(СИ.ТипПлатформы));
		Среда.ВерсияПлатформы = СокрЛП(СИ.ВерсияПриложения);
		Если СтрНайти(Тип, "LINUX") > 0 Тогда
			Среда.СемействоОС = "Linux";
			Среда.ЭтоЛинукс = Истина;
		ИначеЕсли СтрНайти(Тип, "WINDOWS") > 0 Тогда
			Среда.СемействоОС = "Windows";
			Среда.ЭтоВиндовс = Истина;
		КонецЕсли;
	Исключение
		// Тип платформы не определился: ниже сработают предусловия блоков и их Попытки.
		Среда.СемействоОС = "Неизвестно";
	КонецПопытки;

	Попытка
		Среда.ВариантИБ = ПерфСценарии.ВариантРазвёртывания();
	Исключение
		Среда.ВариантИБ = "Неизвестно";
	КонецПопытки;

	// /proc существует только в Linux: на Windows этот блок не выполняется вовсе.
	Если Среда.ЭтоЛинукс Тогда
		Попытка
			// BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
			Среда.ЕстьProc = Не ПустаяСтрока(ПрочитатьТекстФайла("/proc/cpuinfo"));
		Исключение
			Среда.ЕстьProc = Ложь;
		КонецПопытки;
	КонецЕсли;

	Возврат Среда;

КонецФункции

// План сбора: порядок блоков и признак применимости на этой среде.
// Блок, помеченный «неприменим», не вызывается вообще - именно это защищает
// от запросов WMI на Linux, чтения /proc на Windows и обращений к клиенту,
// которого в данном запуске нет. Причина пропуска попадает в ЗамечанияСбора.
Функция ПланСбора(Среда, ЕстьКлиентскаяСтрока = Ложь) Экспорт

	План = Новый ТаблицаЗначений;
	План.Колонки.Добавить("Блок");
	План.Колонки.Добавить("Применим", Новый ОписаниеТипов("Булево"));
	План.Колонки.Добавить("Причина");

	// Порядок важен: сначала дешевое и всегда доступное, затем тяжелые источники.
	ДобавитьБлокПлана(План, "Платформа", Истина, "");
	ДобавитьБлокПлана(План, "ИБ", Истина, "");

	ДобавитьБлокПлана(План, "СерверWin", Среда.ЭтоВиндовс,
		?(Среда.ЭтоВиндовс, "", "не Windows: WMI и COM недоступны"));

	Если Среда.ЭтоЛинукс И НЕ Среда.ЕстьProc Тогда
		ДобавитьБлокПлана(План, "СерверLinux", Ложь, "/proc недоступен (контейнер или ограничения)");
	Иначе
		ДобавитьБлокПлана(План, "СерверLinux", Среда.ЭтоЛинукс,
			?(Среда.ЭтоЛинукс, "", "не Linux: /proc и /sys отсутствуют"));
	КонецЕсли;

	ДобавитьБлокПлана(План, "Клиент", ЕстьКлиентскаяСтрока,
		?(ЕстьКлиентскаяСтрока, "", "клиентские данные не переданы"));

	Возврат План;

КонецФункции

// Служебная: строка плана сбора.
Процедура ДобавитьБлокПлана(План, Имя, Применим, Причина)

	Строка = План.Добавить();
	Строка.Блок = Имя;
	Строка.Применим = Применим;
	Строка.Причина = Причина;

КонецПроцедуры

// Уточнения и дополнительные поля паспорта, собранные на сервере и из строки клиента.
// Возвращает структуру: часть ключей совпадает с реквизитами регистра ПерфСтенды
// (они применяются как уточнения к базовым полям), часть - новые реквизиты схемы 3.
// Пустое значение означает «на этом стенде получить не удалось» - поле не заполняется.
//
// Состав: "Быстрый" - только платформа, имя ИБ и клиентская строка (WMI и /proc не
// вызываются); "Полный" - все применимые блоки. Двухфазность нужна, чтобы паспорт
// появлялся сразу при старте, а тяжелый сбор шел следом и не блокировал интерфейс.
Функция ДопПоля(КлиентСтрока = "", Состав = "Полный") Экспорт

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Поля = Новый Структура;
	Замечания = Новый Массив;

	Поля.Вставить("СхемаПаспорта", ВерсияСхемыПаспорта());
	Поля.Вставить("ЗамечанияСбора", "");
	Поля.Вставить("ВремяСбораМс", 0);
	Поля.Вставить("БлоковНеСобрано", 0);

	// Новые реквизиты паспорта: пустые значения по умолчанию, дальше заполняются по возможности.
	Для Каждого Имя Из НовыеИменаПолей() Цикл
		Поля.Вставить(Имя, "");
	КонецЦикла;
	Для Каждого Имя Из НовыеЧисловыеПоля() Цикл
		Поля.Вставить(Имя, 0);
	КонецЦикла;

	// Уточнения базовых полей: заполняются, только если базовый сбор их не дал
	// (например, на Linux нет WMI, но /proc дает ядра, частоту и память).
	Для Каждого Имя Из ПоляУточнений() Цикл
		Поля.Вставить(Имя, "");
	КонецЦикла;
	Поля.Вставить("СерверЯдерУточнение", 0);
	Поля.Вставить("СерверПотоковУточнение", 0);
	Поля.Вставить("СерверЦПУМГцУточнение", 0);
	Поля.Вставить("СерверПамятьМбУточнение", 0);
	Поля.Вставить("СерверСвободнаПамятьМбУточнение", 0);
	Поля.Вставить("СерверЗагрузкаЦПУПроцУточнение", 0);
	Поля.Вставить("ОбъёмИБМбУточнение", 0);

	Быстрый = (Состав = "Быстрый");
	Среда = ОпределитьСреду();
	План = ПланСбора(Среда, НЕ ПустаяСтрока(КлиентСтрока));
	НеСобрано = 0;

	// Строгий порядок из плана: блоки выполняются по одному, каждый - в своей Попытке.
	Для Каждого Шаг Из План Цикл
		Если НЕ Шаг.Применим Тогда
			Замечание(Замечания, "пропуск " + Шаг.Блок + ": " + Шаг.Причина);
			НеСобрано = НеСобрано + 1;
			Продолжить;
		КонецЕсли;
		Попытка
			Если Шаг.Блок = "Платформа" Тогда
				СобратьПоляПлатформы(Поля, Замечания);
			ИначеЕсли Шаг.Блок = "ИБ" Тогда
				СобратьПоляИБ(Поля, Замечания, НЕ Быстрый);
			ИначеЕсли Шаг.Блок = "СерверWin" Тогда
				Если Быстрый Тогда
					Замечание(Замечания, "WMI сервера: отложен до полной фазы");
					НеСобрано = НеСобрано + 1;
				Иначе
					СобратьПоляWindows(Поля, Замечания);
				КонецЕсли;
			ИначеЕсли Шаг.Блок = "СерверLinux" Тогда
				Если Быстрый Тогда
					Замечание(Замечания, "/proc: отложен до полной фазы");
					НеСобрано = НеСобрано + 1;
				Иначе
					СобратьПоляLinux(Поля, Замечания);
				КонецЕсли;
			ИначеЕсли Шаг.Блок = "Клиент" Тогда
				СобратьПоляКлиента(Поля, КлиентСтрока, Замечания);
			КонецЕсли;
		Исключение
			Замечание(Замечания, Шаг.Блок + ": " + Лев(ИнформацияОбОшибке().Описание, 80));
			НеСобрано = НеСобрано + 1;
		КонецПопытки;
	КонецЦикла;

	Поля.БлоковНеСобрано = НеСобрано;
	Попытка
		Поля.ВремяСбораМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Исключение
		Поля.ВремяСбораМс = 0;
	КонецПопытки;

	Попытка
		Поля.ЗамечанияСбора = Лев(СтрСоединить(Замечания, "; "), 500);
	Исключение
		Поля.ЗамечанияСбора = "замечания не собраны";
	КонецПопытки;

	Возврат Поля;

КонецФункции

// Записывает паспорт стенда. Перезаписать = Истина - собрать заново даже при
// наличии актуального паспорта (барьер перед тестом). Состав = "Быстрый" -
// фаза 1 без WMI и /proc; "Полный" - все применимые блоки.
// Возвращает Истина, если паспорт записан (или уже был актуален).
Функция Записать(Стенд, КлиентСтрока = "", Перезаписать = Ложь, Состав = "Полный") Экспорт

	Попытка
		ПерфСценарии.ЗаписатьПаспортСтенда(Стенд, КлиентСтрока, Перезаписать, Состав);
		Возврат ЕстьПаспорт(Стенд);
	Исключение
		// Паспорт - вспомогательная сущность: его сбой не должен останавливать замер.
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Барьер «паспорт готов до замера»: дождаться фонового сбора (если он идет),
// затем при необходимости собрать паспорт синхронно.
// Возвращает Истина, если паспорт есть в регистре.
Функция Обеспечить(Стенд, КлиентСтрока = "", ЖдатьСекунд = 20) Экспорт

	Попытка
		Если ЕстьПаспорт(Стенд) Тогда
			Возврат Истина;
		КонецЕсли;
		ДождатьсяФона(ЖдатьСекунд);
		Если ЕстьПаспорт(Стенд) Тогда
			Возврат Истина;
		КонецЕсли;
		// Синхронно собирается только быстрая фаза (без COM): тяжелый сбор -
		// в фоновом задании, иначе нажатие кнопки ждало бы WMI.
		Записать(Стенд, КлиентСтрока, Истина, "Быстрый");
		Возврат ЕстьПаспорт(Стенд);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Паспорт стенда есть и описывает текущую версию конфигурации.
Функция ЕстьПаспорт(Стенд) Экспорт

	Попытка
		СтендКлюч = ПерфСценарии.ИмяСтендаДляЗаписи(Стенд);
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Отпечаток КАК Отпечаток,
			|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации,
			|	Т.СхемаПаспорта КАК СхемаПаспорта
			|ИЗ
			|	РегистрСведений.ПерфСтенды КАК Т
			|ГДЕ
			|	Т.Стенд = &Стенд");
		Запрос.УстановитьПараметр("Стенд", СтендКлюч);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат ЗначениеЗаполнено(Выборка.Отпечаток)
				И СокрЛП(Выборка.ВерсияКонфигурации) = СокрЛП(Метаданные.Версия)
				И Выборка.СхемаПаспорта >= ВерсияСхемыПаспорта();
		КонецЕсли;
		Возврат Ложь;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Запускает фоновый сбор паспорта при старте приложения: пользователь не ждет.
Функция ЗапуститьСборФон(КлиентСтрока = "") Экспорт

	Попытка
		Если ЕстьПаспорт("") Тогда
			Возврат "";
		КонецЕсли;
		Параметры = Новый Массив;
		Параметры.Добавить("");           // стенд: пусто = вычислить из профиля
		Параметры.Добавить(КлиентСтрока);
		Задание = ФоновыеЗадания.Выполнить("ПерфПаспорт.СобратьФон", Параметры, КлючЗаданияПаспорта());
		Возврат Строка(Задание.УникальныйИдентификатор);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Точка входа фонового задания: двухфазный сбор.
// Фаза 1 (без COM) нужна, чтобы паспорт существовал как можно раньше;
// фаза 2 добавляет WMI или /proc, размер данных и структуру хранения.
Процедура СобратьФон(Стенд, КлиентСтрока) Экспорт

	Попытка
		Записать(Стенд, КлиентСтрока, Истина, "Быстрый");
	Исключение
		// Фаза 1 не должна завершать задание аварийно: фаза 2 все равно попробует.
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	Попытка
		Записать(Стенд, КлиентСтрока, Истина, "Полный");
	Исключение
		// Фоновое задание не должно завершаться аварийно: паспорт остается с фазой 1.
		Описание = ИнформацияОбОшибке().Описание;
	КонецПопытки;

КонецПроцедуры

// Строка паспорта для маркеров и диагностики: «Схема=3; РежимКлиента=...; ...».
Функция ПаспортСтрокой(Стенд) Экспорт

	Попытка
		СтендКлюч = ПерфСценарии.ИмяСтендаДляЗаписи(Стенд);
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Стенд КАК Стенд, Т.СхемаПаспорта КАК СхемаПаспорта, Т.РежимКлиента КАК РежимКлиента,
			|	Т.РежимЗапуска КАК РежимЗапуска, Т.ТипПлатформыКлиент КАК ТипПлатформыКлиент,
			|	Т.ВерсияПлатформыКлиент КАК ВерсияПлатформыКлиент, Т.КлиентБраузер КАК КлиентБраузер,
			|	Т.КлиентИмяКомпьютера КАК КлиентИмяКомпьютера, Т.СерверЧасовойПояс КАК СерверЧасовойПояс,
			|	Т.ЧасовойПоясИБ КАК ЧасовойПоясИБ, Т.СерверПроизводитель КАК СерверПроизводитель,
			|	Т.СерверМодель КАК СерверМодель, Т.СерверBIOS КАК СерверBIOS,
			|	Т.СерверВиртуализация КАК СерверВиртуализация,
			|	Т.СерверОЗУПроизводитель КАК СерверОЗУПроизводитель,
			|	Т.СерверОЗУЧастотаМГц КАК СерверОЗУЧастотаМГц, Т.СерверОЗУСлотов КАК СерверОЗУСлотов,
			|	Т.СерверСетьАдаптер КАК СерверСетьАдаптер, Т.СерверСетьСкоростьМбит КАК СерверСетьСкоростьМбит,
			|	Т.СерверДиски КАК СерверДиски, Т.СерверСвободноНаДискеГБ КАК СерверСвободноНаДискеГБ,
			|	Т.ИмяИБ КАК ИмяИБ, Т.РазмерДанныхБайт КАК РазмерДанныхБайт,
			|	Т.ЗамечанияСбора КАК ЗамечанияСбора, Т.СУБД КАК СУБД, Т.ВерсияСУБД КАК ВерсияСУБД
			|ИЗ
			|	РегистрСведений.ПерфСтенды КАК Т
			|ГДЕ
			|	Т.Стенд = &Стенд");
		Запрос.УстановитьПараметр("Стенд", СтендКлюч);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Возврат "паспорт не записан";
		КонецЕсли;
		Части = Новый Массив;
		Для Каждого Колонка Из Результат.Колонки Цикл
			Части.Добавить(Колонка.Имя + "=" + СокрЛП(Строка(Выборка[Колонка.Имя])));
		КонецЦикла;
		Возврат СтрСоединить(Части, "; ");
	Исключение
		Возврат "паспорт недоступен: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ключ фонового задания паспорта: по нему ищется активный сбор.
Функция КлючЗаданияПаспорта()
	Возврат "ПерфПаспорт";
КонецФункции

// Ожидание активного фонового сбора паспорта (если он еще выполняется).
Процедура ДождатьсяФона(ЖдатьСекунд)

	Попытка
		Отбор = Новый Структура("Ключ", КлючЗаданияПаспорта());
		Задания = ФоновыеЗадания.ПолучитьЗадания(Отбор);
		Для Каждого Задание Из Задания Цикл
			Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				Задание.ОжидатьЗавершенияВыполнения(ЖдатьСекунд);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Ожидание - оптимизация: не получилось, паспорт соберется синхронно.
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

КонецПроцедуры

// Имена новых строковых полей паспорта (схема 3).
Функция НовыеИменаПолей()
	Возврат СтрРазделить("РежимКлиента,РежимЗапуска,ТипПлатформыКлиент,ВерсияПлатформыКлиент,"
		+ "КлиентБраузер,КлиентИдентификатор,КлиентИмяКомпьютера,СерверЧасовойПояс,ЧасовойПоясИБ,"
		+ "СерверКаталогПрограммы,СерверКаталогВременныхФайлов,СерверВиртуализация,СерверПроизводитель,"
		+ "СерверМодель,СерверBIOS,СерверОЗУПроизводитель,СерверСетьАдаптер,СерверДиски,"
		+ "ИмяИБ", ",", Ложь);
КонецФункции

// Имена новых числовых полей паспорта (схема 3).
Функция НовыеЧисловыеПоля()
	Возврат СтрРазделить("СерверОЗУЧастотаМГц,СерверОЗУСлотов,СерверСетьСкоростьМбит,"
		+ "СерверСвободноНаДискеГБ,РазмерДанныхБайт", ",", Ложь);
КонецФункции

// Имена базовых полей, которые Linux-ветка может уточнить (WMI там недоступен).
Функция ПоляУточнений()
	Возврат СтрРазделить("СерверОС,СерверЦПУ,СерверЦПУПотоки,СерверПК,СерверАптайм,Диск,СУБД,ВерсияСУБД", ",", Ложь);
КонецФункции

// ---------------------------------------------------------------------------
// Блок: платформа, сеанс, информационная база

Процедура СобратьПоляПлатформы(Поля, Замечания)

	Попытка
		Поля.СерверЧасовойПояс = СокрЛП(ЧасовойПоясСеанса());
	Исключение
		Замечание(Замечания, "часовой пояс сеанса");
	КонецПопытки;

	Попытка
		Поля.ЧасовойПоясИБ = СокрЛП(ПолучитьЧасовойПоясИнформационнойБазы());
	Исключение
		Замечание(Замечания, "часовой пояс ИБ");
	КонецПопытки;

	Попытка
		Поля.СерверКаталогПрограммы = Лев(СокрЛП(КаталогПрограммы()), 250);
	Исключение
		Замечание(Замечания, "каталог программы");
	КонецПопытки;

	Попытка
		Поля.СерверКаталогВременныхФайлов = Лев(СокрЛП(КаталогВременныхФайлов()), 250);
	Исключение
		Замечание(Замечания, "каталог временных файлов");
	КонецПопытки;

КонецПроцедуры

// Информационная база: имя/путь, вариант развертывания, размер данных, СУБД.
Процедура СобратьПоляИБ(Поля, Замечания, Полный = Истина)

	Попытка
		Строка = СокрЛП(СтрокаСоединенияИнформационнойБазы());
		Поля.ИмяИБ = Лев(ИмяИБИзСтроки(Строка), 100);
	Исключение
		Замечание(Замечания, "имя ИБ");
	КонецПопытки;

	Если НЕ Полный Тогда
		// Быстрая фаза: только то, что не требует запросов к СУБД и COM.
		Попытка
			Если ПерфСценарии.ВариантРазвёртывания() = "Файловый" Тогда
				Поля.СУБД = "файловая (1CD)";
			КонецЕсли;
		Исключение
			Замечание(Замечания, "СУБД");
		КонецПопытки;
		Возврат;
	КонецЕсли;

	// Размер данных по объектам конфигурации: быстро даже на большой базе,
	// потому что считаются только таблицы объектов PerfTest, а не вся ИБ.
	Попытка
		Объекты = Новый Массив;
		Объекты.Добавить("РегистрСведений.ПерфРезультаты");
		Объекты.Добавить("РегистрСведений.ПерфСтенды");
		Объекты.Добавить("РегистрСведений.ПерфИстория");
		Объекты.Добавить("Справочник.ПерфНоменклатура");
		Объекты.Добавить("Справочник.ПерфСклады");
		Объекты.Добавить("Документ.ПерфПоступление");
		Объекты.Добавить("РегистрНакопления.ПерфОстаткиТоваров");
		Поля.РазмерДанныхБайт = ПолучитьРазмерДанныхБазыДанных(Неопределено, Объекты);
	Исключение
		Замечание(Замечания, "размер данных");
	КонецПопытки;

	// Тип СУБД платформа не сообщает. В файловом режиме он известен по определению,
	// в клиент-серверном признак табличных пространств указывает на PostgreSQL.
	Попытка
		Если ПерфСценарии.ВариантРазвёртывания() = "Файловый" Тогда
			Поля.СУБД = "файловая (1CD)";
			Поля.ВерсияСУБД = "";
		Иначе
			Признак = ПризнакСУБДПоСтруктуреХранения();
			Если НЕ ПустаяСтрока(Признак) Тогда
				Поля.СУБД = Признак;
			Иначе
				Замечание(Замечания, "СУБД: тип не определяется платформой");
			КонецЕсли;
		КонецЕсли;
	Исключение
		Замечание(Замечания, "СУБД");
	КонецПопытки;

КонецПроцедуры

// Имя информационной базы из строки соединения: Ref= для серверной, File= для файловой.
Функция ИмяИБИзСтроки(Строка)
	Верхняя = ВРег(Строка);
	Позиция = СтрНайти(Верхняя, "REF=");
	Если Позиция > 0 Тогда
		Значение = Сред(Строка, Позиция + 4);
		Возврат ПервоеПолеСоединения(Значение);
	КонецЕсли;
	Позиция = СтрНайти(Верхняя, "FILE=");
	Если Позиция > 0 Тогда
		Возврат ПервоеПолеСоединения(Сред(Строка, Позиция + 5));
	КонецЕсли;
	Возврат "";
КонецФункции

// Значение до точки с запятой, без кавычек.
Функция ПервоеПолеСоединения(Значение)
	Результат = СокрЛП(Значение);
	Позиция = СтрНайти(Результат, ";");
	Если Позиция > 0 Тогда
		Результат = Лев(Результат, Позиция - 1);
	КонецЕсли;
	Результат = СтрЗаменить(СтрЗаменить(Результат, """", ""), "'", "");
	Возврат СокрЛП(Результат);
КонецФункции

// Косвенный признак СУБД в клиент-серверном режиме: табличные пространства
// заполняются только в СУБД, где это понятие есть (PostgreSQL, Oracle).
// Пустая строка - признак не найден (MSSQL или структура недоступна).
Функция ПризнакСУБДПоСтруктуреХранения()
	Попытка
		Объекты = Новый Массив;
		Объекты.Добавить("РегистрСведений.ПерфРезультаты");
		Структура = ПолучитьСтруктуруХраненияБазыДанных(Объекты, Истина);
		Если Структура = Неопределено ИЛИ Структура.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;
		ЕстьТабличноеПространство = Ложь;
		Для Каждого Строка Из Структура Цикл
			Если Строка.Свойство("ТабличноеПространствоХраненияДанных")
				И ЗначениеЗаполнено(Строка.ТабличноеПространствоХраненияДанных) Тогда
				ЕстьТабличноеПространство = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат ?(ЕстьТабличноеПространство, "PostgreSQL (по структуре хранения)", "");
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// ---------------------------------------------------------------------------
// Блок: сервер Windows (WMI/COM). Все под Попытками: COM может быть недоступен.

Процедура СобратьПоляWindows(Поля, Замечания)

	Сервис = Неопределено;
	Попытка
		Сервис = ПерфСценарии.WMIСервис();
	Исключение
		Сервис = Неопределено;
	КонецПопытки;
	Если Сервис = Неопределено Тогда
		Замечание(Замечания, "WMI сервера недоступен");
		Возврат;
	КонецЕсли;

	Попытка
		ПК = ПерфСценарии.WMIПервый(Сервис,
			"SELECT Name, Manufacturer, Model, TotalPhysicalMemory, HypervisorPresent, NumberOfProcessors"
			+ " FROM Win32_ComputerSystem");
		Если ПК <> Неопределено Тогда
			Поля.СерверПроизводитель = Лев(ЗначимоеТехническое(ПК.Manufacturer), 100);
			Поля.СерверМодель = Лев(ЗначимоеТехническое(ПК.Model), 100);
			Попытка
				Поля.СерверВиртуализация = ?(ПК.HypervisorPresent = Истина, "гипервизор", "физическая машина");
			Исключение
				Поля.СерверВиртуализация = "";
			КонецПопытки;
		КонецЕсли;
	Исключение
		Замечание(Замечания, "WMI: система");
	КонецПопытки;

	Попытка
		// BSLLS:AssignAliasFieldsInQuery-off (WQL к WMI, не запрос 1С)
		БИОС = ПерфСценарии.WMIПервый(Сервис, "SELECT SMBIOSBIOSVersion, Version FROM Win32_BIOS");
		Если БИОС <> Неопределено Тогда
			Версия = СокрЛП(Строка(БИОС.SMBIOSBIOSVersion));
			Если ПустаяСтрока(Версия) Тогда
				Версия = СокрЛП(Строка(БИОС.Version));
			КонецЕсли;
			Поля.СерверBIOS = Лев(Версия, 80);
		КонецЕсли;
	Исключение
		Замечание(Замечания, "WMI: BIOS");
	КонецПопытки;

	// Модули памяти: суммарная частота и число занятых слотов.
	Попытка
		// BSLLS:AssignAliasFieldsInQuery-off (WQL к WMI, не запрос 1С)
		Модули = WMIВсе(Сервис, "SELECT Capacity, Speed, Manufacturer FROM Win32_PhysicalMemory");
		Производитель = "";
		Частота = 0;
		Для Каждого Модуль Из Модули Цикл
			Если ПустаяСтрока(Производитель) Тогда
				Производитель = ЗначимоеТехническое(Модуль.Manufacturer);
			КонецЕсли;
			Попытка
				Скорость = Число(Модуль.Speed);
				Если Скорость > Частота Тогда
					Частота = Скорость;
				КонецЕсли;
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		Поля.СерверОЗУПроизводитель = Лев(Производитель, 100);
		Поля.СерверОЗУЧастотаМГц = Частота;
		Поля.СерверОЗУСлотов = Модули.Количество();
	Исключение
		Замечание(Замечания, "WMI: память");
	КонецПопытки;

	// Сетевой адаптер: модель и скорость (узкое место обмена клиент-сервер).
	Попытка
		Адаптер = ПерфСценарии.WMIПервый(Сервис,
			// BSLLS:AssignAliasFieldsInQuery-off (WQL к WMI, не запрос 1С)
			"SELECT Name, Speed FROM Win32_NetworkAdapter WHERE NetEnabled = TRUE");
		Если Адаптер <> Неопределено Тогда
			Поля.СерверСетьАдаптер = Лев(СокрЛП(Строка(Адаптер.Name)), 150);
			Попытка
				Скорость = Число(Адаптер.Speed);
				Если Скорость > 0 Тогда
					Поля.СерверСетьСкоростьМбит = Окр(Скорость / 1000000, 0);
				КонецЕсли;
			Исключение
				Поля.СерверСетьСкоростьМбит = 0;
			КонецПопытки;
		КонецЕсли;
	Исключение
		Замечание(Замечания, "WMI: сеть");
	КонецПопытки;

	// Физические диски: модели и объемы одной строкой (до 300 символов).
	Попытка
		// BSLLS:AssignAliasFieldsInQuery-off (WQL к WMI, не запрос 1С)
		Диски = WMIВсе(Сервис, "SELECT Model, Size FROM Win32_DiskDrive");
		Части = Новый Массив;
		Для Каждого Диск Из Диски Цикл
			Модель = СокрЛП(Строка(Диск.Model));
			Объем = 0;
			Попытка
				Объем = Окр(Число(Диск.Size) / 1073741824, 0);
			Исключение
				Объем = 0;
			КонецПопытки;
			Части.Добавить(Модель + ?(Объем > 0, " " + Объем + " ГБ", ""));
		КонецЦикла;
		Поля.СерверДиски = Лев(СтрСоединить(Части, "; "), 300);
	Исключение
		Замечание(Замечания, "WMI: диски");
	КонецПопытки;

	Попытка
		Логический = ПерфСценарии.WMIПервый(Сервис,
			// BSLLS:AssignAliasFieldsInQuery-off (WQL к WMI, не запрос 1С)
			"SELECT FreeSpace, Size FROM Win32_LogicalDisk WHERE DeviceID = 'C:'");
		Если Логический <> Неопределено Тогда
			Поля.СерверСвободноНаДискеГБ = Окр(Число(Логический.FreeSpace) / 1073741824, 1);
		КонецЕсли;
	Исключение
		Замечание(Замечания, "WMI: свободное место");
	КонецПопытки;

КонецПроцедуры

// Все объекты WMI-выборки массивом (пустой массив при сбое).
Функция WMIВсе(Сервис, ЗапросWMI)
	Результат = Новый Массив;
	Попытка
		Выборка = Сервис.ExecQuery(ЗапросWMI);
		Для Каждого Элемент Из Выборка Цикл
			Результат.Добавить(Элемент);
		КонецЦикла;
	Исключение
		Возврат Результат;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// ---------------------------------------------------------------------------
// Блок: сервер Linux. WMI/COM там нет, данные берутся из /proc и /sys.

Процедура СобратьПоляLinux(Поля, Замечания)

	Попытка
		ОС = ПрочитатьТекстФайла("/etc/os-release"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
		Если Не ПустаяСтрока(ОС) Тогда
			Пары = ПарыТекста(ОС, "=");
			Имя = Пары.Получить("PRETTY_NAME");
			Если Не ПустаяСтрока(Имя) Тогда
				Поля.СерверОС = Лев(СнятьКавычки(Имя), 200);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Замечание(Замечания, "/etc/os-release"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
	КонецПопытки;

	// ЦПУ: модель, логические процессоры, ядра (сокеты × ядра на сокет), частота.
	Попытка
		Текст = ПрочитатьТекстФайла("/proc/cpuinfo"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
		Модель = "";
		Частота = 0;
		Логических = 0;
		ЯдерНаСокет = 0;
		Сокеты = Новый Соответствие;
		Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
			Позиция = СтрНайти(Строка, ":");
			Если Позиция = 0 Тогда
				Продолжить;
			КонецЕсли;
			Ключ = СокрЛП(Лев(Строка, Позиция - 1));
			Значение = СокрЛП(Сред(Строка, Позиция + 1));
			Если Ключ = "processor" Тогда
				Логических = Логических + 1;
			ИначеЕсли Ключ = "model name" И ПустаяСтрока(Модель) Тогда
				Модель = Значение;
			ИначеЕсли Ключ = "cpu cores" Тогда
				ЯдерНаСокет = ЧислоТекста(Значение);
			ИначеЕсли Ключ = "physical id" Тогда
				Сокеты.Вставить(Значение, Истина);
			ИначеЕсли Ключ = "cpu MHz" Тогда
				Частота = Макс(Частота, ЧислоТекста(Значение));
			КонецЕсли;
		КонецЦикла;
		Если Не ПустаяСтрока(Модель) Тогда
			Поля.СерверЦПУ = Лев(Модель, 200);
		КонецЕсли;
		Если Логических > 0 Тогда
			Поля.СерверПотоковУточнение = Логических;
		КонецЕсли;
		Если ЯдерНаСокет > 0 И Сокеты.Количество() > 0 Тогда
			Поля.СерверЯдерУточнение = ЯдерНаСокет * Сокеты.Количество();
		ИначеЕсли Логических > 0 И Сокеты.Количество() <= 1 Тогда
			Поля.СерверЯдерУточнение = Логических;
		КонецЕсли;
		Если Частота > 0 Тогда
			Поля.СерверЦПУМГцУточнение = Окр(Частота, 0);
		КонецЕсли;
		Если Логических > 0 Тогда
			Поля.СерверЦПУПотоки = Строка(?(Поля.СерверЯдерУточнение > 0, Поля.СерверЯдерУточнение, Логических))
				+ " ядер / " + Строка(Логических) + " потоков";
		КонецЕсли;
	Исключение
		Замечание(Замечания, "/proc/cpuinfo"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
	КонецПопытки;

	Попытка
		Текст = ПрочитатьТекстФайла("/proc/meminfo"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
		Пары = ПарыТекста(Текст, ":");
		Всего = ЧислоТекста(СтрЗаменить(СокрЛП(Пары.Получить("MemTotal")), "kB", ""));
		Свободно = ЧислоТекста(СтрЗаменить(СокрЛП(Пары.Получить("MemAvailable")), "kB", ""));
		Если Всего > 0 Тогда
			Поля.СерверПамятьМбУточнение = Окр(Всего / 1024, 0);
		КонецЕсли;
		Если Свободно > 0 Тогда
			Поля.СерверСвободнаПамятьМбУточнение = Окр(Свободно / 1024, 0);
		КонецЕсли;
	Исключение
		Замечание(Замечания, "/proc/meminfo"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
	КонецПопытки;

	Попытка
		Текст = ПрочитатьТекстФайла("/proc/uptime"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
		Секунды = ЧислоТекста(СокрЛП(Лев(Текст, ?(СтрНайти(Текст, " ") > 0, СтрНайти(Текст, " ") - 1, СтрДлина(Текст)))));
		Если Секунды > 0 Тогда
			Поля.СерверАптайм = Строка(Цел(Секунды / 86400)) + " дн "
				+ Строка(Цел((Секунды % 86400) / 3600)) + " ч "
				+ Строка(Цел((Секунды % 3600) / 60)) + " мин";
		КонецЕсли;
	Исключение
		Замечание(Замечания, "/proc/uptime"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
	КонецПопытки;

	// Диски: модели и объемы из /sys/block (сектора по 512 байт).
	Попытка
		Файлы = НайтиФайлы("/sys/block", "*"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
		Части = Новый Массив;
		Для Каждого Файл Из Файлы Цикл
			Имя = Файл.ПолноеИмя + "/device/model"; // BSLLS:UsingHardcodePath-off (путь внутри /sys/block)
			Модель = СокрЛП(ПрочитатьТекстФайла(Имя));
			Если ПустаяСтрока(Модель) Тогда
				Продолжить;
			КонецЕсли;
			Сектора = ЧислоТекста(СокрЛП(ПрочитатьТекстФайла(Файл.ПолноеИмя + "/size")));
			Объем = ?(Сектора > 0, Окр(Сектора * 512 / 1073741824, 0), 0);
			Части.Добавить(Модель + ?(Объем > 0, " " + Объем + " ГБ", ""));
		КонецЦикла;
		Поля.СерверДиски = Лев(СтрСоединить(Части, "; "), 300);
	Исключение
		Замечание(Замечания, "/sys/block"); // BSLLS:UsingHardcodePath-off (виртуальные файлы Linux, путь задан ОС)
	КонецПопытки;

КонецПроцедуры

// Текст файла целиком; "" - файла нет или он недоступен (Linux-ветка, /proc).
Функция ПрочитатьТекстФайла(Путь)
	Результат = "";
	Попытка
		Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
		Пока Истина Цикл
			Строка = Чтение.ПрочитатьСтроку();
			Если Строка = Неопределено Тогда
				Прервать;
			КонецЕсли;
			Результат = Результат + Строка + Символы.ПС;
			Если СтрДлина(Результат) > 1000000 Тогда
				Прервать;   // защита от гигантских файлов
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Пары «ключ = значение» (первое вхождение ключа) из текста.
Функция ПарыТекста(Текст, Разделитель)
	Результат = Новый Соответствие;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Позиция = СтрНайти(Строка, Разделитель);
		Если Позиция > 1 Тогда
			Ключ = СокрЛП(Лев(Строка, Позиция - 1));
			Если Результат.Получить(Ключ) = Неопределено Тогда
				Результат.Вставить(Ключ, СокрЛП(Сред(Строка, Позиция + 1)));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Снимает обрамляющие кавычки (os-release отдает PRETTY_NAME="...").
Функция СнятьКавычки(Значение)
	Результат = СокрЛП(Значение);
	Если СтрДлина(Результат) >= 2 Тогда
		Первый = Лев(Результат, 1);
		Последний = Прав(Результат, 1);
		Если (Первый = """" И Последний = """") ИЛИ (Первый = "'" И Последний = "'") Тогда
			Результат = Сред(Результат, 2, СтрДлина(Результат) - 2);
		КонецЕсли;
	КонецЕсли;
	Возврат СокрЛП(Результат);
КонецФункции

// Число из текста (точка как разделитель); при ошибке 0.
// Значение WMI, пригодное для паспорта: отбрасывает служебные заглушки
// (Undefined, None, Unknown, To Be Filled By O.E.M. и подобные), которые
// производители железа пишут вместо реальных данных.
Функция ЗначимоеТехническое(Значение)

	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Служебные = "UNDEFINED,NONE,UNKNOWN,NOT AVAILABLE,NOT APPLICABLE,DEFAULT STRING,"
		+ "TO BE FILLED BY O.E.M.,SYSTEM MANUFACTURER,SYSTEM PRODUCT NAME,INVALID";
	Если СтрНайти("," + Служебные + ",", "," + ВРег(Текст) + ",") > 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст;

КонецФункции

// ЧислоТекста: число из текста WMI/процентов (точка или запятая как разделитель).
Функция ЧислоТекста(Значение)
	Попытка
		Возврат Число(СтрЗаменить(СокрЛП(Значение), ",", "."));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// ---------------------------------------------------------------------------
// Блок: клиентская часть (приходит строкой «Ключ=Значение;...»)

Процедура СобратьПоляКлиента(Поля, КлиентСтрока, Замечания)

	Если ПустаяСтрока(КлиентСтрока) Тогда
		Замечание(Замечания, "клиент не передал сведения");
		Возврат;
	КонецЕсли;

	Попытка
		К = ПарыТекста(СтрЗаменить(КлиентСтрока, ";", Символы.ПС), "=");
		Поля.РежимКлиента = Лев(СокрЛП(ЗначениеПары(К, "РежимКлиента")), 40);
		Поля.РежимЗапуска = Лев(СокрЛП(ЗначениеПары(К, "РежимЗапуска")), 40);
		Поля.ТипПлатформыКлиент = Лев(СокрЛП(ЗначениеПары(К, "ТипПлатформы")), 40);
		Если ПустаяСтрока(Поля.ТипПлатформыКлиент) Тогда
			Поля.ТипПлатформыКлиент = Лев(СокрЛП(ЗначениеПары(К, "Платформа")), 40);
		КонецЕсли;
		Поля.ВерсияПлатформыКлиент = Лев(СокрЛП(ЗначениеПары(К, "ВерсияПриложения")), 32);
		Поля.КлиентБраузер = Лев(СокрЛП(ЗначениеПары(К, "Браузер")), 300);
		Поля.КлиентИдентификатор = Лев(СокрЛП(ЗначениеПары(К, "ИдентификаторКлиента")), 64);
		Если ПустаяСтрока(Поля.КлиентИдентификатор) Тогда
			Поля.КлиентИдентификатор = Лев(СокрЛП(ЗначениеПары(К, "КлиентИдентификатор")), 64);
		КонецЕсли;
		Поля.КлиентИмяКомпьютера = Лев(СокрЛП(ЗначениеПары(К, "ИмяКомпьютера")), 100);
		Если ПустаяСтрока(Поля.КлиентИмяКомпьютера) Тогда
			Поля.КлиентИмяКомпьютера = Лев(СокрЛП(ЗначениеПары(К, "Компьютер")), 100);
		КонецЕсли;
	Исключение
		Замечание(Замечания, "разбор сведений клиента");
	КонецПопытки;

КонецПроцедуры

// Значение пары или "" (в Соответствии его может не быть).
Функция ЗначениеПары(Пары, Ключ)
	Значение = Пары.Получить(Ключ);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Значение));
КонецФункции

// Замечание о несобранном блоке: видно, чего именно не хватило на этом стенде.
Процедура Замечание(Замечания, Текст)
	Если Замечания.Количество() < 12 Тогда
		Замечания.Добавить(Текст);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
