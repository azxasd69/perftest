// ПерфОтчетыHTML - сборка HTML-отчётов из регистров ПерфРезультаты, ПерфСтенды, ПерфИстория.
//
// Отчёт не хранится: каждый вызов читает регистры и строит самодостаточную страницу
// (стили и скрипты встроены, внешних ресурсов нет - страница открывается из файла).
// Четыре отчёта: топ конфигураций, сравнение стендов, история замеров, дашборд.
// Строится на сервере; формы отчётов только показывают готовый HTML в поле документа.
//
// Индекс стенда - среднее отношение «время базы / время стенда» по общим сценариям,
// в процентах (100 - как у базы). Дельта сценария - то же отношение для одного сценария;
// положительная дельта значит «стенд быстрее базы».
//
// Все данные из регистров проходят через Экранировать(): текст пишется в HTML как есть
// и без экранирования ломал бы разметку (или давал XSS при просмотре вне 1С).
#Область ПрограммныйИнтерфейс

// Сборщики четырёх отчётов. Каждый возвращает структуру РезультатОтчёта:
// HTML плюс фактически использованные параметры (база, стенд сравнения, сценарий),
// по ним формы предзаполняют поля и пишут маркер смоука.

// Пустое состояние: иконка, заголовок, пояснение и действие вместо строки текста.
Функция ПустоеСостояние(Заголовок, Пояснение)

	Возврат "<div class='empty'>"
		+ "<div class='empty-ico'>"
		+ "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6'"
		+ " stroke-linecap='round' stroke-linejoin='round' width='34' height='34'>"
		+ "<rect x='3' y='4' width='18' height='14' rx='2'/><path d='M7 20h10'/>"
		+ "<path d='M7 9h6M7 13h4'/></svg></div>"
		+ "<h2>" + Экранировать(Заголовок) + "</h2>"
		+ "<p class='muted'>" + Экранировать(Пояснение) + "</p>"
		+ "<button class='btn primary' data-pf='open:НачальнаяСтраница'>"
		+ "Открыть кокпит</button>"
		+ "</div>";

КонецФункции

// Топ-100 конфигураций (стендов) по интегральному индексу (ТЗ отчётов §5).
Функция СобратьТопКонфигураций(БазовыйСтенд, Настройки = Неопределено) Экспорт

	Данные = ЗагрузитьРезультаты();
	Результаты = Данные.Стенды;
	Паспорта = ЗагрузитьПаспорта();
	База = ВыбратьБазовый(Результаты, БазовыйСтенд);
	ДанныеБазы = Результаты.Получить(База);

	Рейтинг = Новый Массив;
	Для Каждого СтендК Из Результаты Цикл
		Если СтендК.Ключ = База Тогда
			Продолжить;
		КонецЕсли;
		Индекс = Новый Структура("Индекс, Сценариев, ЛучшийСценарий, ЛучшийДельта,"
			+ "ХудшийСценарий, ХудшийДельта, ПоследнийЗамер");
		РассчитатьИндекс(ДанныеБазы, СтендК.Значение, Индекс);
		Если Индекс.Сценариев = 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Новый Структура("Стенд, Индекс, Паспорт", СтендК.Ключ, Индекс,
			Паспорта.Получить(СтендК.Ключ));
		Рейтинг.Добавить(Строка);
	КонецЦикла;
	СортироватьПоИндексу(Рейтинг);

	Строки = Новый Массив;
	Место = 0;
	СтендСеанса = СтендТекущегоСеанса();
	Для Каждого Элемент Из Рейтинг Цикл
		Место = Место + 1;
		Если Место > 100 Тогда
			Прервать;
		КонецЕсли;
		Инд = Элемент.Индекс;
		П = Элемент.Паспорт;
		Ячейки = Новый Массив;
		Ячейки.Добавить(Ячейка(ФорматЧисла(Место, 0), "num"));
		Ячейки.Добавить(Ячейка(Экранировать(Элемент.Стенд)
			+ ?(СокрЛП(Элемент.Стенд) = СтендСеанса, " *", "")));
		Для Каждого ЯчейкаПрофиля Из ЯчейкиПрофиля(П) Цикл
			Ячейки.Добавить(ЯчейкаПрофиля);
		КонецЦикла;
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", Экранировать(П.ПлатформаСервер))));
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", Экранировать(П.ВерсияКонфигурации))));
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", Экранировать(П.РежимИБ))));
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", Экранировать(П.СерверЦПУ))));
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", ФорматЧисла(П.СерверПамятьМб, 0)), "num"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Инд.Сценариев, 0), "num"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Инд.Индекс, 1), "num " + КлассИндекса(Инд.Индекс)));
		Ячейки.Добавить(Ячейка(Экранировать(Инд.ЛучшийСценарий)));
		Ячейки.Добавить(Ячейка(ДельтаТекст(Инд.ЛучшийДельта), "num " + КлассДельты(Инд.ЛучшийДельта)));
		Ячейки.Добавить(Ячейка(Экранировать(Инд.ХудшийСценарий)));
		Ячейки.Добавить(Ячейка(ДельтаТекст(Инд.ХудшийДельта), "num " + КлассДельты(Инд.ХудшийДельта)));
		Ячейки.Добавить(Ячейка(ФорматДаты(Инд.ПоследнийЗамер)));
		Строки.Добавить(Ячейки);
	КонецЦикла;

	Чипы = Новый Массив;
	Чипы.Добавить(Чип("Базовый стенд", База));
	Чипы.Добавить(Чип("Стендов", ФорматЧисла(Результаты.Количество(), 0)));
	Чипы.Добавить(Чип("Сценариев", ФорматЧисла(Данные.Сценарии.Количество(), 0)));
	Чипы.Добавить(Чип("Строк в рейтинге", ФорматЧисла(Строки.Количество(), 0)));

	Заголовки = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Место|Стенд|ID|Развёртывание|ИБ, МБ|Платформа|Конфигурация|Режим ИБ|ЦПУ сервера|ОП, МБ|Сцен.|Индекс, %|Лучший сценарий|+%|Худший сценарий|-%|Последний замер", "|") Цикл
		Заголовки.Добавить(Имя);
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		HTML = ШапкаОтчёта("Топ-100 конфигураций", Чипы)
			+ "<div class='wrap'>"
			+ ПустоеСостояние("Пока нечего сравнивать",
			+ "Нужны замеры минимум на двух стендах: базовом и сравниваемом.")
			+ "</div>";
	Возврат РезультатОтчёта(HTML, База, "", "", "ПерфТопКонфигураций");
	КонецЕсли;

	Версии = Новый Массив;
	Для Каждого ЭлементР Из Рейтинг Цикл
		Если ЭлементР.Паспорт <> Неопределено И НайтиВМассиве(Версии, СокрЛП(ЭлементР.Паспорт.ВерсияКонфигурации)) = -1 Тогда
			Версии.Добавить(СокрЛП(ЭлементР.Паспорт.ВерсияКонфигурации));
		КонецЕсли;
	КонецЦикла;
	Плашка = "";
	Если Версии.Количество() > 1 Тогда
		Плашка = "<p class='warn'>В рейтинге стенды с разными версиями конфигурации ("
			+ Экранировать(СтрСоединить(Версии, ", "))
			+ "): индекс смешивает разницу железа и разницу конфигурации.</p>";
	КонецЕсли;

	HTML = ШапкаОтчёта("Топ-100 конфигураций", Чипы)
		+ "<div class='wrap'>" + Плашка + Таблица(Заголовки, Строки)
		+ "<p class='muted'>Индекс 100 - уровень базового стенда; больше 100 - быстрее базы. "
		+ "Сравнение по мс на тыс. единиц порции, поэтому порция и число повторов не влияют на рейтинг.</p>"
		+ "</div>";
	Возврат РезультатОтчёта(HTML, База, "", "", "ПерфТопКонфигураций", Настройки);

КонецФункции

// Сравнение двух стендов по сценариям (ТЗ отчётов §4).
Функция СобратьСравнениеСтендов(БазовыйСтенд, СтендСравнения, Настройки = Неопределено) Экспорт

	Данные = ЗагрузитьРезультаты();
	Результаты = Данные.Стенды;
	База = ВыбратьБазовый(Результаты, БазовыйСтенд);
	ДанныеБазы = Результаты.Получить(База);

	Сравниваемый = СокрЛП(СтендСравнения);
	Если Сравниваемый = "" Тогда
		Сравниваемый = СтендТекущегоСеанса();
	КонецЕсли;
	Если Сравниваемый = "" ИЛИ Результаты.Получить(Сравниваемый) = Неопределено
		ИЛИ Сравниваемый = База Тогда
		Сравниваемый = ПервыйОтличный(Результаты, База);
	КонецЕсли;
	ДанныеСтенда = Результаты.Получить(Сравниваемый);

	Паспорта = ЗагрузитьПаспорта();
	ПаспортБазы = Паспорта.Получить(База);
	ПаспортСтенда = Паспорта.Получить(Сравниваемый);

	Чипы = Новый Массив;
	Чипы.Добавить(Чип("База", База));
	Чипы.Добавить(Чип("Сравнение", ?(Сравниваемый = "", "нет второго стенда", Сравниваемый)));
	Если ПаспортБазы <> Неопределено И НЕ ПустаяСтрока(ПаспортБазы.ИдентификаторСтенда) Тогда
		Чипы.Добавить(Чип("ID базы", ПаспортБазы.ИдентификаторСтенда));
	КонецЕсли;
	Если ПаспортСтенда <> Неопределено И НЕ ПустаяСтрока(ПаспортСтенда.ИдентификаторСтенда) Тогда
		Чипы.Добавить(Чип("ID сравнения", ПаспортСтенда.ИдентификаторСтенда));
	КонецЕсли;

	Если ДанныеСтенда = Неопределено ИЛИ ДанныеБазы = Неопределено Тогда
		HTML = ШапкаОтчёта("Сравнение стендов", Чипы)
			+ "<div class='wrap'>"
			+ ПустоеСостояние("Нет второго стенда",
			+ "Сравнение строится по двум стендам. Соберите паспорт и замеры ещё на одном стенде.")
			+ "</div>";
	Возврат РезультатОтчёта(HTML, База, Сравниваемый, "", "ПерфСравнениеСтендов");
	КонецЕсли;

	Заголовки = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Сценарий|Порция|Ед.|База, мс/тыс|Стенд, мс/тыс|Дельта, %|Медиана, мс|Мин-Макс, мс|Шум, %|Стенд: дата", "|") Цикл
		Заголовки.Добавить(Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Сумма = 0;
	Количество = 0;
	Для Каждого СценарийК Из Данные.Сценарии Цикл
		СтендЗапись = ДанныеСтенда.Получить(СценарийК);
		БазаЗапись = ДанныеБазы.Получить(СценарийК);
		Если СтендЗапись = Неопределено И БазаЗапись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ячейки = Новый Массив;
		Ячейки.Добавить(Ячейка(Экранировать(СценарийК)));
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", ФорматЧисла(СтендЗапись.Порция, 0)), "num"));
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", Экранировать(СтендЗапись.Единица))));
		Ячейки.Добавить(Ячейка(?(БазаЗапись = Неопределено, "-", ФорматЧисла(БазаЗапись.НаЕдиницуМс, 3)), "num"));
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", ФорматЧисла(СтендЗапись.НаЕдиницуМс, 3)), "num"));
		Если СтендЗапись = Неопределено ИЛИ БазаЗапись = Неопределено ИЛИ БазаЗапись.НаЕдиницуМс = 0 Тогда
			Ячейки.Добавить(Ячейка("-", "num"));
		Иначе
			Дельта = (БазаЗапись.НаЕдиницуМс - СтендЗапись.НаЕдиницуМс) / БазаЗапись.НаЕдиницуМс * 100;
			Ячейки.Добавить(Ячейка(ДельтаТекст(Дельта), "num " + КлассДельты(Дельта)));
			Сумма = Сумма + БазаЗапись.НаЕдиницуМс / СтендЗапись.НаЕдиницуМс;
			Количество = Количество + 1;
		КонецЕсли;
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", ФорматЧисла(СтендЗапись.МедианаМс, 0)), "num"));
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-",
			ФорматЧисла(СтендЗапись.МинМс, 0) + "-" + ФорматЧисла(СтендЗапись.МаксМс, 0)), "num"));
		Если СтендЗапись = Неопределено Тогда
			Ячейки.Добавить(Ячейка("-", "num"));
		Иначе
			Шум = ШумЗаписи(СтендЗапись);
			Ячейки.Добавить(Ячейка(ФорматЧисла(Шум, 1), "num " + ?(Шум > 20, "warn", "")));
		КонецЕсли;
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", ФорматДаты(СтендЗапись.ДатаЗамера))));
		Строки.Добавить(Ячейки);
	КонецЦикла;

	Итог = ?(Количество = 0, "", "Интегральный индекс: "
		+ ФорматЧисла(Сумма / ?(Количество = 0, 1, Количество) * 100, 1) + " (по "
		+ ФорматЧисла(Количество, 0) + " сценариям)");

	HTML = ШапкаОтчёта("Сравнение стендов", Чипы)
		+ "<div class='wrap'>" + ПредупреждениеНесопоставимости(ПаспортБазы, ПаспортСтенда)
		+ Таблица(Заголовки, Строки)
		+ "<p class='muted'>" + Экранировать(Итог) + "</p>"
		+ "<p class='muted'>Дельта больше нуля - сравниваемый стенд быстрее базы. Шум больше 20 процентов - замер нестабилен.</p>"
		+ "</div>";
	Возврат РезультатОтчёта(HTML, База, Сравниваемый, "", "ПерфСравнениеСтендов", Настройки);

КонецФункции

// История замеров по стенду и сценарию (ТЗ отчётов §6).
Функция СобратьИсториюЗамеров(Стенд, Сценарий, Настройки = Неопределено) Экспорт

	Если ПустаяСтрока(Стенд) Тогда
		Стенд = СтендТекущегоСеанса();
		Если НЕ ПустаяСтрока(Стенд) И СтендСИсторией(Стенд) = "" Тогда
			Стенд = ""; // у стенда сеанса журнала нет - покажем стенд с историей
		КонецЕсли;
		Если ПустаяСтрока(Стенд) Тогда
			Стенд = СтендСИсторией("");
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Сценарий) Тогда
		Сценарий = СценарийПоУмолчанию(Стенд);
	КонецЕсли;

	Запрос = Новый Запрос;
	Текст = "ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	Т.Сценарий КАК Сценарий,
		|	Т.ДатаЗамера КАК ДатаЗамера,
		|	Т.МедианаМс КАК МедианаМс,
		|	Т.НаЕдиницуМс КАК НаЕдиницуМс,
		|	Т.Порция КАК Порция,
		|	Т.Повторов КАК Повторов,
		|	Т.МинМс КАК МинМс,
		|	Т.МаксМс КАК МаксМс,
		|	Т.Единица КАК Единица
		|ИЗ
		|	РегистрСведений.ПерфИстория КАК Т";

	Условия = Новый Массив;
	Если НЕ ПустаяСтрока(Стенд) Тогда
		Условия.Добавить("Т.Стенд = &Стенд");
		Запрос.УстановитьПараметр("Стенд", СокрЛП(Стенд));
	КонецЕсли;
	Если НЕ ПустаяСтрока(Сценарий) Тогда
		Условия.Добавить("Т.Сценарий = &Сценарий");
		Запрос.УстановитьПараметр("Сценарий", СокрЛП(Сценарий));
	КонецЕсли;
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + " ГДЕ " + СтрСоединить(Условия, " И ");
	КонецЕсли;
	Текст = Текст + " УПОРЯДОЧИТЬ ПО Т.ДатаЗамера";
	Запрос.Текст = Текст;

	Все = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Все.Добавить(Выборка);
	КонецЦикла;

	Чипы = Новый Массив;
	Чипы.Добавить(Чип("Стенд", ?(ПустаяСтрока(Стенд), "все", Стенд)));
	Чипы.Добавить(Чип("Сценарий", ?(ПустаяСтрока(Сценарий), "все", Сценарий)));
	Чипы.Добавить(Чип("Замеров", ФорматЧисла(Все.Количество(), 0)));

	Если Все.Количество() = 0 Тогда
		HTML = ШапкаОтчёта("История замеров", Чипы)
			+ "<div class='wrap'><p class='muted'>Записей истории нет. Журнал ПерфИстория наполняется при каждом "
			+ "запуске тестов (после версии 1.10).</p></div>";
	Возврат РезультатОтчёта(HTML, Стенд, "", Сценарий, "ПерфИсторияЗамеров");
	КонецЕсли;

	Заголовки = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Дата замера|Медиана, мс|Мс/тыс.|Порция|Повторов|Мин-Макс, мс|Шум, %|Дельта к пред., %", "|") Цикл
		Заголовки.Добавить(Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Значения = Новый Массив;
	Предыдущая = Неопределено;
	Шумных = 0;
	СуммаМедиан = 0;
	Минимум = Неопределено;
	Максимум = Неопределено;
	Для Каждого Запись Из Все Цикл
		Ячейки = Новый Массив;
		Ячейки.Добавить(Ячейка(ФорматДаты(Запись.ДатаЗамера)));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.МедианаМс, 0), "num"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.НаЕдиницуМс, 3), "num"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.Порция, 0), "num"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.Повторов, 0), "num"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.МинМс, 0) + "-" + ФорматЧисла(Запись.МаксМс, 0), "num"));
		Шум = 0;
		Если Запись.МедианаМс > 0 Тогда
			Шум = (Запись.МаксМс - Запись.МинМс) / Запись.МедианаМс * 100;
		КонецЕсли;
		Если Шум > 20 Тогда
			Шумных = Шумных + 1;
		КонецЕсли;
		Ячейки.Добавить(Ячейка(ФорматЧисла(Шум, 1), "num " + ?(Шум > 20, "warn", "")));
		Если Предыдущая = Неопределено ИЛИ Предыдущая.МедианаМс = 0 Тогда
			Ячейки.Добавить(Ячейка("-", "num"));
		Иначе
			Дельта = (Предыдущая.МедианаМс - Запись.МедианаМс) / Предыдущая.МедианаМс * 100;
			Ячейки.Добавить(Ячейка(ДельтаТекст(Дельта), "num " + КлассДельты(Дельта)));
		КонецЕсли;
		Строки.Добавить(Ячейки);
		Значения.Добавить(Запись.МедианаМс);
		Предыдущая = Запись;
		СуммаМедиан = СуммаМедиан + Запись.МедианаМс;
		Если Минимум = Неопределено ИЛИ Запись.МедианаМс < Минимум Тогда
			Минимум = Запись.МедианаМс;
		КонецЕсли;
		Если Максимум = Неопределено ИЛИ Запись.МедианаМс > Максимум Тогда
			Максимум = Запись.МедианаМс;
		КонецЕсли;
	КонецЦикла;

	Среднее = СуммаМедиан / Все.Количество();
	Разброс = 0;
	Если Среднее > 0 Тогда
		Разброс = (Максимум - Минимум) / Среднее * 100;
	КонецЕсли;

	// Сводка: короткие пары «подпись - число», числа выделены, чтобы строка читалась.
	Сводка = "<div class='summary'>"
		+ "<span>Замеров <b>" + ФорматЧисла(Все.Количество(), 0) + "</b></span>"
		+ "<span>Медиана медиан <b>" + ФорматЧисла(Среднее, 0) + " мс</b></span>"
		+ "<span>Минимум <b>" + ФорматЧисла(Минимум, 0) + " мс</b></span>"
		+ "<span>Максимум <b>" + ФорматЧисла(Максимум, 0) + " мс</b></span>"
		+ "<span>Разброс <b>" + ФорматЧисла(Разброс, 1) + " %</b></span>"
		+ "<span>Шумных <b>" + ФорматЧисла(Шумных, 0) + "</b></span>"
		+ "</div>";

	HTML = ШапкаОтчёта("История замеров", Чипы)
		+ "<div class='wrap'>" + БлокСпарклайна(Значения, 720, 60)
		+ Сводка
		+ Таблица(Заголовки, Строки)
		+ "</div>";
	Возврат РезультатОтчёта(HTML, Стенд, "", Сценарий, "ПерфИсторияЗамеров", Настройки);

КонецФункции

// Дашборд: карточки стендов, последние замеры, тренд (ТЗ отчётов §7).
Функция СобратьДашборд(БазовыйСтенд, Настройки = Неопределено) Экспорт

	Данные = ЗагрузитьРезультаты();
	Результаты = Данные.Стенды;
	Паспорта = ЗагрузитьПаспорта();
	База = ВыбратьБазовый(Результаты, БазовыйСтенд);
	ДанныеБазы = Результаты.Получить(База);

	Карточки = Новый Массив;
	Шумных = 0;
	ВсегоЗамеров = 0;
	Последние = Новый Массив;

	// Стенд текущего сеанса считается один раз: внутри цикла по стендам функция
	// выполняла запросы на каждый стенд (замечание EDT query-in-loop).
	СтендСеанса = СокрЛП(СтендТекущегоСеанса());

	Для Каждого СтендК Из Результаты Цикл
		Индекс = Новый Структура("Индекс, Сценариев, ЛучшийСценарий, ЛучшийДельта,"
			+ "ХудшийСценарий, ХудшийДельта, ПоследнийЗамер");
		РассчитатьИндекс(ДанныеБазы, СтендК.Значение, Индекс);
		П = Паспорта.Получить(СтендК.Ключ);

		Худшие = Новый Массив;
		Для Каждого СценарийК Из Данные.Сценарии Цикл
			Запись = СтендК.Значение.Получить(СценарийК);
			Если Запись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ВсегоЗамеров = ВсегоЗамеров + 1;
			Если ШумЗаписи(Запись) > 20 Тогда
				Шумных = Шумных + 1;
			КонецЕсли;
			Дел = Неопределено;
			БазаЗапись = ?(ДанныеБазы = Неопределено, Неопределено, ДанныеБазы.Получить(СценарийК));
			Если БазаЗапись <> Неопределено И БазаЗапись.НаЕдиницуМс > 0 И СтендК.Ключ <> База Тогда
				Дел = (БазаЗапись.НаЕдиницуМс - Запись.НаЕдиницуМс) / БазаЗапись.НаЕдиницуМс * 100;
			КонецЕсли;
			Худшие.Добавить(Новый Структура("Сценарий, Дельта, Запись", СценарийК, Дел, Запись));
			Последние.Добавить(Новый Структура("Стенд, Сценарий, Запись, Дельта",
				СтендК.Ключ, СценарийК, Запись, Дел));
		КонецЦикла;
		СортироватьПоДельте(Худшие);

		Цвет = ?(Индекс.Индекс >= 100, "var(--pf-ok)", ?(Индекс.Индекс >= 90, "var(--pf-warn)", "var(--pf-bad)"));
		Бары = Новый Массив;
		Счетчик = 0;
		Для Каждого Худший Из Худшие Цикл
			Счетчик = Счетчик + 1;
			Если Счетчик > 3 Тогда
				Прервать;
			КонецЕсли;
			Если Худший.Дельта = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Ширина = ?(Худший.Дельта < 0, -Худший.Дельта, 0);
			Если Ширина > 100 Тогда
				Ширина = 100;
			КонецЕсли;
			Бары.Добавить("<div class='muted xs'>"
				+ Экранировать(Худший.Сценарий) + ": " + ДельтаТекст(Худший.Дельта) + "%</div>"
				+ "<div class='bar'><i style='width:" + ФорматЧисла(Ширина, 0)
				+ "%;background:" + ?(Худший.Дельта < 0, "var(--pf-bad)", "var(--pf-ok)") + "'></i></div>");
		КонецЦикла;

		Карточки.Добавить("<div class='card'><div class='muted'>" + Экранировать(СтендК.Ключ)
			+ ?(СокрЛП(СтендК.Ключ) = СтендСеанса, " <span class='badge'>этот сеанс</span>", "")
			+ ?(П = Неопределено, "", "  <span class='badge'>" + Экранировать(П.ПлатформаСервер + " / " + П.РежимИБ) + "</span>")
			+ "</div><div class='big " + ?(Цвет = "var(--pf-ok)", "good", "bad") + "'>"
			+ ?(СтендК.Ключ = База, "база", ФорматЧисла(Индекс.Индекс, 1))
			+ "</div><div class='muted'>" + ФорматЧисла(Индекс.Сценариев, 0) + " из "
			+ ФорматЧисла(Данные.Сценарии.Количество(), 0) + " сценариев · замер "
			+ ФорматДаты(Индекс.ПоследнийЗамер) + "</div>"
			+ СтрСоединить(Бары, "") + "</div>");
	КонецЦикла;

	// Последние замеры: сортировка по дельте (худшие сверху), ограничение 40 строк.
	СортироватьПоДельтеВозраст(Последние);
	Заголовки = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Стенд|Сценарий|Мс/тыс.|Медиана, мс|Дельта к базе, %|Шум, %|Дата", "|") Цикл
		Заголовки.Добавить(Имя);
	КонецЦикла;
	Строки = Новый Массив;
	Счетчик = 0;
	СтендСеанса = СтендТекущегоСеанса();
	Для Каждого Элемент Из Последние Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик > 40 Тогда
			Прервать;
		КонецЕсли;
		Шум = ШумЗаписи(Элемент.Запись);
		Ячейки = Новый Массив;
		Ячейки.Добавить(Ячейка(Экранировать(Элемент.Стенд)
			+ ?(СокрЛП(Элемент.Стенд) = СтендСеанса, " *", "")));
		Ячейки.Добавить(Ячейка(Экранировать(Элемент.Сценарий)));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Элемент.Запись.НаЕдиницуМс, 3), "num"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Элемент.Запись.МедианаМс, 0), "num"));
		Ячейки.Добавить(Ячейка(?(Элемент.Дельта = Неопределено, "база", ДельтаТекст(Элемент.Дельта)),
			"num " + ?(Элемент.Дельта = Неопределено, "muted", КлассДельты(Элемент.Дельта))));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Шум, 1), "num " + ?(Шум > 20, "warn", "")));
		Ячейки.Добавить(Ячейка(ФорматДаты(Элемент.Запись.ДатаЗамера)));
		Строки.Добавить(Ячейки);
	КонецЦикла;

	Чипы = Новый Массив;
	Чипы.Добавить(Чип("База", База));
	Чипы.Добавить(Чип("Стендов", ФорматЧисла(Результаты.Количество(), 0)));
	Чипы.Добавить(Чип("Замеров", ФорматЧисла(ВсегоЗамеров, 0)));
	Чипы.Добавить(Чип("Шумных", ФорматЧисла(Шумных, 0)));

	HTML = ШапкаОтчёта("Дашборд тестов производительности", Чипы)
		+ "<div class='wrap'><div class='cards'>" + СтрСоединить(Карточки, "") + "</div>"
		+ "<h2>Последние замеры</h2>" + Таблица(Заголовки, Строки)
		+ "<p class='muted'>Построено: " + ФорматДаты(ТекущаяДатаСеанса()) + "</p></div>";
	Возврат РезультатОтчёта(HTML, База, "", "", "ПерфДашборд", Настройки);

КонецФункции

// Список стендов (для подсказки на формах).
Функция СписокСтендов() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Т.Стенд КАК Стенд ИЗ РегистрСведений.ПерфРезультаты КАК Т УПОРЯДОЧИТЬ ПО Стенд");
	Выборка = Запрос.Выполнить().Выбрать();
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Список.Добавить(СокрЛП(Выборка.Стенд));
	КонецЦикла;
	Возврат СтрСоединить(Список, ", ");
КонецФункции

#КонецОбласти

#Область Данные

// Чтение регистров, сводный индекс стенда, шум замера и сортировки.
// Здесь нет ни одного запроса к ИБ на каждый сценарий: наборы читаются один раз на отчёт.

// Все замеры из ПерфРезультаты: соответствие Стенд -> (Сценарий -> запись)
// и отсортированный список сценариев - единый набор для всех отчётов.
Функция ЗагрузитьРезультаты()
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	Т.Сценарий КАК Сценарий,
		|	Т.НаЕдиницуМс КАК НаЕдиницуМс,
		|	Т.МедианаМс КАК МедианаМс,
		|	Т.Порция КАК Порция,
		|	Т.Повторов КАК Повторов,
		|	Т.МинМс КАК МинМс,
		|	Т.МаксМс КАК МаксМс,
		|	Т.Единица КАК Единица,
		|	Т.ДатаЗамера КАК ДатаЗамера
		|ИЗ
		|	РегистрСведений.ПерфРезультаты КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.Стенд, Т.Сценарий");
	Стенды = Новый Соответствие;
	Сценарии = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стенд = СокрЛП(Выборка.Стенд);
		Сценарий = СокрЛП(Выборка.Сценарий);
		ПоСтенду = Стенды.Получить(Стенд);
		Если ПоСтенду = Неопределено Тогда
			ПоСтенду = Новый Соответствие;
			Стенды.Вставить(Стенд, ПоСтенду);
		КонецЕсли;
		ПоСтенду.Вставить(Сценарий, Новый Структура(
			"НаЕдиницуМс, МедианаМс, Порция, Повторов, МинМс, МаксМс, Единица, ДатаЗамера",
			Выборка.НаЕдиницуМс, Выборка.МедианаМс, Выборка.Порция, Выборка.Повторов,
			Выборка.МинМс, Выборка.МаксМс, СокрЛП(Выборка.Единица), Выборка.ДатаЗамера));
		Если НайтиВМассиве(Сценарии, Сценарий) = -1 Тогда
			Сценарии.Добавить(Сценарий);
		КонецЕсли;
	КонецЦикла;
	СортироватьСтроки(Сценарии);
	Возврат Новый Структура("Стенды, Сценарии", Стенды, Сценарии);
КонецФункции

// Паспорта стендов: соответствие Стенд -> структура полей профиля.
Функция ЗагрузитьПаспорта()
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	Т.ПлатформаСервер КАК ПлатформаСервер,
		|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации,
		|	Т.РежимИБ КАК РежимИБ,
		|	Т.СерверЦПУ КАК СерверЦПУ,
		|	Т.СерверПамятьМб КАК СерверПамятьМб,
		|	Т.ИдентификаторСтенда КАК ИдентификаторСтенда,
		|	Т.ВариантРазвёртывания КАК ВариантРазвёртывания,
		|	Т.СУБД КАК СУБД,
		|	Т.ОбъёмИБМб КАК ОбъёмИБМб,
		|	Т.СерверЯдер КАК СерверЯдер,
		|	Т.СерверПотоков КАК СерверПотоков,
		|	Т.Диск КАК Диск,
		|	Т.ДатаПаспорта КАК ДатаПаспорта
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т");
	Паспорта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Паспорта.Вставить(СокрЛП(Выборка.Стенд), Новый Структура(
			"ПлатформаСервер, ВерсияКонфигурации, РежимИБ, СерверЦПУ, СерверПамятьМб,"
			+ "ИдентификаторСтенда, ВариантРазвёртывания, СУБД, ОбъёмИБМб, СерверЯдер,"
			+ "СерверПотоков, Диск, ДатаПаспорта",
			СокрЛП(Выборка.ПлатформаСервер), СокрЛП(Выборка.ВерсияКонфигурации),
			СокрЛП(Выборка.РежимИБ), СокрЛП(Выборка.СерверЦПУ), Выборка.СерверПамятьМб,
			СокрЛП(Выборка.ИдентификаторСтенда), СокрЛП(Выборка.ВариантРазвёртывания),
			СокрЛП(Выборка.СУБД), Выборка.ОбъёмИБМб, Выборка.СерверЯдер,
			Выборка.СерверПотоков, СокрЛП(Выборка.Диск), Выборка.ДатаПаспорта));
	КонецЦикла;
	Возврат Паспорта;
КонецФункции


// Плашка о том, что стенды сравниваются в разных условиях (версия конфигурации,
// режим ИБ, версия платформы): такие дельты нельзя читать как разницу железа.
Функция ПредупреждениеНесопоставимости(ПаспортА, ПаспортБ)

	Если ПаспортА = Неопределено ИЛИ ПаспортБ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Различия = Новый Массив;
	Если СокрЛП(ПаспортА.ВерсияКонфигурации) <> СокрЛП(ПаспортБ.ВерсияКонфигурации) Тогда
		Различия.Добавить("версия конфигурации " + ПаспортА.ВерсияКонфигурации
			+ " и " + ПаспортБ.ВерсияКонфигурации);
	КонецЕсли;
	Если СокрЛП(ПаспортА.РежимИБ) <> СокрЛП(ПаспортБ.РежимИБ) Тогда
		Различия.Добавить("режим ИБ " + ПаспортА.РежимИБ + " и " + ПаспортБ.РежимИБ);
	КонецЕсли;
	Если СокрЛП(ПаспортА.ПлатформаСервер) <> СокрЛП(ПаспортБ.ПлатформаСервер) Тогда
		Различия.Добавить("платформа " + ПаспортА.ПлатформаСервер + " и " + ПаспортБ.ПлатформаСервер);
	КонецЕсли;
	Если Различия.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "<p class='warn'>Стенды замерены в разных условиях: "
		+ Экранировать(СтрСоединить(Различия, "; "))
		+ ". Дельта отражает и эти различия, а не только железо.</p>";

КонецФункции

// Колонки профиля стенда для таблиц: идентификатор, вариант развёртывания, объём ИБ.
Функция ЯчейкиПрофиля(П)
	Если П = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Результат = Новый Массив;
	Результат.Добавить(Ячейка(?(ПустаяСтрока(П.ИдентификаторСтенда), "-", Экранировать(П.ИдентификаторСтенда)), "muted"));
	Результат.Добавить(Ячейка(?(ПустаяСтрока(П.ВариантРазвёртывания), "-", Экранировать(П.ВариантРазвёртывания))));
	Результат.Добавить(Ячейка(?(П.ОбъёмИБМб = 0, "-", ФорматЧисла(П.ОбъёмИБМб, 1)), "num"));
	Возврат Результат;

КонецФункции

// База сравнения: заданная пользователем, затем стенд с «вендор» в имени,
// затем стенд самого свежего замера.
Функция ВыбратьБазовый(Результаты, Заданный)
	Имя = СокрЛП(Заданный);
	Если НЕ ПустаяСтрока(Имя) И Результаты.Получить(Имя) <> Неопределено Тогда
		Возврат Имя;
	КонецЕсли;
	Если Результаты.Получить("вендор 8.3.27") <> Неопределено Тогда
		Возврат "вендор 8.3.27";
	КонецЕсли;
	// Эталон мог быть назван короче ("вендор", "вендор 8.3.27 ...") - ищем по префиксу.
	Для Каждого СтендК Из Результаты Цикл
		Если Найти(НРег(СокрЛП(СтендК.Ключ)), "вендор") = 1 Тогда
			Возврат СокрЛП(СтендК.Ключ);
		КонецЕсли;
	КонецЦикла;
	Лучший = "";
	Позже = Дата(1, 1, 1);
	Для Каждого СтендК Из Результаты Цикл
		Для Каждого СценарийК Из СтендК.Значение Цикл
			Если СценарийК.Значение.ДатаЗамера > Позже Тогда
				Позже = СценарийК.Значение.ДатаЗамера;
				Лучший = СтендК.Ключ;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Лучший;
КонецФункции

// Первый по алфавиту стенд, отличный от базы: стенд сравнения по умолчанию.
Функция ПервыйОтличный(Результаты, База)
	Список = Новый Массив;
	Для Каждого СтендК Из Результаты Цикл
		Если СтендК.Ключ <> База Тогда
			Список.Добавить(СтендК.Ключ);
		КонецЕсли;
	КонецЦикла;
	СортироватьСтроки(Список);
	Возврат ?(Список.Количество() = 0, "", Список[0]);
КонецФункции

// Сводный индекс стенда к базе: среднее отношение «база/стенд» по общим
// сценариям, в процентах. Плюс сценарии с лучшей и худшей дельтой и дата
// последнего замера. Сценарии без пары или с нулевым временем не учитываются.
Процедура РассчитатьИндекс(ДанныеБазы, ДанныеСтенда, Индекс)
	Сумма = 0;
	Количество = 0;
	Индекс.ЛучшийСценарий = "";
	Индекс.ЛучшийДельта = -1000000;
	Индекс.ХудшийСценарий = "";
	Индекс.ХудшийДельта = 1000000;
	Индекс.ПоследнийЗамер = Дата(1, 1, 1);
	Для Каждого СценарийК Из ДанныеСтенда Цикл
		Запись = СценарийК.Значение;
		Если Запись.ДатаЗамера > Индекс.ПоследнийЗамер Тогда
			Индекс.ПоследнийЗамер = Запись.ДатаЗамера;
		КонецЕсли;
		БазаЗапись = ?(ДанныеБазы = Неопределено, Неопределено, ДанныеБазы.Получить(СценарийК.Ключ));
		Если БазаЗапись = Неопределено ИЛИ БазаЗапись.НаЕдиницуМс = 0 ИЛИ Запись.НаЕдиницуМс = 0 Тогда
			Продолжить;
		КонецЕсли;
		Сумма = Сумма + БазаЗапись.НаЕдиницуМс / Запись.НаЕдиницуМс;
		Количество = Количество + 1;
		Дельта = (БазаЗапись.НаЕдиницуМс - Запись.НаЕдиницуМс) / БазаЗапись.НаЕдиницуМс * 100;
		Если Дельта > Индекс.ЛучшийДельта Тогда
			Индекс.ЛучшийДельта = Дельта;
			Индекс.ЛучшийСценарий = СценарийК.Ключ;
		КонецЕсли;
		Если Дельта < Индекс.ХудшийДельта Тогда
			Индекс.ХудшийДельта = Дельта;
			Индекс.ХудшийСценарий = СценарийК.Ключ;
		КонецЕсли;
	КонецЦикла;
	Индекс.Сценариев = Количество;
	Индекс.Индекс = ?(Количество = 0, 0, Окр(Сумма / Количество * 100, 1));
	Если Количество = 0 Тогда
		Индекс.ЛучшийДельта = 0;
		Индекс.ХудшийДельта = 0;
	КонецЕсли;
КонецПроцедуры

// Разброс замера: (Макс - Мин) / Медиана в процентах.
// Больше 20% считается шумным замером (повторять прогон).
Функция ШумЗаписи(Запись)
	Если Запись.МедианаМс = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат (Запись.МаксМс - Запись.МинМс) / Запись.МедианаМс * 100;
КонецФункции

// Сортировка вставками по убыванию индекса: лучшие стенды первыми.
Процедура СортироватьПоИндексу(Список)
	Для Верх = 1 По Список.Количество() - 1 Цикл
		Текущий = Список[Верх];
		Позиция = Верх;
		Пока Позиция > 0 И Список[Позиция - 1].Индекс.Индекс < Текущий.Индекс.Индекс Цикл
			Список[Позиция] = Список[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		Список[Позиция] = Текущий;
	КонецЦикла;
КонецПроцедуры

// Сортировка вставками: худшие (самая отрицательная дельта) первыми.
Процедура СортироватьПоДельте(Список)
	// Худшие (наиболее отрицательная дельта) - первыми.
	Для Верх = 1 По Список.Количество() - 1 Цикл
		Текущий = Список[Верх];
		Позиция = Верх;
		Пока Позиция > 0 И ДельтаЗначение(Список[Позиция - 1].Дельта) > ДельтаЗначение(Текущий.Дельта) Цикл
			Список[Позиция] = Список[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		Список[Позиция] = Текущий;
	КонецЦикла;
КонецПроцедуры

// Сортировка вставками: сначала худшие дельты, внутри равных - по стенду
// и сценарию (устойчивый порядок нужен для одинаковых отчётов).
Процедура СортироватьПоДельтеВозраст(Список)
	// Сначала худшие, затем нейтральные; внутри - по имени стенда и сценария.
	Для Верх = 1 По Список.Количество() - 1 Цикл
		Текущий = Список[Верх];
		Позиция = Верх;
		Пока Позиция > 0 И СравнитьЗамеры(Список[Позиция - 1], Текущий) > 0 Цикл
			Список[Позиция] = Список[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		Список[Позиция] = Текущий;
	КонецЦикла;
КонецПроцедуры

// Компаратор сортировки: сначала дельта, при равенстве - стенд + сценарий.
Функция СравнитьЗамеры(А, Б)
	ДелА = ДельтаЗначение(А.Дельта);
	ДелБ = ДельтаЗначение(Б.Дельта);
	Если ДелА < ДелБ Тогда
		Возврат -1;
	ИначеЕсли ДелА > ДелБ Тогда
		Возврат 1;
	КонецЕсли;
	Если А.Стенд + А.Сценарий < Б.Стенд + Б.Сценарий Тогда
		Возврат -1;
	ИначеЕсли А.Стенд + А.Сценарий > Б.Стенд + Б.Сценарий Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Дельта для сортировки: отсутствующая считается худшей (большое число).
Функция ДельтаЗначение(Значение)
	Возврат ?(Значение = Неопределено, 1000000, Значение);
КонецФункции

// Позиция значения в массиве или -1 (сравнение по значению, а не по ссылке).
Функция НайтиВМассиве(Массив, Значение)
	Для Индекс = 0 По Массив.Количество() - 1 Цикл
		Если Массив[Индекс] = Значение Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;
КонецФункции

// Сортировка вставками строк: стабильный порядок без платформенной Сортировать.
Процедура СортироватьСтроки(Список)
	Для Верх = 1 По Список.Количество() - 1 Цикл
		Текущий = Список[Верх];
		Позиция = Верх;
		Пока Позиция > 0 И Список[Позиция - 1] > Текущий Цикл
			Список[Позиция] = Список[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		Список[Позиция] = Текущий;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область Сеанс

// Текущий сеанс: режим ИБ, стенд этого сеанса и умолчания для настроек отчётов.

// Режим информационной базы текущего сеанса ("Файловый"/"Серверный").
Функция РежимИБТекущий() Экспорт
	Строка = ВРег(СокрЛП(СтрокаСоединенияИнформационнойБазы()));
	Возврат ?(СтрНайти(Строка, "FILE=") > 0, "Файловый", "Серверный");
КонецФункции

// Стенд, соответствующий текущему сеансу: сопоставление паспортов, затем свежий замер,
// затем версия платформы. Пустая строка - сопоставить не удалось и замеров нет.
Функция СтендТекущегоСеанса() Экспорт

	Платформа = СокрЛП(ПерфСценарии.ВерсияПлатформы());
	ВерсияКф = СокрЛП(Метаданные.Версия);
	РежимИБ = РежимИБТекущий();
	Компьютер = СокрЛП(ИмяКомпьютера());

	// Точное совпадение по идентификатору профиля - самый надёжный признак:
	// переживает переименование стенда и не зависит от полноты паспорта.
	Идентификатор = ПерфСценарии.ИдентификаторСтенда();
	Если НЕ ПустаяСтрока(Идентификатор) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Стенд КАК Стенд
			|ИЗ
			|	РегистрСведений.ПерфСтенды КАК Т
			|ГДЕ
			|	Т.ИдентификаторСтенда = &Идентификатор
			|УПОРЯДОЧИТЬ ПО
			|	Т.ДатаПаспорта УБЫВ");
		Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Выборка.Стенд);
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	Т.ВерсияПлатформыСервер КАК ВерсияПлатформыСервер,
		|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации,
		|	Т.РежимИБ КАК РежимИБ,
		|	Т.СерверКомпьютер КАК СерверКомпьютер
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();

	Лучший = "";
	ЛучшийБалл = 0;
	Пока Выборка.Следующий() Цикл
		Балл = 0;
		Если СокрЛП(Выборка.ВерсияПлатформыСервер) = Платформа Тогда
			Балл = Балл + 3;
		КонецЕсли;
		Если СокрЛП(Выборка.РежимИБ) = РежимИБ Тогда
			Балл = Балл + 2;
		КонецЕсли;
		Если НЕ ПустаяСтрока(Компьютер)
			И СокрЛП(Выборка.СерверКомпьютер) = Компьютер Тогда
			Балл = Балл + 2;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ВерсияКф)
			И СокрЛП(Выборка.ВерсияКонфигурации) = ВерсияКф Тогда
			Балл = Балл + 1;
		КонецЕсли;
		Если Балл > ЛучшийБалл Тогда
			ЛучшийБалл = Балл;
			Лучший = СокрЛП(Выборка.Стенд);
		КонецЕсли;
	КонецЦикла;

	Если ЛучшийБалл >= 5 Тогда
		Возврат Лучший;
	КонецЕсли;

	// Запасной вариант: самый свежий замер.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Стенд КАК Стенд,
		|	Т.ДатаЗамера КАК ДатаЗамера
		|ИЗ
		|	РегистрСведений.ПерфРезультаты КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаЗамера УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Стенд);
	КонецЕсли;

	Возврат ?(ПустаяСтрока(Платформа), "", Платформа);
КонецФункции

// Значения текущего сеанса одной структурой (для чипа и диагностики).
Функция ОписаниеСеанса() Экспорт
	С = Новый Структура;
	С.Вставить("Платформа", СокрЛП(ПерфСценарии.ВерсияПлатформы()));
	С.Вставить("ВерсияКонфигурации", СокрЛП(Метаданные.Версия));
	С.Вставить("РежимИБ", РежимИБТекущий());
	С.Вставить("Компьютер", СокрЛП(ИмяКомпьютера()));
	С.Вставить("Пользователь", СокрЛП(ИмяПользователя()));
	С.Вставить("Стенд", СтендТекущегоСеанса());
	Возврат С;
КонецФункции



// Диагностика наполнения регистров: "стенд: результатов N, истории N, паспорт да/нет".
Функция ДиагностикаСтендов() Экспорт

	Данные = ЗагрузитьРезультаты();
	Результаты = Данные.Стенды;
	Паспорта = ЗагрузитьПаспорта();
	Части = Новый Массив;
	Для Каждого СтендК Из Результаты Цикл
		Счет = 0;
		Сценарии = Новый Массив;
		Для Каждого СценК Из СтендК.Значение Цикл
			Счет = Счет + 1;
			Сценарии.Добавить(СценК.Ключ);
		КонецЦикла;
		Части.Добавить(СокрЛП(СтендК.Ключ) + ":рез=" + Счет
			+ ",пасп=" + ?(Паспорта.Получить(СтендК.Ключ) = Неопределено, "нет", "да"));
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	КОЛИЧЕСТВО(*) КАК Счет
		|ИЗ
		|	РегистрСведений.ПерфИстория КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.Стенд");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Части.Добавить("ист:" + СокрЛП(Выборка.Стенд) + "=" + Выборка.Счет);
	КонецЦикла;

	Возврат СтрСоединить(Части, " | ");

КонецФункции

// Стенд, у которого есть записи журнала: заданный (если у него есть записи) или
// стенд последней записи журнала.
Функция СтендСИсторией(Заданный) Экспорт
	Если НЕ ПустаяСтрока(Заданный) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Стенд КАК Стенд
			|ИЗ
			|	РегистрСведений.ПерфИстория КАК Т
			|ГДЕ
			|	Т.Стенд = &Стенд");
		Запрос.УстановитьПараметр("Стенд", СокрЛП(Заданный));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Заданный);
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Стенд КАК Стенд
		|ИЗ
		|	РегистрСведений.ПерфИстория КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаЗамера УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Стенд);
	КонецЕсли;
	Возврат "";
КонецФункции

// Сценарий по умолчанию для истории: худший к базе у стенда, иначе первый в журнале.
Функция СценарийПоУмолчанию(Стенд) Экспорт
	Данные = ЗагрузитьРезультаты();
	База = ВыбратьБазовый(Данные.Стенды, "");
	ДанныеСтенда = Данные.Стенды.Получить(СокрЛП(Стенд));
	ДанныеБазы = Данные.Стенды.Получить(База);
	Если ДанныеСтенда <> Неопределено И ДанныеБазы <> Неопределено И База <> СокрЛП(Стенд) Тогда
		Худший = "";
		ХудшаяДельта = 1000000;
		Для Каждого СценарийК Из Данные.Сценарии Цикл
			Запись = ДанныеСтенда.Получить(СценарийК);
			ЗаписьБазы = ДанныеБазы.Получить(СценарийК);
			Если Запись = Неопределено ИЛИ ЗаписьБазы = Неопределено ИЛИ ЗаписьБазы.НаЕдиницуМс = 0 Тогда
				Продолжить;
			КонецЕсли;
			Дельта = (ЗаписьБазы.НаЕдиницуМс - Запись.НаЕдиницуМс) / ЗаписьБазы.НаЕдиницуМс * 100;
			Если Дельта < ХудшаяДельта Тогда
				ХудшаяДельта = Дельта;
				Худший = СценарийК;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ПустаяСтрока(Худший) Тогда
			Возврат Худший;
		КонецЕсли;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Сценарий КАК Сценарий
		|ИЗ
		|	РегистрСведений.ПерфИстория КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаЗамера УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Сценарий);
	КонецЕсли;
	Возврат ?(Данные.Сценарии.Количество() > 0, Данные.Сценарии[0], "");
КонецФункции

// Структура результата отчёта: HTML + фактически использованные параметры.
Функция РезультатОтчёта(HTML, БазовыйСтенд = "", СтендСравнения = "", Сценарий = "",
	ИмяФормы = "", Настройки = Неопределено) Экспорт
	Сеанс = ОписаниеСеанса();
	// Контент отчёта; каркас (head, меню, тема) собирает ПерфUI.Документ.
	// Поле HTML документа показывает только полный документ, поэтому страница
	// всегда собирается целиком - это делает единый каркас.
	Тело = "<div class='pf-rep-tools'>"
		+ "<span class='lbl'>базовый стенд</span>"
		+ "<input value='" + Экранировать(БазовыйСтенд) + "' data-pf-field='base'>"
		+ "<button class='btn' data-pf='send:refresh'>Сформировать</button>"
		+ "<button class='btn' data-pf='send:reset'>Сбросить к сеансу</button>"
		+ "</div>" + "<div class='pf-body'>" + HTML + "</div>";
	// Стили страницы идут в head через ДопСтили: так каркас (панель, тема)
	// применяется после них, и светлой теме не нужны !important для приоритета.
	Документ = ПерфUI.Документ(ИмяФормы, "ПерфТест - отчёт", Тело, Стили(),
		Ложь, "", "", "", Настройки);
	Возврат Новый Структура("HTML, БазовыйСтенд, СтендСравнения, Сценарий,"
		+ "ТекущийСтенд, ЕстьТекущийСтенд, Платформа, РежимИБ, Компьютер",
		Документ, СокрЛП(БазовыйСтенд), СокрЛП(СтендСравнения), СокрЛП(Сценарий),
		Сеанс.Стенд, НЕ ПустаяСтрока(Сеанс.Стенд), Сеанс.Платформа, Сеанс.РежимИБ,
		Сеанс.Компьютер);
КонецФункции

#КонецОбласти


// Массив имён стендов (для списков выбора на формах).
Функция СписокСтендовМассив() Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.Стенд КАК Стенд
		|ИЗ
		|	РегистрСведений.ПерфРезультаты КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Стенд");
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(СокрЛП(Выборка.Стенд));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Массив кодов сценариев (для списков выбора на формах).
Функция СписокСценариевМассив() Экспорт
	Результат = Новый Массив;
	Для Каждого Строка Из ПерфСценарии.СписокСценариев() Цикл
		Результат.Добавить(СокрЛП(Строка.Имя));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#Область HTML

