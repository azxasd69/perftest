// ПерфОтчетыHTML - сборка HTML-отчетов из регистров ПерфРезультаты, ПерфСтенды, ПерфИстория.
//
// Отчет не хранится: каждый вызов читает регистры и строит самодостаточную страницу
// (стили и скрипты встроены, внешних ресурсов нет - страница открывается из файла).
// Четыре отчета: топ конфигураций, сравнение стендов, история замеров, дашборд.
// Строится на сервере; формы отчетов только показывают готовый HTML в поле документа.
//
// Индекс стенда - среднее отношение «время базы / время стенда» по общим сценариям,
// в процентах (100 - как у базы). Дельта сценария - то же отношение для одного сценария;
// положительная дельта значит «стенд быстрее базы».
//
// Все данные из регистров проходят через Экранировать(): текст пишется в HTML как есть
// и без экранирования ломал бы разметку (или давал XSS при просмотре вне 1С).
#Область ПрограммныйИнтерфейс

// Сборщики четырех отчетов. Каждый возвращает структуру РезультатОтчета:
// HTML плюс фактически использованные параметры (база, стенд сравнения, сценарий),
// по ним формы предзаполняют поля и пишут маркер смоука.

// Топ-100 конфигураций (стендов) по интегральному индексу (ТЗ отчетов §5).
Функция СобратьТопКонфигураций(БазовыйСтенд, Настройки = Неопределено) Экспорт

	Данные = ЗагрузитьРезультаты();
	Результаты = Данные.Стенды;
	Паспорта = ЗагрузитьПаспорта();
	База = ВыбратьБазовый(Результаты, БазовыйСтенд);
	ДанныеБазы = Результаты.Получить(База);

	Рейтинг = Новый Массив;
	Для Каждого СтендК Из Результаты Цикл
		Если СтендК.Ключ = База Тогда
			Продолжить;
		КонецЕсли;
		Индекс = Новый Структура("Индекс, Сценариев, ЛучшийСценарий, ЛучшийДельта,"
			+ "ХудшийСценарий, ХудшийДельта, ПоследнийЗамер");
		РассчитатьИндекс(ДанныеБазы, СтендК.Значение, Индекс);
		Если Индекс.Сценариев = 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Новый Структура("Стенд, Индекс, Паспорт", СтендК.Ключ, Индекс,
			Паспорта.Получить(СтендК.Ключ));
		Рейтинг.Добавить(Строка);
	КонецЦикла;
	СортироватьПоИндексу(Рейтинг);

	Строки = Новый Массив;
	Место = 0;
	СтендСеанса = СтендТекущегоСеанса();
	Для Каждого Элемент Из Рейтинг Цикл
		Место = Место + 1;
		Если Место > 100 Тогда
			Прервать;
		КонецЕсли;
		Инд = Элемент.Индекс;
		П = Элемент.Паспорт;
		Ячейки = Новый Массив;
		Ячейки.Добавить(Ячейка(ФорматЧисла(Место, 0), "n"));
		Ячейки.Добавить(Ячейка(Экранировать(Элемент.Стенд)
			+ ?(СокрЛП(Элемент.Стенд) = СтендСеанса, " *", "")));
		Для Каждого ЯчейкаПрофиля Из ЯчейкиПрофиля(П) Цикл
			Ячейки.Добавить(ЯчейкаПрофиля);
		КонецЦикла;
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", Экранировать(П.ПлатформаСервер))));
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", Экранировать(П.ВерсияКонфигурации))));
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", Экранировать(П.РежимИБ))));
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", Экранировать(П.СерверЦПУ))));
		Ячейки.Добавить(Ячейка(?(П = Неопределено, "-", ФорматЧисла(П.СерверПамятьМб, 0)), "n"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Инд.Сценариев, 0), "n"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Инд.Индекс, 1), "n " + КлассИндекса(Инд.Индекс)));
		Ячейки.Добавить(Ячейка(Экранировать(Инд.ЛучшийСценарий)));
		Ячейки.Добавить(Ячейка(ДельтаТекст(Инд.ЛучшийДельта), "n " + КлассДельты(Инд.ЛучшийДельта)));
		Ячейки.Добавить(Ячейка(Экранировать(Инд.ХудшийСценарий)));
		Ячейки.Добавить(Ячейка(ДельтаТекст(Инд.ХудшийДельта), "n " + КлассДельты(Инд.ХудшийДельта)));
		Ячейки.Добавить(Ячейка(ФорматДаты(Инд.ПоследнийЗамер)));
		Строки.Добавить(Ячейки);
	КонецЦикла;

	Чипы = Новый Массив;
	Чипы.Добавить(Чип("Базовый стенд", База));
	Чипы.Добавить(Чип("Стендов", ФорматЧисла(Результаты.Количество(), 0)));
	Чипы.Добавить(Чип("Сценариев", ФорматЧисла(Данные.Сценарии.Количество(), 0)));
	Чипы.Добавить(Чип("Строк в рейтинге", ФорматЧисла(Строки.Количество(), 0)));

	Заголовки = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Место|Стенд|ID|Развертывание|ИБ, МБ|Платформа|Конфигурация|Режим ИБ|ЦПУ сервера|ОП, МБ|Сцен.|Индекс, %|Лучший сценарий|+%|Худший сценарий|-%|Последний замер", "|") Цикл
		Заголовки.Добавить(Имя);
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
				Возврат РезультатОтчета("Топ-100 конфигураций", Чипы,
			ПустоеСостояние("Пока нечего сравнивать",
				"Нужны замеры минимум на двух стендах: базовом и сравниваемом."),
			"ПерфТопКонфигураций", База);
	КонецЕсли;

	Версии = Новый Массив;
	Для Каждого ЭлементР Из Рейтинг Цикл
		Если ЭлементР.Паспорт <> Неопределено И НайтиВМассиве(Версии, СокрЛП(ЭлементР.Паспорт.ВерсияКонфигурации)) = -1 Тогда
			Версии.Добавить(СокрЛП(ЭлементР.Паспорт.ВерсияКонфигурации));
		КонецЕсли;
	КонецЦикла;
	Плашка = "";
	Если Версии.Количество() > 1 Тогда
		Плашка = ПлиткаПредупреждения("В рейтинге стенды с разными версиями конфигурации ("
			+ Экранировать(СтрСоединить(Версии, ", "))
			+ "): индекс смешивает разницу железа и разницу конфигурации.");
	КонецЕсли;

		Возврат РезультатОтчета("Топ-100 конфигураций", Чипы,
		Плашка + БлокОтчета("Рейтинг стендов", "индекс к базовому стенду",
			Таблица(Заголовки, Строки, Истина),
			"Индекс 100 - уровень базового стенда; больше 100 - быстрее базы. "
			+ "Сравнение по мс на тыс. единиц порции, поэтому порция и число повторов не влияют на рейтинг."),
		"ПерфТопКонфигураций", База, "", "", Настройки);

КонецФункции

// Сравнение двух стендов по сценариям (ТЗ отчетов §4).
Функция СобратьСравнениеСтендов(БазовыйСтенд, СтендСравнения, Настройки = Неопределено) Экспорт

	Данные = ЗагрузитьРезультаты();
	Результаты = Данные.Стенды;
	База = ВыбратьБазовый(Результаты, БазовыйСтенд);
	ДанныеБазы = Результаты.Получить(База);

	Сравниваемый = СокрЛП(СтендСравнения);
	Если Сравниваемый = "" Тогда
		Сравниваемый = СтендТекущегоСеанса();
	КонецЕсли;
	Если Сравниваемый = "" ИЛИ Результаты.Получить(Сравниваемый) = Неопределено
		ИЛИ Сравниваемый = База Тогда
		Сравниваемый = ПервыйОтличный(Результаты, База);
	КонецЕсли;
	ДанныеСтенда = Результаты.Получить(Сравниваемый);

	Паспорта = ЗагрузитьПаспорта();
	ПаспортБазы = Паспорта.Получить(База);
	ПаспортСтенда = Паспорта.Получить(Сравниваемый);

	Чипы = Новый Массив;
	Чипы.Добавить(Чип("База", База));
	Чипы.Добавить(Чип("Сравнение", ?(Сравниваемый = "", "нет второго стенда", Сравниваемый)));
	Если ПаспортБазы <> Неопределено И НЕ ПустаяСтрока(ПаспортБазы.ИдентификаторСтенда) Тогда
		Чипы.Добавить(Чип("ID базы", ПаспортБазы.ИдентификаторСтенда));
	КонецЕсли;
	Если ПаспортСтенда <> Неопределено И НЕ ПустаяСтрока(ПаспортСтенда.ИдентификаторСтенда) Тогда
		Чипы.Добавить(Чип("ID сравнения", ПаспортСтенда.ИдентификаторСтенда));
	КонецЕсли;

	Если ДанныеСтенда = Неопределено ИЛИ ДанныеБазы = Неопределено Тогда
				Возврат РезультатОтчета("Сравнение стендов", Чипы,
			ПустоеСостояние("Нет второго стенда",
				"Сравнение строится по двум стендам. Соберите паспорт и замеры еще на одном стенде."),
			"ПерфСравнениеСтендов", База, Сравниваемый);
	КонецЕсли;

	Заголовки = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Сценарий|Порция|Ед.|База, мс/тыс|Стенд, мс/тыс|Дельта, %|Медиана, мс|Мин-Макс, мс|Шум, %|Стенд: дата", "|") Цикл
		Заголовки.Добавить(Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Сумма = 0;
	Количество = 0;
	Для Каждого СценарийК Из Данные.Сценарии Цикл
		СтендЗапись = ДанныеСтенда.Получить(СценарийК);
		БазаЗапись = ДанныеБазы.Получить(СценарийК);
		Если СтендЗапись = Неопределено И БазаЗапись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ячейки = Новый Массив;
		Ячейки.Добавить(Ячейка(Экранировать(СценарийК)));
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", ФорматЧисла(СтендЗапись.Порция, 0)), "n"));
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", Экранировать(СтендЗапись.Единица))));
		Ячейки.Добавить(Ячейка(?(БазаЗапись = Неопределено, "-", ФорматЧисла(БазаЗапись.НаЕдиницуМс, 3)), "n"));
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", ФорматЧисла(СтендЗапись.НаЕдиницуМс, 3)), "n"));
		Если СтендЗапись = Неопределено ИЛИ БазаЗапись = Неопределено ИЛИ БазаЗапись.НаЕдиницуМс = 0 Тогда
			Ячейки.Добавить(Ячейка("-", "n"));
		Иначе
			Дельта = (БазаЗапись.НаЕдиницуМс - СтендЗапись.НаЕдиницуМс) / БазаЗапись.НаЕдиницуМс * 100;
			Ячейки.Добавить(Ячейка(ДельтаТекст(Дельта), "n " + КлассДельты(Дельта)));
			Сумма = Сумма + БазаЗапись.НаЕдиницуМс / СтендЗапись.НаЕдиницуМс;
			Количество = Количество + 1;
		КонецЕсли;
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", ФорматЧисла(СтендЗапись.МедианаМс, 0)), "n"));
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-",
			ФорматЧисла(СтендЗапись.МинМс, 0) + "-" + ФорматЧисла(СтендЗапись.МаксМс, 0)), "n"));
		Если СтендЗапись = Неопределено Тогда
			Ячейки.Добавить(Ячейка("-", "n"));
		Иначе
			Шум = ШумЗаписи(СтендЗапись);
			Ячейки.Добавить(Ячейка(ФорматЧисла(Шум, 1), "n " + ?(Шум > 20, "warn", "")));
		КонецЕсли;
		Ячейки.Добавить(Ячейка(?(СтендЗапись = Неопределено, "-", ФорматДаты(СтендЗапись.ДатаЗамера))));
		Строки.Добавить(Ячейки);
	КонецЦикла;

	Делитель = ?(Количество = 0, 1, Количество);
	Итог = ?(Количество = 0, "", "Интегральный индекс: "
		+ ФорматЧисла(Сумма / Делитель * 100, 1) + " (по "
		+ ФорматЧисла(Количество, 0) + " сценариям)");

		Примечание = ?(ПустаяСтрока(Итог), "", "<b>" + Экранировать(Итог) + "</b>. ")
		+ "Дельта больше нуля - сравниваемый стенд быстрее базы. "
		+ "Шум больше 20 процентов - замер нестабилен.";
	Возврат РезультатОтчета("Сравнение стендов", Чипы,
		ПлиткаПредупреждения(ПредупреждениеНесопоставимости(ПаспортБазы, ПаспортСтенда))
		+ БлокОтчета("Сценарии", "база против сравниваемого", Таблица(Заголовки, Строки), Примечание),
		"ПерфСравнениеСтендов", База, Сравниваемый, "", Настройки);

КонецФункции

// История замеров по стенду и сценарию (ТЗ отчетов §6).
// Сколько последних замеров показывает история: предел держит отчёт
// дешёвым при росте журнала. Журнал при этом не чистится.
Функция ПределИстории() Экспорт

	Возврат 200;

КонецФункции

Функция СобратьИсториюЗамеров(Стенд, Сценарий, Настройки = Неопределено) Экспорт

	Если ПустаяСтрока(Стенд) Тогда
		Стенд = СтендТекущегоСеанса();
		Если НЕ ПустаяСтрока(Стенд) И СтендСИсторией(Стенд) = "" Тогда
			Стенд = ""; // у стенда сеанса журнала нет - покажем стенд с историей
		КонецЕсли;
		Если ПустаяСтрока(Стенд) Тогда
			Стенд = СтендСИсторией("");
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Сценарий) Тогда
		Сценарий = СценарийПоУмолчанию(Стенд);
	КонецЕсли;

	Предел = ПределИстории();
	Запрос = Новый Запрос;
	Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел + 1, "ЧГ=0") + "
		|	Т.Стенд КАК Стенд,
		|	Т.Сценарий КАК Сценарий,
		|	Т.ДатаЗамера КАК ДатаЗамера,
		|	Т.МедианаМс КАК МедианаМс,
		|	Т.НаЕдиницуМс КАК НаЕдиницуМс,
		|	Т.Порция КАК Порция,
		|	Т.Повторов КАК Повторов,
		|	Т.МинМс КАК МинМс,
		|	Т.МаксМс КАК МаксМс,
		|	Т.Единица КАК Единица
		|ИЗ
		|	РегистрСведений.ПерфИстория КАК Т";

	Условия = Новый Массив;
	Если НЕ ПустаяСтрока(Стенд) Тогда
		Условия.Добавить("Т.Стенд = &Стенд");
		Запрос.УстановитьПараметр("Стенд", СокрЛП(Стенд));
	КонецЕсли;
	Если НЕ ПустаяСтрока(Сценарий) Тогда
		Условия.Добавить("Т.Сценарий = &Сценарий");
		Запрос.УстановитьПараметр("Сценарий", СокрЛП(Сценарий));
	КонецЕсли;
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + " ГДЕ " + СтрСоединить(Условия, " И ");
	КонецЕсли;
	// На экране нужны последние замеры, а не весь журнал: при росте истории
	// полное чтение становится дорогим (аудит 07.11.2026, п.10).
	Текст = Текст + " УПОРЯДОЧИТЬ ПО Т.ДатаЗамера УБЫВ";
	Запрос.Текст = Текст;

	Все = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Все.Добавить(Выборка);
	КонецЦикла;

	// Запись сверх лимита нужна была только чтобы отличить «ровно N» от «больше N».
	Обрезано = Ложь;
	Если Все.Количество() > Предел Тогда
		Обрезано = Истина;
		Все.Удалить(Предел);
	КонецЕсли;
	// Журнал прочитан от новых к старым, на экран идёт хронология.
	// Для ... По не идёт назад: обратный порядок только через индекс.
	ПоВозрастанию = Новый Массив;
	Для Индекс = 0 По Все.Количество() - 1 Цикл
		ПоВозрастанию.Добавить(Все[Все.Количество() - 1 - Индекс]);
	КонецЦикла;
	Все = ПоВозрастанию;

	Чипы = Новый Массив;
	Чипы.Добавить(Чип("Стенд", ?(ПустаяСтрока(Стенд), "все", Стенд)));
	Чипы.Добавить(Чип("Сценарий", ?(ПустаяСтрока(Сценарий), "все", Сценарий)));
	Чипы.Добавить(Чип("Замеров", ФорматЧисла(Все.Количество(), 0)));
	Если Обрезано Тогда
		Чипы.Добавить(Чип("Показано", "последние " + ФорматЧисла(Предел, 0)));
	КонецЕсли;

	Если Все.Количество() = 0 Тогда
				Возврат РезультатОтчета("История замеров", Чипы,
			БлокОтчета("История замеров", "",
				"<div class='empty'>Записей истории нет. Журнал ПерфИстория наполняется "
				+ "при каждом запуске тестов (после версии 1.10).</div>"),
			"ПерфИсторияЗамеров", Стенд, "", Сценарий);
	КонецЕсли;

	Заголовки = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Дата замера|Медиана, мс|Мс/тыс.|Порция|Повторов|Мин-Макс, мс|Шум, %|Дельта к пред., %", "|") Цикл
		Заголовки.Добавить(Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Значения = Новый Массив;
	Предыдущая = Неопределено;
	Шумных = 0;
	СуммаМедиан = 0;
	Минимум = Неопределено;
	Максимум = Неопределено;
	Для Каждого Запись Из Все Цикл
		Ячейки = Новый Массив;
		Ячейки.Добавить(Ячейка(ФорматДаты(Запись.ДатаЗамера)));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.МедианаМс, 0), "n"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.НаЕдиницуМс, 3), "n"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.Порция, 0), "n"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.Повторов, 0), "n"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Запись.МинМс, 0) + "-" + ФорматЧисла(Запись.МаксМс, 0), "n"));
		Шум = 0;
		Если Запись.МедианаМс > 0 Тогда
			Шум = (Запись.МаксМс - Запись.МинМс) / Запись.МедианаМс * 100;
		КонецЕсли;
		Если Шум > 20 Тогда
			Шумных = Шумных + 1;
		КонецЕсли;
		Ячейки.Добавить(Ячейка(ФорматЧисла(Шум, 1), "n " + ?(Шум > 20, "warn", "")));
		Если Предыдущая = Неопределено ИЛИ Предыдущая.МедианаМс = 0 Тогда
			Ячейки.Добавить(Ячейка("-", "n"));
		Иначе
			Дельта = (Предыдущая.МедианаМс - Запись.МедианаМс) / Предыдущая.МедианаМс * 100;
			Ячейки.Добавить(Ячейка(ДельтаТекст(Дельта), "n " + КлассДельты(Дельта)));
		КонецЕсли;
		Строки.Добавить(Ячейки);
		Значения.Добавить(Запись.МедианаМс);
		Предыдущая = Запись;
		СуммаМедиан = СуммаМедиан + Запись.МедианаМс;
		Если Минимум = Неопределено ИЛИ Запись.МедианаМс < Минимум Тогда
			Минимум = Запись.МедианаМс;
		КонецЕсли;
		Если Максимум = Неопределено ИЛИ Запись.МедианаМс > Максимум Тогда
			Максимум = Запись.МедианаМс;
		КонецЕсли;
	КонецЦикла;

	Среднее = СуммаМедиан / Все.Количество();
	Разброс = 0;
	Если Среднее > 0 Тогда
		Разброс = (Максимум - Минимум) / Среднее * 100;
	КонецЕсли;



		График = БлокСпарклайна(Значения, 1080, 80);
	Возврат РезультатОтчета("История замеров", Чипы,
		ПлиткаОтчета("Замеров", ФорматЧисла(Все.Количество(), 0), "",
			?(Обрезано, "показаны последние " + ФорматЧисла(Предел, 0), "весь журнал"), 2)
		+ ПлиткаОтчета("Медиана медиан", ФорматЧисла(Среднее, 0), "мс", "среднее по журналу", 2)
		+ ПлиткаОтчета("Минимум", ФорматЧисла(Минимум, 0), "мс", "лучший замер", 2)
		+ ПлиткаОтчета("Максимум", ФорматЧисла(Максимум, 0), "мс", "худший замер", 2)
		+ ПлиткаОтчета("Разброс", ФорматЧисла(Разброс, 1), "%", "от минимума до максимума", 2)
		+ ПлиткаОтчета("Шумных", ФорматЧисла(Шумных, 0), "", "разброс > 20 %", 2)
		+ ?(ПустаяСтрока(График), "",
			БлокОтчета("Динамика медиан", "от старых замеров к новым", График))
		+ БлокОтчета("Хронология", "последние замеры снизу", Таблица(Заголовки, Строки)),
		"ПерфИсторияЗамеров", Стенд, "", Сценарий, Настройки);

КонецФункции

// Дашборд: карточки стендов, последние замеры, тренд (ТЗ отчетов §7).
Функция СобратьДашборд(БазовыйСтенд, Настройки = Неопределено) Экспорт

	Данные = ЗагрузитьРезультаты();
	Результаты = Данные.Стенды;
	Паспорта = ЗагрузитьПаспорта();
	База = ВыбратьБазовый(Результаты, БазовыйСтенд);
	ДанныеБазы = Результаты.Получить(База);

	Если Результаты.Количество() = 0 Тогда
		ЧипыПусто = Новый Массив;
		ЧипыПусто.Добавить(Чип("стендов", "0"));
		Возврат РезультатОтчета("Дашборд тестов производительности", ЧипыПусто,
			ПустоеСостояние("Замеров еще нет",
				"Запустите сценарии на кокпите: дашборд собирается из записей регистров."),
			"ПерфДашборд", БазовыйСтенд, "", "", Настройки);
	КонецЕсли;

	Карточки = Новый Массив;
	Шумных = 0;
	ВсегоЗамеров = 0;
	Последние = Новый Массив;

	// Стенд текущего сеанса считается один раз: внутри цикла по стендам функция
	// выполняла запросы на каждый стенд (замечание EDT query-in-loop).
	СтендСеанса = СокрЛП(СтендТекущегоСеанса());

	Для Каждого СтендК Из Результаты Цикл
		Индекс = Новый Структура("Индекс, Сценариев, ЛучшийСценарий, ЛучшийДельта,"
			+ "ХудшийСценарий, ХудшийДельта, ПоследнийЗамер");
		РассчитатьИндекс(ДанныеБазы, СтендК.Значение, Индекс);
		П = Паспорта.Получить(СтендК.Ключ);

		Худшие = Новый Массив;
		Для Каждого СценарийК Из Данные.Сценарии Цикл
			Запись = СтендК.Значение.Получить(СценарийК);
			Если Запись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ВсегоЗамеров = ВсегоЗамеров + 1;
			Если ШумЗаписи(Запись) > 20 Тогда
				Шумных = Шумных + 1;
			КонецЕсли;
			Дел = Неопределено;
			БазаЗапись = ?(ДанныеБазы = Неопределено, Неопределено, ДанныеБазы.Получить(СценарийК));
			Если БазаЗапись <> Неопределено И БазаЗапись.НаЕдиницуМс > 0 И СтендК.Ключ <> База Тогда
				Дел = (БазаЗапись.НаЕдиницуМс - Запись.НаЕдиницуМс) / БазаЗапись.НаЕдиницуМс * 100;
			КонецЕсли;
			Худшие.Добавить(Новый Структура("Сценарий, Дельта, Запись", СценарийК, Дел, Запись));
			Последние.Добавить(Новый Структура("Стенд, Сценарий, Запись, Дельта",
				СтендК.Ключ, СценарийК, Запись, Дел));
		КонецЦикла;
		СортироватьПоДельте(Худшие);

		Если Индекс.Индекс >= 100 Тогда
			Цвет = "var(--pf-ok)";
		ИначеЕсли Индекс.Индекс >= 90 Тогда
			Цвет = "var(--pf-warn)";
		Иначе
			Цвет = "var(--pf-bad)";
		КонецЕсли;
		Бары = Новый Массив;
		Счетчик = 0;
		Для Каждого Худший Из Худшие Цикл
			Счетчик = Счетчик + 1;
			Если Счетчик > 3 Тогда
				Прервать;
			КонецЕсли;
			Если Худший.Дельта = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Ширина = ?(Худший.Дельта < 0, -Худший.Дельта, 0);
			Если Ширина > 100 Тогда
				Ширина = 100;
			КонецЕсли;
			Бары.Добавить("<div class='subtle'>"
				+ Экранировать(Худший.Сценарий) + ": " + ДельтаТекст(Худший.Дельта) + "%</div>"
				+ "<div class='track'><i style='width:" + ФорматЧисла(Ширина, 0)
				+ "%;background:" + ?(Худший.Дельта < 0, "var(--pf-bad)", "var(--pf-ok)") + "'></i></div>");
		КонецЦикла;

		Карточки.Добавить("<section class='tile span-6'><div class='lbl'>"
			+ Экранировать(СтендК.Ключ)
			+ ?(СокрЛП(СтендК.Ключ) = СтендСеанса, " <span class='badge'>этот сеанс</span>", "")
			+ ?(П = Неопределено, "", " <span class='badge'>"
				+ Экранировать(П.ПлатформаСервер + " / " + П.РежимИБ) + "</span>")
			+ "</div><div class='big " + ?(Цвет = "var(--pf-ok)", "good", "bad") + "'>"
			+ ?(СтендК.Ключ = База, "база", ФорматЧисла(Индекс.Индекс, 1))
			+ "</div><div class='sub'>" + ФорматЧисла(Индекс.Сценариев, 0) + " из "
			+ ФорматЧисла(Данные.Сценарии.Количество(), 0) + " сценариев, замер "
			+ ФорматДаты(Индекс.ПоследнийЗамер) + "</div>"
			+ СтрСоединить(Бары, "") + "</section>");
	КонецЦикла;

	// Последние замеры: сортировка по дельте (худшие сверху), ограничение 40 строк.
	СортироватьПоДельтеВозраст(Последние);
	Заголовки = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Стенд|Сценарий|Мс/тыс.|Медиана, мс|Дельта к базе, %|Шум, %|Дата", "|") Цикл
		Заголовки.Добавить(Имя);
	КонецЦикла;
	Строки = Новый Массив;
	Счетчик = 0;
	СтендСеанса = СтендТекущегоСеанса();
	Для Каждого Элемент Из Последние Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик > 40 Тогда
			Прервать;
		КонецЕсли;
		Шум = ШумЗаписи(Элемент.Запись);
		Ячейки = Новый Массив;
		Ячейки.Добавить(Ячейка(Экранировать(Элемент.Стенд)
			+ ?(СокрЛП(Элемент.Стенд) = СтендСеанса, " *", "")));
		Ячейки.Добавить(Ячейка(Экранировать(Элемент.Сценарий)));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Элемент.Запись.НаЕдиницуМс, 3), "n"));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Элемент.Запись.МедианаМс, 0), "n"));
		Ячейки.Добавить(Ячейка(?(Элемент.Дельта = Неопределено, "база", ДельтаТекст(Элемент.Дельта)),
			"n " + ?(Элемент.Дельта = Неопределено, "muted", КлассДельты(Элемент.Дельта))));
		Ячейки.Добавить(Ячейка(ФорматЧисла(Шум, 1), "n " + ?(Шум > 20, "warn", "")));
		Ячейки.Добавить(Ячейка(ФорматДаты(Элемент.Запись.ДатаЗамера)));
		Строки.Добавить(Ячейки);
	КонецЦикла;

	Чипы = Новый Массив;
	Чипы.Добавить(Чип("База", База));
	Чипы.Добавить(Чип("Стендов", ФорматЧисла(Результаты.Количество(), 0)));
	Чипы.Добавить(Чип("Замеров", ФорматЧисла(ВсегоЗамеров, 0)));
	Чипы.Добавить(Чип("Шумных", ФорматЧисла(Шумных, 0)));

	Возврат РезультатОтчета("Дашборд тестов производительности", Чипы,
		ПлиткаОтчета("Стендов", ФорматЧисла(Результаты.Количество(), 0), "",
			"в регистре результатов", 3)
		+ ПлиткаОтчета("Замеров", ФорматЧисла(ВсегоЗамеров, 0), "", "всего записей", 3)
		+ ПлиткаОтчета("Сценариев", ФорматЧисла(Данные.Сценарии.Количество(), 0), "",
			"в каталоге тестов", 3)
		+ ПлиткаОтчета("Шумных", ФорматЧисла(Шумных, 0), "",
			"разброс > 20 %", 3)
		+ СтрСоединить(Карточки, "")
		+ БлокОтчета("Последние замеры", "худшие дельты сверху", Таблица(Заголовки, Строки),
			"Построено: " + ФорматДаты(ТекущаяДатаСеанса())),
		"ПерфДашборд", База, "", "", Настройки);

КонецФункции

// Список стендов (для подсказки на формах).
Функция СписокСтендов() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Т.Стенд КАК Стенд ИЗ РегистрСведений.ПерфРезультаты КАК Т УПОРЯДОЧИТЬ ПО Стенд");
	Выборка = Запрос.Выполнить().Выбрать();
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Список.Добавить(СокрЛП(Выборка.Стенд));
	КонецЦикла;
	Возврат СтрСоединить(Список, ", ");
КонецФункции

#КонецОбласти

#Область Данные

// Чтение регистров, сводный индекс стенда, шум замера и сортировки.
// Здесь нет ни одного запроса к ИБ на каждый сценарий: наборы читаются один раз на отчет.

// Все замеры из ПерфРезультаты: соответствие Стенд -> (Сценарий -> запись)
// и отсортированный список сценариев - единый набор для всех отчетов.
// Замер: чтение результатов (регистр + история).
Функция ЗагрузитьРезультаты()

	НачалоМс = ПерфСценарии.ТекущиеМс();
	Результат = ЗагрузитьРезультатыВнутр();
	ПерфСценарии.ЗаписатьМетку("stage:data=" + Формат(ПерфСценарии.ТекущиеМс() - НачалоМс, "ЧГ=0"));
	Возврат Результат;

КонецФункции

Функция ЗагрузитьРезультатыВнутр()
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	Т.Сценарий КАК Сценарий,
		|	Т.НаЕдиницуМс КАК НаЕдиницуМс,
		|	Т.МедианаМс КАК МедианаМс,
		|	Т.Порция КАК Порция,
		|	Т.Повторов КАК Повторов,
		|	Т.МинМс КАК МинМс,
		|	Т.МаксМс КАК МаксМс,
		|	Т.Единица КАК Единица,
		|	Т.ДатаЗамера КАК ДатаЗамера
		|ИЗ
		|	РегистрСведений.ПерфРезультаты КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.Стенд, Т.Сценарий");
	Стенды = Новый Соответствие;
	Сценарии = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стенд = СокрЛП(Выборка.Стенд);
		Сценарий = СокрЛП(Выборка.Сценарий);
		ПоСтенду = Стенды.Получить(Стенд);
		Если ПоСтенду = Неопределено Тогда
			ПоСтенду = Новый Соответствие;
			Стенды.Вставить(Стенд, ПоСтенду);
		КонецЕсли;
		ПоСтенду.Вставить(Сценарий, Новый Структура(
			"НаЕдиницуМс, МедианаМс, Порция, Повторов, МинМс, МаксМс, Единица, ДатаЗамера",
			Выборка.НаЕдиницуМс, Выборка.МедианаМс, Выборка.Порция, Выборка.Повторов,
			Выборка.МинМс, Выборка.МаксМс, СокрЛП(Выборка.Единица), Выборка.ДатаЗамера));
		Если НайтиВМассиве(Сценарии, Сценарий) = -1 Тогда
			Сценарии.Добавить(Сценарий);
		КонецЕсли;
	КонецЦикла;
	СортироватьСтроки(Сценарии);
	Возврат Новый Структура("Стенды, Сценарии", Стенды, Сценарии);
КонецФункции

// Паспорта стендов: соответствие Стенд -> структура полей профиля.
// Замер: чтение паспортов стендов.
Функция ЗагрузитьПаспорта()

	НачалоМс = ПерфСценарии.ТекущиеМс();
	Результат = ЗагрузитьПаспортаВнутр();
	ПерфСценарии.ЗаписатьМетку("stage:passports=" + Формат(ПерфСценарии.ТекущиеМс() - НачалоМс, "ЧГ=0"));
	Возврат Результат;

КонецФункции

Функция ЗагрузитьПаспортаВнутр()
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	Т.ПлатформаСервер КАК ПлатформаСервер,
		|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации,
		|	Т.РежимИБ КАК РежимИБ,
		|	Т.СерверЦПУ КАК СерверЦПУ,
		|	Т.СерверПамятьМб КАК СерверПамятьМб,
		|	Т.ИдентификаторСтенда КАК ИдентификаторСтенда,
		|	Т.ВариантРазвёртывания КАК ВариантРазвёртывания,
		|	Т.СУБД КАК СУБД,
		|	Т.ОбъёмИБМб КАК ОбъёмИБМб,
		|	Т.СерверЯдер КАК СерверЯдер,
		|	Т.СерверПотоков КАК СерверПотоков,
		|	Т.Диск КАК Диск,
		|	Т.ДатаПаспорта КАК ДатаПаспорта
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т");
	Паспорта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Паспорта.Вставить(СокрЛП(Выборка.Стенд), Новый Структура(
			"ПлатформаСервер, ВерсияКонфигурации, РежимИБ, СерверЦПУ, СерверПамятьМб,"
			+ "ИдентификаторСтенда, ВариантРазвёртывания, СУБД, ОбъёмИБМб, СерверЯдер,"
			+ "СерверПотоков, Диск, ДатаПаспорта",
			СокрЛП(Выборка.ПлатформаСервер), СокрЛП(Выборка.ВерсияКонфигурации),
			СокрЛП(Выборка.РежимИБ), СокрЛП(Выборка.СерверЦПУ), Выборка.СерверПамятьМб,
			СокрЛП(Выборка.ИдентификаторСтенда), СокрЛП(Выборка.ВариантРазвёртывания),
			СокрЛП(Выборка.СУБД), Выборка.ОбъёмИБМб, Выборка.СерверЯдер,
			Выборка.СерверПотоков, СокрЛП(Выборка.Диск), Выборка.ДатаПаспорта));
	КонецЦикла;
	Возврат Паспорта;
КонецФункции

// Плашка о том, что стенды сравниваются в разных условиях (версия конфигурации,
// режим ИБ, версия платформы): такие дельты нельзя читать как разницу железа.
Функция ПредупреждениеНесопоставимости(ПаспортА, ПаспортБ)

	Если ПаспортА = Неопределено ИЛИ ПаспортБ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Различия = Новый Массив;
	Если СокрЛП(ПаспортА.ВерсияКонфигурации) <> СокрЛП(ПаспортБ.ВерсияКонфигурации) Тогда
		Различия.Добавить("версия конфигурации " + ПаспортА.ВерсияКонфигурации
			+ " и " + ПаспортБ.ВерсияКонфигурации);
	КонецЕсли;
	Если СокрЛП(ПаспортА.РежимИБ) <> СокрЛП(ПаспортБ.РежимИБ) Тогда
		Различия.Добавить("режим ИБ " + ПаспортА.РежимИБ + " и " + ПаспортБ.РежимИБ);
	КонецЕсли;
	Если СокрЛП(ПаспортА.ПлатформаСервер) <> СокрЛП(ПаспортБ.ПлатформаСервер) Тогда
		Различия.Добавить("платформа " + ПаспортА.ПлатформаСервер + " и " + ПаспортБ.ПлатформаСервер);
	КонецЕсли;
	Если Различия.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Стенды замерены в разных условиях: "
		+ Экранировать(СтрСоединить(Различия, "; "))
		+ ". Дельта отражает и эти различия, а не только железо.";

КонецФункции

// Колонки профиля стенда для таблиц: идентификатор, вариант развертывания, объем ИБ.
Функция ЯчейкиПрофиля(П)
	Если П = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Результат = Новый Массив;
	Результат.Добавить(Ячейка(?(ПустаяСтрока(П.ИдентификаторСтенда), "-", Экранировать(П.ИдентификаторСтенда)), "muted"));
	Результат.Добавить(Ячейка(?(ПустаяСтрока(П.ВариантРазвёртывания), "-", Экранировать(П.ВариантРазвёртывания))));
	Результат.Добавить(Ячейка(?(П.ОбъёмИБМб = 0, "-", ФорматЧисла(П.ОбъёмИБМб, 1)), "n"));
	Возврат Результат;

КонецФункции

// База сравнения: заданная пользователем, затем стенд с «вендор» в имени,
// затем стенд самого свежего замера.
Функция ВыбратьБазовый(Результаты, Заданный)
	Имя = СокрЛП(Заданный);
	Если НЕ ПустаяСтрока(Имя) И Результаты.Получить(Имя) <> Неопределено Тогда
		Возврат Имя;
	КонецЕсли;
	Если Результаты.Получить("вендор 8.3.27") <> Неопределено Тогда
		Возврат "вендор 8.3.27";
	КонецЕсли;
	// Эталон мог быть назван короче ("вендор", "вендор 8.3.27 ...") - ищем по префиксу.
	Для Каждого СтендК Из Результаты Цикл
		Если СтрНайти(НРег(СокрЛП(СтендК.Ключ)), "вендор") = 1 Тогда
			Возврат СокрЛП(СтендК.Ключ);
		КонецЕсли;
	КонецЦикла;
	Лучший = "";
	Позже = Дата(1, 1, 1);
	Для Каждого СтендК Из Результаты Цикл
		Для Каждого СценарийК Из СтендК.Значение Цикл
			Если СценарийК.Значение.ДатаЗамера > Позже Тогда
				Позже = СценарийК.Значение.ДатаЗамера;
				Лучший = СтендК.Ключ;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Лучший;
КонецФункции

// Первый по алфавиту стенд, отличный от базы: стенд сравнения по умолчанию.
Функция ПервыйОтличный(Результаты, База)
	Список = Новый Массив;
	Для Каждого СтендК Из Результаты Цикл
		Если СтендК.Ключ <> База Тогда
			Список.Добавить(СтендК.Ключ);
		КонецЕсли;
	КонецЦикла;
	СортироватьСтроки(Список);
	Возврат ?(Список.Количество() = 0, "", Список[0]);
КонецФункции

// Сводный индекс стенда к базе: среднее отношение «база/стенд» по общим
// сценариям, в процентах. Плюс сценарии с лучшей и худшей дельтой и дата
// последнего замера. Сценарии без пары или с нулевым временем не учитываются.
Процедура РассчитатьИндекс(ДанныеБазы, ДанныеСтенда, Индекс)
	Сумма = 0;
	Количество = 0;
	Индекс.ЛучшийСценарий = "";
	Индекс.ЛучшийДельта = -1000000;
	Индекс.ХудшийСценарий = "";
	Индекс.ХудшийДельта = 1000000;
	Индекс.ПоследнийЗамер = Дата(1, 1, 1);
	Для Каждого СценарийК Из ДанныеСтенда Цикл
		Запись = СценарийК.Значение;
		Если Запись.ДатаЗамера > Индекс.ПоследнийЗамер Тогда
			Индекс.ПоследнийЗамер = Запись.ДатаЗамера;
		КонецЕсли;
		БазаЗапись = ?(ДанныеБазы = Неопределено, Неопределено, ДанныеБазы.Получить(СценарийК.Ключ));
		Если БазаЗапись = Неопределено ИЛИ БазаЗапись.НаЕдиницуМс = 0 ИЛИ Запись.НаЕдиницуМс = 0 Тогда
			Продолжить;
		КонецЕсли;
		Сумма = Сумма + БазаЗапись.НаЕдиницуМс / Запись.НаЕдиницуМс;
		Количество = Количество + 1;
		Дельта = (БазаЗапись.НаЕдиницуМс - Запись.НаЕдиницуМс) / БазаЗапись.НаЕдиницуМс * 100;
		Если Дельта > Индекс.ЛучшийДельта Тогда
			Индекс.ЛучшийДельта = Дельта;
			Индекс.ЛучшийСценарий = СценарийК.Ключ;
		КонецЕсли;
		Если Дельта < Индекс.ХудшийДельта Тогда
			Индекс.ХудшийДельта = Дельта;
			Индекс.ХудшийСценарий = СценарийК.Ключ;
		КонецЕсли;
	КонецЦикла;
	Индекс.Сценариев = Количество;
	Индекс.Индекс = ?(Количество = 0, 0, Окр(Сумма / Количество * 100, 1));
	Если Количество = 0 Тогда
		Индекс.ЛучшийДельта = 0;
		Индекс.ХудшийДельта = 0;
	КонецЕсли;
КонецПроцедуры

// Разброс замера: (Макс - Мин) / Медиана в процентах.
// Больше 20% считается шумным замером (повторять прогон).
Функция ШумЗаписи(Запись)
	Если Запись.МедианаМс = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат (Запись.МаксМс - Запись.МинМс) / Запись.МедианаМс * 100;
КонецФункции

// Сортировка вставками по убыванию индекса: лучшие стенды первыми.
Процедура СортироватьПоИндексу(Список)
	Для Верх = 1 По Список.Количество() - 1 Цикл
		Текущий = Список[Верх];
		Позиция = Верх;
		Пока Позиция > 0 И Список[Позиция - 1].Индекс.Индекс < Текущий.Индекс.Индекс Цикл
			Список[Позиция] = Список[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		Список[Позиция] = Текущий;
	КонецЦикла;
КонецПроцедуры

// Сортировка вставками: худшие (самая отрицательная дельта) первыми.
Процедура СортироватьПоДельте(Список)
	// Худшие (наиболее отрицательная дельта) - первыми.
	Для Верх = 1 По Список.Количество() - 1 Цикл
		Текущий = Список[Верх];
		Позиция = Верх;
		Пока Позиция > 0 И ДельтаЗначение(Список[Позиция - 1].Дельта) > ДельтаЗначение(Текущий.Дельта) Цикл
			Список[Позиция] = Список[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		Список[Позиция] = Текущий;
	КонецЦикла;
КонецПроцедуры

// Сортировка вставками: сначала худшие дельты, внутри равных - по стенду
// и сценарию (устойчивый порядок нужен для одинаковых отчетов).
Процедура СортироватьПоДельтеВозраст(Список)
	// Сначала худшие, затем нейтральные; внутри - по имени стенда и сценария.
	Для Верх = 1 По Список.Количество() - 1 Цикл
		Текущий = Список[Верх];
		Позиция = Верх;
		Пока Позиция > 0 И СравнитьЗамеры(Список[Позиция - 1], Текущий) > 0 Цикл
			Список[Позиция] = Список[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		Список[Позиция] = Текущий;
	КонецЦикла;
КонецПроцедуры

// Компаратор сортировки: сначала дельта, при равенстве - стенд + сценарий.
Функция СравнитьЗамеры(А, Б)
	ДелА = ДельтаЗначение(А.Дельта);
	ДелБ = ДельтаЗначение(Б.Дельта);
	Если ДелА < ДелБ Тогда
		Возврат -1;
	ИначеЕсли ДелА > ДелБ Тогда
		Возврат 1;
	КонецЕсли;
	Если А.Стенд + А.Сценарий < Б.Стенд + Б.Сценарий Тогда
		Возврат -1;
	ИначеЕсли А.Стенд + А.Сценарий > Б.Стенд + Б.Сценарий Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Дельта для сортировки: отсутствующая считается худшей (большое число).
Функция ДельтаЗначение(Значение)
	Возврат ?(Значение = Неопределено, 1000000, Значение);
КонецФункции

// Позиция значения в массиве или -1 (сравнение по значению, а не по ссылке).
Функция НайтиВМассиве(Массив, Значение)
	Для Индекс = 0 По Массив.Количество() - 1 Цикл
		Если Массив[Индекс] = Значение Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;
КонецФункции

// Сортировка вставками строк: стабильный порядок без платформенной Сортировать.
Процедура СортироватьСтроки(Список)
	Для Верх = 1 По Список.Количество() - 1 Цикл
		Текущий = Список[Верх];
		Позиция = Верх;
		Пока Позиция > 0 И Список[Позиция - 1] > Текущий Цикл
			Список[Позиция] = Список[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		Список[Позиция] = Текущий;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область Сеанс

// Текущий сеанс: режим ИБ, стенд этого сеанса и умолчания для настроек отчетов.

// Режим информационной базы текущего сеанса ("Файловый"/"Серверный").
Функция РежимИБТекущий() Экспорт
	Строка = ВРег(СокрЛП(СтрокаСоединенияИнформационнойБазы()));
	Возврат ?(СтрНайти(Строка, "FILE=") > 0, "Файловый", "Серверный");
КонецФункции

// Стенд, соответствующий текущему сеансу: сопоставление паспортов, затем свежий замер,
// затем версия платформы. Пустая строка - сопоставить не удалось и замеров нет.
// Замер: стенд текущего сеанса (исторически - полный WMI-сбор).
Функция СтендТекущегоСеанса() Экспорт

	НачалоМс = ПерфСценарии.ТекущиеМс();
	Результат = СтендТекущегоСеансаВнутр();
	ПерфСценарии.ЗаписатьМетку("stage:session=" + Формат(ПерфСценарии.ТекущиеМс() - НачалоМс, "ЧГ=0"));
	Возврат Результат;

КонецФункции

Функция СтендТекущегоСеансаВнутр() Экспорт

	Платформа = СокрЛП(ПерфСценарии.ВерсияПлатформы());
	ВерсияКф = СокрЛП(Метаданные.Версия);
	РежимИБ = РежимИБТекущий();
	Компьютер = СокрЛП(ИмяКомпьютера());

	// Точное совпадение по идентификатору профиля - самый надежный признак:
	// переживает переименование стенда и не зависит от полноты паспорта.
	Идентификатор = ПерфСценарии.ИдентификаторСтендаИзРегистра();
	Если НЕ ПустаяСтрока(Идентификатор) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Стенд КАК Стенд
			|ИЗ
			|	РегистрСведений.ПерфСтенды КАК Т
			|ГДЕ
			|	Т.ИдентификаторСтенда = &Идентификатор
			|УПОРЯДОЧИТЬ ПО
			|	Т.ДатаПаспорта УБЫВ");
		Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Выборка.Стенд);
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	Т.ВерсияПлатформыСервер КАК ВерсияПлатформыСервер,
		|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации,
		|	Т.РежимИБ КАК РежимИБ,
		|	Т.СерверКомпьютер КАК СерверКомпьютер
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();

	Лучший = "";
	ЛучшийБалл = 0;
	Пока Выборка.Следующий() Цикл
		Балл = 0;
		Если СокрЛП(Выборка.ВерсияПлатформыСервер) = Платформа Тогда
			Балл = Балл + 3;
		КонецЕсли;
		Если СокрЛП(Выборка.РежимИБ) = РежимИБ Тогда
			Балл = Балл + 2;
		КонецЕсли;
		Если НЕ ПустаяСтрока(Компьютер)
			И СокрЛП(Выборка.СерверКомпьютер) = Компьютер Тогда
			Балл = Балл + 2;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ВерсияКф)
			И СокрЛП(Выборка.ВерсияКонфигурации) = ВерсияКф Тогда
			Балл = Балл + 1;
		КонецЕсли;
		Если Балл > ЛучшийБалл Тогда
			ЛучшийБалл = Балл;
			Лучший = СокрЛП(Выборка.Стенд);
		КонецЕсли;
	КонецЦикла;

	Если ЛучшийБалл >= 5 Тогда
		Возврат Лучший;
	КонецЕсли;

	// Запасной вариант: самый свежий замер.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Стенд КАК Стенд,
		|	Т.ДатаЗамера КАК ДатаЗамера
		|ИЗ
		|	РегистрСведений.ПерфРезультаты КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаЗамера УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Стенд);
	КонецЕсли;

	Возврат ?(ПустаяСтрока(Платформа), "", Платформа);
КонецФункции

// Значения текущего сеанса одной структурой (для чипа и диагностики).
// Замер: описание сеанса (внутри - стенд текущего сеанса, исторически WMI).
Функция ОписаниеСеанса() Экспорт

	НачалоМс = ПерфСценарии.ТекущиеМс();
	Результат = ОписаниеСеансаВнутр();
	ПерфСценарии.ЗаписатьМетку("stage:desc=" + Формат(ПерфСценарии.ТекущиеМс() - НачалоМс, "ЧГ=0"));
	Возврат Результат;

КонецФункции

Функция ОписаниеСеансаВнутр() Экспорт
	С = Новый Структура;
	С.Вставить("Платформа", СокрЛП(ПерфСценарии.ВерсияПлатформы()));
	С.Вставить("ВерсияКонфигурации", СокрЛП(Метаданные.Версия));
	С.Вставить("РежимИБ", РежимИБТекущий());
	С.Вставить("Компьютер", СокрЛП(ИмяКомпьютера()));
	С.Вставить("Пользователь", СокрЛП(ИмяПользователя()));
	С.Вставить("Стенд", СтендТекущегоСеанса());
	Возврат С;
КонецФункции

// Диагностика наполнения регистров: "стенд: результатов N, истории N, паспорт да/нет".
Функция ДиагностикаСтендов() Экспорт

	Данные = ЗагрузитьРезультаты();
	Результаты = Данные.Стенды;
	Паспорта = ЗагрузитьПаспорта();
	Части = Новый Массив;
	Для Каждого СтендК Из Результаты Цикл
		Счет = 0;
		Сценарии = Новый Массив;
		Для Каждого СценК Из СтендК.Значение Цикл
			Счет = Счет + 1;
			Сценарии.Добавить(СценК.Ключ);
		КонецЦикла;
		Части.Добавить(СокрЛП(СтендК.Ключ) + ":рез=" + Счет
			+ ",пасп=" + ?(Паспорта.Получить(СтендК.Ключ) = Неопределено, "нет", "да"));
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Стенд КАК Стенд,
		|	КОЛИЧЕСТВО(*) КАК Счет
		|ИЗ
		|	РегистрСведений.ПерфИстория КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.Стенд");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Части.Добавить("ист:" + СокрЛП(Выборка.Стенд) + "=" + Выборка.Счет);
	КонецЦикла;

	Возврат СтрСоединить(Части, " | ");

КонецФункции

// Стенд, у которого есть записи журнала: заданный (если у него есть записи) или
// стенд последней записи журнала.
Функция СтендСИсторией(Заданный) Экспорт
	Если НЕ ПустаяСтрока(Заданный) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Стенд КАК Стенд
			|ИЗ
			|	РегистрСведений.ПерфИстория КАК Т
			|ГДЕ
			|	Т.Стенд = &Стенд");
		Запрос.УстановитьПараметр("Стенд", СокрЛП(Заданный));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Заданный);
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Стенд КАК Стенд
		|ИЗ
		|	РегистрСведений.ПерфИстория КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаЗамера УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Стенд);
	КонецЕсли;
	Возврат "";
КонецФункции

// Сценарий по умолчанию для истории: худший к базе у стенда, иначе первый в журнале.
Функция СценарийПоУмолчанию(Стенд) Экспорт
	Данные = ЗагрузитьРезультаты();
	База = ВыбратьБазовый(Данные.Стенды, "");
	ДанныеСтенда = Данные.Стенды.Получить(СокрЛП(Стенд));
	ДанныеБазы = Данные.Стенды.Получить(База);
	Если ДанныеСтенда <> Неопределено И ДанныеБазы <> Неопределено И База <> СокрЛП(Стенд) Тогда
		Худший = "";
		ХудшаяДельта = 1000000;
		Для Каждого СценарийК Из Данные.Сценарии Цикл
			Запись = ДанныеСтенда.Получить(СценарийК);
			ЗаписьБазы = ДанныеБазы.Получить(СценарийК);
			Если Запись = Неопределено ИЛИ ЗаписьБазы = Неопределено ИЛИ ЗаписьБазы.НаЕдиницуМс = 0 Тогда
				Продолжить;
			КонецЕсли;
			Дельта = (ЗаписьБазы.НаЕдиницуМс - Запись.НаЕдиницуМс) / ЗаписьБазы.НаЕдиницуМс * 100;
			Если Дельта < ХудшаяДельта Тогда
				ХудшаяДельта = Дельта;
				Худший = СценарийК;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ПустаяСтрока(Худший) Тогда
			Возврат Худший;
		КонецЕсли;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Сценарий КАК Сценарий
		|ИЗ
		|	РегистрСведений.ПерфИстория КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаЗамера УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Сценарий);
	КонецЕсли;
	Возврат ?(Данные.Сценарии.Количество() > 0, Данные.Сценарии[0], "");
КонецФункции

// Структура результата отчета: HTML + фактически использованные параметры.
// Версия данных для кэша страниц: количество и последняя дата в трёх регистрах.
// Один пакетный запрос; страница пересобирается только при изменении данных.
Функция ВерсияДанных() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего, МАКСИМУМ(ДатаЗамера) КАК Последняя
		|ИЗ РегистрСведений.ПерфРезультаты
		|;
		|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего, МАКСИМУМ(ДатаЗамера) КАК Последняя
		|ИЗ РегистрСведений.ПерфИстория
		|;
		|ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего, МАКСИМУМ(ДатаПаспорта) КАК Последняя
		|ИЗ РегистрСведений.ПерфСтенды");
	Части = Новый Массив;
	Для Каждого РезультатПакета Из Запрос.ВыполнитьПакет() Цикл
		ВыборкаПакета = РезультатПакета.Выбрать();
		Если ВыборкаПакета.Следующий() Тогда
			Последняя = ?(ЗначениеЗаполнено(ВыборкаПакета.Последняя),
				Формат(ВыборкаПакета.Последняя, "ДФ=yyyyMMddHHmmss"), "0");
			Части.Добавить(Строка(ВыборкаПакета.Всего) + "/" + Последняя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ";");

КонецФункции

// Ключ страницы: форма, версия конфигурации, версия настроек оформления,
// версия данных и параметры запроса. Совпал ключ - страницу можно не собирать.
Функция КлючСтраницы(Имя, Доп = "") Экспорт

	Возврат Имя + "|" + Метаданные.Версия + "|" + ПерфUI.ВерсияНастроек()
		+ "|" + ВерсияДанных() + "|" + Доп;

КонецФункции

// Метка кэша в готовом HTML: комментарий не виден и не влияет на разметку.
Функция МеткаКэша(Ключ) Экспорт

	Возврат "<!--pf-key:" + Ключ + "-->";

КонецФункции

// Совпадает ли метка в готовой странице с текущим ключом.
Функция КэшПопадание(HTML, Ключ) Экспорт

	Возврат НЕ ПустаяСтрока(HTML) И СтрНайти(HTML, МеткаКэша(Ключ)) > 0;

КонецФункции

// Самопроверка кэша для автопрогона: попадание по своей метке и промах по чужой.
Функция СамопроверкаКэша() Экспорт

	Ключ = КлючСтраницы("Самопроверка", "тест");
	Страница = "<html></html>" + МеткаКэша(Ключ);
	// Ключ должен быть детерминированным: иначе кэш не сработает ни разу.
	Возврат КэшПопадание(Страница, Ключ) И НЕ КэшПопадание(Страница, Ключ + "x")
		И Ключ = КлючСтраницы("Самопроверка", "тест");

КонецФункции

Функция РезультатОтчета(Заголовок, Чипы, Содержимое, ИмяФормы, БазовыйСтенд = "",
	СтендСравнения = "", Сценарий = "", Настройки = Неопределено) Экспорт

	Сеанс = ОписаниеСеанса();
	// Каркас один на все отчеты: бар кокпита, контент в bento, тема и меню.
	// Чип сеанса и ID профиля добавляются здесь, чтобы сборщики о них не думали.
	Все = Новый Массив;
	Для Каждого Элемент Из Чипы Цикл
		Все.Добавить(Элемент);
	КонецЦикла;
	Все.Добавить(Чип("сеанс", Сеанс.Платформа + " / " + Сеанс.РежимИБ
		+ ?(ПустаяСтрока(Сеанс.Стенд), "", " / " + Сеанс.Стенд)));
	ИдПрофиля = ПерфСценарии.ИдентификаторСтендаИзРегистра();
	Если НЕ ПустаяСтрока(ИдПрофиля) Тогда
		Все.Добавить(Чип("ID профиля", ИдПрофиля));
	КонецЕсли;

	Тело = БарОтчета(Заголовок, Все, БазовыйСтенд)
		+ "<main class='bento'>" + Содержимое + "</main>";
	// Поле HTML документа показывает только полный документ, поэтому страница
	// всегда собирается целиком - это делает единый каркас.
	Документ = ПерфUI.Документ(ИмяФормы, "ПерфТест - " + СокрЛП(Заголовок), Тело,
		ПерфUI.СтилиОтчетов(), Ложь, "wrap", "", "", Настройки);
	Возврат Новый Структура("HTML, БазовыйСтенд, СтендСравнения, Сценарий,"
		+ "ТекущийСтенд, ЕстьТекущийСтенд, Платформа, РежимИБ, Компьютер",
		Документ, СокрЛП(БазовыйСтенд), СокрЛП(СтендСравнения), СокрЛП(Сценарий),
		Сеанс.Стенд, НЕ ПустаяСтрока(Сеанс.Стенд), Сеанс.Платформа, Сеанс.РежимИБ,
		Сеанс.Компьютер);

КонецФункции

#КонецОбласти

// Массив имен стендов (для списков выбора на формах).
Функция СписокСтендовМассив() Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.Стенд КАК Стенд
		|ИЗ
		|	РегистрСведений.ПерфРезультаты КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Стенд");
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(СокрЛП(Выборка.Стенд));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Массив кодов сценариев (для списков выбора на формах).
Функция СписокСценариевМассив() Экспорт
	Результат = Новый Массив;
	Для Каждого Строка Из ПерфСценарии.СписокСценариев() Цикл
		Результат.Добавить(СокрЛП(Строка.Имя));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#Область HTML

// Пустое состояние: плитка с заголовком и действием вместо строки текста.
Функция ПустоеСостояние(Заголовок, Пояснение)

	Возврат "<section class='tile span-12'><div class='log-head'><h2>" + Экранировать(Заголовок)
		+ "</h2></div><div class='empty'>" + Экранировать(Пояснение) + "</div>"
		+ "<button class='btn primary' data-pf='open:НачальнаяСтраница'>Открыть кокпит</button></section>";

КонецФункции

// Примитивы разметки и форматирования. Все, что попадает в HTML из данных,
// проходит через Экранировать() - иначе разметка ломается.


// Шапка отчета: бар кокпита (бренд, крошки, поле базового стенда, кнопки)
// и ряд чипов-бейджей под ним.
Функция БарОтчета(Заголовок, Чипы, БазовыйСтенд)

	НачалоМс = ПерфСценарии.ТекущиеМс();
	Части = Новый Массив;
	Части.Добавить("<header class='bar'>");
	Части.Добавить("<div class='bar-row'>");
	Части.Добавить("<div class='brand'><span class='pulse'></span>ПерфТест<span class='ver'>"
		+ Экранировать(Метаданные.Версия) + "</span></div>");
	Части.Добавить("<div class='crumbles'><span>отчеты</span><span>"
		+ Экранировать(Заголовок) + "</span></div>");
	Части.Добавить("<span class='grow'></span>");
	Части.Добавить("<label class='field'><span>базовый стенд</span>"
		+ "<input class='stand-input' value='" + Экранировать(БазовыйСтенд)
		+ "' spellcheck='false' data-pf-field='base'></label>");
	Части.Добавить("<button class='btn' data-pf='send:refresh'>Сформировать</button>");
	Части.Добавить("<button class='btn kbd' data-pf='send:reset'>Сбросить к сеансу</button>");
	Части.Добавить("</div>");
	Части.Добавить("<div class='bar-row'><span class='chips'>");
	Для Каждого Элемент Из Чипы Цикл
		Части.Добавить(Элемент);
	КонецЦикла;
	Части.Добавить("</span></div></header>");
	// Шапка исторически самый дорогой участок (WMI): замер сохранен.
	ПерфСценарии.ЗаписатьМетку("stage:header=" + Формат(ПерфСценарии.ТекущиеМс() - НачалоМс, "ЧГ=0"));
	Возврат СтрСоединить(Части, "");

КонецФункции

// Чип «подпись + значение» - бейдж кокпита.
Функция Чип(Заголовок, Значение)
	Возврат "<span class='badge'><span class='subtle'>" + Экранировать(Заголовок) + "</span> "
		+ Экранировать(Значение) + "</span>";
КонецФункции

// Плитка KPI: те же плитки, что в верхней строке кокпита.
Функция ПлиткаОтчета(Подпись, Значение, Единица, Пояснение, Ширина = 3)

	Возврат "<section class='tile span-" + Ширина + "'><div class='lbl'>" + Экранировать(Подпись)
		+ "</div><div class='big'>" + Экранировать(Значение)
		+ ?(ПустаяСтрока(Единица), "", "<small> " + Экранировать(Единица) + "</small>")
		+ "</div><div class='sub'>" + Экранировать(Пояснение) + "</div></section>";

КонецФункции

// Плитка предупреждения: текст без разметки; пустая строка - ничего не выводим.
Функция ПлиткаПредупреждения(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "<section class='tile span-12'><div class='warn'>" + Текст + "</div></section>";

КонецФункции

// Плитка с заголовком в стиле кокпита; Содержимое и Примечание - готовая разметка.
Функция БлокОтчета(Заголовок, Подзаголовок, Содержимое, Примечание = "", Ширина = 12)

	Части = Новый Массив;
	Части.Добавить("<section class='tile span-" + Ширина + "'><div class='log-head'><h2>"
		+ Экранировать(Заголовок) + "</h2>"
		+ ?(ПустаяСтрока(Подзаголовок), "", "<span>" + Экранировать(Подзаголовок) + "</span>")
		+ "</div>" + Содержимое);
	Если НЕ ПустаяСтрока(Примечание) Тогда
		Части.Добавить("<div class='foot'>" + Примечание + "</div>");
	КонецЕсли;
	Части.Добавить("</section>");
	Возврат СтрСоединить(Части, "");

КонецФункции

// Ячейка таблицы: текст и необязательный CSS-класс. Текст не экранируется -
// экранировать должен тот, кто его формирует.
Функция Ячейка(Текст, Класс = "")
	Возврат Новый Структура("Текст, Класс", Текст, Класс);
КонецФункции

// HTML-таблица из заголовков и строк вида Массив(Ячейка(), ...).
Функция Таблица(Заголовки, Строки, Плотная = Ложь)
	Ч = Новый Массив;
	Ч.Добавить("<table><thead><tr>");
	Для Каждого Заголовок Из Заголовки Цикл
		Ч.Добавить("<th>" + Экранировать(Заголовок) + "</th>");
	КонецЦикла;
	Ч.Добавить("</tr></thead><tbody>");
	Для Каждого Строка Из Строки Цикл
		Ч.Добавить("<tr>");
		Для Каждого Ячейка Из Строка Цикл
			Если ПустаяСтрока(Ячейка.Класс) Тогда
				Ч.Добавить("<td>" + Ячейка.Текст + "</td>");
			Иначе
				Ч.Добавить("<td class='" + Экранировать(Ячейка.Класс) + "'>" + Ячейка.Текст + "</td>");
			КонецЕсли;
		КонецЦикла;
		Ч.Добавить("</tr>");
	КонецЦикла;
	Ч.Добавить("</tbody></table>");
	// Широкая таблица прокручивается внутри плитки, а не растягивает страницу.
	Возврат "<div class='tw" + ?(Плотная, " tw-wide", "") + "'>"
		+ СтрСоединить(Ч, "") + "</div>";
КонецФункции

// Спарклайн в обертке: пустой график не оставляет рамку на странице.
Функция БлокСпарклайна(Значения, Ширина, Высота)

	График = Спарклайн(Значения, Ширина, Высота);
	Если ПустаяСтрока(График) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "<div class='spark'>" + График + "</div>";

КонецФункции

// Инлайн-SVG спарклайн по значениям: ширина и высота в пикселях, без библиотек.
// Пустые значения рисуются как разрыв.
Функция Спарклайн(Значения, Ширина = 720, Высота = 60)
	Если Значения.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	Минимум = Значения[0];
	Максимум = Значения[0];
	Для Каждого Элемент Из Значения Цикл
		Если Элемент < Минимум Тогда
			Минимум = Элемент;
		КонецЕсли;
		Если Элемент > Максимум Тогда
			Максимум = Элемент;
		КонецЕсли;
	КонецЦикла;
	Разница = Максимум - Минимум;
	Если Разница = 0 Тогда
		Разница = 1;
	КонецЕсли;
	Точки = Новый Массив;
	Шаг = Ширина / (Значения.Количество() - 1);
	Для Индекс = 0 По Значения.Количество() - 1 Цикл
		Х = Окр(Индекс * Шаг, 1);
		Y = Окр(Высота - 6 - (Значения[Индекс] - Минимум) / Разница * (Высота - 12), 1);
		Точки.Добавить(ФорматЧисла(Х, 1) + "," + ФорматЧисла(Y, 1));
	КонецЦикла;
	Возврат "<svg width='" + ФорматЧисла(Ширина, 0) + "' height='" + ФорматЧисла(Высота, 0)
		+ "'><polyline fill='none' stroke='var(--pf-info)' stroke-width='2' points='"
		+ СтрСоединить(Точки, " ") + "'/></svg>";
КонецФункции

// Экранирование HTML: &, <, >, кавычки. Применяется ко всем данным из регистров
// и к пользовательским именам стендов.
Функция Экранировать(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Результат = Строка(Значение);
	// Порядок важен: амперсанд первым, иначе экранируются амперсанды своих же замен.
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");
	Возврат Результат;
КонецФункции

// Число с разделителями разрядов и заданным числом знаков; Неопределено - «-».
Функция ФорматЧисла(Значение, Знаков = 0)
	Если Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;
	Результат = Формат(Значение, "ЧДЦ=" + Строка(Знаков) + "; ЧГ=0");
	Если ПустаяСтрока(Результат) Тогда
		// Для нуля формат с ЧГ=0 отдает пустую строку - собираем нули вручную
		// (СтрПовторить в 8.3.27.2342 отсутствует).
		Нули = "";
		Для НомерЗнака = 1 По Знаков Цикл
			Нули = Нули + "0";
		КонецЦикла;
		Результат = "0" + ?(Знаков > 0, "," + Нули, "");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Дата в формате ДЛФ=DT; пустая дата (0001-01-01) - «-».
Функция ФорматДаты(Значение)
	Если Значение = Неопределено ИЛИ Значение = Дата(1, 1, 1) Тогда
		Возврат "-";
	КонецЕсли;
	Возврат Формат(Значение, "ДЛФ=DT");
КонецФункции

// Дельта в процентах со знаком и одним знаком после запятой; нет данных - «-».
Функция ДельтаТекст(Значение)
	Если Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;
	Возврат ?(Значение > 0, "+", "") + ФорматЧисла(Значение, 1);
КонецФункции

// CSS-класс дельты: > +5% - good, < -5% - bad, иначе нейтрально.
Функция КлассДельты(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли Значение > 5 Тогда
		Возврат "good";
	ИначеЕсли Значение < -5 Тогда
		Возврат "bad";
	КонецЕсли;
	Возврат "";
КонецФункции

// CSS-класс индекса: >= 100 - good, < 90 - bad, иначе нейтрально.
Функция КлассИндекса(Значение)
	Если Значение >= 100 Тогда
		Возврат "good";
	ИначеЕсли Значение < 90 Тогда
		Возврат "bad";
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти
