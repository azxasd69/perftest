// CMS-шифрование конвертов через openssl (ТЗ_доработка_интеграция.md, § 8.4, этап Э6).
//
// Зачем отдельный модуль: каналы без транспортной защиты (HTTP 80, почта, DNS)
// обязаны передавать зашифрованный конверт, иначе паспорт с путями и именами
// машин уходит открытым текстом. Шифрование - единственное, что здесь есть:
// очередь, подпись и маршрутизация остаются в ПерфОбмен и ПерфОбменТранспорт,
// чтобы сетевая ошибка не была неотличима от ошибки шифрования.
//
// Ограничение, названное честно: нужен openssl.exe на машине, где исполняется
// серверный код. В веб-клиенте каналы 4, 6 и 8 недоступны, и это видно в журнале.

#Область Доступность

// Наличие openssl в PATH. Проверка кэшируется на время вызова: запуск процесса
// стоит десятки миллисекунд, а вызывается она в пробе и в каждой отправке.
Функция ЕстьOpenSSL() Экспорт

	Возврат ПерфОбменТранспорт.ЕстьВPath("openssl");

КонецФункции

// Версия openssl строкой: попадает в журнал пробы, чтобы было видно, чем шифровали.
Функция ВерсияOpenSSL() Экспорт

	Попытка
		Путь = КаталогВременныхФайлов() + "perf-openssl-version.txt";
		УдалитьФайлы(Путь);
		// Редирект вывода делает оболочка ОС: на Linux cmd нет, а sh есть.
		Если ПерфОбменТранспорт.ЭтоЛинукс() Тогда
			Команда = "sh -c ""openssl version > '" + Путь + "'""";
		Иначе
			Команда = "cmd /c openssl version > """ + Путь + """";
		КонецЕсли;
		ЗапуститьПриложение(Команда, , Истина);
		Если ПерфОбмен.ФайлЕсть(Путь) Тогда
			Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
			СтрокаВерсии = СокрЛП(Чтение.ПрочитатьСтроку());
			Чтение.Закрыть();
			УдалитьФайлы(Путь);
			Возврат СтрокаВерсии;
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
	Возврат "";

КонецФункции

#КонецОбласти

#Область Сертификат

// Сертификат получателя (сайта) для CMS. Хранится в том же регистре, что CA,
// но под ключом CMS: это разные вещи - CA проверяет сервер, CMS шифрует тело.
Функция СертификатСайта() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|
		|	Т.Сертификат КАК Сертификат
		|ИЗ
		|	РегистрСведений.ПерфОбменСертификат КАК Т
		|ГДЕ
		|	Т.Ключ = &Ключ");
	Запрос.УстановитьПараметр("Ключ", "CMS");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Сертификат);
	КонецЕсли;
	Возврат "";

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбменШифр.Сертификат",
			"Не удалось прочитать сертификат CMS",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат "";
	КонецПопытки;

КонецФункции

Процедура ЗаписатьСертификатСайта(ПЕМ, Комментарий = "") Экспорт

	ПерфОбмен.ЗаписатьСертификат(ПЕМ, Комментарий, "", "CMS");

КонецПроцедуры

#КонецОбласти

#Область Шифрование

// Шифрование тела конверта. Возвращает Структура(Успех, ДанныеBase64, Причина).
// Временные файлы удаляются всегда, включая ветку исключения: в них открытый JSON.
Функция Зашифровать(Тело, СертификатПЕМ = "") Экспорт

	Результат = Новый Структура("Успех, ДанныеBase64, Причина", Ложь, "", "");

	Если НЕ ЕстьOpenSSL() Тогда
		Результат.Причина = "нет openssl в PATH";
		Возврат Результат;
	КонецЕсли;

	ПЕМ = ?(ПустаяСтрока(СертификатПЕМ), СертификатСайта(), СертификатПЕМ);
	Если ПустаяСтрока(ПЕМ) Тогда
		Результат.Причина = "не загружен сертификат CMS";
		ПерфСценарии.ЗаписатьМетку("exchange-cms:no-cert");
		Возврат Результат;
	КонецЕсли;

	Каталог = КаталогВременныхФайлов();
	Отпечаток = ПерфОбмен.ХешHex(ПЕМ);
	ФайлТела = Каталог + "perf-cms-" + Отпечаток + ".json";
	ФайлСертификата = Каталог + "perf-cms-cert-" + Отпечаток + ".pem";
	ФайлВыхода = Каталог + "perf-cms-" + Отпечаток + ".cms";

	Попытка
		Запись = Новый ЗаписьТекста(ФайлТела, КодировкаТекста.UTF8);
		Запись.Записать(Тело);
		Запись.Закрыть();

		Запись = Новый ЗаписьТекста(ФайлСертификата, КодировкаТекста.UTF8);
		Запись.Записать(ПЕМ);
		Запись.Закрыть();

		УдалитьФайлы(ФайлВыхода);
		Команда = "openssl cms -encrypt -aes-256-gcm -binary"
			+ " -in """ + ФайлТела + """"
			+ " -out """ + ФайлВыхода + """"
			+ " """ + ФайлСертификата + """";
		Запуск = ПерфОбменТранспорт.ЗапуститьСТаймаутом(Команда, 30);
		Если НЕ Запуск.Успех Тогда
			Результат.Причина = "openssl: " + Запуск.Причина;
			ПерфСценарии.ЗаписатьМетку("exchange-cms:" + Запуск.Причина);
		ИначеЕсли НЕ ПерфОбмен.ФайлЕсть(ФайлВыхода) Тогда
			Результат.Причина = "openssl не создал файл";
		Иначе
			Результат.ДанныеBase64 = Base64Строка(Новый ДвоичныеДанные(ФайлВыхода));
			Результат.Успех = Истина;
			ПерфСценарии.ЗаписатьМетку("exchange-cms:ok:" + СтрДлина(Результат.ДанныеBase64));
		КонецЕсли;
	Исключение
		Результат.Причина = ПерфОбмен.КраткоОшибки(ОписаниеОшибки());
	КонецПопытки;

	Для Каждого Путь Из СтрРазделить(ФайлТела + ";" + ФайлСертификата + ";" + ФайлВыхода, ";") Цикл
		Попытка
			Если ПерфОбмен.ФайлЕсть(Путь) Тогда
				УдалитьФайлы(Путь);
			КонецЕсли;
		Исключение
			ИгнорируемаяОшибка = ИнформацияОбОшибке();
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Конверт в формате sealed (ТЗ 8.4): тело шифруется целиком и уходит строкой data.
// Подпись считается от base64-строки, а не от исходного JSON.
Функция СобратьЗапечатанный(Тело, КодНабора = "2026-11") Экспорт

	Шифрование = Зашифровать(Тело);
	Если НЕ Шифрование.Успех Тогда
		Возврат Новый Структура("Успех, Тело, Причина", Ложь, "", Шифрование.Причина);
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Поток = Новый ПотокВПамяти();
	Запись.ОткрытьПоток(Поток, "UTF-8");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("sealed");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("kid");
	Запись.ЗаписатьЗначение(КодНабора);
	Запись.ЗаписатьИмяСвойства("alg");
	Запись.ЗаписатьЗначение("cms-aes-256-gcm");
	Запись.ЗаписатьИмяСвойства("data");
	Запись.ЗаписатьЗначение(Шифрование.ДанныеBase64);
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();
	Запись.Закрыть();

	Текст = ПолучитьСтрокуИзДвоичныхДанных(Поток.ЗакрытьИПолучитьДвоичныеДанные(), КодировкаТекста.UTF8);
	Возврат Новый Структура("Успех, Тело, Причина", Истина, Текст, "");

КонецФункции

#КонецОбласти
