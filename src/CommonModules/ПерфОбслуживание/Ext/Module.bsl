// Обслуживание базы «ПерфТест»: очистка данных тестов и разбор журнала.
//
// Очистка удаляет только данные: замеры, историю, паспорта стендов, очередь
// обмена, результаты проб и журнал ошибок. Настройки (константы, каналы,
// секреты, сертификат) и демо-фикстуры сценариев не затрагиваются - иначе
// после очистки база перестала бы отправлять и мерить сопоставимо.
//
// Журнал регистрации читается платформенным способом: файловый вариант
// хранит его рядом с базой (1Cv8Log), и без выгрузки в файл его не разобрать
// в агентском шелле.

#Область ПрограммныйИнтерфейс

// Очистка данных тестов. Возвращает структуру «сколько было» по регистрам.
Функция ОчиститьДанные() Экспорт

	Результат = Новый Структура("Результаты, История, Стенды, Очередь, Проба, Ошибки, Журнал",
		0, 0, 0, 0, 0, 0, Ложь);
	Попытка
		Результат.Результаты = ОчиститьРегистр("ПерфРезультаты");
		Результат.История = ОчиститьРегистр("ПерфИстория");
		Результат.Стенды = ОчиститьРегистр("ПерфСтенды");
		Результат.Очередь = ОчиститьРегистр("ПерфОчередьОбмена");
		Результат.Проба = ОчиститьРегистр("ПерфОбменПроба");
	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбслуживание.ОчиститьДанные",
			"Не удалось очистить данные замеров", ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
	КонецПопытки;

	// Журнал регистрации чистится до регистра ошибок: иначе запись о самом
	// факте очистки (файловый вариант её не поддерживает) осталась бы в журнале.
	Результат.Журнал = ОчиститьЖурнал();

	Попытка
		Было = КоличествоЗаписей("ПерфОшибки");
		ПерфЖурнал.Очистить();
		Результат.Ошибки = Было;
	Исключение
		Результат.Ошибки = -1;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Ошибки журнала регистрации за последние Часов часов: массив структур.
// Отбор по уровню «Ошибка» - предупреждения и информация не нужны. Чтение
// платформенное: ВыгрузитьЖурналРегистрации в таблицу значений.
Функция ОшибкиЖурнала(Часов = 24) Экспорт

	Результат = Новый Массив;
	Попытка
		Если Часов <= 0 Тогда
			Часов = 24;
		КонецЕсли;
		Конец = ТекущаяДатаСеанса();
		Начало = Конец - Часов * 3600;
		Отбор = Новый Структура("ДатаНачала, ДатаОкончания, Уровень",
			Начало, Конец, УровеньЖурналаРегистрации.Ошибка);
		Колонки = Новый Массив;
		Колонки.Добавить("Дата");
		Колонки.Добавить("ПредставлениеСобытия");
		Колонки.Добавить("Комментарий");
		Колонки.Добавить("ИмяПользователя");
		Колонки.Добавить("ПредставлениеМетаданных");
		Таблица = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, Колонки);
		Для Каждого Строка Из Таблица Цикл
			Результат.Добавить(Новый Структура("Дата, Событие, Описание, Пользователь, Метаданные",
				Строка.Дата, СокрЛП(Строка.ПредставлениеСобытия), СокрЛП(Строка.Комментарий),
				СокрЛП(Строка.ИмяПользователя), СокрЛП(Строка.ПредставлениеМетаданных)));
		КонецЦикла;
	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбслуживание.ОшибкиЖурнала",
			"Не удалось прочитать журнал регистрации", ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Предупреждение", "", "", "сервер");
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Очистка журнала регистрации платформенным способом: пустой отбор = весь журнал.
Функция ОчиститьЖурнал() Экспорт

	Попытка
		ОчиститьЖурналРегистрации(Новый Структура);
		Возврат Истина;
	Исключение
		Причина = ПерфОбмен.КраткоОшибки(ОписаниеОшибки());
		// Файловый вариант журнала очищать через платформу не умеет: там журнал
		// чистится удалением файлов 1Cv8Log\*.lgp при закрытой базе.
		Если СтрНайти(НРег(Причина), "не поддерживается") > 0 Тогда
			ПерфЖурнал.ЗаписатьОшибку("ПерфОбслуживание.ОчиститьЖурнал",
				"Журнал файловой базы платформой не очищается: удалите 1Cv8Log\\*.lgp", Причина,
				"Событие", "", "", "сервер");
		Иначе
			ПерфЖурнал.ЗаписатьОшибку("ПерфОбслуживание.ОчиститьЖурнал",
				"Не удалось очистить журнал регистрации", Причина,
				"Предупреждение", "", "", "сервер");
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Выгрузка ошибок журнала в текстовый файл (КаталогВременныхФайлов или Путь).
// Возвращает количество записанных строк.
Функция ВыгрузитьОшибкиЖурнала(Часов = 24, Путь = "") Экспорт

	Ошибки = ОшибкиЖурнала(Часов);
	Если ПустаяСтрока(Путь) Тогда
		Путь = КаталогВременныхФайлов() + "perftest_eventlog.txt"; // BSLLS:UsingHardcodePath-off
	КонецЕсли;
	Попытка
		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
		Запись.ЗаписатьСтроку("журнал регистрации, ошибки за " + Строка(Часов) + " ч: " + Строка(Ошибки.Количество()));
		Для Каждого Строка Из Ошибки Цикл
			Запись.ЗаписатьСтроку(Формат(Строка.Дата, "ДЛФ=DT") + " | " + Строка.Событие
				+ " | " + Строка.Описание + " | " + Строка.Пользователь + " | " + Строка.Метаданные);
		КонецЦикла;
		Запись.Закрыть();
	Исключение
		Возврат -1;
	КонецПопытки;
	Возврат Ошибки.Количество();

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Запись текстового файла на сервере. Нужна клиентским модулям: в тонком и
// веб-клиенте файловые методы (Новый ЗаписьТекста, КаталогВременныхФайлов)
// синхронные и запрещены платформой - в толстом клиенте они работают, поэтому
// ошибка видна не всегда. Возвращает Истина, если файл записан.
Функция ЗаписатьТекстовыйФайл(Путь, Текст, Дописать = Ложь) Экспорт

	Если ПустаяСтрока(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, , Дописать);
		Запись.Записать(Текст);
		Запись.Закрыть();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Тот же файл, но в каталоге временных файлов сервера. Имя очищается от
// разделителей пути: маркер или дамп HTML не должны уводить запись за
// пределы временного каталога. Возвращает Истина, если файл записан.
Функция ЗаписатьВременныйФайл(ИмяФайла, Текст, Дописать = Ложь) Экспорт

	Имя = СокрЛП(СтрЗаменить(СтрЗаменить(ИмяФайла, "/", "_"), "\", "_"));
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Путь = КаталогВременныхФайлов() + Лев(Имя, 120); // BSLLS:UsingHardcodePath-off
	Возврат ЗаписатьТекстовыйФайл(Путь, Текст, Дописать);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Счётчик записей регистра: нужен, чтобы отчитаться «сколько удалено».
Функция КоличествоЗаписей(ИмяРегистра)

	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ РегистрСведений." + ИмяРегистра);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Всего;
		КонецЕсли;
	Исключение
		Возврат 0;
	КонецПопытки;
	Возврат 0;

КонецФункции

// Очистка одного регистра: набор без отбора с Записать(Истина) заменяет все записи.
Функция ОчиститьРегистр(ИмяРегистра)

	Было = КоличествоЗаписей(ИмяРегистра);
	Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Набор.Записать(Истина);
	Возврат Было;

КонецФункции

#КонецОбласти
