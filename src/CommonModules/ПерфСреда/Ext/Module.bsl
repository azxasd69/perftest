// Среда исполнения «ПерфТест» и автонастройка под неё.
//
// Модуль отвечает на два вопроса: где и как исполняется код (сервер или клиент
// в файловой ИБ, вариант работы базы, ОС, режим клиента) и какие возможности из
// этого следуют (WMI, /proc, pscp, openssl, интернет-объекты). По этому профилю
// применяются настройки обмена: выключается только заведомо нерабочее в этой
// среде; включение каналов, адреса, порты, пути и секреты не меняются.
//
// Модуль серверный. Клиентскую часть (режим клиента, вариант запуска) отдает
// ПерфСредаКлиент и передает сюда структурой.

#Область ПрограммныйИнтерфейс

// Среда исполнения. ПараметрыКлиента - структура ПерфСредаКлиент.Параметры().
Функция Определить(ПараметрыКлиента = Неопределено) Экспорт

	Среда = Новый Структура;
	Среда.Вставить("ВариантРаботы", "Неизвестно");
	Среда.Вставить("ГдеКод", "Неизвестно");
	Среда.Вставить("ОС", "Неизвестно");
	Среда.Вставить("Платформа", "");
	Среда.Вставить("РежимКлиента", "Неизвестно");
	Среда.Вставить("ВариантЗапуска", "Интерактив");
	Среда.Вставить("ПробаДоступна", Ложь);
	Среда.Вставить("Возможности", Новый Структура("WMI, Proc, Pscp, OpenSSL, Почта",
		Ложь, Ложь, Ложь, Ложь, Ложь));
	Среда.Вставить("Отпечаток", "os?");

	Попытка
		Паспорт = ПерфПаспорт.ОпределитьСреду();
		Среда.ОС = СокрЛП(Паспорт.СемействоОС);
		Среда.Платформа = СокрЛП(Паспорт.ВерсияПлатформы);
		Среда.ВариантРаботы = ?(Паспорт.ВариантИБ = "Файловый", "Файловая", "Клиент-сервер");
	Исключение
		// Паспорт недоступен: среда остается неопределенной, настройки не трогаем.
		Среда.ОС = "Неизвестно";
	КонецПопытки;

	Если Среда.ВариантРаботы = "Неизвестно" Тогда
		Попытка
			Среда.ВариантРаботы = ?(ПерфСценарии.ВариантРазвёртывания() = "Файловый",
				"Файловая", "Клиент-сервер");
		Исключение
			Среда.ВариантРаботы = "Неизвестно";
		КонецПопытки;
	КонецЕсли;

	// В файловой ИБ серверный код исполняется в процессе клиента: это не ошибка,
	// а свойство варианта работы, и оно попадает в отпечаток.
	Среда.ГдеКод = ?(Среда.ВариантРаботы = "Файловая", "Клиент (файловая ИБ)", "Сервер");

	// Возможности среды: проверяются фактом, а не предположением об ОС.
	ЕстьPscp = Ложь;
	ЕстьOpenSSL = Ложь;
	Попытка
		ЕстьPscp = ПерфОбменТранспорт.ЕстьВPath("pscp");
		ЕстьOpenSSL = ПерфОбменТранспорт.ЕстьВPath("openssl");
	Исключение
		ЕстьPscp = Ложь;
		ЕстьOpenSSL = Ложь;
	КонецПопытки;

	Среда.Возможности.WMI = (Среда.ОС = "Windows");
	Среда.Возможности.Proc = (Среда.ОС = "Linux");
	Среда.Возможности.Почта = (Среда.ОС = "Windows" ИЛИ Среда.ОС = "Linux");
	Среда.Возможности.Pscp = ЕстьPscp;
	Среда.Возможности.OpenSSL = ЕстьOpenSSL;

	Если ПараметрыКлиента <> Неопределено Тогда
		Если ТипЗнч(ПараметрыКлиента) = Тип("Структура") Тогда
			Среда.РежимКлиента = СокрЛП(ПараметрыКлиента.РежимКлиента);
			Среда.ВариантЗапуска = СокрЛП(ПараметрыКлиента.ВариантЗапуска);
			Среда.ПробаДоступна = ПараметрыКлиента.ПробаДоступна;
		КонецЕсли;
	КонецЕсли;

	Среда.Отпечаток = Отпечаток(Среда);
	Возврат Среда;

КонецФункции

// Короткий отпечаток среды: "win-srv-thick". Меняется при переезде на другой
// стенд или в другой режим запуска - это видно в журнале и маркере.
Функция Отпечаток(Среда) Экспорт

	ОС = ?(Среда.ОС = "Linux", "lin", ?(Среда.ОС = "Windows", "win", "os"));
	База = ?(Среда.ВариантРаботы = "Файловая", "file",
		?(Среда.ВариантРаботы = "Клиент-сервер", "srv", "db"));
	Отпечаток = ОС + "-" + База;
	// Режим клиента известен только на клиенте: на серверной сборке страницы
	// его в отпечатке нет, иначе там появлялось бы ложное "cli".
	Если Среда.РежимКлиента = "Толстый" Тогда
		Отпечаток = Отпечаток + "-thick";
	ИначеЕсли Среда.РежимКлиента = "Тонкий" Тогда
		Отпечаток = Отпечаток + "-thin";
	ИначеЕсли Среда.РежимКлиента = "Веб" Тогда
		Отпечаток = Отпечаток + "-web";
	КонецЕсли;
	Возврат Отпечаток;

КонецФункции

// Среда одной строкой: для маркеров и журнала (без секретов и путей).
Функция ТекстСреды(Среда) Экспорт

	Части = Новый Массив;
	Части.Добавить("среда " + Среда.ГдеКод);
	Части.Добавить(Среда.ВариантРаботы);
	Части.Добавить(Среда.ОС);
	Части.Добавить("клиент " + Среда.РежимКлиента);
	Части.Добавить("запуск " + Среда.ВариантЗапуска);
	Части.Добавить("pscp " + ?(Среда.Возможности.Pscp, "да", "нет"));
	Части.Добавить("openssl " + ?(Среда.Возможности.OpenSSL, "да", "нет"));
	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Правила профиля: какие каналы в этой среде заведомо не работают.
// Только запреты: разрешение каналов - решение администратора.
Функция Профиль(Среда) Экспорт

	Профиль = Новый ТаблицаЗначений;
	Профиль.Колонки.Добавить("Канал");
	Профиль.Колонки.Добавить("Допустим");
	Профиль.Колонки.Добавить("Причина");

	ДобавитьПравило(Профиль, "SFTP", Среда.Возможности.Pscp, "нет клиента pscp в PATH");

	// HTTP80 передает конверт только в CMS: без openssl канал нерабочий.
	ДобавитьПравило(Профиль, "HTTP80", Среда.Возможности.OpenSSL, "нет openssl для CMS");

	// Канал PROXY имеет смысл только при заданном прокси.
	ЕстьПрокси = Ложь;
	Попытка
		ЕстьПрокси = (ПерфОбмен.ПроксиИзНастроек() <> Неопределено);
	Исключение
		ЕстьПрокси = Ложь;
	КонецПопытки;
	ДобавитьПравило(Профиль, "PROXY", ЕстьПрокси, "прокси не задан");

	// DNS в платформе не реализуется: канал обслуживает только утилита.
	ДобавитьПравило(Профиль, "DNS", Ложь, "канал только утилитой perf-push");

	// Почта без адресов отправителя и получателя не отправит ничего.
	АдресаЕсть = Ложь;
	Попытка
		Почта = ПерфОбменТранспорт.ПараметрыКанала("SMTP");
		АдресаЕсть = ЗначениеЗаполнено(СокрЛП(Почта.АдресОтправителя))
			И ЗначениеЗаполнено(СокрЛП(Почта.АдресПолучателя));
	Исключение
		АдресаЕсть = Ложь;
	КонецПопытки;
	ДобавитьПравило(Профиль, "SMTP", АдресаЕсть, "не заданы адреса почты");

	// Открытый FTP запрещен политикой: паспорт не должен уходить открытым текстом.
	ЗащитаЕсть = Ложь;
	Попытка
		ФТП = ПерфОбменТранспорт.ПараметрыКанала("FTP");
		ЗащитаЕсть = (НРег(СокрЛП(ФТП.Защита)) <> "нет");
	Исключение
		ЗащитаЕсть = Ложь;
	КонецПопытки;
	ДобавитьПравило(Профиль, "FTP", ЗащитаЕсть, "открытый FTP запрещен");

	Возврат Профиль;

КонецФункции

// Применение профиля к настройкам обмена. Идемпотентно: выключает только
// включенные каналы, которых в этой среде нет; выключенные не перезаписывает.
// Константа ПерфПрофильСреды = "Выкл" отключает автоприменение целиком.
// ПараметрыКлиента - структура ПерфСредаКлиент.Параметры() или Неопределено.
Функция Применить(ПараметрыКлиента = Неопределено) Экспорт

	Итог = Новый Структура("Применено, Выключено, БезИзменений, Отпечаток, Текст",
		Ложь, 0, 0, "", "");
	Попытка
		Среда = Определить(ПараметрыКлиента);
		Итог.Отпечаток = Среда.Отпечаток;
		Итог.Текст = ТекстСреды(Среда);

		Если НРег(СокрЛП(Константы.ПерфПрофильСреды.Получить())) = "выкл" Тогда
			Итог.Текст = Итог.Текст + "; автонастройка выключена константой";
			Возврат Итог;
		КонецЕсли;

		Итог.Применено = Истина;
		Выключенные = Новый Массив;
		Для Каждого Правило Из Профиль(Среда) Цикл
			Если Правило.Допустим Тогда
				Продолжить;
			КонецЕсли;
			Запись = РегистрыСведений.ПерфОбменКанал.СоздатьМенеджерЗаписи();
			Запись.Канал = Правило.Канал;
			Запись.Прочитать();
			Если НЕ Запись.Включен Тогда
				// Канал уже выключен: не трогаем ни флаг, ни примечание администратора.
				Итог.БезИзменений = Итог.БезИзменений + 1;
				Продолжить;
			КонецЕсли;
			Запись.Включен = Ложь;
			Запись.Примечание = Лев("авто " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yy")
				+ ": " + Правило.Причина, 150);
			Запись.Записать();
			Итог.Выключено = Итог.Выключено + 1;
			Выключенные.Добавить(Правило.Канал);
		КонецЦикла;

		Если Итог.Выключено > 0 Тогда
			Итог.Текст = Итог.Текст + "; выключено: " + СтрСоединить(Выключенные, ",");
		Иначе
			Итог.Текст = Итог.Текст + "; изменений нет";
		КонецЕсли;
		ПерфСценарии.ЗаписатьМетку("env:apply:" + Итог.Отпечаток + ":" + Строка(Итог.Выключено));
	Исключение
		Итог.Текст = Итог.Текст + "; ошибка: " + ПерфОбмен.КраткоОшибки(ОписаниеОшибки());
	КонецПопытки;

	// ЗаписатьОшибку не бросает: при недоступности регистра текст уходит в файл.
	ПерфЖурнал.ЗаписатьОшибку("ПерфСреда.Применить", Итог.Текст, "", "Событие", "", "", "сервер");

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПравило(Профиль, Канал, Допустим, Причина)

	Строка = Профиль.Добавить();
	Строка.Канал = Канал;
	Строка.Допустим = Допустим;
	Строка.Причина = Причина;

КонецПроцедуры

#КонецОбласти
