// Обмен замерами с порталом (ТЗ_доработка_интеграция.md, этап Э1).
//
// Принципы (ТЗ § 1.4):
//   - замер не зависит от сети: конверт сначала пишется в регистр очереди;
//   - сеть вызывается только из цикла отправки, вне транзакции замера;
//   - идемпотентность по идентификатору конверта;
//   - секретов в конфигурации нет: они хранятся в регистре ПерфОбменСекрет;
//
// Модуль серверный, без директив компиляции: в общих модулях они не пишутся.
// Переменные модуля в общем модуле платформой не поддерживаются (BSL LS: CommonModuleVariables),
// поэтому состояние между вызовами не хранится: каждый метод самодостаточен.

// --- Регламентное задание отправки ----------------------------------------
// Экземпляр задания создаётся кодом: расписание - это данные базы, в XML-выгрузке
// его нет. Возвращает строку маркера для служебных режимов, пустая строка - уже есть.
Функция ОбеспечитьРегламентноеЗаданиеОбмена() Экспорт

	Попытка
		Описание = Метаданные.РегламентныеЗадания.Найти("ПерфОбменОтправка");
		Если Описание = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Для Каждого Существующее Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
			Если Существующее.Метаданные = Описание Тогда
				Возврат "";
			КонецЕсли;
		КонецЦикла;
		Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(Описание);
		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ПериодПовтораВТечениеДня = 900;
		Задание.Расписание = Расписание;
		Задание.Использование = Истина;
		Задание.Записать();
		Возврат "job-created:ПерфОбменОтправка:900";
	Исключение
		Возврат "job-ensure-error:" + КраткоОшибки(ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// Состояние регламентных заданий обмена для режима /C "ПерфОбменЗадания".
// Возвращает массив готовых строк маркеров. Период (строка, секунды) необязателен:
// с ним расписание переписывается - так проверяется, что планировщик запускает метод.
Функция ДиагностикаЗаданийОбмена(ПериодСекунд = "") Экспорт

	Маркеры = Новый Массив;
	Попытка
		Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
		Маркеры.Добавить("job-count:" + Строка(Задания.Количество()));
		Для Каждого Задание Из Задания Цикл
			Последнее = "нет";
			Если Задание.ПоследнееЗадание <> Неопределено Тогда
				Последнее = Строка(Задание.ПоследнееЗадание.Состояние);
			КонецЕсли;
			ИмяЗадания = Строка(Задание.Наименование);
			Если ПустаяСтрока(ИмяЗадания) И Задание.Метаданные <> Неопределено Тогда
				ИмяЗадания = Задание.Метаданные.Имя;
			КонецЕсли;
			Маркеры.Добавить("job:" + ИмяЗадания
				+ ":" + ?(Задание.Использование, "включено", "выключено")
				+ ":" + Строка(Задание.Расписание)
				+ ":последнее=" + Последнее);
			Если ЗначениеЗаполнено(ПериодСекунд) Тогда
				Расписание = Новый РасписаниеРегламентногоЗадания;
				Расписание.ПериодПовтораВТечениеДня = Число(ПериодСекунд);
				Задание.Расписание = Расписание;
				Задание.Записать();
				Маркеры.Добавить("job-schedule:" + СокрЛП(ПериодСекунд));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Маркеры = Новый Массив;
		Маркеры.Добавить("job-error:" + КраткоОшибки(ОписаниеОшибки()));
	КонецПопытки;
	Возврат Маркеры;

КонецФункции

#Область НастройкаОбмена

// Настройки обмена применяются на сервере. Клиентский код модуля приложения
// не должен обращаться к Константы напрямую: в тонком и веб-клиенте их нет,
// а запись констант с клиента требует монопольного режима.

Процедура ПрименитьНастройку(Адрес, БазовыйПуть = "", Порт = 443,
	РазмерБатча = 50, Таймаут = 30) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка

	Константы.ПерфОбменАдрес.Установить(СокрЛП(Адрес));
	Константы.ПерфОбменБазовыйПуть.Установить(СокрЛП(БазовыйПуть));
	Константы.ПерфОбменПорт.Установить(Порт);
	Константы.ПерфОбменБатч.Установить(РазмерБатча);
	Константы.ПерфОбменТаймаут.Установить(Таймаут);
	Константы.ПерфОбменВключен.Установить(Истина);

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Настройка",
			"Не удалось записать настройки обмена",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
	КонецПопытки;

КонецПроцедуры

Процедура ЗадатьКаталогСекрета(Путь) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Константы.ПерфОбменКаталогСекрета.Установить(СокрЛП(Путь));

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Настройка",
			"Не удалось записать каталог секрета",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Очередь

// Постановка замера в очередь обмена. Вызывается из ПерфСценарии.ЗаписатьРезультат.
// Ошибка обмена не должна ломать замер, поэтому вызывающий код оборачивает вызов в Попытку.
Функция ПоставитьВОчередьРезультат(Стенд, ИмяСценария, Данные) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Конверт = СобратьКонвертРезультат(Стенд, ИмяСценария, Данные);
	Возврат ЗаписатьВОчередь(Конверт, "result", Стенд,
		"HTTPS,HTTPS8443,PROXY,WEBDAV,FTP,SMTP,SFTP,DNS");

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Не удалось поставить замер в очередь",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Идентификатор, Создана, ВОчереди", "", Ложь, 0);
	КонецПопытки;

КонецФункции

// Постановка конверта в очередь: единственное место записи в регистр.
// Идемпотентность проверяется ДО записи: тот же id второй раз не пишется,
// иначе повторная постановка сбрасывала бы Попыток и историю доставки (ТЗ 7.3).
Функция ЗаписатьВОчередь(Конверт, Вид, Стенд, КаналыРазрешены) Экспорт

	Результат = Новый Структура("Идентификатор, Создана, ВОчереди", "", Ложь, 0);

	Если НЕ Константы.ПерфОбменВключен.Получить() Тогда
		Возврат Результат;
	КонецЕсли;

	// Сборка могла не удасться (ошибка внутри обёрнута в Попытку): пустой конверт
	// в очередь не пишем, иначе на сервер уйдёт мусор с тем же пустым id.
	Если ПустаяСтрока(Конверт.Тело) Или ПустаяСтрока(Конверт.Идентификатор) Тогда
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Конверт не собрался: пустое тело или идентификатор",
			"вид=" + Вид + "; стенд=" + СокрЛП(Стенд));
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|
		|	Т.Хеш КАК Хеш
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|ГДЕ
		|	Т.Идентификатор = &Идентификатор");
	Запрос.УстановитьПараметр("Идентификатор", Конверт.Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Идентификатор = Конверт.Идентификатор;
		Если СокрЛП(Выборка.Хеш) <> СокрЛП(Конверт.Хеш) Тогда
			// id = f(тело), поэтому расхождение хеша означает повреждение записи.
			ПерфСценарии.ЗаписатьМетку("exchange-hashbad:" + Конверт.Идентификатор);
			ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
				"Хеш записи очереди не совпадает с конвертом",
				"id=" + Конверт.Идентификатор + "; вид=" + Вид);
		Иначе
			ПерфСценарии.ЗаписатьМетку("exchange-dup:" + Лев(Конверт.Идентификатор, 16));
		КонецЕсли;
		Результат.ВОчереди = КоличествоВОчереди();
		Возврат Результат;
	КонецЕсли;

	Менеджер = РегистрыСведений.ПерфОчередьОбмена.СоздатьМенеджерЗаписи();
	Менеджер.Идентификатор = Конверт.Идентификатор;
	Менеджер.Вид = Вид;
	Менеджер.Схема = 1;
	Менеджер.Тело = Конверт.Тело;
	Менеджер.Хеш = Конверт.Хеш;
	Менеджер.РазмерБайт = Конверт.РазмерБайт;
	Менеджер.ДатаСоздания = ТекущаяДатаСеанса();
	Менеджер.Статус = "Ожидает";
	Менеджер.Уровень = 1;
	Менеджер.Попыток = 0;
	Менеджер.Циклов = 0;
	Менеджер.СледующаяПопытка = ТекущаяДатаСеанса();
	Менеджер.ПометкаОтправки = Дата(1, 1, 1);
	Менеджер.Стенд = Лев(СокрЛП(Стенд), 120);
	Менеджер.Канал = "";
	Менеджер.КаналыРазрешены = КаналыРазрешены;
	Менеджер.ПризнакУтилиты = Ложь;
	Менеджер.Записать();

	Результат.Идентификатор = Конверт.Идентификатор;
	Результат.Создана = Истина;
	Результат.ВОчереди = КоличествоВОчереди();
	ПерфСценарии.ЗаписатьМетку("exchange-queued:" + Вид + ":" + Результат.ВОчереди);
	Возврат Результат;

КонецФункции

// Сколько конвертов ждёт отправки (без учёта подтверждённых и ошибочных).
Функция КоличествоВОчереди() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	КОЛИЧЕСТВО(*) КАК Счет
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|ГДЕ
		|	Т.Статус В (""Ожидает"", ""ВОтправке"", ""ОжидаетУтилиту"")");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Счет;
	КонецЕсли;
	Возврат 0;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Не удалось посчитать очередь",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Конверты

// Сборка конверта result. Порядок свойств фиксирован: от него зависит идентификатор.
// Приём с пустым id: тело собирается с ""id"":"""", идентификатор считается от него,
// затем пустое значение заменяется на вычисленное. Так хеш не замыкается сам на себя
// и не зависит от форматирования остальных свойств.
Функция СобратьКонвертРезультат(Стенд, ИмяСценария, Данные) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Запись = Новый ЗаписьJSON;
	Поток = Новый ПотокВПамяти();
	Запись.ОткрытьПоток(Поток, "UTF-8");
	Запись.ЗаписатьНачалоОбъекта();

	Запись.ЗаписатьИмяСвойства("schema");
	Запись.ЗаписатьЗначение(1);
	Запись.ЗаписатьИмяСвойства("id");
	Запись.ЗаписатьЗначение(ЗаглушкаИдентификатора());
	Запись.ЗаписатьИмяСвойства("kind");
	Запись.ЗаписатьЗначение("result");

	// sig описывает фактическую подпись конверта: приёмник сохраняет её как есть.
	Запись.ЗаписатьИмяСвойства("sig");
	Запись.ЗаписатьЗначение(?(ПустаяСтрока(КлючHMAC()), "none", "hmac-sha256"));

	Запись.ЗаписатьИмяСвойства("stand");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПоляСтенда(Запись, Стенд);
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("measured_at");
	Запись.ЗаписатьЗначение(ДатаISO(Данные.ДатаЗамера));
	Запись.ЗаписатьИмяСвойства("measured_at_utc");
	Запись.ЗаписатьЗначение(МеткаUnixСекунд(Данные.ДатаЗамера));
	Запись.ЗаписатьИмяСвойства("tz_offset");
	Запись.ЗаписатьЗначение(СмещениеЧасовМин() * 60);
	Запись.ЗаписатьИмяСвойства("conformance");
	Запись.ЗаписатьЗначение(1);

	Запись.ЗаписатьИмяСвойства("results");
	Запись.ЗаписатьНачалоМассива();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("scenario");
	Запись.ЗаписатьЗначение(СокрЛП(ИмяСценария));
	Запись.ЗаписатьИмяСвойства("representation");
	Запись.ЗаписатьЗначение("median");
	Запись.ЗаписатьИмяСвойства("median_ms");
	Запись.ЗаписатьЗначение(Окр(Данные.МедианаМс, 3));
	Запись.ЗаписатьИмяСвойства("per_unit_ms");
	Запись.ЗаписатьЗначение(Окр(Данные.НаЕдиницуМс, 3));
	Запись.ЗаписатьИмяСвойства("unit");
	Запись.ЗаписатьЗначение(СокрЛП(Данные.Единица));
	Запись.ЗаписатьИмяСвойства("portion");
	Запись.ЗаписатьЗначение(Данные.Порция);
	Запись.ЗаписатьИмяСвойства("repeats");
	Запись.ЗаписатьЗначение(Данные.Повторов);
	Запись.ЗаписатьИмяСвойства("min_ms");
	Запись.ЗаписатьЗначение(Окр(Данные.МинМс, 3));
	Запись.ЗаписатьИмяСвойства("max_ms");
	Запись.ЗаписатьЗначение(Окр(Данные.МаксМс, 3));
	// runs_string - поле контракта приёмника: длительность прогонов строкой.
	Запись.ЗаписатьИмяСвойства("runs_string");
	Запись.ЗаписатьЗначение(СвойствоДанных(Данные, "ВремяПрогонов", ""));
	Запись.ЗаписатьИмяСвойства("measured_at_utc");
	Запись.ЗаписатьЗначение(МеткаUnixСекунд(Данные.ДатаЗамера));
	Запись.ЗаписатьИмяСвойства("config_version");
	Запись.ЗаписатьЗначение(СокрЛП(Метаданные.Версия));
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецМассива();

	Запись.ЗаписатьКонецОбъекта();
	Запись.Закрыть();

	ТелоБезИд = ПолучитьСтрокуИзДвоичныхДанных(Поток.ЗакрытьИПолучитьДвоичныеДанные(), КодировкаТекста.UTF8);
	Идентификатор = ИдентификаторКонверта("r", ТелоБезИд);
	// Замена по уникальной заглушке: не зависит от того, как платформа расставила кавычки и пробелы.
	Тело = СтрЗаменить(ТелоБезИд, ЗаглушкаИдентификатора(), Идентификатор);

	Возврат Новый Структура("Идентификатор, Тело, Хеш, РазмерБайт",
		Идентификатор, Тело, ХешHex(Тело),
		ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8).Размер());

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Сборка",
			"Не удалось собрать конверт за��ера",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Идентификатор, Тело, Хеш, РазмерБайт", "", "", "", 0);
	КонецПопытки;

КонецФункции

// Поля ключа стенда: key, fingerprint, platform, visibility, base.
Процедура ЗаписатьПоляСтенда(Запись, Стенд)

	Ключ = ПерфСценарии.ИмяСтендаДляЗаписи(Стенд);
	Отпечаток = "";
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|
		|	Т.ХешОтпечатка КАК ХешОтпечатка,
		|	Т.Отпечаток КАК Отпечаток
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т
		|ГДЕ
		|	Т.Стенд = &Стенд");
	Запрос.УстановитьПараметр("Стенд", Ключ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отпечаток = ?(ЗначениеЗаполнено(Выборка.ХешОтпечатка), СокрЛП(Выборка.ХешОтпечатка),
			ХешHex(СокрЛП(Выборка.Отпечаток)));
	КонецЕсли;

	// Приёмник требует строго 64 hex и отказывает всему конверту иначе (HTTP 207/400).
	// Если паспорт ещё не записан, берём детерминированный хеш ключа стенда:
	// он сменится на настоящий отпечаток первым же паспортом, и поколение стенда
	// на сайте создастся заново - это видно и лучше, чем отвергнутый замер.
	Если НеЭтоХеш64(Отпечаток) Тогда
		Отпечаток = ХешHex(Ключ + "|" + ПерфСценарии.ВерсияПлатформы());
		ПерфСценарии.ЗаписатьМетку("exchange-fingerprint:fallback");
	КонецЕсли;

	Запись.ЗаписатьИмяСвойства("key");
	Запись.ЗаписатьЗначение(Ключ);
	Запись.ЗаписатьИмяСвойства("fingerprint");
	Запись.ЗаписатьЗначение(Отпечаток);
	Запись.ЗаписатьИмяСвойства("platform");
	Запись.ЗаписатьЗначение(ПерфСценарии.ВерсияПлатформы());
	Запись.ЗаписатьИмяСвойства("visibility");
	Запись.ЗаписатьЗначение(Публичность());
	Запись.ЗаписатьИмяСвойства("base");
	Запись.ЗаписатьЗначение("вендор 8.3.27");

КонецПроцедуры

// Значение stand.visibility: константа обмена, по умолчанию private (ТЗ 3.7, С-14).
Функция Публичность() Экспорт

	Значение = НРег(СокрЛП(Константы.ПерфОбменПубличность.Получить()));
	Если Значение = "public" Тогда
		Возврат "public";
	КонецЕсли;
	Возврат "private";

КонецФункции

// Строго 64 hex в нижнем регистре: контракт приёмника stand.fingerprint.
Функция НеЭтоХеш64(Значение) Экспорт

	СтрокаХеша = НРег(СокрЛП(Значение));
	Если СтрДлина(СтрокаХеша) <> 64 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Индекс = 1 По 64 Цикл
		Если СтрНайти("0123456789abcdef", Сред(СтрокаХеша, Индекс, 1)) = 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Значение поля из переданной структуры без падения на отсутствующем свойстве.
Функция СвойствоДанных(Данные, Имя, ЗначениеПоУмолчанию) Экспорт

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя) Тогда
		Возврат Данные[Имя];
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Заглушка идентификатора: 43 нуля. Заменяется на вычисленный идентификатор
// после сериализации, поэтому поиск не зависит от форматирования JSON.
Функция ЗаглушкаИдентификатора() Экспорт

	Возврат "0000000000000000000000000000000000000000000";

КонецФункции

// Идентификатор конверта: префикс (1) + дефис + base64url(SHA-256) (43) = 45 символов.
Функция ИдентификаторКонверта(Префикс, ТелоБезИд) Экспорт

	Возврат Префикс + "-" + Лев(Base64URL(ХешДанные(ТелоБезИд)), 43);

КонецФункции

Функция ХешДанные(Данные) Экспорт

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Данные);
	Возврат Хеш.ХешСумма;

КонецФункции

Функция ХешHex(ТекстДляХеша) Экспорт

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешДанные(ТекстДляХеша)));

КонецФункции

Функция Base64URL(Данные) Экспорт

	СтрокаБ64 = Base64Строка(Данные);
	СтрокаБ64 = СтрЗаменить(СтрокаБ64, "+", "-");
	СтрокаБ64 = СтрЗаменить(СтрокаБ64, "/", "_");
	СтрокаБ64 = СтрЗаменить(СтрокаБ64, "=", "");
	Возврат СтрокаБ64;

КонецФункции

#КонецОбласти

#Область Время

// Смещение часового пояса сеанса от UTC в минутах.
// Паспорт для этого не используется: поля ЧасовойПоясИБ и СерверЧасовойПояс никем не заполняются.
Функция СмещениеЧасовМин() Экспорт

	// Разность дат в 1С - это секунды, поэтому в минуты переводим делением на 60.
	Возврат Цел((ТекущаяДатаСеанса() - ТекущаяУниверсальнаяДата()) / 60 + 0.5);

КонецФункции

Функция ДатаISO(ДатаМестная) Экспорт

	Минуты = СмещениеЧасовМин();
	Знак = ?(Минуты < 0, "-", "+");
	// Abs в русском варианте языка нет: модуль считаем тернарным оператором.
	Модуль = Цел(?(Минуты < 0, -Минуты, Минуты));
	Возврат Формат(ДатаМестная, "ДФ=yyyy-MM-ddTHH:mm:ss")
		+ Знак + Формат(Цел(Модуль / 60), "ЧЦ=2; ЧВН=; ЧГ=0")
		+ ":" + Формат(Модуль % 60, "ЧЦ=2; ЧВН=; ЧГ=0");

КонецФункции

Функция ДатаISOUTS(ДатаМестная) Экспорт

	// К дате прибавляется/вычитается число СЕКУНД, поэтому минуты умножаем на 60.
	Возврат Формат(ДатаМестная - СмещениеЧасовМин() * 60, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";

КонецФункции

// Unix-время в секундах числом: этого требует поле measured_at_utc конверта
// (в приемнике это int64; ISO-строка отвергается с 400 bad_json).
Функция МеткаUnixСекунд(ДатаМестная) Экспорт

	// Разность дат уже в секундах: умножение на 86400 давало значение в 86 400 раз больше,
	// и приемник показывал дату в 4914115 году.
	Возврат Цел(ДатаМестная - СмещениеЧасовМин() * 60 - Дата(1970, 1, 1) + 0.5);

КонецФункции

Функция МеткаUnix() Экспорт

	Возврат Формат(Цел(ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1)), "ЧГ=0");

КонецФункции

#КонецОбласти

#Область Подпись

// HMAC-SHA-256 по RFC 2104.
// ХешФункция.HMAC в платформе нет (у ХешированиеДанных один параметр конструктора,
// сумма - свойство ХешСумма), поэтому K xor ipad/opad считается по hex-цифрам:
// XOR побитовый и не зависит от группировки, значит hex(a) xor hex(b) поэлементно
// дает hex(a xor b).
Функция ПодписьHMAC(КлючBase64, Данные) Экспорт

	КлючДанные = ПолучитьДвоичныеДанныеИзBase64Строки(КлючBase64);
	Если КлючДанные.Размер() > 64 Тогда
		КлючДанные = ХешДанные(КлючДанные);
	КонецЕсли;

	HexКлюча = ПолучитьHexСтрокуИзДвоичныхДанных(КлючДанные);
	Пока СтрДлина(HexКлюча) < 128 Цикл
		HexКлюча = HexКлюча + "00";
	КонецЦикла;

	HexIPad = "";
	HexOPad = "";
	Пока СтрДлина(HexIPad) < 128 Цикл
		HexIPad = HexIPad + "36";
		HexOPad = HexOPad + "5c";
	КонецЦикла;

	Внутренние = Новый ХешированиеДанных(ХешФункция.SHA256);
	Внутренние.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки(HexXor(HexКлюча, HexIPad)));
	Внутренние.Добавить(Данные);

	Внешние = Новый ХешированиеДанных(ХешФункция.SHA256);
	Внешние.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки(HexXor(HexКлюча, HexOPad)));
	Внешние.Добавить(Внутренние.ХешСумма);

	Возврат Base64URL(Внешние.ХешСумма);

КонецФункции

Функция HexXor(HexСлева, HexСправа) Экспорт

	Если СтрДлина(HexСлева) <> СтрДлина(HexСправа) Тогда
		ВызватьИсключение "HexXor: разная длина hex-строк";
	КонецЕсли;

	Результат = "";
	Для Индекс = 1 По СтрДлина(HexСлева) Цикл
		ПозицияСлева = СтрНайти("0123456789abcdef", НРег(Сред(HexСлева, Индекс, 1)));
		ПозицияСправа = СтрНайти("0123456789abcdef", НРег(Сред(HexСправа, Индекс, 1)));
		Если ПозицияСлева = 0 ИЛИ ПозицияСправа = 0 Тогда
			ВызватьИсключение "HexXor: недопустимый hex-символ";
		КонецЕсли;
		Результат = Результат + Сред("0123456789abcdef",
			ПобитовоеИсключительноеИли(ПозицияСлева - 1, ПозицияСправа - 1) + 1, 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Полная очистка очереди. Нужна при смене формата конверта: в регистре лежат
// готовые тела, они не пересобираются и уходят в прежнем виде.
// Возвращает число удалённых записей.
Функция ОчиститьОчередь() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Удалено = 0;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Менеджер = РегистрыСведений.ПерфОчередьОбмена.СоздатьМенеджерЗаписи();
		Менеджер.Идентификатор = Выборка.Идентификатор;
		Менеджер.Удалить();
		Удалено = Удалено + 1;
	КонецЦикла;

	Возврат Удалено;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Не удалось очистить очередь",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Секреты

// Секрет хранится в базе: регистр ПерфОбменСекрет (измерение Ключ, ресурс Значение).
// Причина: база переносится выгрузкой .dt вместе с секретом и не зависит от прав
// файловой системы сервера и от того, под какой учётной записью работает rphost.
// Цена решения: токен доступен тому, у кого есть доступ к базе или её дампу,
// поэтому на портале нужна ротация токена (ТЗ, § 14.2).
//
// Файл obmen-secrets.json больше не основной источник: он читается один раз,
// если регистр пуст, и сразу переносится в базу.

Функция Токен() Экспорт

	Возврат СокрЛП(ПрочитатьСекреты().Токен);

КонецФункции

Функция КлючHMAC() Экспорт

	Возврат СокрЛП(ПрочитатьСекреты().КлючHMAC);

КонецФункции

// Чтение секретов: регистр, затем (однократно) файл с переносом в регистр.
Функция ПрочитатьСекреты() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Результат = Новый Структура("Токен, КлючHMAC", "", "");

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Ключ КАК Ключ,
		|	Т.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ПерфОбменСекрет КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ключ = "Токен" Тогда
			Результат.Токен = СокрЛП(Выборка.Значение);
		ИначеЕсли Выборка.Ключ = "КлючHMAC" Тогда
			Результат.КлючHMAC = СокрЛП(Выборка.Значение);
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(Результат.Токен) Тогда
		ИзФайла = ПрочитатьСекретыИзФайла();
		Если НЕ ПустаяСтрока(ИзФайла.Токен) Тогда
			ЗаписатьСекреты(ИзФайла.Токен, ИзФайла.КлючHMAC);
			Результат = ИзФайла;
			ПерфСценарии.ЗаписатьМетку("exchange-secrets-migrated-to-db");
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Секрет",
			"Не удалось прочитать секреты из базы",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Токен, КлючHMAC", "", "");
	КонецПопытки;

КонецФункции

// Запись секретов в базу. Вызывается из служебного режима или из кода настройки.
Процедура ЗаписатьСекреты(Токен, КлючHMAC) Экспорт

	ЗаписатьОдинСекрет("Токен", Токен);
	ЗаписатьОдинСекрет("КлючHMAC", КлючHMAC);

	// Файл больше не нужен: убираем копию, чтобы секрет не остался на диске.
	Путь = ФайлСекрета();
	Если ФайлЕсть(Путь) Тогда
		Попытка
			УдалитьФайлы(Путь);
		Исключение
			ПерфСценарии.ЗаписатьМетку("exchange-secrets-file-kept:" + КраткоОшибки(ОписаниеОшибки()));
		КонецПопытки;
	КонецЕсли;

	ПерфСценарии.ЗаписатьМетку("exchange-secrets-saved:db");

КонецПроцедуры

Процедура ЗаписатьОдинСекрет(Ключ, Значение) Экспорт

	Менеджер = РегистрыСведений.ПерфОбменСекрет.СоздатьМенеджерЗаписи();
	Менеджер.Ключ = Ключ;
	Менеджер.Значение = Лев(СокрЛП(Значение), 500);
	Менеджер.Изменён = ТекущаяДатаСеанса();
	Менеджер.КемИзменён = Лев(СокрЛП(ИмяПользователя()), 100);
	Менеджер.Записать();

КонецПроцедуры

// Удаление секретов: ротация токена или отзыв доступа.
Процедура УдалитьСекреты() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Ключ КАК Ключ
		|ИЗ
		|	РегистрСведений.ПерфОбменСекрет КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Менеджер = РегистрыСведений.ПерфОбменСекрет.СоздатьМенеджерЗаписи();
		Менеджер.Ключ = Выборка.Ключ;
		Менеджер.Удалить();
	КонецЦикла;
	ПерфСценарии.ЗаписатьМетку("exchange-secrets-cleared");

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Секрет",
			"Не удалось удалить секреты",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
	КонецПопытки;

КонецПроцедуры

// Признак наличия секрета и его маска для чипа и диагностики. Значение не возвращается.
Функция СостояниеСекрета() Экспорт

	Секреты = ПрочитатьСекреты();
	Состояние = Новый Структура("Есть, Маска, КлючHMACЕсть", Ложь, "", Ложь);
	Состояние.Есть = НЕ ПустаяСтрока(Секреты.Токен);
	Состояние.КлючHMACЕсть = НЕ ПустаяСтрока(Секреты.КлючHMAC);
	Если Состояние.Есть Тогда
		Если СтрДлина(Секреты.Токен) >= 12 Тогда
			Состояние.Маска = Лев(Секреты.Токен, 8) + "***";
		Иначе
			Состояние.Маска = "***";
		КонецЕсли;
	КонецЕсли;
	Возврат Состояние;

КонецФункции

// Файл секрета: только для миграции на схему хранения в базе.
Функция КаталогСекрета() Экспорт

	Каталог = СокрЛП(Константы.ПерфОбменКаталогСекрета.Получить());
	Если ПустаяСтрока(Каталог) Тогда
		Каталог = КаталогВременныхФайлов();
	КонецЕсли;
	// Разделитель зависит от ОС: на Linux обратная косая давала имя файла
	// с обратной косой внутри, и спул с файлом секретов не находились (1.39).
	Разделитель = ПолучитьРазделительПути();
	Если Прав(Каталог, 1) <> "/" И Прав(Каталог, 1) <> "\" Тогда
		Каталог = Каталог + Разделитель;
	КонецЕсли;
	Возврат Каталог;

КонецФункции

Функция ФайлСекрета() Экспорт

	Возврат КаталогСекрета() + "obmen-secrets.json";

КонецФункции

// Проверка существования файла: глобальной ФайлСуществует в платформе нет.
Функция ФайлЕсть(Путь) Экспорт

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();

КонецФункции

// Чтение секретов из файла: только для разовой миграции в базу.
Функция ПрочитатьСекретыИзФайла() Экспорт

	Результат = Новый Структура("Токен, КлючHMAC", "", "");
	Путь = ФайлСекрета();
	Если НЕ ФайлЕсть(Путь) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(Путь);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Если Данные.Свойство("token") Тогда
				Результат.Токен = СокрЛП(Данные.token);
			КонецЕсли;
			Если Данные.Свойство("hmac") Тогда
				Результат.КлючHMAC = СокрЛП(Данные.hmac);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ПерфСценарии.ЗаписатьМетку("exchange-secrets-error:" + КраткоОшибки(ОписаниеОшибки()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Перенос секретов из файла подготовки: режим /CПерфОбменСекрет.
Функция ИмпортироватьСекреты() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Входящий = КаталогСекрета() + "obmen-secrets-in.json";
	Если НЕ ФайлЕсть(Входящий) Тогда
		ИзФайла = ПрочитатьСекретыИзФайла();
		Если ПустаяСтрока(ИзФайла.Токен) Тогда
			Возврат Ложь;
		КонецЕсли;
		ЗаписатьСекреты(ИзФайла.Токен, ИзФайла.КлючHMAC);
		Возврат Истина;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Входящий);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Токен = ?(Данные.Свойство("token"), СокрЛП(Данные.token), "");
	Ключ = ?(Данные.Свойство("hmac"), СокрЛП(Данные.hmac), "");
	ЗаписатьСекреты(Токен, Ключ);
	УдалитьФайлы(Входящий);
	Возврат Истина;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Секрет",
			"Не удалось импортировать секреты из файла",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Маскирование: в журнал и в ТекстОтвета не должны попадать токен и ключ.
Функция КраткоОшибки(Текст) Экспорт

	Результат = СтрЗаменить(СтрЗаменить(СокрЛП(Текст), Символы.ПС, " "), Символы.ВК, " ");

	// Значение токена здесь не запрашивается: метод вызывается в цикле по конвертам,
	// и чтение секрета на каждую ошибку давало бы запрос в цикле (EDT: query-in-loop).
	// Маскируем по форме: значение токена встречается в текстах только как часть
	// заголовка "Bearer <значение>", поэтому хвост после "Bearer " отбрасываем.
	Позиция = СтрНайти(Результат, "Bearer ");
	Если Позиция > 0 Тогда
		Результат = Лев(Результат, Позиция - 1) + "Bearer <token>";
	КонецЕсли;

	Результат = СтрЗаменить(Результат, "Pwd=", "Pwd=***");
	Возврат Лев(Результат, 200);

КонецФункции

#КонецОбласти

#Область Отправка

// Один цикл: снять зависшие, подготовить пакет, отправить, разобрать ответ.
Функция ОтправитьОчередь(МаксимумКонвертов = 0, МаксимумБайт = 0) Экспорт

	Итог = Новый Структура("Отправлено, Ошибок, Осталось, Код, Текст, Канал, Уровень",
		0, 0, 0, 0, "", "", "");

	Если НЕ Константы.ПерфОбменВключен.Получить() Тогда
		Итог.Осталось = КоличествоВОчереди();
		Возврат Итог;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Константы.ПерфОбменАдрес.Получить())) Тогда
		Итог.Текст = "адрес не задан";
		Итог.Осталось = КоличествоВОчереди();
		Возврат Итог;
	КонецЕсли;
	Если ПустаяСтрока(Токен()) Тогда
		Итог.Текст = "ключ не настроен";
		Итог.Осталось = КоличествоВОчереди();
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Отправка",
			"Токен приёма не задан: обмен не начат",
			"адрес=" + СокрЛП(Константы.ПерфОбменАдрес.Получить())
				+ "; в очереди " + Строка(Итог.Осталось));
		Возврат Итог;
	КонецЕсли;

	СнятьЗависшие();

	Если МаксимумКонвертов <= 0 Тогда
		МаксимумКонвертов = Константы.ПерфОбменБатч.Получить();
	КонецЕсли;
	Если МаксимумКонвертов <= 0 Тогда
		МаксимумКонвертов = 50;
	КонецЕсли;
	Если МаксимумБайт <= 0 Тогда
		МаксимумБайт = 262144;
	КонецЕсли;

	Пакет = ПодготовитьПакет(МаксимумКонвертов, МаксимумБайт);
	Если Пакет.Количество() = 0 Тогда
		Итог.Осталось = КоличествоВОчереди();
		Возврат Итог;
	КонецЕсли;

	// Лестница каналов (ТЗ 9.3): пробуем по приоритету, первый успех закрывает цикл.
	// Если проб нет, канал один - HTTPS: обмен не должен зависеть от регистра проб.
	Каналы = ПерфОбменТранспорт.ДоступныеКаналы();
	Канал = ?(Каналы.Количество() > 0, Каналы[0], "HTTPS");
	Пометка = ПометитьОтправляемыми(Пакет, Канал);
	Попытка
		Тело = СобратьТело(Пакет);
		// Пустой ключ - стенд работает без подписи (meta: sig.required=false).
		Ключ = КлючHMAC();
		Подпись = ?(ПустаяСтрока(Ключ), "", ПодписьHMAC(Ключ, МеткаUnix() + "." + Тело));
		РезультатОтправки = ПерфОбменТранспорт.ОтправитьПакет(Тело, Подпись);
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = КраткоОшибки(СведенияОбОшибке.Описание);
		ОтметитьНеудачу(Пометка, Канал, 0, ТекстОшибки);
		ПерфСценарии.ЗаписатьМетку("exchange-net:" + Канал + ":" + ТекстОшибки);
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Соединение",
			"Не удалось отправить пакет: " + ТекстОшибки,
			"канал=" + Канал + "; конвертов=" + Строка(Пометка.Количество())
				+ "; адрес=" + СокрЛП(Константы.ПерфОбменАдрес.Получить()));
		Итог.Текст = ТекстОшибки;
		Итог.Осталось = КоличествоВОчереди();
		Возврат Итог;
	КонецПопытки;

	Итог.Канал = РезультатОтправки.Канал;
	Итог.Уровень = РезультатОтправки.Уровень;
	Итог.Код = РезультатОтправки.Код;
	Итог.Текст = Лев(РезультатОтправки.Текст, 500);
	ПерфСценарии.ЗаписатьМетку("exchange-channel:" + РезультатОтправки.Канал
		+ ":" + РезультатОтправки.Код);
	ПерфСценарии.ЗаписатьМетку("exchange-level:" + РезультатОтправки.Уровень);

	Если РезультатОтправки.НужноУтилиту Тогда
		// Конверт требует внешнего агента: остаётся для второй ступени лестницы.
		Для Каждого Идентификатор Из Пометка Цикл
			ОтметитьПоИдентификатору(Идентификатор, "ОжидаетУтилиту", 0, "ждёт утилиту");
		КонецЦикла;
		ПерфСценарии.ЗаписатьМетку("exchange-utility:" + Пометка.Количество());
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Канал",
			"Конверты переданы на ступень утилиты",
			"канал=" + РезультатОтправки.Канал + "; конвертов=" + Строка(Пометка.Количество()),
			"Информация");
	ИначеЕсли (РезультатОтправки.Код = 200 ИЛИ РезультатОтправки.Код = 207)
		И РезультатОтправки.ОжидаетсяJSON И НЕ РезультатОтправки.ЭтоЖсон Тогда
		// Типовая ловушка: SPA или прокси отдают index.html с кодом 200 на любой путь.
		// Принять это за успех значило бы потерять данные, отметив их отправленными.
		ОтметитьОтказ(Пометка, Канал, РезультатОтправки.Код, "ответ не JSON: приёмник не найден");
		ПерфСценарии.ЗаписатьМетку("exchange-notjson:" + РезультатОтправки.Код);
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Ответ",
			"Ответ не JSON: по адресу нет приёмника",
			"код=" + Строка(РезультатОтправки.Код) + "; тип=" + Лев(РезультатОтправки.Текст, 200));
	ИначеЕсли (РезультатОтправки.Код = 200 ИЛИ РезультатОтправки.Код = 207)
		И РезультатОтправки.ОжидаетсяJSON Тогда
		РазобратьОтвет(РезультатОтправки.Текст, Пометка, Итог);
		ПерфСценарии.ЗаписатьМетку("exchange-sent:" + Итог.Отправлено + ":" + РезультатОтправки.Код);
	ИначеЕсли РезультатОтправки.Код = 200 ИЛИ РезультатОтправки.Код = 202 Тогда
		// Файловые и почтовые каналы не возвращают JSON: подтверждение приходит
		// отдельно (ack), поэтому успехом считается принятый транспорт.
		Для Каждого Идентификатор Из Пометка Цикл
			ОтметитьПоИдентификатору(Идентификатор, "Отправлено", РезультатОтправки.Код, "");
		КонецЦикла;
		Итог.Отправлено = Пометка.Количество();
		ПерфСценарии.ЗаписатьМетку("exchange-sent:" + Итог.Отправлено + ":" + РезультатОтправки.Код);
	ИначеЕсли РезультатОтправки.Код = 429 ИЛИ РезультатОтправки.Код >= 500 Тогда
		ОтметитьНеудачу(Пометка, Канал, РезультатОтправки.Код, "повторить позже");
		ПерфСценарии.ЗаписатьМетку("exchange-error:" + РезультатОтправки.Код + ":" + "повторить позже");
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Ответ",
			"Приёмник просит повторить позже",
			"код=" + Строка(РезультатОтправки.Код) + "; тело=" + Лев(РезультатОтправки.Текст, 300),
			"Предупреждение");
	ИначеЕсли РезультатОтправки.ТранспортнаяОшибка ИЛИ РезультатОтправки.Код = 0 Тогда
		// Сеть недоступна: конверт остаётся в очереди и уйдёт при восстановлении канала.
		ОтметитьНеудачу(Пометка, Канал, РезультатОтправки.Код, РезультатОтправки.Текст);
		ПерфСценарии.ЗаписатьМетку("exchange-net:" + Канал + ":" + Лев(РезультатОтправки.Текст, 60));
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Соединение",
			"Отправка не удалась: сообщение осталось в очереди",
			"канал=" + РезультатОтправки.Канал + "; текст=" + Лев(РезультатОтправки.Текст, 300)
				+ "; конвертов=" + Строка(Пометка.Количество()),
			"Предупреждение");
	Иначе
		ОтметитьОтказ(Пометка, Канал, РезультатОтправки.Код, РезультатОтправки.Текст);
		ПерфСценарии.ЗаписатьМетку("exchange-error:" + РезультатОтправки.Код + ":"
			+ Лев(РезультатОтправки.Текст, 40));
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Ответ",
			"Пакет отклонён приёмником",
			"код=" + Строка(РезультатОтправки.Код) + "; тело=" + Лев(РезультатОтправки.Текст, 300)
				+ "; конвертов=" + Строка(Пометка.Количество()));
	КонецЕсли;

	Итог.Осталось = КоличествоВОчереди();
	Возврат Итог;

КонецФункции

// Выборка конвертов к отправке с проверкой целостности.
// Конверт, не прошедший проверку, в пакет не попадает и сразу переходит в Ошибка.
Функция ПодготовитьПакет(МаксимумКонвертов, МаксимумБайт) Экспорт

	Пакет = Новый Массив;
	Всего = 0;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Идентификатор КАК Идентификатор,
		|	Т.Вид КАК Вид,
		|	Т.Тело КАК Тело,
		|	Т.Хеш КАК Хеш,
		|	Т.РазмерБайт КАК РазмерБайт
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|ГДЕ
		|	Т.Статус = &Статус
		|	И Т.ПризнакУтилиты = ЛОЖЬ
		|	И Т.СледующаяПопытка <= &Сейчас
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаСоздания");
	Запрос.УстановитьПараметр("Статус", "Ожидает");
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() И Пакет.Количество() < МаксимумКонвертов Цикл
		Если Всего + Выборка.РазмерБайт > МаксимумБайт Тогда
			Прервать;
		КонецЕсли;

		Если НРег(ХешHex(Выборка.Тело)) <> НРег(СокрЛП(Выборка.Хеш)) Тогда
			ОтметитьПоИдентификатору(Выборка.Идентификатор, "Ошибка", 0, "hash mismatch");
			ПерфСценарии.ЗаписатьМетку("exchange-hashbad:" + Выборка.Идентификатор);
			Продолжить;
		КонецЕсли;

		Пакет.Добавить(Новый Структура("Идентификатор, Вид, Тело, РазмерБайт",
			Выборка.Идентификатор, СокрЛП(Выборка.Вид), Выборка.Тело, Выборка.РазмерБайт));
		Всего = Всего + Выборка.РазмерБайт;
	КонецЦикла;

	Возврат Пакет;

КонецФункции

// Тело запроса: обертка client + batch.
Функция СобратьТело(Пакет) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Запись = Новый ЗаписьJSON;
	Поток = Новый ПотокВПамяти();
	Запись.ОткрытьПоток(Поток, "UTF-8");
	Запись.ЗаписатьНачалоОбъекта();

	Запись.ЗаписатьИмяСвойства("client");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("app");
	Запись.ЗаписатьЗначение("PerfTest");
	Запись.ЗаписатьИмяСвойства("version");
	Запись.ЗаписатьЗначение(СокрЛП(Метаданные.Версия));
	Запись.ЗаписатьИмяСвойства("platform");
	Запись.ЗаписатьЗначение(ПерфСценарии.ВерсияПлатформы());
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("batch");
	Запись.ЗаписатьНачалоМассива();
	ПервыйЭлемент = Истина;
	Для Каждого Конверт Из Пакет Цикл
		// ЗаписатьБезОбработки не ставит разделитель между элементами: запятую пишем сами,
		// иначе массив получается вида [{...}{...}] и приёмник отвечает 400 bad_json.
		Если НЕ ПервыйЭлемент Тогда
			Запись.ЗаписатьБезОбработки(",");
		КонецЕсли;
		ПервыйЭлемент = Ложь;
		// Тело конверта - готовый JSON: пишем без обработки, иначе платформа
		// воспримет строку как значение и экранирует её как строку.
		Запись.ЗаписатьБезОбработки(Конверт.Тело);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

	Запись.ЗаписатьКонецОбъекта();
	Запись.Закрыть();

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Поток.ЗакрытьИПолучитьДвоичныеДанные(), КодировкаТекста.UTF8);

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Сборка",
			"Не удалось собрать тело пакета",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат "";
	КонецПопытки;

КонецФункции

// Пометка ВОтправке ДО сети: второй сеанс эти записи не увидит.
Функция ПометитьОтправляемыми(Пакет, Канал) Экспорт

	Пометка = Новый Массив;
	Для Каждого Конверт Из Пакет Цикл
		Менеджер = РегистрыСведений.ПерфОчередьОбмена.СоздатьМенеджерЗаписи();
		Менеджер.Идентификатор = Конверт.Идентификатор;
		Менеджер.Прочитать();
		Если Менеджер.Идентификатор <> Конверт.Идентификатор Тогда
			Продолжить;
		КонецЕсли;
		Менеджер.Статус = "ВОтправке";
		Менеджер.Канал = Канал;
		Менеджер.Попыток = Менеджер.Попыток + 1;
		Менеджер.СледующаяПопытка = ТекущаяДатаСеанса() + 600;
		Менеджер.Записать();
		Пометка.Добавить(Конверт.Идентификатор);
	КонецЦикла;
	Возврат Пометка;

КонецФункции

Процедура ОтметитьНеудачу(Пометка, Канал, Код, Текст) Экспорт

	Для Каждого Идентификатор Из Пометка Цикл
		Менеджер = РегистрыСведений.ПерфОчередьОбмена.СоздатьМенеджерЗаписи();
		Менеджер.Идентификатор = Идентификатор;
		Менеджер.Прочитать();
		Если Менеджер.Идентификатор <> Идентификатор Тогда
			Продолжить;
		КонецЕсли;
		Менеджер.Статус = "Ожидает";
		Менеджер.Канал = Канал;
		Менеджер.Циклов = Менеджер.Циклов + 1;
		Менеджер.КодОтвета = Код;
		Менеджер.ТекстОтвета = Лев(Текст, 500);
		Менеджер.СледующаяПопытка = ТекущаяДатаСеанса() + ПаузаСекунд(Менеджер.Циклов);
		Менеджер.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура ОтметитьОтказ(Пометка, Канал, Код, Текст) Экспорт

	Для Каждого Идентификатор Из Пометка Цикл
		ОтметитьПоИдентификатору(Идентификатор, "Ошибка", Код, Текст);
	КонецЦикла;

КонецПроцедуры

Процедура ОтметитьПоИдентификатору(Идентификатор, Статус, Код, Текст)

	Менеджер = РегистрыСведений.ПерфОчередьОбмена.СоздатьМенеджерЗаписи();
	Менеджер.Идентификатор = Идентификатор;
	Менеджер.Прочитать();
	Если Менеджер.Идентификатор <> Идентификатор Тогда
		Возврат;
	КонецЕсли;
	Менеджер.Статус = Статус;
	Менеджер.КодОтвета = Код;
	Менеджер.ТекстОтвета = Лев(КраткоОшибки(Текст), 500);
	Если Статус = "Отправлено" Тогда
		Менеджер.ДатаОтправки = ТекущаяДатаСеанса();
	КонецЕсли;
	Менеджер.Записать();

КонецПроцедуры

// Разбор ответа: 207 разбирается по items, 200 без items считается полным успехом.
Процедура РазобратьОтвет(ТелоСтрокой, Пометка, Итог) Экспорт

	Статусы = Новый Соответствие;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоСтрокой);
		Ответ = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("items") Тогда
			Для Каждого Элемент Из Ответ.items Цикл
				Статусы.Вставить(СокрЛП(Элемент.id), СокрЛП(Элемент.status));
			КонецЦикла;
		КонецЕсли;
	Исключение
		Статусы = Новый Соответствие;
	КонецПопытки;

	Для Каждого Идентификатор Из Пометка Цикл
		Статус = Статусы.Получить(Идентификатор);
		// duplicate - тот же конверт уже принят ранее (например, повтор после таймаута).
		// Для отправки это успех: иначе запись навсегда осталась бы в «Ошибка» и
		// уходила бы в повтор бесконечно: сервер всегда отвечает duplicate на тот же id.
		Если Статус = Неопределено ИЛИ Статус = "ok" ИЛИ Статус = "duplicate" Тогда
			ОтметитьПоИдентификатору(Идентификатор, "Отправлено", 200, "");
			Итог.Отправлено = Итог.Отправлено + 1;
		Иначе
			ОтметитьПоИдентификатору(Идентификатор, "Ошибка", 207, Статус);
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецЕсли;
	КонецЦикла;

	// Частичный приём: сервер вернул 207 и часть конвертов отклонил.
	// Одна запись на пакет, иначе журнал забьётся строками по каждому конверту.
	Если Итог.Ошибок > 0 Тогда
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Разбор",
			"Приёмник принял не все конверты",
			"принято=" + Строка(Итог.Отправлено) + "; отклонено=" + Строка(Итог.Ошибок),
			"Предупреждение");
	КонецЕсли;

КонецПроцедуры

// Снятие зависших: пометка ВОтправке, висящая дольше 10 минут, возвращается в Ожидает.
Функция СнятьЗависшие(Минут = 10) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|ГДЕ
		|	Т.Статус = &Статус
		|	И Т.ПометкаОтправки < &Граница");
	Запрос.УстановитьПараметр("Статус", "ВОтправке");
	// Граница считается от времени пометки, а не от СледующаяПопытка: иначе окно
	// сдвигается на величину паузы и запись висит вдвое дольше (ТЗ 4, 6.1).
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - Минут * 60);
	Выборка = Запрос.Выполнить().Выбрать();

	Снято = 0;
	Пока Выборка.Следующий() Цикл
		Менеджер = РегистрыСведений.ПерфОчередьОбмена.СоздатьМенеджерЗаписи();
		Менеджер.Идентификатор = Выборка.Идентификатор;
		Менеджер.Прочитать();
		Если Менеджер.Идентификатор <> Выборка.Идентификатор Тогда
			Продолжить;
		КонецЕсли;
		Менеджер.Статус = "Ожидает";
		Менеджер.СледующаяПопытка = ТекущаяДатаСеанса();
		Менеджер.ПометкаОтправки = Дата(1, 1, 1);
		Менеджер.Записать();
		Снято = Снято + 1;
	КонецЦикла;

	Если Снято > 0 Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-unstuck:" + Снято);
	КонецЕсли;
	Возврат Снято;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Не удалось снять зависшие конверты",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат 0;
	КонецПопытки;

КонецФункции

// Возврат ошибочных конвертов в очередь: нужно после смены токена или починки приёмника.
Функция СброситьОшибки() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|ГДЕ
		|	Т.Статус = &Статус");
	Запрос.УстановитьПараметр("Статус", "Ошибка");
	Выборка = Запрос.Выполнить().Выбрать();

	Сброшено = 0;
	Пока Выборка.Следующий() Цикл
		Менеджер = РегистрыСведений.ПерфОчередьОбмена.СоздатьМенеджерЗаписи();
		Менеджер.Идентификатор = Выборка.Идентификатор;
		Менеджер.Прочитать();
		Если Менеджер.Идентификатор <> Выборка.Идентификатор Тогда
			Продолжить;
		КонецЕсли;
		Менеджер.Статус = "Ожидает";
		Менеджер.Попыток = 0;
		Менеджер.Циклов = 0;
		Менеджер.СледующаяПопытка = ТекущаяДатаСеанса();
		Менеджер.ПометкаОтправки = Дата(1, 1, 1);
		Менеджер.Записать();
		Сброшено = Сброшено + 1;
	КонецЦикла;

	Если Сброшено > 0 Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-reset:" + Сброшено);
	КонецЕсли;
	Возврат Сброшено;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Не удалось вернуть ошибки в очередь",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат 0;
	КонецПопытки;

КонецФункции

// Чистка подтверждённых записей: очередь не должна расти бесконечно.
Функция ОчиститьОтправленные(Дней = 30) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|ГДЕ
		|	Т.Статус = &Статус
		|	И Т.ДатаСоздания < &Граница");
	Запрос.УстановитьПараметр("Статус", "Отправлено");
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - Дней * 86400);
	Выборка = Запрос.Выполнить().Выбрать();

	Удалено = 0;
	Пока Выборка.Следующий() Цикл
		Менеджер = РегистрыСведений.ПерфОчередьОбмена.СоздатьМенеджерЗаписи();
		Менеджер.Идентификатор = Выборка.Идентификатор;
		Менеджер.Прочитать();
		Если Менеджер.Идентификатор = Выборка.Идентификатор Тогда
			Менеджер.Удалить();
			Удалено = Удалено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Удалено;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Не удалось очистить отправленные",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция ПаузаСекунд(Циклов) Экспорт

	Шаги = Новый Массив;
	Шаги.Добавить(1);
	Шаги.Добавить(5);
	Шаги.Добавить(15);
	Шаги.Добавить(60);
	Шаги.Добавить(300);
	Шаги.Добавить(900);
	Индекс = Мин(Циклов, Шаги.Количество() - 1);
	Если Индекс < 0 Тогда
		Индекс = 0;
	КонецЕсли;
	База = Шаги[Индекс];
	Возврат База;

КонецФункции

#КонецОбласти

#Область Сертификаты

// Сертификат удостоверяющего центра портала хранится в базе (регистр ПерфОбменСертификат).
// Зачем: на новом сервере хранилище ОС пустое, и проверка сертификата сервера
// обрывает обмен ("удаленный узел не прошел проверку"). Сертификат в базе едет
// вместе с .dt и не требует ни установки в хранилище, ни прав администратора.
//
// Хранится только открытая часть (CA), приватного ключа здесь нет: утечка базы
// не даёт возможности выдать себя за портал. Подменять сертификат в базе
// по-прежнему может любой, у кого есть право записи в регистр.

Функция ПрочитатьСертификат() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Результат = Новый Структура("Есть, Сертификат, Отпечаток, Комментарий, ДействуетДо", Ложь, "", "", "", "");

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|
		|	Т.Сертификат КАК Сертификат,
		|	Т.Отпечаток КАК Отпечаток,
		|	Т.Комментарий КАК Комментарий,
		|	Т.ДействуетДо КАК ДействуетДо
		|ИЗ
		|	РегистрСведений.ПерфОбменСертификат КАК Т
		|ГДЕ
		|	Т.Ключ = &Ключ");
	Запрос.УстановитьПараметр("Ключ", "CA");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Сертификат = Выборка.Сертификат;
		Результат.Есть = НЕ ПустаяСтрока(Результат.Сертификат);
		Результат.Отпечаток = СокрЛП(Выборка.Отпечаток);
		Результат.Комментарий = СокрЛП(Выборка.Комментарий);
		Результат.ДействуетДо = Выборка.ДействуетДо;
	КонецЕсли;

	Возврат Результат;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Сертификат",
			"Не удалось прочитать сертификат из базы",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Есть, Сертификат, Отпечаток, Комментарий, ДействуетДо", Ложь, "", "", "", "");
	КонецПопытки;

КонецФункции

Процедура ЗаписатьСертификат(ПЕМ, Комментарий = "", ДействуетДо = "", Ключ = "CA") Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Менеджер = РегистрыСведений.ПерфОбменСертификат.СоздатьМенеджерЗаписи();
	// Ключ CA - сертификат портала для проверки TLS; CMS - сертификат получателя
	// для шифрования конверта (это разные сертификаты).
	Менеджер.Ключ = ?(ПустаяСтрока(Ключ), "CA", Лев(СокрЛП(Ключ), 64));
	Менеджер.Сертификат = ПЕМ;
	Менеджер.Отпечаток = ХешHex(ПЕМ);
	Менеджер.Комментарий = Лев(СокрЛП(Комментарий), 250);
	Если ТипЗнч(ДействуетДо) = Тип("Дата") Тогда
		Менеджер.ДействуетДо = ДействуетДо;
	КонецЕсли;
	Менеджер.Изменён = ТекущаяДатаСеанса();
	Менеджер.КемИзменён = Лев(СокрЛП(ИмяПользователя()), 100);
	Менеджер.Записать();

	ПерфСценарии.ЗаписатьМетку("exchange-cert:saved:" + Лев(Менеджер.Отпечаток, 12));

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Сертификат",
			"Не удалось записать сертификат в базу",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
	КонецПопытки;

КонецПроцедуры

Процедура УдалитьСертификат() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Менеджер = РегистрыСведений.ПерфОбменСертификат.СоздатьМенеджерЗаписи();
	Менеджер.Ключ = "CA";
	Менеджер.Удалить();
	ПерфСценарии.ЗаписатьМетку("exchange-cert:cleared");

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Сертификат",
			"Не удалось удалить сертификат",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
	КонецПопытки;

КонецПроцедуры

// Платформа умеет читать УЦ только из файла (СертификатыУдостоверяющихЦентровФайл),
// поэтому PEM из базы на время запроса кладётся во временный каталог сервера.
Функция ЗаписатьВременныйФайлСертификата(ПЕМ) Экспорт

	Путь = КаталогВременныхФайлов() + "perf-ca-" + Лев(ХешHex(ПЕМ), 16) + ".pem";
	ПолучитьДвоичныеДанныеИзСтроки(ПЕМ, КодировкаТекста.UTF8).Записать(Путь);
	Возврат Путь;

КонецФункции

Процедура УдалитьВременныйФайлСертификата(Путь) Экспорт

	Если ПустаяСтрока(Путь) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если ФайлЕсть(Путь) Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
		ПерфСценарии.ЗаписатьМетку("exchange-cert:file-busy");
	КонецПопытки;

КонецПроцедуры

// Загрузка из файла подготовки: obmen-ca-in.pem в каталоге секретов.
// Файл удаляется после записи в базу, чтобы открытая часть не осталась на диске.
Функция ИмпортироватьСертификат(Комментарий = "") Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Путь = КаталогСекрета() + "obmen-ca-in.pem";
	Если НЕ ФайлЕсть(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	ПЕМ = Чтение.Прочитать();
	Чтение.Закрыть();
	УдалитьФайлы(Путь);

	Если СтрНайти(ПЕМ, "BEGIN CERTIFICATE") = 0 Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-cert:bad-file");
		Возврат Ложь;
	КонецЕсли;

	ЗаписатьСертификат(ПЕМ, Комментарий);
	Возврат Истина;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Сертификат",
			"Не удалось импортировать сертификат из файла",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Соединение

// Соединение и уровень защиты.
// Без параметров ЗащищенноеСоединениеOpenSSL не проверяет сертификат сервера:
// это документированное поведение, на нем и строится правило "сертификат не блокирует обмен".
Функция ОткрытьСоединение(БезПроверки = Ложь, Порт = 0, Прокси = Неопределено,
	ТаймаутСекунд = 0) Экспорт

	Адрес = РазобратьАдрес(Константы.ПерфОбменАдрес.Получить());
	Если Порт <= 0 Тогда
		Порт = Адрес.Порт;
	КонецЕсли;
	Таймаут = ?(ТаймаутСекунд > 0, ТаймаутСекунд, Константы.ПерфОбменТаймаут.Получить());
	Если Таймаут <= 0 Тогда
		Таймаут = 30;
	КонецЕсли;

	Уровень = "B";
	Причина = "сертификат сервера не проверен";
	Источник = "нет";
	Защита = Неопределено;
	ВременныйФайл = "";

	// HTTP 80 идёт без TLS: защита обеспечивается CMS-шифрованием конверта.
	Если Порт = 80 Тогда
		Соединение = Новый HTTPСоединение(Адрес.Хост, Порт, , , Прокси, Таймаут);
		Возврат Новый Структура("Соединение, Уровень, Причина, Хост, Порт, Источник, ВременныйФайл",
			Соединение, "C", "без TLS, требуется CMS-конверт", Адрес.Хост, Порт, "нет", "");
	КонецЕсли;

	// Явный отказ от проверки: повторная попытка после отказа проверки сертификата.
	Если БезПроверки Тогда
		Защита = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение(Адрес.Хост, Порт, , , Прокси, Таймаут, Защита);
		Возврат Новый Структура("Соединение, Уровень, Причина, Хост, Порт, Источник, ВременныйФайл",
			Соединение, "B", "проверка отключена принудительно", Адрес.Хост, Порт, "нет", "");
	КонецЕсли;

	// 1. Сертификат из базы: основной путь для переносимой базы.
	Сертификат = ПрочитатьСертификат();
	Если Сертификат.Есть Тогда
		Попытка
			ВременныйФайл = ЗаписатьВременныйФайлСертификата(Сертификат.Сертификат);
			УЦ = Новый СертификатыУдостоверяющихЦентровФайл(ВременныйФайл);
			Защита = Новый ЗащищенноеСоединениеOpenSSL(, УЦ);
			Уровень = "A";
			Причина = "";
			Источник = "база";
		Исключение
			Причина = КраткоОшибки(ОписаниеОшибки());
			УдалитьВременныйФайлСертификата(ВременныйФайл);
			ВременныйФайл = "";
			Защита = Неопределено;
			ПерфСценарии.ЗаписатьМетку("exchange-cert:open-failed");
		КонецПопытки;
	КонецЕсли;

	// 2. Хранилище ОС: если в базе сертификата нет или он не подошёл.
	Если Защита = Неопределено Тогда
		Попытка
			Защита = Новый ЗащищенноеСоединениеOpenSSL(, СертификатыУЦОС());
			Уровень = "A";
			Причина = "";
			Источник = "ОС";
		Исключение
			Защита = Новый ЗащищенноеСоединениеOpenSSL();
			Источник = "нет";
		КонецПопытки;
	КонецЕсли;

	Соединение = Новый HTTPСоединение(Адрес.Хост, Порт, , , Прокси, Таймаут, Защита);
	Возврат Новый Структура("Соединение, Уровень, Причина, Хост, Порт, Источник, ВременныйФайл",
		Соединение, Уровень, Причина, Адрес.Хост, Порт, Источник, ВременныйФайл);

КонецФункции

// Разбор адреса: допускаются https://host, host, host:port.
Функция РазобратьАдрес(Адрес) Экспорт

	СтрокаАдреса = НРег(СокрЛП(Адрес));
	СтрокаАдреса = СтрЗаменить(СтрокаАдреса, "https://", "");
	СтрокаАдреса = СтрЗаменить(СтрокаАдреса, "http://", "");
	Порт = Константы.ПерфОбменПорт.Получить();
	Если Порт <= 0 Тогда
		Порт = 443;
	КонецЕсли;

	Позиция = СтрНайти(СтрокаАдреса, ":");
	Если Позиция > 0 Тогда
		ПортСтрокой = Сред(СтрокаАдреса, Позиция + 1);
		Попытка
			Порт = Число(ПортСтрокой);
		Исключение
			Порт = 443;
		КонецПопытки;
		СтрокаАдреса = Лев(СтрокаАдреса, Позиция - 1);
	КонецЕсли;

	Возврат Новый Структура("Хост, Порт", СтрокаАдреса, Порт);

КонецФункции

Функция СертификатыУЦОС() Экспорт

	Попытка
		Возврат Новый СертификатыУдостоверяющихЦентровОС;
	Исключение
		ВызватьИсключение "Нет хранилища сертификатов ОС";
	КонецПопытки;

КонецФункции

Функция ПроксиИзНастроек() Экспорт

	Попытка
		Прокси = Неопределено;
		Возврат Прокси;
	Исключение
