// Настройки пробы с рабочего места: адрес приёмника, прокси, таймаут и ресурсы
// HTTP-каналов. Клиент не читает ни константы, ни регистры - всё приходит готовым.
Функция ПараметрыПробыКлиента() Экспорт

	Попытка
		Адрес = РазобратьАдрес(Константы.ПерфОбменАдрес.Получить());
		Если ПустаяСтрока(Адрес.Хост) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Прокси = ПроксиИзНастроек();

		Каналы = Новый Массив;
		Для Каждого Код Из ПерфОбменТранспорт.ВсеКаналы() Цикл
			Параметры = ПерфОбменТранспорт.ПараметрыКанала(Код);
			Если Код = "HTTPS" ИЛИ Код = "HTTPS8443" ИЛИ Код = "HTTP80" Тогда
				Каналы.Добавить(Новый Структура("Канал, Порт, Ресурс", Код, Параметры.Порт,
					БазовыйПуть() + "/api/v1/meta"));
			ИначеЕсли Код = "WEBDAV" Тогда
				Каналы.Добавить(Новый Структура("Канал, Порт, Ресурс", Код, Параметры.Порт,
					Параметры.ПутьВходящие + "/"));
			ИначеЕсли Код = "PROXY" И Прокси <> Неопределено Тогда
				// Канал PROXY проверяется, только когда прокси действительно настроен.
				Каналы.Добавить(Новый Структура("Канал, Порт, Ресурс", Код, Параметры.Порт,
					БазовыйПуть() + "/api/v1/meta"));
			КонецЕсли;
		КонецЦикла;

		Возврат Новый Структура("Хост, Прокси, Таймаут, Каналы",
			Адрес.Хост, Прокси, ПерфОбменТранспорт.ТаймаутПробы(), Каналы);
	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Проба",
			"Не удалось подготовить пробу с рабочего места",
			КраткоОшибки(ОписаниеОшибки()), "Предупреждение", "", "", "сервер");
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Запись пробы узла "Клиент": строки готовит клиент, узел и срок годности - сервер.
Процедура ЗаписатьПробуКлиента(Результаты, ИмяПК, Процесс) Экспорт

	ПерфОбменТранспорт.ЗаписатьПробы(Результаты, "Клиент",
		"клиент " + ?(ПустаяСтрока(ИмяПК), ИмяКомпьютера(), ИмяПК), ИмяПК, Процесс);

КонецПроцедуры

// Задание пробы: выполняется фоном, результат уходит в регистр ПерфОбменПроба
// и маркером в лог. Отдельная процедура нужна, чтобы задание писалось с одним
// именем метода и чтобы факт прохода был виден без чтения регистра.
Процедура ПробаКаналовЗадание() Экспорт

	Попытка
		Пробы = ПерфОбменТранспорт.ПроверитьКаналы();
		Доступно = 0;
		Для Каждого Проба Из Пробы Цикл
			Если Проба.Доступен Тогда
				Доступно = Доступно + 1;
			КонецЕсли;
		КонецЦикла;
		ПерфСценарии.ЗаписатьМетку("probe:rows=" + Строка(Пробы.Количество())
			+ ";ok=" + Строка(Доступно));
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		ПерфСценарии.ЗаписатьМетку("probe:error " + КраткоОшибки(СведенияОбОшибке.Описание));
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Проба",
			"Фоновая проба каналов завершилась ошибкой",
			КраткоОшибки(СведенияОбОшибке.Описание),
			"Предупреждение", "", "", "сервер");
	КонецПопытки;

КонецПроцедуры

// Запуск фоновой пробы. Вызывается при старте сеанса и кнопкой «Запустить все».
// Повторный запуск поверх активного задания не создаётся: проба перезаписывает
// регистр целиком, две параллельные пробы затирали бы записи друг друга.
// Возвращает УИД задания, пустая строка - проба уже идёт или запуск не удался.
Функция ПроверитьКаналыФон() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
		// Пробовать нечего, пока нет записей каналов: создаём типовые (все выключены).
		ПерфОбменТранспорт.ОбеспечитьКаналы();
		Отбор = Новый Структура("Ключ, Состояние", "ПерфОбменПроба",
			СостояниеФоновогоЗадания.Активно);
		Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0 Тогда
			Возврат "";
		КонецЕсли;
		Задание = ФоновыеЗадания.Выполнить("ПерфОбмен.ПробаКаналовЗадание", Новый Массив,
			"ПерфОбменПроба", "Проба каналов обмена");
		Возврат ?(Задание = Неопределено, "", Строка(Задание.УникальныйИдентификатор));

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Проба",
			"Не удалось запустить фоновую пробу каналов",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Самотест

// Служебный режим /CПерфОбменСамотест: проверки без сети и без записи в регистры.
// Векторы - RFC 4231 (значения посчитаны независимой реализацией HMAC-SHA-256).
Функция СамоТест() Экспорт

	Итог = Новый Структура("Векторы, Сборка, Подпись, Разбор, Ошибки, Пакет, Время, Паспорт",
		0, Ложь, Ложь, Ложь, "", Ложь, Ложь, Ложь);

	// 1. Четыре вектора HMAC: каждый со своим маркером, чтобы видеть расхождение.
	Первый = Вектор("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", "Hi There",
		"b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7");
	ПерфСценарии.ЗаписатьМетку("vec1:" + ?(Первый.Ок, "ok", Лев(Первый.Факт, 16)));
	Итог.Векторы = Итог.Векторы + ?(Первый.Ок, 1, 0);
	Второй = Вектор("4a656665", "what do ya want for nothing?",
		"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
	ПерфСценарии.ЗаписатьМетку("vec2:" + ?(Второй.Ок, "ok", Лев(Второй.Факт, 16)));
	Итог.Векторы = Итог.Векторы + ?(Второй.Ок, 1, 0);
	Третий = ВекторПоХексу("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
		"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
		"773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe");
	ПерфСценарии.ЗаписатьМетку("vec3:" + ?(Третий.Ок, "ok", Лев(Третий.Факт, 16)));
	Итог.Векторы = Итог.Векторы + ?(Третий.Ок, 1, 0);
	Четвертый = ВекторПоХексу("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
		"54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374",
		"60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54");
	ПерфСценарии.ЗаписатьМетку("vec4:" + ?(Четвертый.Ок, "ok", Лев(Четвертый.Факт, 16)));
	Итог.Векторы = Итог.Векторы + ?(Четвертый.Ок, 1, 0);

	// 2. Сборка конверта: идентификатор стабилен, размер в пределах, JSON разбирается.
	Попытка
		Данные = Новый Структура("МедианаМс, НаЕдиницуМс, МинМс, МаксМс, Порция, Единица, Повторов, ДатаЗамера",
			84, 1680, 82, 91, 50000, "итераций", 3, ТекущаяДатаСеанса());
		Первый = СобратьКонвертРезультат("СЕЛФТЕСТ", "CPU_Арифметика", Данные);
		Второй = СобратьКонвертРезультат("СЕЛФТЕСТ", "CPU_Арифметика", Данные);
		Итог.Сборка = (Первый.Идентификатор = Второй.Идентификатор)
			И (СтрДлина(Первый.Идентификатор) = 45)
			И (Первый.РазмерБайт <= 4096)
			И (Первый.РазмерБайт > 100);
		Если НЕ Итог.Сборка Тогда
			Итог.Ошибки = Итог.Ошибки + "сборка;";
		КонецЕсли;

		// 3. Подпись: тело подписывается и проверяется независимо.
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Первый.Тело);
			Разобранный = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			Итог.Разбор = (ТипЗнч(Разобранный) = Тип("Структура"))
				И Разобранный.Свойство("kind")
				И (Разобранный.kind = "result")
				И (Разобранный.id = Первый.Идентификатор);
			Если НЕ Итог.Разбор Тогда
				Итог.Ошибки = Итог.Ошибки + "разбор;";
			КонецЕсли;
		Исключение
			Итог.Ошибки = Итог.Ошибки + "json;";
		КонецПопытки;

		Итог.Подпись = (СтрДлина(ПодписьHMAC(Base64Строка(ПолучитьДвоичныеДанныеИзHexСтроки("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")), "проверка")) = 43);

		// 3b. Время: метка Unix должна быть правдоподобной (2023..2033) и совпадать
		// со строковой формой. Ловит ошибку масштаба: секунды против суток.
		Секунды = МеткаUnixСекунд(ТекущаяДатаСеанса());
		Итог.Время = (Секунды > 1672531200) И (Секунды < 2000000000)
			И (Число(МеткаUnix()) = Секунды);
		ПерфСценарии.ЗаписатьМетку("exchange-time:" + ?(Итог.Время, "ok", "fail") + ":" + Строка(Секунды));
		Если НЕ Итог.Время Тогда
			Итог.Ошибки = Итог.Ошибки + "время;";
		КонецЕсли;

		// 3c. Паспорт: конверт собирается, id вида p-, fingerprint 64 hex,
		// свойства читаются из регистра. Приёмник требует именно такой формы.
		Попытка
			Паспорт = СобратьКонвертПаспорт(ПерфСценарии.ИмяСтендаДляЗаписи(""));
			Свойства = 0;
			ОтпечатокОк = Ложь;
			Если ПустаяСтрока(Паспорт.Тело) Тогда
				// Паспорта ещё нет (новая база): проверка неприменима, это не сбой.
				ПерфСценарии.ЗаписатьМетку("exchange-passport:skip-empty");
				Итог.Паспорт = Истина;
			КонецЕсли;
			Если НЕ ПустаяСтрока(Паспорт.Тело) Тогда
				ЧтениеПаспорта = Новый ЧтениеJSON;
				ЧтениеПаспорта.УстановитьСтроку(Паспорт.Тело);
				РазобранныйПаспорт = ПрочитатьJSON(ЧтениеПаспорта);
				ЧтениеПаспорта.Закрыть();
				Если РазобранныйПаспорт.Свойство("passport") И РазобранныйПаспорт.passport.Свойство("properties") Тогда
					Свойства = РазобранныйПаспорт.passport.properties.Количество();
				КонецЕсли;
				Если РазобранныйПаспорт.Свойство("stand") Тогда
					ОтпечатокОк = НЕ НеЭтоХеш64(РазобранныйПаспорт.stand.fingerprint);
				КонецЕсли;
				Итог.Паспорт = (Лев(Паспорт.Идентификатор, 2) = "p-")
					И (СтрДлина(Паспорт.Идентификатор) = 45)
					И (Свойства >= 40) И ОтпечатокОк;
			КонецЕсли;
			ПерфСценарии.ЗаписатьМетку("exchange-passport-id:" + ?(Итог.Паспорт, "ok", "fail")
				+ ":props=" + Строка(Свойства));
			Если НЕ Итог.Паспорт Тогда
				Итог.Ошибки = Итог.Ошибки + "паспорт;";
			КонецЕсли;
		Исключение
			Итог.Ошибки = Итог.Ошибки + "паспорт;";
		КонецПопытки;

		// 4. Пакет: два конверта в массиве batch, JSON разбирается целиком.
		// Проверка ловит дефект разделителя: без запятой приёмник отвечает 400 bad_json.
		Попытка
			СписокКонвертов = Новый Массив;
			СписокКонвертов.Добавить(Первый);
			СписокКонвертов.Добавить(Второй);
			ТелоПакета = СобратьТело(СписокКонвертов);
			ЧтениеПакета = Новый ЧтениеJSON;
			ЧтениеПакета.УстановитьСтроку(ТелоПакета);
			ПакетРазобранный = ПрочитатьJSON(ЧтениеПакета);
			ЧтениеПакета.Закрыть();
			Итог.Пакет = (ТипЗнч(ПакетРазобранный) = Тип("Структура"))
				И ПакетРазобранный.Свойство("batch")
				И (ПакетРазобранный.batch.Количество() = 2);
			Если Итог.Пакет Тогда
				// Приемник ждет int64: строка здесь дает 400 bad_json на живой отправке.
				ПервыйКонверт = ПакетРазобранный.batch[0];
				Итог.Пакет = (ТипЗнч(ПервыйКонверт.measured_at_utc) = Тип("Число"))
					И (ПервыйКонверт.measured_at_utc > 1600000000);
			КонецЕсли;
			Если НЕ Итог.Пакет Тогда
				Итог.Ошибки = Итог.Ошибки + "пакет;";
			КонецЕсли;
		Исключение
			Итог.Ошибки = Итог.Ошибки + "пакет;" + КраткоОшибки(ОписаниеОшибки()) + ";";
		КонецПопытки;
	Исключение
		Итог.Ошибки = Итог.Ошибки + КраткоОшибки(ОписаниеОшибки());
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Проверка одного вектора: ключ в hex, данные строкой.
Функция Вектор(КлючHex, ТекстДанных, ОжидаемыйHex)

	Ключ = Base64Строка(ПолучитьДвоичныеДанныеИзHexСтроки(КлючHex));
	Возврат СравнитьПодпись(ПодписьHMAC(Ключ, ТекстДанных), ОжидаемыйHex);

КонецФункции

// Сверка фактической подписи с эталоном; результат - структура(Ок, Факт).
Функция СравнитьПодпись(Подпись, ОжидаемыйHex)

	Факт = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзBase64Строки(ВосстановитьBase64(Подпись))));
	Возврат Новый Структура("Ок, Факт", Факт = НРег(ОжидаемыйHex), Факт);

КонецФункции

// Проверка вектора с двоичными данными (не текст).
Функция ВекторПоХексу(КлючHex, ДанныеHex, ОжидаемыйHex)

	Ключ = Base64Строка(ПолучитьДвоичныеДанныеИзHexСтроки(КлючHex));
	Возврат СравнитьПодпись(ПодписьHMAC(Ключ, ПолучитьДвоичныеДанныеИзHexСтроки(ДанныеHex)), ОжидаемыйHex);

КонецФункции

// Обратное преобразование base64url в base64 (для сверки hex).
Функция ВосстановитьBase64(СтрокаBase64URL)

	Результат = СтрЗаменить(СтрокаBase64URL, "-", "+");
	Результат = СтрЗаменить(Результат, "_", "/");
	Пока СтрДлина(Результат) % 4 <> 0 Цикл
		Результат = Результат + "=";
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
