#Область Самотест

// Служебный режим /CПерфОбменСамотест: проверки без сети и без записи в регистры.
// Векторы - RFC 4231 (значения посчитаны независимой реализацией HMAC-SHA-256).
Функция СамоТест() Экспорт

	Итог = Новый Структура("Векторы, Сборка, Подпись, Разбор, Ошибки", 0, Ложь, Ложь, Ложь, "");

	// 1. Четыре вектора HMAC: каждый со своим маркером, чтобы видеть расхождение.
	Первый = Вектор("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", "Hi There",
		"b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7");
	ПерфСценарии.ЗаписатьМетку("vec1:" + ?(Первый.Ок, "ok", Лев(Первый.Факт, 16)));
	Итог.Векторы = Итог.Векторы + ?(Первый.Ок, 1, 0);
	Второй = Вектор("4a656665", "what do ya want for nothing?",
		"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
	ПерфСценарии.ЗаписатьМетку("vec2:" + ?(Второй.Ок, "ok", Лев(Второй.Факт, 16)));
	Итог.Векторы = Итог.Векторы + ?(Второй.Ок, 1, 0);
	Третий = ВекторПоХексу("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
		"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
		"773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe");
	ПерфСценарии.ЗаписатьМетку("vec3:" + ?(Третий.Ок, "ok", Лев(Третий.Факт, 16)));
	Итог.Векторы = Итог.Векторы + ?(Третий.Ок, 1, 0);
	Четвертый = ВекторПоХексу("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
		"54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374",
		"60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54");
	ПерфСценарии.ЗаписатьМетку("vec4:" + ?(Четвертый.Ок, "ok", Лев(Четвертый.Факт, 16)));
	Итог.Векторы = Итог.Векторы + ?(Четвертый.Ок, 1, 0);

	// 2. Сборка конверта: идентификатор стабилен, размер в пределах, JSON разбирается.
	Попытка
		Данные = Новый Структура("МедианаМс, НаЕдиницуМс, МинМс, МаксМс, Порция, Единица, Повторов, ДатаЗамера",
			84, 1680, 82, 91, 50000, "итераций", 3, ТекущаяДатаСеанса());
		Первый = СобратьКонвертРезультат("СЕЛФТЕСТ", "CPU_Арифметика", Данные);
		Второй = СобратьКонвертРезультат("СЕЛФТЕСТ", "CPU_Арифметика", Данные);
		Итог.Сборка = (Первый.Идентификатор = Второй.Идентификатор)
			И (СтрДлина(Первый.Идентификатор) = 45)
			И (Первый.РазмерБайт <= 4096)
			И (Первый.РазмерБайт > 100);
		Если НЕ Итог.Сборка Тогда
			Итог.Ошибки = Итог.Ошибки + "сборка;";
		КонецЕсли;

		// 3. Подпись: тело подписывается и проверяется независимо.
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Первый.Тело);
			Разобранный = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			Итог.Разбор = (ТипЗнч(Разобранный) = Тип("Структура"))
				И Разобранный.Свойство("kind")
				И (Разобранный.kind = "result")
				И (Разобранный.id = Первый.Идентификатор);
			Если НЕ Итог.Разбор Тогда
				Итог.Ошибки = Итог.Ошибки + "разбор;";
			КонецЕсли;
		Исключение
			Итог.Ошибки = Итог.Ошибки + "json;";
		КонецПопытки;

		Итог.Подпись = (СтрДлина(ПодписьHMAC(Base64Строка(ПолучитьДвоичныеДанныеИзHexСтроки("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")), "проверка")) = 43);
	Исключение
		Итог.Ошибки = Итог.Ошибки + КраткоОшибки(ОписаниеОшибки());
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Проверка одного вектора: ключ в hex, данные строкой.
Функция Вектор(КлючHex, ТекстДанных, ОжидаемыйHex)

	Ключ = Base64Строка(ПолучитьДвоичныеДанныеИзHexСтроки(КлючHex));
	Возврат СравнитьПодпись(ПодписьHMAC(Ключ, ТекстДанных), ОжидаемыйHex);

КонецФункции

// Сверка фактической подписи с эталоном; результат - структура(Ок, Факт).
Функция СравнитьПодпись(Подпись, ОжидаемыйHex)

	Факт = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзBase64Строки(ВосстановитьBase64(Подпись))));
	Возврат Новый Структура("Ок, Факт", Факт = НРег(ОжидаемыйHex), Факт);

КонецФункции

// Проверка вектора с двоичными данными (не текст).
Функция ВекторПоХексу(КлючHex, ДанныеHex, ОжидаемыйHex)

	Ключ = Base64Строка(ПолучитьДвоичныеДанныеИзHexСтроки(КлючHex));
	Возврат СравнитьПодпись(ПодписьHMAC(Ключ, ПолучитьДвоичныеДанныеИзHexСтроки(ДанныеHex)), ОжидаемыйHex);

КонецФункции

// Обратное преобразование base64url в base64 (для сверки hex).
Функция ВосстановитьBase64(СтрокаBase64URL)

	Результат = СтрЗаменить(СтрокаBase64URL, "-", "+");
	Результат = СтрЗаменить(Результат, "_", "/");
	Пока СтрДлина(Результат) % 4 <> 0 Цикл
		Результат = Результат + "=";
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
