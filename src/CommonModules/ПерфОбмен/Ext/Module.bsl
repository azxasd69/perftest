КонецФункции

// Базовый путь API: у стенда он может быть /perf (сообщается в GET .../api/v1/meta).
Функция БазовыйПуть() Экспорт

	Путь = СокрЛП(Константы.ПерфОбменБазовыйПуть.Получить());
	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(Путь, 1) <> "/" Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	Если Прав(Путь, 1) = "/" Тогда
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;
	Возврат Путь;

КонецФункции

// Признак того, что запрос упал именно на проверке сертификата сервера.
// Русская платформа пишет "Удаленный узел не прошел проверку", английская - про
// certificate/hostname; в обоих случаях повтор без проверки решает задачу.
Функция ЭтоОшибкаПроверкиСертификата(Текст) Экспорт

	Низкий = НРег(Текст);
	Признаки = Новый Массив;
	Признаки.Добавить("не прошел проверку");
	Признаки.Добавить("сертификат");
	Признаки.Добавить("certificate");
	Признаки.Добавить("ssl");
	Признаки.Добавить("tls");
	Для Каждого Признак Из Признаки Цикл
		Если СтрНайти(Низкий, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Один HTTP-вызов с попыткой сохранить проверку сертификата.
// Порядок: уровень A (база -> ОС). Если проверка не прошла - повтор без проверки,
// уровень B, и маркер exchange-tls-downgrade: деградация видна в журнале.
// ТаймаутСекунд = 0 - взять из константы (так работает отправка). Проба передаёт
// короткий таймаут: молчащий порт иначе держит фоновое задание десятки секунд.
Функция ВыполнитьЗапрос(Метод, Путь, Тело = Неопределено, Подпись = "", Порт = 0,
	Прокси = Неопределено, ТаймаутСекунд = 0) Экспорт

	Попытка
		Возврат ВыполнитьЗапросУровня(Метод, Путь, Тело, Подпись, Ложь, Порт, Прокси, ТаймаутСекунд);
	Исключение
		Текст = ОписаниеОшибки();
		Если НЕ ЭтоОшибкаПроверкиСертификата(Текст) Тогда
			ВызватьИсключение Текст;
		КонецЕсли;
		ПерфСценарии.ЗаписатьМетку("exchange-tls-downgrade:" + КраткоОшибки(Текст));
		Возврат ВыполнитьЗапросУровня(Метод, Путь, Тело, Подпись, Истина, Порт, Прокси, ТаймаутСекунд);
	КонецПопытки;

КонецФункции

Функция ВыполнитьЗапросУровня(Метод, Путь, Тело, Подпись, БезПроверки, Порт = 0,
	Прокси = Неопределено, ТаймаутСекунд = 0)

	СоединениеИтог = ОткрытьСоединение(БезПроверки, Порт, Прокси, ТаймаутСекунд);

	Запрос = Новый HTTPЗапрос(Путь);
	Если Тело <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Подпись) Тогда
		Запрос.Заголовки.Вставить("X-Signature", "t=" + МеткаUnix() + ",v1=" + Подпись);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Токен()) Тогда
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен());
	КонецЕсли;
	Запрос.Заголовки.Вставить("X-Stand", ПерфСценарии.ИдентификаторСтендаИзРегистра());
	Запрос.Заголовки.Вставить("X-Schema", "1");
	Запрос.Заголовки.Вставить("X-Level", СоединениеИтог.Уровень);

	Попытка
		Ответ = СоединениеИтог.Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		УдалитьВременныйФайлСертификата(СоединениеИтог.ВременныйФайл);
		ВызватьИсключение ОписаниеОшибки() + " [tls:" + СоединениеИтог.Источник + "]";
	КонецПопытки;

	УдалитьВременныйФайлСертификата(СоединениеИтог.ВременныйФайл);

	Возврат Новый Структура("КодСостояния, ТелоСтрокой, Уровень, ЭтоЖсон, Источник, Ответ",
		Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), СоединениеИтог.Уровень,
		ЭтоОтветJSON(Ответ), СоединениеИтог.Источник, Ответ);

КонецФункции

// Запрос, собранный вызывающим: нужен WebDAV (PUT с двоичным телом, MOVE с
// заголовком Destination). Логика TLS та же, что у ВыполнитьЗапрос.
Функция ВыполнитьЗапросОбъект(Метод, Запрос, Порт = 0, Прокси = Неопределено) Экспорт

	СоединениеИтог = ОткрытьСоединение(Ложь, Порт, Прокси);
	Если НЕ Запрос.Заголовки.Свойство("X-Level") Тогда
		Запрос.Заголовки.Вставить("X-Level", СоединениеИтог.Уровень);
	КонецЕсли;
	Если НЕ Запрос.Заголовки.Свойство("Authorization") И НЕ ПустаяСтрока(Токен()) Тогда
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен());
	КонецЕсли;
	Попытка
		Ответ = СоединениеИтог.Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		УдалитьВременныйФайлСертификата(СоединениеИтог.ВременныйФайл);
		ВызватьИсключение ОписаниеОшибки() + " [tls:" + СоединениеИтог.Источник + "]";
	КонецПопытки;
	УдалитьВременныйФайлСертификата(СоединениеИтог.ВременныйФайл);
	Возврат Новый Структура("КодСостояния, Ответ, Уровень",
		Ответ.КодСостояния, Ответ, СоединениеИтог.Уровень);

КонецФункции

Функция ВыполнитьЗапросПриема(Тело, Подпись) Экспорт

	Ответ = ВыполнитьЗапрос("POST", БазовыйПуть() + "/api/v1/ingest", Тело, Подпись);

	Возврат Новый Структура("КодСостояния, ТелоСтрокой, Уровень, ЭтоЖсон",
		Ответ.КодСостояния, Ответ.ТелоСтрокой, Ответ.Уровень, Ответ.ЭтоЖсон);

КонецФункции

// Ответ API всегда JSON; HTML означает статику или прокси-заглушку.
Функция ЭтоОтветJSON(Ответ) Экспорт

	ТипСодержимого = "";
	Попытка
		ТипСодержимого = НРег(СокрЛП(Ответ.Заголовки.Получить("Content-Type")));
	Исключение
		ТипСодержимого = "";
	КонецПопытки;
	Возврат СтрНайти(ТипСодержимого, "json") > 0;

КонецФункции

// Проверка связи: GET /api/v1/meta.
Функция ПроверитьСвязь() Экспорт

	Результат = Новый Структура("Есть, Код, Текст, Уровень, Источник", Ложь, 0, "", "", "");
	Попытка
		Ответ = ВыполнитьЗапрос("GET", БазовыйПуть() + "/api/v1/meta");
		Результат.Код = Ответ.КодСостояния;
		Результат.Текст = Лев(Ответ.ТелоСтрокой, 500);
		Результат.Уровень = Ответ.Уровень;
		Результат.Источник = Ответ.Источник;
		// Код 200 от статики ничего не значит: связь есть только если ответил именно API.
		Результат.Есть = (Ответ.КодСостояния = 200 И Ответ.ЭтоЖсон);
		Если Ответ.КодСостояния = 200 И НЕ Ответ.ЭтоЖсон Тогда
			Результат.Текст = "ответ не JSON: по адресу нет приёмника";
		КонецЕсли;
	Исключение
		Результат.Текст = КраткоОшибки(ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Состояние

Функция СостояниеОбмена() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Результат = Новый Структура(
		"Включен, ВОчереди, ОжидаетУтилиту, Ошибок, Отправлено24ч, ПоследняяОтправка, Текст, Статус, Канал, Уровень",
		Ложь, 0, 0, 0, 0, "", "", "", "", "");

	Результат.Включен = Константы.ПерфОбменВключен.Получить();
	Если ПустаяСтрока(СокрЛП(Константы.ПерфОбменАдрес.Получить())) Тогда
		Результат.Текст = "адрес не задан";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Статус КАК Статус,
		|	КОЛИЧЕСТВО(*) КАК Счет
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.Статус");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Статус = "Ожидает" ИЛИ Выборка.Статус = "ВОтправке" Тогда
			Результат.ВОчереди = Результат.ВОчереди + Выборка.Счет;
		ИначеЕсли Выборка.Статус = "ОжидаетУтилиту" Тогда
			Результат.ОжидаетУтилиту = Результат.ОжидаетУтилиту + Выборка.Счет;
		ИначеЕсли Выборка.Статус = "Ошибка" Тогда
			Результат.Ошибок = Результат.Ошибок + Выборка.Счет;
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	КОЛИЧЕСТВО(*) КАК Счет,
		|	МАКСИМУМ(Т.ДатаОтправки) КАК Последняя
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|ГДЕ
		|	Т.Статус = &Статус
		|	И Т.ДатаОтправки >= &Граница");
	Запрос.УстановитьПараметр("Статус", "Отправлено");
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - 86400);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Отправлено24ч = Выборка.Счет;
		Результат.ПоследняяОтправка = Выборка.Последняя;
	КонецЕсли;

	// Канал и уровень последней успешной отправки: их показывает чип обмена.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|
		|	Т.Канал КАК Канал,
		|	Т.Уровень КАК Уровень
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|ГДЕ
		|	Т.Статус = &Статус
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаОтправки УБЫВ");
	Запрос.УстановитьПараметр("Статус", "Отправлено");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Канал = СокрЛП(Выборка.Канал);
		Результат.Уровень = Строка(?(Выборка.Уровень = 0, 1, Выборка.Уровень));
	КонецЕсли;

	Результат.Статус = ТекстСостояния(Результат);
	Возврат Результат;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Состояние",
			"Не удалось прочитать состояние обмена",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура(
			"Включен, ВОчереди, ОжидаетУтилиту, Ошибок, Отправлено24ч, ПоследняяОтправка, Текст, Статус, Канал, Уровень",
			Ложь, 0, 0, 0, 0, "", "ошибка чтения состояния", "ошибка", "", "");
	КонецПопытки;

КонецФункции

// Текст чипа обмена (ТЗ 13.1): одна строка, понятная без деталей.
Функция ТекстСостояния(С) Экспорт

	Если НЕ С.Включен Тогда
		Возврат "выключен";
	КонецЕсли;
	Если С.Текст = "адрес не задан" Тогда
		Возврат "адрес не задан";
	КонецЕсли;
	Если С.Ошибок > 0 Тогда
		Возврат "ошибка, " + Строка(С.Ошибок);
	КонецЕсли;
	Если С.ОжидаетУтилиту > 0 Тогда
		Возврат "ждёт утилиту, " + Строка(С.ОжидаетУтилиту);
	КонецЕсли;
	Если С.ВОчереди > 0 Тогда
		Возврат "в очереди, " + Строка(С.ВОчереди);
	КонецЕсли;
	Возврат "ок";

КонецФункции

// Признак того, что конверт передан внешней утилите: повторно его не отправляем.
Процедура ПометитьПризнакУтилиты(Идентификатор) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Менеджер = РегистрыСведений.ПерфОчередьОбмена.СоздатьМенеджерЗаписи();
	Менеджер.Идентификатор = Идентификатор;
	Менеджер.Прочитать();
	Если Менеджер.Идентификатор <> Идентификатор Тогда
		Возврат;
	КонецЕсли;
	Менеджер.ПризнакУтилиты = Истина;
	Менеджер.Записать();

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Не удалось пометить конверт для утилиты",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
	КонецПопытки;

КонецПроцедуры

// Пометка статуса по идентификатору: нужна транспорту (спул, подтверждения).
Процедура ОтметитьПоИдентификаторуПублично(Идентификатор, Статус, Код = 0, Текст = "") Экспорт

	ОтметитьПоИдентификатору(Идентификатор, Статус, Код, Текст);

КонецПроцедуры

// Фоновое задание отправки: фиксированный ключ не дает запустить второе одновременно.
// Ключ задания - третий параметр: Выполнить(ИмяМетода, Параметры, Ключ, Наименование).
Функция ОтправитьОчередьФон() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Задание = ФоновыеЗадания.Выполнить("ПерфОбмен.ОтправитьОчередь", Новый Массив,
		"ПерфОбменОтправка", "Отправка очереди обмена");
	Возврат ?(Задание = Неопределено, "", Строка(Задание.УникальныйИдентификатор));

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Отправка",
			"Не удалось запустить фоновую отправку",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область КонвертПаспорт

// Конверт passport: реквизиты регистра ПерфСтенды как есть.
// Ключи свойств - имена реквизитов 1С: так их читает приёмник
// (tools\portal\internal\store\ingest.go, savePassport). Пустое значение
// уходит как null: на сайте "не собрано" отличается от пустой строки.
Функция СобратьКонвертПаспорт(Стенд) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Ключ = ПерфСценарии.ИмяСтендаДляЗаписи(Стенд);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|
		|	*
		|ИЗ
		|	РегистрСведений.ПерфСтенды КАК Т
		|ГДЕ
		|	Т.Стенд = &Стенд");
	Запрос.УстановитьПараметр("Стенд", Ключ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-passport:нет данных:" + Ключ);
		Возврат Новый Структура("Идентификатор, Тело, Хеш, РазмерБайт", "", "", "", 0);
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Поток = Новый ПотокВПамяти();
	Запись.ОткрытьПоток(Поток, "UTF-8");
	Запись.ЗаписатьНачалоОбъекта();

	Запись.ЗаписатьИмяСвойства("schema");
	Запись.ЗаписатьЗначение(1);
	Запись.ЗаписатьИмяСвойства("id");
	Запись.ЗаписатьЗначение(ЗаглушкаИдентификатора());
	Запись.ЗаписатьИмяСвойства("kind");
	Запись.ЗаписатьЗначение("passport");
	Запись.ЗаписатьИмяСвойства("sig");
	Запись.ЗаписатьЗначение(?(ПустаяСтрока(КлючHMAC()), "none", "hmac-sha256"));

	Запись.ЗаписатьИмяСвойства("stand");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПоляСтенда(Запись, Стенд);
	Запись.ЗаписатьКонецОбъекта();

	ДатаПаспорта = Выборка.ДатаПаспорта;
	Если ДатаПаспорта = Дата(1, 1, 1) Тогда
		ДатаПаспорта = ТекущаяДатаСеанса();
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства("captured_at");
	Запись.ЗаписатьЗначение(ДатаISO(ДатаПаспорта));
	Запись.ЗаписатьИмяСвойства("captured_at_utc");
	Запись.ЗаписатьЗначение(МеткаUnixСекунд(ДатаПаспорта));
	Запись.ЗаписатьИмяСвойства("tz_offset");
	Запись.ЗаписатьЗначение(СмещениеЧасовМин() * 60);

	Запись.ЗаписатьИмяСвойства("passport");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("schema");
	Схема = Выборка.СхемаПаспорта;
	Запись.ЗаписатьЗначение(?(Схема = 0, 3, Схема));
	Запись.ЗаписатьИмяСвойства("properties");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьСвойстваПаспорта(Запись, Выборка);
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьКонецОбъекта();
	Запись.Закрыть();

	ТелоБезИд = ПолучитьСтрокуИзДвоичныхДанных(Поток.ЗакрытьИПолучитьДвоичныеДанные(), КодировкаТекста.UTF8);
	Идентификатор = ИдентификаторКонверта("p", ТелоБезИд);
	Тело = СтрЗаменить(ТелоБезИд, ЗаглушкаИдентификатора(), Идентификатор);

	Возврат Новый Структура("Идентификатор, Тело, Хеш, РазмерБайт",
		Идентификатор, Тело, ХешHex(Тело),
		ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8).Размер());

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Сборка",
			"Не удалось собрать конверт паспорта",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Идентификатор, Тело, Хеш, РазмерБайт", "", "", "", 0);
	КонецПопытки;

КонецФункции

// Свойства паспорта: перебор реквизитов регистра, без списка из 71 имени.
// Так состав полей не разъедется с регистром при добавлении реквизита.
Процедура ЗаписатьСвойстваПаспорта(Запись, Выборка)

	МетаданныеРегистра = Метаданные.РегистрыСведений.ПерфСтенды;
	Для Каждого Реквизит Из МетаданныеРегистра.Реквизиты Цикл
		ЗаписатьЗначениеПаспорта(Запись, Реквизит.Имя, Выборка[Реквизит.Имя]);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьЗначениеПаспорта(Запись, Имя, Значение)

	Запись.ЗаписатьИмяСвойства(Имя);
	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Запись.ЗаписатьЗначение(Неопределено);
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Если Значение = Дата(1, 1, 1) Тогда
			Запись.ЗаписатьЗначение(Неопределено);
		Иначе
			Запись.ЗаписатьЗначение(ДатаISOUTS(Значение));
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Если ПустаяСтрока(Значение) Тогда
			Запись.ЗаписатьЗначение(Неопределено);
		Иначе
			// Пароль в строке соединения вырезается до записи в регистр
			// (СтрокаСоединенияБезПароля), здесь только страховка от старой записи.
			Запись.ЗаписатьЗначение(ЗамаскироватьПароль(Значение));
		КонецЕсли;
	Иначе
		Запись.ЗаписатьЗначение(Значение);
	КонецЕсли;

КонецПроцедуры

Функция ЗамаскироватьПароль(Значение) Экспорт

	Если СтрНайти(НРег(Значение), "pwd=") = 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Части = СтрРазделить(Значение, ";");
	Результат = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если Лев(НРег(СокрЛП(Часть)), 4) = "pwd=" Тогда
			Результат.Добавить("Pwd=***");
		Иначе
			Результат.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Результат, ";");

КонецФункции

// Постановка паспорта в очередь. Вызывается только после фактической записи
// паспорта: 20 КБ на каждый прогон не уходят (ТЗ 12.2).
Функция ПоставитьВОчередьПаспорт(Стенд) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Конверт = СобратьКонвертПаспорт(Стенд);
	Результат = ЗаписатьВОчередь(Конверт, "passport", Стенд,
		"HTTPS,HTTPS8443,PROXY,WEBDAV,FTP,SMTP,SFTP");
	Если Результат.Создана И Конверт.РазмерБайт > 20480 Тогда
		// Контракт держит до 262144 байт, но паспорт больше 20 КБ - признак
		// разросшегося списка значений; фиксируем в маркере, не отказываем.
		ПерфСценарии.ЗаписатьМетку("exchange-passport-size:" + Конверт.РазмерБайт);
	КонецЕсли;
	Возврат Результат;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Не удалось поставить паспорт в очередь",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Идентификатор, Создана, ВОчереди", "", Ложь, 0);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область КонвертИстория

// Конверт history: точки регистра ПерфИстория в массиве history.
// Приёмник ждёт measured_at_utc у каждой точки и не более 500 точек на конверт.
Функция СобратьКонвертИсторию(Стенд, Сценарий, ОтДаты, ПоДату, Смещение = 0) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Ключ = ПерфСценарии.ИмяСтендаДляЗаписи(Стенд);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 500
		|
		|	Т.Сценарий КАК Сценарий,
		|	Т.ДатаЗамера КАК ДатаЗамера,
		|	Т.МедианаМс КАК МедианаМс,
		|	Т.НаЕдиницуМс КАК НаЕдиницуМс,
		|	Т.Единица КАК Единица,
		|	Т.Порция КАК Порция,
		|	Т.Повторов КАК Повторов,
		|	Т.МинМс КАК МинМс,
		|	Т.МаксМс КАК МаксМс,
		|	Т.ВремяПрогонов КАК ВремяПрогонов
		|ИЗ
		|	РегистрСведений.ПерфИстория КАК Т
		|ГДЕ
		|	Т.Стенд = &Стенд
		|	И Т.ДатаЗамера >= &ОтДаты
		|	И Т.ДатаЗамера <= &ПоДату
		|	И (&Сценарий = "" ИЛИ Т.Сценарий = &Сценарий)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаЗамера");
	Запрос.УстановитьПараметр("Стенд", Ключ);
	Запрос.УстановитьПараметр("Сценарий", СокрЛП(Сценарий));
	Запрос.УстановитьПараметр("ОтДаты", ОтДаты);
	Запрос.УстановитьПараметр("ПоДату", ПоДату);
	Выборка = Запрос.Выполнить().Выбрать();

	Точки = Новый Массив;
	Первый = Дата(1, 1, 1);
	Пока Выборка.Следующий() Цикл
		Если Первый = Дата(1, 1, 1) Тогда
			Первый = Выборка.ДатаЗамера;
		КонецЕсли;
		Точки.Добавить(Новый Структура("Сценарий, ДатаЗамера, МедианаМс, НаЕдиницуМс, Единица, Порция, Повторов, МинМс, МаксМс, ВремяПрогонов",
			СокрЛП(Выборка.Сценарий), Выборка.ДатаЗамера, Выборка.МедианаМс, Выборка.НаЕдиницуМс,
			СокрЛП(Выборка.Единица), Выборка.Порция, Выборка.Повторов, Выборка.МинМс, Выборка.МаксМс,
			СокрЛП(Выборка.ВремяПрогонов)));
	КонецЦикла;

	Если Точки.Количество() = 0 Тогда
		Возврат Новый Структура("Идентификатор, Тело, Хеш, РазмерБайт", "", "", "", 0);
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Поток = Новый ПотокВПамяти();
	Запись.ОткрытьПоток(Поток, "UTF-8");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("schema");
	Запись.ЗаписатьЗначение(1);
	Запись.ЗаписатьИмяСвойства("id");
	Запись.ЗаписатьЗначение(ЗаглушкаИдентификатора());
	Запись.ЗаписатьИмяСвойства("kind");
	Запись.ЗаписатьЗначение("history");
	Запись.ЗаписатьИмяСвойства("sig");
	Запись.ЗаписатьЗначение(?(ПустаяСтрока(КлючHMAC()), "none", "hmac-sha256"));

	Запись.ЗаписатьИмяСвойства("stand");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПоляСтенда(Запись, Стенд);
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("measured_at");
	Запись.ЗаписатьЗначение(ДатаISO(Первый));
	Запись.ЗаписатьИмяСвойства("measured_at_utc");
	Запись.ЗаписатьЗначение(МеткаUnixСекунд(Первый));
	Запись.ЗаписатьИмяСвойства("tz_offset");
	Запись.ЗаписатьЗначение(СмещениеЧасовМин() * 60);
	Запись.ЗаписатьИмяСвойства("run_id");
	Запись.ЗаписатьЗначение("history-" + Формат(Первый, "ДФ=yyyyMMddHHmmss"));

	Запись.ЗаписатьИмяСвойства("history");
	Запись.ЗаписатьНачалоМассива();
	ПервыйЭлемент = Истина;
	Для Каждого Точка Из Точки Цикл
		Если НЕ ПервыйЭлемент Тогда
			Запись.ЗаписатьБезОбработки(",");
		КонецЕсли;
		ПервыйЭлемент = Ложь;
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("scenario");
		Запись.ЗаписатьЗначение(Точка.Сценарий);
		Запись.ЗаписатьИмяСвойства("representation");
		Запись.ЗаписатьЗначение("median");
		Запись.ЗаписатьИмяСвойства("median_ms");
		Запись.ЗаписатьЗначение(Окр(Точка.МедианаМс, 3));
		Запись.ЗаписатьИмяСвойства("per_unit_ms");
		Запись.ЗаписатьЗначение(Окр(Точка.НаЕдиницуМс, 3));
		Запись.ЗаписатьИмяСвойства("unit");
		Запись.ЗаписатьЗначение(Точка.Единица);
		Запись.ЗаписатьИмяСвойства("portion");
		Запись.ЗаписатьЗначение(Точка.Порция);
		Запись.ЗаписатьИмяСвойства("repeats");
		Запись.ЗаписатьЗначение(Точка.Повторов);
		Запись.ЗаписатьИмяСвойства("min_ms");
		Запись.ЗаписатьЗначение(Окр(Точка.МинМс, 3));
		Запись.ЗаписатьИмяСвойства("max_ms");
		Запись.ЗаписатьЗначение(Окр(Точка.МаксМс, 3));
		Запись.ЗаписатьИмяСвойства("runs_string");
		Запись.ЗаписатьЗначение(Точка.ВремяПрогонов);
		Запись.ЗаписатьИмяСвойства("measured_at_utc");
		Запись.ЗаписатьЗначение(МеткаUnixСекунд(Точка.ДатаЗамера));
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

	Запись.ЗаписатьКонецОбъекта();
	Запись.Закрыть();

	ТелоБезИд = ПолучитьСтрокуИзДвоичныхДанных(Поток.ЗакрытьИПолучитьДвоичныеДанные(), КодировкаТекста.UTF8);
	Идентификатор = ИдентификаторКонверта("h", ТелоБезИд);
	Тело = СтрЗаменить(ТелоБезИд, ЗаглушкаИдентификатора(), Идентификатор);

	Возврат Новый Структура("Идентификатор, Тело, Хеш, РазмерБайт",
		Идентификатор, Тело, ХешHex(Тело),
		ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8).Размер());

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Сборка",
			"Не удалось собрать конверт истории",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Идентификатор, Тело, Хеш, РазмерБайт", "", "", "", 0);
	КонецПопытки;

КонецФункции

// Постановка истории в очередь окнами по 500 точек (лимит приёмника).
// Возвращает число созданных конвертов.
Функция СобратьИсториюВОчередь(Стенд, Сценарий = "", ОтДаты = "", ПоДату = "", Смещение = 0) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Если НеЭтоДата(ОтДаты) Тогда
		ОтДаты = ТекущаяУниверсальнаяДата() - 365 * 86400;
	КонецЕсли;
	Если НеЭтоДата(ПоДату) Тогда
		ПоДату = ТекущаяДатаСеанса() + 86400;
	КонецЕсли;

	Создано = 0;
	Начало = ОтДаты;
	Пока Начало <= ПоДату Цикл
		Конверт = СобратьКонвертИсторию(Стенд, Сценарий, Начало, ПоДату, Смещение);
		Если ПустаяСтрока(Конверт.Идентификатор) Тогда
			// Конверт пуст: уменьшаем окно, если оно ещё велико, иначе выходим.
			Если Начало + 3600 <= ПоДату Тогда
				Начало = Начало + 3600;
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЕсли;
		Результат = ЗаписатьВОчередь(Конверт, "history", Стенд,
			"HTTPS,HTTPS8443,PROXY,WEBDAV,FTP,SMTP,SFTP");
		Если Результат.Создана Тогда
			Создано = Создано + 1;
		КонецЕсли;
		// Следующее окно начинается через час после начала текущего:
		// так конверты не пересекаются, даже если точки идут неравномерно.
		Начало = Начало + 3600;
	КонецЦикла;

	ПерфСценарии.ЗаписатьМетку("exchange-history:" + Создано);
	Возврат Создано;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Очередь",
			"Не удалось поставить историю в очередь",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция НеЭтоДата(Значение) Экспорт

	Возврат ТипЗнч(Значение) <> Тип("Дата");

КонецФункции

#КонецОбласти

#Область ЗаданияИСпул

// Метод регламентного задания ПерфОбменОтправка: один цикл отправки.
Процедура РегламентнаяОтправка() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Итог = ОтправитьОчередь();
	ПерфСценарии.ЗаписатьМетку("exchange-schedule:" + Итог.Отправлено + ":" + Итог.Осталось);
	Если Итог.Ошибок > 0 Тогда
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Задание",
			"Регламентная отправка завершилась с отказами",
			"ошибок=" + Строка(Итог.Ошибок) + "; осталось=" + Строка(Итог.Осталось),
			"Предупреждение");
	КонецЕсли;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Задание",
			"Сбой регламентной отправки",
			КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
	КонецПопытки;

КонецПроцедуры

// Автодосылка из сеанса: пока панель открыта, очередь уходит сама. Дополняет
// регламентное задание: в файловой ИБ планировщик работает только при открытом
// сеансе, и панель обычно и есть этот сеанс.
Функция ОтправитьОчередьЕслиПора() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Если КоличествоВОчереди() = 0 Тогда
		Возврат "";
	КонецЕсли;
	// Второй проход поверх работающего задания отправил бы те же конверты дважды.
	// У менеджера фоновых заданий в 8.3.27 нет ни ПолучитьЗадания(), ни
	// ПолучитьТекущиеЗадания() - отбор по ключу и состоянию отдаёт
	// ПолучитьФоновыеЗадания(Структура). Задание стартует с ключом "ПерфОбменОтправка".
	Отбор = Новый Структура("Ключ, Состояние", "ПерфОбменОтправка",
		СостояниеФоновогоЗадания.Активно);
	Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ОтправитьОчередьФон();

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбмен.Отправка",
			"Не удалось запустить автодосылку из сеанса",
			КраткоОшибки(ОписаниеОшибки()),
			"Предупреждение", "", "", "сервер");
		Возврат "";
	КонецПопытки;

КонецФункции

