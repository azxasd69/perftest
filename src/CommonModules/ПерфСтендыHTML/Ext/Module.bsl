Функция БлокКаналов(Данные)

	Возврат ПлиткаКаналов("Сервер", "Доступность каналов с сервера", Данные.Каналы,
			Данные.Каналы.Каталог, "")
		+ ПлиткаКаналов("Клиент", "Доступность каналов с клиента", Данные.Каналы,
			Данные.Каналы.Клиентские,
			"с рабочего места проверяются каналы поверх HTTP; FTP, SMTP, SFTP и DNS - только с сервера");

КонецФункции

// Плитка одного узла: приоритет, канал, отклик, код и отметка доступности.
// Коды - состав плитки в порядке каталога, Примечание - пояснение в подвале.
Функция ПлиткаКаналов(Узел, Заголовок, Каналы, Коды, Примечание)

	СтрокиУзла = Каналы.Узлы.Получить(Узел);
	Если СтрокиУзла = Неопределено Тогда
		СтрокиУзла = Новый Соответствие;
	КонецЕсли;

	Заголовки = Новый Массив;
	Заголовки.Добавить("Приоритет");
	Заголовки.Добавить("Канал");
	Заголовки.Добавить("Мс");
	Заголовки.Добавить("Код");
	Заголовки.Добавить("Отметка");
	Право = Новый Массив;
	Право.Добавить(0);
	Право.Добавить(2);
	Право.Добавить(3);

	Строки = Новый Массив;
	Отвечают = 0;
	Включено = 0;
	Проверено = 0;
	Проверен = Дата(1, 1, 1);
	ГоденДо = Дата(1, 1, 1);
	Откуда = "";

	Для Каждого Код Из Коды Цикл
		Проба = СтрокиУзла.Получить(СокрЛП(Код));
		Отметка = "нет пробы";
		Вид = "";
		Причина = "";
		Мс = "";
		КодОтвета = "";
		Приоритет = ПерфОбменТранспорт.ТиповыеНастройки(Код).БазовыйПриоритет;

		Если Проба = Неопределено Тогда
			// Канал входит в состав плитки, но с этого узла его не проверяли:
			// пустая ячейка отличается от "проверяли, значения нет".
		Иначе
			Проверено = Проверено + 1;
			Приоритет = Проба.БазовыйПриоритет;
			Мс = "&mdash;";
			КодОтвета = "&mdash;";
			Если Проба.Мс > 0 Тогда
				Мс = Формат(Проба.Мс, "ЧГ=0");
			КонецЕсли;
			Если Проба.Код > 0 Тогда
				КодОтвета = Формат(Проба.Код, "ЧГ=0");
			КонецЕсли;
			Если Проба.Проверен > Проверен Тогда
				Проверен = Проба.Проверен;
				ГоденДо = Проба.ГоденДо;
			КонецЕсли;
			Если ПустаяСтрока(Откуда) Тогда
				Откуда = СокрЛП(Проба.Откуда);
			КонецЕсли;
			Если Проба.Доступен Тогда
				Отвечают = Отвечают + 1;
			КонецЕсли;
			Если Проба.Разрешён Тогда
				Включено = Включено + 1;
			КонецЕсли;
			Если НЕ Проба.Доступен Тогда
				Отметка = "недоступен";
				Вид = "err";
				Причина = КраткаяПричина(Проба.Причина);
			ИначеЕсли НЕ Проба.Разрешён Тогда
				// Канал отвечает, но выключен в настройках: в лестницу он не попадает.
				Отметка = "выключен";
				Вид = "cancel";
			Иначе
				Отметка = "в работе";
				Вид = "ok";
			КонецЕсли;
		КонецЕсли;

		Ячейка = "<b>" + Текст(Код) + "</b>";
		Если НЕ ПустаяСтрока(Причина) Тогда
			Ячейка = Ячейка + "<div class='subtle'>" + Текст(Причина) + "</div>";
		КонецЕсли;
		Строка = Новый Массив;
		Строка.Добавить(Формат(Приоритет, "ЧГ="));
		Строка.Добавить(Ячейка);
		Строка.Добавить(Мс);
		Строка.Добавить(КодОтвета);
		Строка.Добавить(ПерфUI.Бейдж(Отметка, Вид));
		Строки.Добавить(Строка);
	КонецЦикла;

	Всего = Коды.Количество();
	Подзаголовок = "проба не выполнялась";
	Если Проверен > Дата(1, 1, 1) Тогда
		Подзаголовок = Формат(Отвечают, "ЧГ=") + " из " + Формат(Всего, "ЧГ=")
			+ ?(Проверено < Всего, " проверенных", "")
			+ " &middot; проба " + Формат(Проверен, "ДФ=ЧЧ:мм")
			+ ?(ГоденДо < ТекущаяДатаСеанса(), ", устарела", "");
	КонецЕсли;

	Инфо = Новый Массив;
	Если НЕ ПустаяСтрока(Откуда) Тогда
		Инфо.Добавить("проверено: " + Текст(Откуда));
	КонецЕсли;
	Инфо.Добавить("включено " + Формат(Включено, "ЧГ=") + " из " + Формат(Всего, "ЧГ="));
	Если НЕ ПустаяСтрока(Примечание) Тогда
		Инфо.Добавить(Примечание);
	КонецЕсли;

	Возврат "<section class='tile tile-flat span-6'><div class='log-head'><h2>" + Текст(Заголовок)
		+ "</h2><span>" + Подзаголовок + "</span></div><div class='tw'>"
		+ ПерфUI.Таблица(Заголовки, Строки, Право) + "</div><div class='foot'>"
		+ СтрСоединить(Инфо, " &middot; ") + "</div></section>";

КонецФункции

Функция БлокЗамеры(Данные)

	Если Данные.Замеры.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Максимум = 0;
	Для Каждого Замер Из Данные.Замеры Цикл
		Максимум = Макс(Максимум, Замер.МедианаМс);
	КонецЦикла;

	Части = Новый Массив;
	Части.Добавить("<section class='tile tile-flat span-12'>"
		+ "<div class='log-head'><h2>Замеры стенда</h2><span>медианы по сценариям</span></div>"
		+ "<table><thead><tr><th>Сценарий</th><th>Платформа</th><th class='n'>Медиана, мс</th>"
		+ "<th class='n'>мс / 1000 ед.</th><th class='n'>Мин</th><th class='n'>Макс</th>"
		+ "<th class='n'>Порция</th><th>Доля</th></tr></thead><tbody>");
	Для Каждого Замер Из Данные.Замеры Цикл
		Подпись = Замер.Сценарий;
		Описание = "";
		Сценарий = СценарийПоКоду(Замер.Сценарий);
		Если Сценарий <> Неопределено Тогда
			Подпись = Сценарий.Представление;
			Описание = Сценарий.Описание;
		КонецЕсли;
		Доля = ?(Максимум > 0, Окр(Замер.МедианаМс / Максимум * 100, 0), 0);
		Части.Добавить("<tr><td><b>" + Текст(Подпись) + "</b>"
			+ "<div class='subtle'>" + Текст(Замер.Сценарий)
			+ ?(ПустаяСтрока(Описание), "", " &middot; " + Текст(Описание)) + "</div></td>"
			+ "<td class='subtle'>" + Текст(Замер.ВерсияПлатформы) + "</td>"
			+ "<td class='n'>" + Формат(Замер.МедианаМс, "ЧГ=") + "</td>"
			+ "<td class='n'>" + Формат(Замер.НаЕдиницуМс, "ЧДЦ=2; ЧГ=") + "</td>"
			+ "<td class='n'>" + Формат(Замер.МинМс, "ЧГ=") + "</td>"
			+ "<td class='n'>" + Формат(Замер.МаксМс, "ЧГ=") + "</td>"
			+ "<td class='n'>" + Формат(Замер.Порция, "ЧГ=") + "</td>"
			+ "<td><div class='track'><i style='width:" + Формат(Доля, "ЧГ=") + "%'></i></div></td></tr>");
	КонецЦикла;
	Части.Добавить("</tbody></table></section>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция БлокЗамечаний(Данные)

	Части = Новый Массив;
	Части.Добавить("<section class='tile span-6'><div class='log-head'><h2>Что не собрано</h2></div>");
	Если Данные.Замечания.Количество() = 0 Тогда
		Части.Добавить("<div class='sub'>Паспорт собран полностью: все блоки применимы на этом стенде.</div>");
	Иначе
		Для Каждого Причина Из Данные.Замечания Цикл
			Части.Добавить("<div class='result cancel'>" + Текст(Причина) + "</div>");
		КонецЦикла;
	КонецЕсли;
	Части.Добавить("</section>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция БлокДиагностики(Данные)

	П = Данные.Паспорт;
	Части = Новый Массив;
	Части.Добавить(НачалоБлока("Диагностика сбора", 6));
	Части.Добавить(Пара("Схема паспорта", Формат(П.СхемаПаспорта, "ЧГ=")));
	Если П.ВремяСбораМс > 0 Тогда
		Части.Добавить(Пара("Время сбора", Формат(П.ВремяСбораМс, "ЧГ=") + " мс"));
	КонецЕсли;
	Части.Добавить(Пара("Блоков не собрано", Формат(П.БлоковНеСобрано, "ЧГ=")));
	Части.Добавить(Пара("Дата паспорта", Формат(П.ДатаПаспорта, "ДЛФ=DT")));
	Части.Добавить(Пара("Платформа сбора", П.ВерсияПлатформыСервер));
	Если ЗначениеЗаполнено(П.Примечание) Тогда
		Части.Добавить(Пара("Примечание", П.Примечание));
	КонецЕсли;
	Части.Добавить(КонецБлока());
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция Подвал(Данные)

	П = Данные.Паспорт;
	Возврат "<div class='foot'>Паспорт стенда, схема " + Формат(П.СхемаПаспорта, "ЧГ=")
		+ " &middot; отпечаток <span class='subtle'>" + Текст(Лев(П.Отпечаток, 80)) + "</span>"
		+ " &middot; сбор идет до старта замера и в фоне, поэтому результат не искажается</div>";

КонецФункции

// Открытие/закрытие секции-плитки с заголовком в стиле кокпита.
Функция НачалоБлока(Заголовок, Ширина)

	Возврат "<section class='tile span-" + Ширина + "'><div class='log-head'><h2>"
		+ Текст(Заголовок) + "</h2></div><dl class='kv'>";

КонецФункции

Функция КонецБлока()

	Возврат "</dl></section>";

КонецФункции

// Пара «подпись - значение»; пустое значение не выводится.
Функция Пара(Подпись, Значение)

	ТекстЗначения = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(ТекстЗначения) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "<dt>" + Текст(Подпись) + "</dt><dd>" + Текст(ТекстЗначения) + "</dd>";

КонецФункции

// Экранирование данных: паспорт содержит произвольные строки (пути, модели).
Функция Текст(Значение)

	Возврат ПерфUI.Экранировать(Значение);

КонецФункции

#КонецОбласти

