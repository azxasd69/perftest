// Карточка стенда «ПерфТест»: паспорт, среда, платформа, замеры, замечания сбора.
//
// Разметка собрана из компонентов кокпита (ПерфUI.Стили): bar, bento, tile,
// log-head, table, badge, track, big. Своего CSS у страницы почти нет - только
// сетка пар «подпись - значение» и поле выбора стенда, которых в кокпите нет.
// Поэтому светлая тема работает без отдельных правил: цвета берутся из токенов,
// и дублировать их под .pf-dark не нужно: тема меняет только токены.
//
// Правила:
//   * любое обращение к регистрам - в Попытка; нет данных - блок не рисуется;
//   * пустое поле не выводится строкой «-», блок просто скрывается;
//   * текст из паспорта экранируется (это данные, а не разметка).

#Область ПрограммныйИнтерфейс

// Полная страница карточки. Стенд = "" - берется последний собранный паспорт.
Функция СтраницаСтенда(Стенд = "", Настройки = Неопределено) Экспорт

	Попытка
		Данные = ДанныеСтенда(Стенд);
	Исключение
		// Причина сбоя видна в маркере: иначе карточка молча показывает пустое состояние.
		Попытка
			ПерфСценарии.ЗаписатьМетку("card-error:" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ПерфЖурнал.ЗаписатьИсключение("ПерфСтендыHTML.СтраницаСтенда", ИнформацияОбОшибке());
		КонецПопытки;
		Данные = Неопределено;
	КонецПопытки;

	Части = Новый Массив;
	Если Данные = Неопределено Тогда
		Части.Добавить("<main class='bento'><section class='tile span-12'>"
			+ "<div class='log-head'><h2>Паспорта стендов еще нет</h2></div>"
			+ "<div class='empty'>Паспорт собирается автоматически при первом замере: "
			+ "запустите сценарий на кокпите и вернитесь на эту страницу.</div></section></main>");
		Возврат ПерфUI.Документ("ПерфСтенды", "ПерфТест - карточка стенда",
			СтрСоединить(Части, ""), "", "wrap", "", "", Настройки);
	КонецЕсли;

	Части.Добавить(Шапка(Данные));
	Части.Добавить("<main class='bento'>");
	Части.Добавить(Плитки(Данные));
	Части.Добавить(БлокСреда(Данные));
	Части.Добавить(БлокПлатформа(Данные));
	Части.Добавить(БлокКлиент(Данные));
	Части.Добавить(БлокКаналов(Данные));
	Части.Добавить(БлокЗамеры(Данные));
	Части.Добавить(БлокЗамечаний(Данные));
	Части.Добавить(БлокДиагностики(Данные));
	Части.Добавить("</main>");
	Части.Добавить(Подвал(Данные));

	Возврат ПерфUI.Документ("ПерфСтенды", "ПерфТест - карточка " + Данные.Стенд,
		СтрСоединить(Части, ""), "", "wrap", "", "", Настройки);

КонецФункции

// Данные карточки одной структурой: паспорт, замеры, замечания, служебное.
Функция ДанныеСтенда(Стенд = "") Экспорт

	Имя = СокрЛП(Стенд);
	Если ПустаяСтрока(Имя) Тогда
		Имя = ПоследнийСтенд();
	КонецЕсли;
	Если ПустаяСтрока(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Паспорт = ПаспортСтенда(Имя);
	Если Паспорт = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Стенд", Имя);
	Данные.Вставить("Паспорт", Паспорт);
	Данные.Вставить("Замеры", ЗамерыСтенда(Имя));
	Данные.Вставить("Замечания", ЗамечанияСбора(Паспорт));
	Данные.Вставить("Стенды", ПерфОтчетыHTML.СписокСтендовМассив());
	// Пробы каналов обмена: одинаковый список на обоих узлах, разные отметки.
	Данные.Вставить("Каналы", КаналыСтенда());
	Возврат Данные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Последний стенд по дате паспорта: карточка по умолчанию открывается на нем.
Функция ПоследнийСтенд()

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Стенд КАК Стенд
			|ИЗ
			|	РегистрСведений.ПерфСтенды КАК Т
			|УПОРЯДОЧИТЬ ПО
			|	Т.ДатаПаспорта УБЫВ");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Выборка.Стенд);
		КонецЕсли;
	Исключение
		ПерфЖурнал.ЗаписатьИсключение("ПерфСтендыHTML.ПоследнийСтенд", ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";

КонецФункции

// Паспорт стенда: все реквизиты схемы 3, которые показывает карточка.
Функция ПаспортСтенда(Имя)

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Стенд КАК Стенд,
			|	Т.ВерсияПлатформыСервер КАК ВерсияПлатформыСервер,
			|	Т.ПлатформаСервер КАК ПлатформаСервер,
			|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации,
			|	Т.РежимИБ КАК РежимИБ,
			|	Т.ВариантРазвёртывания КАК ВариантРазвёртывания,
			|	Т.СУБД КАК СУБД,
			|	Т.ВерсияСУБД КАК ВерсияСУБД,
			|	Т.ДатаПаспорта КАК ДатаПаспорта,
			|	Т.СхемаПаспорта КАК СхемаПаспорта,
			|	Т.ВремяСбораМс КАК ВремяСбораМс,
			|	Т.БлоковНеСобрано КАК БлоковНеСобрано,
			|	Т.ЗамечанияСбора КАК ЗамечанияСбора,
			|	Т.Примечание КАК Примечание,
			|	Т.Отпечаток КАК Отпечаток,
			|	Т.ИмяИБ КАК ИмяИБ,
			|	Т.ОбъёмИБМб КАК ОбъёмИБМб,
			|	Т.РазмерДанныхБайт КАК РазмерДанныхБайт,
			|	Т.СерверКомпьютер КАК СерверКомпьютер,
			|	Т.СерверОС КАК СерверОС,
			|	Т.СерверЦПУ КАК СерверЦПУ,
			|	Т.СерверЦПУПотоки КАК СерверЦПУПотоки,
			|	Т.СерверЦПУМГц КАК СерверЦПУМГц,
			|	Т.СерверЯдер КАК СерверЯдер,
			|	Т.СерверПотоков КАК СерверПотоков,
			|	Т.СерверПамятьМб КАК СерверПамятьМб,
			|	Т.СерверСвободнаПамятьМб КАК СерверСвободнаПамятьМб,
			|	Т.СерверПК КАК СерверПК,
			|	Т.СерверПроизводитель КАК СерверПроизводитель,
			|	Т.СерверМодель КАК СерверМодель,
			|	Т.СерверBIOS КАК СерверBIOS,
			|	Т.СерверВиртуализация КАК СерверВиртуализация,
			|	Т.СерверОЗУПроизводитель КАК СерверОЗУПроизводитель,
			|	Т.СерверОЗУЧастотаМГц КАК СерверОЗУЧастотаМГц,
			|	Т.СерверОЗУСлотов КАК СерверОЗУСлотов,
			|	Т.СерверСетьАдаптер КАК СерверСетьАдаптер,
			|	Т.СерверСетьСкоростьМбит КАК СерверСетьСкоростьМбит,
			|	Т.СерверДиски КАК СерверДиски,
			|	Т.СерверСвободноНаДискеГБ КАК СерверСвободноНаДискеГБ,
			|	Т.СерверАптайм КАК СерверАптайм,
			|	Т.СерверЧасовойПояс КАК СерверЧасовойПояс,
			|	Т.ЧасовойПоясИБ КАК ЧасовойПоясИБ,
			|	Т.СерверКаталогПрограммы КАК СерверКаталогПрограммы,
			|	Т.СерверКаталогВременныхФайлов КАК СерверКаталогВременныхФайлов,
			|	Т.РежимКлиента КАК РежимКлиента,
			|	Т.РежимЗапуска КАК РежимЗапуска,
			|	Т.ТипПлатформыКлиент КАК ТипПлатформыКлиент,
			|	Т.ВерсияПлатформыКлиент КАК ВерсияПлатформыКлиент,
			|	Т.КлиентБраузер КАК КлиентБраузер,
			|	Т.КлиентИдентификатор КАК КлиентИдентификатор,
			|	Т.КлиентИмяКомпьютера КАК КлиентИмяКомпьютера,
			|	Т.КлиентОС КАК КлиентОС,
			|	Т.КлиентЦПУ КАК КлиентЦПУ,
			|	Т.КлиентЦПУПотоки КАК КлиентЦПУПотоки,
			|	Т.КлиентПамятьМб КАК КлиентПамятьМб,
			|	Т.КлиентСвободнаПамятьМб КАК КлиентСвободнаПамятьМб,
			|	Т.КлиентПК КАК КлиентПК,
			|	Т.КлиентАптайм КАК КлиентАптайм
			|ИЗ
			|	РегистрСведений.ПерфСтенды КАК Т
			|ГДЕ
			|	Т.Стенд = &Стенд");
		Запрос.УстановитьПараметр("Стенд", Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат = Новый Структура;
		Для Каждого Колонка Из Выборка.Владелец().Колонки Цикл
			Результат.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Замеры стенда, отсортированные по убыванию медианы.
// Версия платформы входит в ключ регистра: один стенд может быть измерен
// несколькими платформами, поэтому она выводится отдельной колонкой.
Функция ЗамерыСтенда(Имя)

	Результат = Новый Массив;
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Т.Сценарий КАК Сценарий,
			|	Т.ВерсияПлатформы КАК ВерсияПлатформы,
			|	Т.МедианаМс КАК МедианаМс,
			|	Т.НаЕдиницуМс КАК НаЕдиницуМс,
			|	Т.МинМс КАК МинМс,
			|	Т.МаксМс КАК МаксМс,
			|	Т.Порция КАК Порция,
			|	Т.Единица КАК Единица,
			|	Т.Повторов КАК Повторов,
			|	Т.ДатаЗамера КАК ДатаЗамера
			|ИЗ
			|	РегистрСведений.ПерфРезультаты КАК Т
			|ГДЕ
			|	Т.Стенд = &Стенд
			|УПОРЯДОЧИТЬ ПО
			|	Т.МедианаМс УБЫВ");
		Запрос.УстановитьПараметр("Стенд", Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Новый Структура("Сценарий, ВерсияПлатформы, МедианаМс, НаЕдиницуМс, "
				+ "МинМс, МаксМс, Порция, Единица, Повторов, ДатаЗамера",
				СокрЛП(Выборка.Сценарий), СокрЛП(Выборка.ВерсияПлатформы), Выборка.МедианаМс,
				Выборка.НаЕдиницуМс, Выборка.МинМс, Выборка.МаксМс, Выборка.Порция,
				СокрЛП(Выборка.Единица), Выборка.Повторов, Выборка.ДатаЗамера));
		КонецЦикла;
	Исключение
		ПерфЖурнал.ЗаписатьИсключение("ПерфСтендыHTML.ЗамерыСтенда", ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Замечания сбора в человеческом виде: каждая причина отдельным пунктом.
Функция ЗамечанияСбора(Паспорт)

	Результат = Новый Массив;
	Текст = СокрЛП(Паспорт.ЗамечанияСбора);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(Текст, ";", Ложь) Цикл
		Причина = СокрЛП(Часть);
		Если НЕ ПустаяСтрока(Причина) Тогда
			Результат.Добавить(Причина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Каналы, которые проверяются с рабочего места: их перечисляет настройка пробы
// (клиент не умеет FTP, SMTP, SFTP и DNS). Сбой настройки не скрывает плитку:
// берется типовой набор HTTP-каналов.
Функция КаналыКлиента()

	Попытка
		Настройки = ПерфОбмен.ПараметрыПробыКлиента();
		Если Настройки <> Неопределено Тогда
			Коды = Новый Массив;
			Для Каждого Канал Из Настройки.Каналы Цикл
				Коды.Добавить(СокрЛП(Канал.Канал));
			КонецЦикла;
			Возврат Коды;
		КонецЕсли;
	Исключение
		ПерфЖурнал.ЗаписатьИсключение("ПерфСтендыHTML.КаналыКлиента", ИнформацияОбОшибке());
	КонецПопытки;
	Коды = Новый Массив;
	Коды.Добавить("HTTPS");
	Коды.Добавить("HTTPS8443");
	Коды.Добавить("HTTP80");
	Коды.Добавить("WEBDAV");
	Возврат Коды;

КонецФункции

// Пробы каналов по узлам: каталог, строки по каждому узлу и момент пробы.
// Узел - измерение регистра: "Сервер" пишет проба из 1С, "Клиент" - проба
// с рабочего места, "Внешний" - внешняя утилита.
Функция КаналыСтенда()

	Результат = Новый Структура("Каталог, Узлы, Клиентские", Новый Массив,
		Новый Соответствие, Новый Массив);
	Попытка
		Результат.Каталог = ПерфОбменТранспорт.ВсеКаналы();
		Результат.Клиентские = КаналыКлиента();
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Т.Узел КАК Узел,
			|	Т.Канал КАК Канал,
			|	Т.БазовыйПриоритет КАК БазовыйПриоритет,
			|	Т.Разрешён КАК Разрешён,
			|	Т.Доступен КАК Доступен,
			|	Т.Код КАК Код,
			|	Т.Мс КАК Мс,
			|	Т.Проверен КАК Проверен,
			|	Т.ГоденДо КАК ГоденДо,
			|	Т.Причина КАК Причина,
			|	Т.Откуда КАК Откуда
			|ИЗ
			|	РегистрСведений.ПерфОбменПроба КАК Т");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Узел = СокрЛП(Выборка.Узел);
			Строки = Результат.Узлы.Получить(Узел);
			Если Строки = Неопределено Тогда
				Строки = Новый Соответствие;
				Результат.Узлы.Вставить(Узел, Строки);
			КонецЕсли;
			Строки.Вставить(СокрЛП(Выборка.Канал),
				Новый Структура("БазовыйПриоритет, Разрешён, Доступен, Код, Мс, "
					+ "Проверен, ГоденДо, Причина, Откуда",
					Выборка.БазовыйПриоритет, Выборка.Разрешён, Выборка.Доступен, Выборка.Код,
					Выборка.Мс, Выборка.Проверен, Выборка.ГоденДо, СокрЛП(Выборка.Причина),
					СокрЛП(Выборка.Откуда)));
		КонецЦикла;
	Исключение
		ПерфЖурнал.ЗаписатьИсключение("ПерфСтендыHTML.КаналыСтенда", ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Версия проб для ключа кэша страницы: после пробы плитки должны пересобраться.
Функция ВерсияПроб() Экспорт

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Всего,
			|	МАКСИМУМ(Т.Проверен) КАК Последняя
			|ИЗ
			|	РегистрСведений.ПерфОбменПроба КАК Т");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Формат(Выборка.Всего, "ЧГ=0") + "|"
				+ Формат(?(ЗначениеЗаполнено(Выборка.Последняя), Выборка.Последняя, Дата(1, 1, 1)),
					"ДФ=yyyyMMddHHmmss");
		КонецЕсли;
	Исключение
		ПерфЖурнал.ЗаписатьИсключение("ПерфСтендыHTML.ВерсияПроб", ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";

КонецФункции

// Причина отказа короткой фразой: полный текст платформы остается в журнале и
// в регистре, а на плитке нужна одна строка, читаемая без разбора стека вызовов.
Функция КраткаяПричина(Причина)

	Текст = НРег(СокрЛП(Причина));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНайти(Текст, "таймаут") > 0 Тогда
		Возврат "таймаут";
	ИначеЕсли СтрНайти(Текст, "login denied") > 0 ИЛИ СтрНайти(Текст, "аутентификац") > 0 Тогда
		Возврат "отказ аутентификации";
	ИначеЕсли СтрНайти(Текст, "сертификат") > 0 ИЛИ СтрНайти(Текст, "tls") > 0
		ИЛИ СтрНайти(Текст, "ssl") > 0 Тогда
		Возврат "ошибка TLS";
	ИначеЕсли СтрНайти(Текст, "недопустимое значение параметра") > 0 Тогда
		Возврат "ошибка настройки канала";
	ИначеЕсли СтрНайти(Текст, "только утилитой") > 0 Тогда
		Возврат "только утилитой";
	ИначеЕсли СтрНайти(Текст, "нет ответа") > 0 Тогда
		Возврат "нет ответа";
	КонецЕсли;
	// Незнакомый текст: отбрасываем платформенные обертки «{Модуль(стр)}: ... (Метод): »
	// и берем хвост - он и есть причина; полный текст остается в журнале.
	Хвост = СокрЛП(Причина);
	Позиция = СтрНайти(Хвост, "): ", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Хвост = СокрЛП(Сред(Хвост, Позиция + 3));
	КонецЕсли;
	Возврат Лев(Хвост, 64);

КонецФункции

// Подпись и описание сценария по коду из каталога.
Функция СценарийПоКоду(Код)

	Попытка
		Для Каждого Сценарий Из ПерфСценарии.СписокСценариев() Цикл
			Если СокрЛП(Сценарий.Имя) = Код Тогда
				Возврат Сценарий;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ПерфЖурнал.ЗаписатьИсключение("ПерфСтендыHTML.СценарийПоКоду", ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

// ---------------------------------------------------------------------------
// Блоки разметки: те же компоненты, что и на кокпите (bar, bento, tile).

// Шапка: бренд, крошки, выбор стенда и переходы; вторая строка - чипы паспорта.
Функция Шапка(Данные)

	// Как в кокпите: переходы, параметр страницы (выбор стенда), действие.
	// Крошки «стенд / карточка» и чипы паспорта убраны - они дублировали навигацию и тело страницы.
	Пункты = Новый Массив;
	Для Каждого Имя Из Данные.Стенды Цикл
		Пункты.Добавить("<option value='" + Текст(Имя) + "'"
			+ ?(СокрЛП(Имя) = Данные.Стенд, " selected", "") + ">" + Текст(Имя) + "</option>");
	КонецЦикла;
	Средняя = "<label class='field'><span>стенд</span>"
		+ "<select id='stand' data-pf-field='stand'>" + СтрСоединить(Пункты, "") + "</select></label>";
	// Действия страницы: проба каналов с рабочего места и обновление паспорта.
	Возврат ПерфUI.Шапка("ПерфСтенды", Средняя,
		"<button class='btn' data-pf='send:probe'>Проверить каналы</button>"
		+ "<button class='btn primary' data-pf='send:refresh'>Обновить</button>");

КонецФункции

// Четыре KPI: те же плитки, что в верхней строке кокпита.
Функция Плитки(Данные)

	П = Данные.Паспорт;
	Ядра = ?(ЗначениеЗаполнено(П.СерверЯдер), Формат(П.СерверЯдер, "ЧГ="), "-");
	Потоки = ?(ЗначениеЗаполнено(П.СерверПотоков), Формат(П.СерверПотоков, "ЧГ="), "-");
	Память = ?(П.СерверПамятьМб > 0, Формат(Окр(П.СерверПамятьМб / 1024, 1), "ЧДЦ=1; ЧГ="), "-");
	ДанныеИБ = ?(П.РазмерДанныхБайт > 0, Формат(Окр(П.РазмерДанныхБайт / 1024, 0), "ЧГ="), "-");
	ВсегоЗамеров = Данные.Замеры.Количество();

	Части = Новый Массив;
	Части.Добавить(ПерфUI.Плитка("Ядра / потоки", Ядра, "/ " + Потоки,
		?(ЗначениеЗаполнено(П.СерверЦПУ), СокрЛП(П.СерверЦПУ), "данных о процессоре нет")));
	Части.Добавить(ПерфUI.Плитка("Память сервера", Память, "ГБ", ОЗУПояснение(П)));
	Части.Добавить(ПерфUI.Плитка("Данные ИБ", ДанныеИБ, "КБ", "объекты PerfTest"));
	Части.Добавить(ПерфUI.Плитка("Замеров в стенде", Формат(ВсегоЗамеров, "ЧГ="), "",
		?(ВсегоЗамеров > 0, "медианы по сценариям", "замеров еще нет")));
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция ОЗУПояснение(П)

	Части = Новый Массив;
	Если П.СерверОЗУЧастотаМГц > 0 Тогда
		Части.Добавить("DDR4-" + Формат(П.СерверОЗУЧастотаМГц, "ЧГ=") + " МГц");
	КонецЕсли;
	Если П.СерверОЗУСлотов > 0 Тогда
		Части.Добавить(Формат(П.СерверОЗУСлотов, "ЧГ=") + " слота");
	КонецЕсли;
	Если ЗначениеЗаполнено(П.СерверОЗУПроизводитель) Тогда
		Части.Добавить(СокрЛП(П.СерверОЗУПроизводитель));
	КонецЕсли;
	Возврат ?(Части.Количество() > 0, СтрСоединить(Части, ", "), "модули не определены");

КонецФункции

