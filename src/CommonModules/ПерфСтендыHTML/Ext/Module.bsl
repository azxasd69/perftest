// Карточка стенда «ПерфТест»: паспорт, среда, платформа, замеры, замечания сбора.
//
// Модуль только собирает HTML по данным регистров и отдаёт его в единый каркас
// ПерфUI.Документ (боковая панель, тема, стили). Переключателя темы на карточке
// нет: тема берётся из приложения, иначе из системной настройки (см. СкриптТемы).
//
// Правила:
//   * любое обращение к регистрам - в Попытка; нет данных - блок не рисуется;
//   * пустое поле не выводится строкой «-», блок просто скрывается;
//   * текст из паспорта экранируется (это данные, а не разметка).

#Область ПрограммныйИнтерфейс

// Полная страница карточки. Стенд = "" - берётся последний собранный паспорт.
Функция СтраницаСтенда(Стенд = "") Экспорт

	Попытка
		Данные = ДанныеСтенда(Стенд);
	Исключение
		Данные = Неопределено;
	КонецПопытки;

	Если Данные = Неопределено Тогда
		Тело = "<div class='pfsc-empty'>Паспорта стендов ещё нет: выполните замер на кокпите - "
			+ "паспорт соберётся автоматически.</div>";
		Возврат ПерфUI.Документ("ПерфСтенды", "ПерфТест - карточка стенда", Тело,
			СтилиКарточки(), Ложь, "pfsc-wrap");

	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(Шапка(Данные));
	Части.Добавить(Плитки(Данные));
	Части.Добавить("<section class='pfsc-grid'>");
	Части.Добавить(БлокСреда(Данные));
	Части.Добавить(БлокПлатформа(Данные));
	Части.Добавить("</section>");
	Части.Добавить(БлокКлиент(Данные));
	Части.Добавить(БлокЗамеры(Данные));
	Части.Добавить("<section class='pfsc-grid'>");
	Части.Добавить(БлокЗамечаний(Данные));
	Части.Добавить(БлокДиагностики(Данные));
	Части.Добавить("</section>");
	Части.Добавить(Подвал(Данные));

	Возврат ПерфUI.Документ("ПерфСтенды", "ПерфТест - карточка " + Данные.Стенд,
		СтрСоединить(Части, ""), СтилиКарточки(), Ложь, "pfsc-wrap");

КонецФункции

// Данные карточки одной структурой: паспорт, замеры, замечания, служебное.
Функция ДанныеСтенда(Стенд = "") Экспорт

	Имя = СокрЛП(Стенд);
	Если ПустаяСтрока(Имя) Тогда
		Имя = ПоследнийСтенд();
	КонецЕсли;
	Если ПустаяСтрока(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Паспорт = ПаспортСтенда(Имя);
	Если Паспорт = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Стенд", Имя);
	Данные.Вставить("Паспорт", Паспорт);
	Данные.Вставить("Замеры", ЗамерыСтенда(Имя));
	Данные.Вставить("Замечания", ЗамечанияСбора(Паспорт));
	Данные.Вставить("Стенды", ПерфОтчетыHTML.СписокСтендовМассив());
	Возврат Данные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Последний стенд по дате паспорта: карточка по умолчанию открывается на нём.
Функция ПоследнийСтенд()

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Стенд КАК Стенд
			|ИЗ
			|	РегистрСведений.ПерфСтенды КАК Т
			|УПОРЯДОЧИТЬ ПО
			|	Т.ДатаПаспорта УБЫВ");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Выборка.Стенд);
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
	Возврат "";

КонецФункции

// Паспорт стенда: все реквизиты схемы 3, которые показывает карточка.
Функция ПаспортСтенда(Имя)

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Стенд КАК Стенд,
			|	Т.ВерсияПлатформыСервер КАК ВерсияПлатформыСервер,
			|	Т.ПлатформаСервер КАК ПлатформаСервер,
			|	Т.ВерсияКонфигурации КАК ВерсияКонфигурации,
			|	Т.РежимИБ КАК РежимИБ,
			|	Т.ВариантРазвёртывания КАК ВариантРазвёртывания,
			|	Т.СУБД КАК СУБД,
			|	Т.ВерсияСУБД КАК ВерсияСУБД,
			|	Т.ДатаПаспорта КАК ДатаПаспорта,
			|	Т.СхемаПаспорта КАК СхемаПаспорта,
			|	Т.ВремяСбораМс КАК ВремяСбораМс,
			|	Т.БлоковНеСобрано КАК БлоковНеСобрано,
			|	Т.ЗамечанияСбора КАК ЗамечанияСбора,
			|	Т.Примечание КАК Примечание,
			|	Т.Отпечаток КАК Отпечаток,
			|	Т.ИмяИБ КАК ИмяИБ,
			|	Т.ОбъёмИБМб КАК ОбъёмИБМб,
			|	Т.РазмерДанныхБайт КАК РазмерДанныхБайт,
			|	Т.СерверКомпьютер КАК СерверКомпьютер,
			|	Т.СерверОС КАК СерверОС,
			|	Т.СерверЦПУ КАК СерверЦПУ,
			|	Т.СерверЦПУПотоки КАК СерверЦПУПотоки,
			|	Т.СерверЦПУМГц КАК СерверЦПУМГц,
			|	Т.СерверЯдер КАК СерверЯдер,
			|	Т.СерверПотоков КАК СерверПотоков,
			|	Т.СерверПамятьМб КАК СерверПамятьМб,
			|	Т.СерверСвободнаПамятьМб КАК СерверСвободнаПамятьМб,
			|	Т.СерверПК КАК СерверПК,
			|	Т.СерверПроизводитель КАК СерверПроизводитель,
			|	Т.СерверМодель КАК СерверМодель,
			|	Т.СерверBIOS КАК СерверBIOS,
			|	Т.СерверВиртуализация КАК СерверВиртуализация,
			|	Т.СерверОЗУПроизводитель КАК СерверОЗУПроизводитель,
			|	Т.СерверОЗУЧастотаМГц КАК СерверОЗУЧастотаМГц,
			|	Т.СерверОЗУСлотов КАК СерверОЗУСлотов,
			|	Т.СерверСетьАдаптер КАК СерверСетьАдаптер,
			|	Т.СерверСетьСкоростьМбит КАК СерверСетьСкоростьМбит,
			|	Т.СерверДиски КАК СерверДиски,
			|	Т.СерверСвободноНаДискеГБ КАК СерверСвободноНаДискеГБ,
			|	Т.СерверАптайм КАК СерверАптайм,
			|	Т.СерверЧасовойПояс КАК СерверЧасовойПояс,
			|	Т.ЧасовойПоясИБ КАК ЧасовойПоясИБ,
			|	Т.СерверКаталогПрограммы КАК СерверКаталогПрограммы,
			|	Т.СерверКаталогВременныхФайлов КАК СерверКаталогВременныхФайлов,
			|	Т.РежимКлиента КАК РежимКлиента,
			|	Т.РежимЗапуска КАК РежимЗапуска,
			|	Т.ТипПлатформыКлиент КАК ТипПлатформыКлиент,
			|	Т.ВерсияПлатформыКлиент КАК ВерсияПлатформыКлиент,
			|	Т.КлиентБраузер КАК КлиентБраузер,
			|	Т.КлиентИдентификатор КАК КлиентИдентификатор,
			|	Т.КлиентИмяКомпьютера КАК КлиентИмяКомпьютера,
			|	Т.КлиентОС КАК КлиентОС,
			|	Т.КлиентЦПУ КАК КлиентЦПУ,
			|	Т.КлиентЦПУПотоки КАК КлиентЦПУПотоки,
			|	Т.КлиентПамятьМб КАК КлиентПамятьМб,
			|	Т.КлиентСвободнаПамятьМб КАК КлиентСвободнаПамятьМб,
			|	Т.КлиентПК КАК КлиентПК,
			|	Т.КлиентАптайм КАК КлиентАптайм
			|ИЗ
			|	РегистрСведений.ПерфСтенды КАК Т
			|ГДЕ
			|	Т.Стенд = &Стенд");
		Запрос.УстановитьПараметр("Стенд", Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат = Новый Структура;
		Для Каждого Колонка Из Выборка.Владелец().Колонки Цикл
			Результат.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Замеры стенда, отсортированные по убыванию медианы.
Функция ЗамерыСтенда(Имя)

	Результат = Новый Массив;
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Т.Сценарий КАК Сценарий,
			|	Т.МедианаМс КАК МедианаМс,
			|	Т.НаЕдиницуМс КАК НаЕдиницуМс,
			|	Т.МинМс КАК МинМс,
			|	Т.МаксМс КАК МаксМс,
			|	Т.Порция КАК Порция,
			|	Т.Единица КАК Единица,
			|	Т.Повторов КАК Повторов,
			|	Т.ДатаЗамера КАК ДатаЗамера
			|ИЗ
			|	РегистрСведений.ПерфРезультаты КАК Т
			|ГДЕ
			|	Т.Стенд = &Стенд
			|УПОРЯДОЧИТЬ ПО
			|	Т.МедианаМс УБЫВ");
		Запрос.УстановитьПараметр("Стенд", Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Новый Структура("Сценарий, МедианаМс, НаЕдиницуМс, МинМс, МаксМс, "
				+ "Порция, Единица, Повторов, ДатаЗамера",
				СокрЛП(Выборка.Сценарий), Выборка.МедианаМс, Выборка.НаЕдиницуМс,
				Выборка.МинМс, Выборка.МаксМс, Выборка.Порция, СокрЛП(Выборка.Единица),
				Выборка.Повторов, Выборка.ДатаЗамера));
		КонецЦикла;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Замечания сбора в человеческом виде: каждая причина отдельным пунктом.
Функция ЗамечанияСбора(Паспорт)

	Результат = Новый Массив;
	Текст = СокрЛП(Паспорт.ЗамечанияСбора);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(Текст, ";", Ложь) Цикл
		Причина = СокрЛП(Часть);
		Если НЕ ПустаяСтрока(Причина) Тогда
			Результат.Добавить(Причина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Подпись и описание сценария по коду из каталога.
Функция СценарийПоКоду(Код)

	Попытка
		Для Каждого Сценарий Из ПерфСценарии.СписокСценариев() Цикл
			Если СокрЛП(Сценарий.Имя) = Код Тогда
				Возврат Сценарий;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

// ---------------------------------------------------------------------------
// Блоки разметки

Функция Шапка(Данные)

	П = Данные.Паспорт;
	Части = Новый Массив;
	Части.Добавить("<header class='pfsc-head'><div class='pfsc-head-main'>");
	Части.Добавить("<div class='pfsc-crumbs'><span>ПерфТест</span><span>стенды</span>"
		+ "<span>карточка</span></div>");
	Части.Добавить("<h1>" + Текст(Данные.Стенд) + "</h1>");
	Части.Добавить("<div class='pfsc-chips'>");
	Части.Добавить(Чип("схема паспорта " + Формат(П.СхемаПаспорта, "ЧГ="), ""));
	Если ЗначениеЗаполнено(П.ВерсияПлатформыСервер) Тогда
		Части.Добавить(Чип("платформа " + СокрЛП(П.ВерсияПлатформыСервер), ""));
	КонецЕсли;
	Если ЗначениеЗаполнено(П.СУБД) Тогда
		Части.Добавить(Чип("ИБ " + СокрЛП(П.СУБД), ""));
	КонецЕсли;
	Если ЗначениеЗаполнено(П.РежимКлиента) Тогда
		КлиентКоротко = СокрЛП(П.РежимКлиента);
		Если ВРег(Лев(КлиентКоротко, 6)) = "КЛИЕНТ" Тогда
			КлиентКоротко = СокрЛП(Сред(КлиентКоротко, 8));
		КонецЕсли;
		Части.Добавить(Чип("клиент " + КлиентКоротко, ""));
	КонецЕсли;
	Если П.БлоковНеСобрано > 0 Тогда
		Части.Добавить(Чип("собрано не всё: " + Формат(П.БлоковНеСобрано, "ЧГ=") + " "
			+ СклонениеБлоков(П.БлоковНеСобрано), "warn"));
	Иначе
		Части.Добавить(Чип("паспорт полный", "ok"));
	КонецЕсли;
	Части.Добавить("</div></div>");

	// Действия: выбор стенда и переходы. Переключателя темы здесь нет.
	Части.Добавить("<div class='pfsc-actions'>");
	Части.Добавить("<select class='pfsc-select' id='pfStand' onchange='PF1C.send(""stand:""+this.value)'>");
	Для Каждого Имя Из Данные.Стенды Цикл
		Части.Добавить("<option value='" + Текст(Имя) + "'" + ?(СокрЛП(Имя) = Данные.Стенд, " selected", "")
			+ ">" + Текст(Имя) + "</option>");
	КонецЦикла;
	Части.Добавить("</select>");
	Части.Добавить("<button class='pfsc-btn' onclick='PF1C.send(""open:ПерфСравнениеСтендов"")'>Сравнить</button>");
	Части.Добавить("<button class='pfsc-btn primary' onclick='PF1C.send(""open:ПерфДашборд"")'>На дашборд</button>");
	Части.Добавить("</div></header>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция Плитки(Данные)

	П = Данные.Паспорт;
	Ядра = ?(ЗначениеЗаполнено(П.СерверЯдер), Формат(П.СерверЯдер, "ЧГ="), "-");
	Потоки = ?(ЗначениеЗаполнено(П.СерверПотоков), Формат(П.СерверПотоков, "ЧГ="), "-");
	Память = ?(П.СерверПамятьМб > 0, Формат(Окр(П.СерверПамятьМб / 1024, 1), "ЧДЦ=1; ЧГ="), "-");
	ДанныеИБ = ?(П.РазмерДанныхБайт > 0, Формат(Окр(П.РазмерДанныхБайт / 1024, 0), "ЧГ="), "-");
	ВсегоЗамеров = Данные.Замеры.Количество();

	Части = Новый Массив;
	Части.Добавить("<section class='pfsc-kpi'>");
	Части.Добавить(Плитка("Ядра / потоки", Ядра, "/ " + Потоки,
		?(ЗначениеЗаполнено(П.СерверЦПУ), СокрЛП(П.СерверЦПУ), "данных о процессоре нет")));
	Части.Добавить(Плитка("Память сервера", Память, "ГБ", ОЗУПояснение(П)));
	Части.Добавить(Плитка("Данные ИБ", ДанныеИБ, "КБ", "объекты PerfTest"));
	Части.Добавить(Плитка("Замеров в стенде", Формат(ВсегоЗамеров, "ЧГ="), "",
		?(ВсегоЗамеров > 0, "медианы по сценариям", "замеров ещё нет")));
	Части.Добавить("</section>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция Плитка(Подпись, Значение, Единица, Пояснение)

	Возврат "<div class='pfsc-tile'><div class='pfsc-lbl'>" + Текст(Подпись) + "</div>"
		+ "<div class='pfsc-big'>" + Текст(Значение)
		+ ?(ПустаяСтрока(Единица), "", "<small>" + Текст(Единица) + "</small>") + "</div>"
		+ "<div class='pfsc-sub'>" + Текст(Пояснение) + "</div></div>";

КонецФункции

Функция ОЗУПояснение(П)

	Части = Новый Массив;
	Если П.СерверОЗУЧастотаМГц > 0 Тогда
		Части.Добавить("DDR4-" + Формат(П.СерверОЗУЧастотаМГц, "ЧГ=") + " МГц");
	КонецЕсли;
	Если П.СерверОЗУСлотов > 0 Тогда
		Части.Добавить(Формат(П.СерверОЗУСлотов, "ЧГ=") + " слота");
	КонецЕсли;
	Если ЗначениеЗаполнено(П.СерверОЗУПроизводитель) Тогда
		Части.Добавить(СокрЛП(П.СерверОЗУПроизводитель));
	КонецЕсли;
	Возврат ?(Части.Количество() > 0, СтрСоединить(Части, ", "), "модули не определены");

КонецФункции

Функция БлокСреда(Данные)

	П = Данные.Паспорт;
	Части = Новый Массив;
	Части.Добавить("<article class='pfsc-card'><h2>Среда сервера</h2><dl class='pfsc-rows'>");
	Части.Добавить(Пара("ОС", П.СерверОС));
	Части.Добавить(Пара("Процессор", П.СерверЦПУ));
	Если П.СерверЦПУМГц > 0 Тогда
		Части.Добавить(Пара("Частота", Формат(П.СерверЦПУМГц, "ЧГ=") + " МГц"));
	КонецЕсли;
	Если П.СерверПамятьМб > 0 Тогда
		Части.Добавить(Пара("Память", Формат(П.СерверПамятьМб, "ЧГ=") + " МБ, свободно "
			+ Формат(П.СерверСвободнаПамятьМб, "ЧГ=") + " МБ"));
	КонецЕсли;
	Если П.СерверОЗУСлотов > 0 ИЛИ П.СерверОЗУЧастотаМГц > 0 Тогда
		Части.Добавить(Пара("Модули ОЗУ", ОЗУПояснение(П)));
	КонецЕсли;
	Части.Добавить(Пара("BIOS / UEFI", П.СерверBIOS));
	Части.Добавить(Пара("Тип машины", П.СерверВиртуализация));
	Части.Добавить(Пара("Диски", П.СерверДиски));
	Если П.СерверСвободноНаДискеГБ > 0 Тогда
		Части.Добавить(Пара("Свободно на диске", Формат(П.СерверСвободноНаДискеГБ, "ЧДЦ=0; ЧГ=") + " ГБ"));
	КонецЕсли;
	Если ЗначениеЗаполнено(П.СерверСетьАдаптер) Тогда
		Части.Добавить(Пара("Сеть", СокрЛП(П.СерверСетьАдаптер)
			+ ?(П.СерверСетьСкоростьМбит > 0, ", " + Формат(П.СерверСетьСкоростьМбит, "ЧГ=") + " Мбит/с", "")));
	КонецЕсли;
	Части.Добавить(Пара("Аптайм", П.СерверАптайм));
	Части.Добавить("</dl></article>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция БлокПлатформа(Данные)

	П = Данные.Паспорт;
	Части = Новый Массив;
	Части.Добавить("<article class='pfsc-card'><h2>Платформа и информационная база</h2>"
		+ "<dl class='pfsc-rows'>");
	Части.Добавить(Пара("Платформа сервера", СокрЛП(П.ВерсияПлатформыСервер)
		+ ?(ЗначениеЗаполнено(П.ПлатформаСервер), ", " + СокрЛП(П.ПлатформаСервер), "")));
	Если ЗначениеЗаполнено(П.ВерсияПлатформыКлиент) Тогда
		Части.Добавить(Пара("Платформа клиента", СокрЛП(П.ВерсияПлатформыКлиент)
			+ ?(ЗначениеЗаполнено(П.ТипПлатформыКлиент), ", " + СокрЛП(П.ТипПлатформыКлиент), "")));
	КонецЕсли;
	Части.Добавить(Пара("Режим клиента", П.РежимКлиента
		+ ?(ЗначениеЗаполнено(П.РежимЗапуска), " (" + СокрЛП(П.РежимЗапуска) + ")", "")));
	Части.Добавить(Пара("Режим ИБ", П.РежимИБ));
	Части.Добавить(Пара("СУБД", П.СУБД));
	Если ЗначениеЗаполнено(П.ВерсияСУБД) Тогда
		Части.Добавить(Пара("Версия СУБД", П.ВерсияСУБД));
	КонецЕсли;
	Части.Добавить(Пара("Имя ИБ", П.ИмяИБ));
	Части.Добавить(Пара("Версия конфигурации", П.ВерсияКонфигурации));
	Части.Добавить(Пара("Часовой пояс сеанса", П.СерверЧасовойПояс));
	Части.Добавить(Пара("Часовой пояс ИБ", П.ЧасовойПоясИБ));
	Части.Добавить(Пара("Каталог программы", П.СерверКаталогПрограммы));
	Части.Добавить(Пара("Временные файлы", П.СерверКаталогВременныхФайлов));
	Части.Добавить("</dl></article>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция БлокКлиент(Данные)

	П = Данные.Паспорт;
	// Клиентских данных может не быть (веб, внешнее соединение): блок не рисуем.
	Если ПустаяСтрока(П.КлиентОС) И ПустаяСтрока(П.КлиентЦПУ) И ПустаяСтрока(П.КлиентИмяКомпьютера) Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Части.Добавить("<section class='pfsc-grid'><article class='pfsc-card pfsc-span'>"
		+ "<h2>Рабочее место (клиент)</h2><dl class='pfsc-rows'>");
	Части.Добавить(Пара("Компьютер", П.КлиентИмяКомпьютера
		+ ?(ЗначениеЗаполнено(П.КлиентПК), " (" + СокрЛП(П.КлиентПК) + ")", "")));
	Части.Добавить(Пара("ОС клиента", П.КлиентОС));
	Части.Добавить(Пара("Процессор", П.КлиентЦПУ + ?(ЗначениеЗаполнено(П.КлиентЦПУПотоки),
		", " + СокрЛП(П.КлиентЦПУПотоки), "")));
	Если П.КлиентПамятьМб > 0 Тогда
		Части.Добавить(Пара("Память", Формат(П.КлиентПамятьМб, "ЧГ=") + " МБ, свободно "
			+ Формат(П.КлиентСвободнаПамятьМб, "ЧГ=") + " МБ"));
	КонецЕсли;
	Части.Добавить(Пара("Идентификатор клиента", П.КлиентИдентификатор));
	Части.Добавить(Пара("Аптайм", П.КлиентАптайм));
	Если ЗначениеЗаполнено(П.КлиентБраузер) Тогда
		Части.Добавить(Пара("Браузер", П.КлиентБраузер));
	КонецЕсли;
	Части.Добавить("</dl></article></section>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция БлокЗамеры(Данные)

	Если Данные.Замеры.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Максимум = 0;
	Для Каждого Замер Из Данные.Замеры Цикл
		Максимум = Макс(Максимум, Замер.МедианаМс);
	КонецЦикла;

	Части = Новый Массив;
	Части.Добавить("<section class='pfsc-card pfsc-span'><h2>Замеры стенда (медианы)</h2>"
		+ "<div class='pfsc-table-wrap'><table><thead><tr>"
		+ "<th>Сценарий</th><th class='n'>Медиана, мс</th><th class='n'>мс / 1000 ед.</th>"
		+ "<th class='n'>Мин</th><th class='n'>Макс</th><th class='n'>Порция</th><th>Доля</th>"
		+ "</tr></thead><tbody>");
	Для Каждого Замер Из Данные.Замеры Цикл
		Подпись = Замер.Сценарий;
		Описание = "";
		Сценарий = СценарийПоКоду(Замер.Сценарий);
		Если Сценарий <> Неопределено Тогда
			Подпись = Сценарий.Представление;
			Описание = Сценарий.Описание;
		КонецЕсли;
		Доля = ?(Максимум > 0, Окр(Замер.МедианаМс / Максимум * 100, 0), 0);
		Части.Добавить("<tr><td class='name'>" + Текст(Подпись)
			+ "<div class='pfsc-code'>" + Текст(Замер.Сценарий) + "</div>"
			+ ?(ПустаяСтрока(Описание), "", "<div class='pfsc-note'>" + Текст(Описание) + "</div>")
			+ "</td><td class='n'>" + Формат(Замер.МедианаМс, "ЧГ=") + "</td>"
			+ "<td class='n'>" + Формат(Замер.НаЕдиницуМс, "ЧДЦ=2; ЧГ=") + "</td>"
			+ "<td class='n'>" + Формат(Замер.МинМс, "ЧГ=") + "</td>"
			+ "<td class='n'>" + Формат(Замер.МаксМс, "ЧГ=") + "</td>"
			+ "<td class='n'>" + Формат(Замер.Порция, "ЧГ=") + "</td>"
			+ "<td><div class='pfsc-bar'><i style='width:" + Формат(Доля, "ЧГ=") + "%'></i></div></td></tr>");
	КонецЦикла;
	Части.Добавить("</tbody></table></div></section>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция БлокЗамечаний(Данные)

	Части = Новый Массив;
	Части.Добавить("<article class='pfsc-card'><h2>Что не собрано</h2>");
	Если Данные.Замечания.Количество() = 0 Тогда
		Части.Добавить("<div class='pfsc-ok'>Паспорт собран полностью: все блоки применимы "
			+ "на этом стенде.</div>");
	Иначе
		Части.Добавить("<ul class='pfsc-notes'>");
		Для Каждого Причина Из Данные.Замечания Цикл
			Части.Добавить("<li><span class='pfsc-ico'>i</span><span>" + Текст(Причина) + "</span></li>");
		КонецЦикла;
		Части.Добавить("</ul>");
	КонецЕсли;
	Части.Добавить("</article>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция БлокДиагностики(Данные)

	П = Данные.Паспорт;
	Части = Новый Массив;
	Части.Добавить("<article class='pfsc-card'><h2>Диагностика сбора</h2><dl class='pfsc-rows'>");
	Части.Добавить(Пара("Схема паспорта", Формат(П.СхемаПаспорта, "ЧГ=")));
	Если П.ВремяСбораМс > 0 Тогда
		Части.Добавить(Пара("Время сбора", Формат(П.ВремяСбораМс, "ЧГ=") + " мс"));
	КонецЕсли;
	Части.Добавить(Пара("Блоков не собрано", Формат(П.БлоковНеСобрано, "ЧГ=")));
	Части.Добавить(Пара("Дата паспорта", Формат(П.ДатаПаспорта, "ДЛФ=DT")));
	Части.Добавить(Пара("Платформа сбора", П.ВерсияПлатформыСервер));
	Если ЗначениеЗаполнено(П.Примечание) Тогда
		Части.Добавить(Пара("Примечание", П.Примечание));
	КонецЕсли;
	Части.Добавить("</dl></article>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция Подвал(Данные)

	П = Данные.Паспорт;
	Возврат "<footer class='pfsc-foot'>"
		+ "<span>Паспорт стенда · схема " + Формат(П.СхемаПаспорта, "ЧГ=") + "</span>"
		+ "<span>Отпечаток <span class='pfsc-mono'>" + Текст(Лев(П.Отпечаток, 80)) + "</span></span>"
		+ "<span>Сбор идёт до старта замера и в фоне: результат не искажается</span></footer>";

КонецФункции

// Пара «подпись - значение»; пустое значение не выводится.
Функция Пара(Подпись, Значение)

	ТекстЗначения = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(ТекстЗначения) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "<dt>" + Текст(Подпись) + "</dt><dd>" + Текст(ТекстЗначения) + "</dd>";

КонецФункции

// Склонение для счетчика неприменимых блоков: 1 блок, 2 блока, 5 блоков.
Функция СклонениеБлоков(Количество)

	Остаток10 = Количество % 10;
	Остаток100 = Количество % 100;
	Если Остаток10 = 1 И Остаток100 <> 11 Тогда
		Возврат "блок";
	ИначеЕсли Остаток10 >= 2 И Остаток10 <= 4 И (Остаток100 < 12 ИЛИ Остаток100 > 14) Тогда
		Возврат "блока";
	КонецЕсли;
	Возврат "блоков";

КонецФункции

Функция Чип(ТекстЧипа, Вид)

	Возврат "<span class='pfsc-chip" + ?(ПустаяСтрока(Вид), "", " " + Вид) + "'>"
		+ "<i class='pfsc-dot'></i>" + Текст(ТекстЧипа) + "</span>";

КонецФункции

// Экранирование данных: паспорт содержит произвольные строки (пути, модели).
Функция Текст(Значение)

	Возврат ПерфUI.Экранировать(Значение);

КонецФункции

