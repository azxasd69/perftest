// Страница журнала обмена (ТЗ_доработка_интеграция.md, § 13, этап Э2).
//
// Собирается теми же строителями, что отчёты: ПерфUI.Документ даёт полный
// документ с меню и темой, дальше только таблицы и бейджи. Своих стилей нет,
// поэтому расширение PerfStyle не требует правок (ТЗ 1.3).

#Область Страница

// Полная страница журнала: состояние, каналы, очередь, последние отправки.
Функция Страница(Активный = "ПерфОбменЖурнал", Настройки = Неопределено) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Состояние = ПерфОбмен.СостояниеОбмена();
	Тело = БлокСостояния(Состояние) + БлокСреды() + БлокКаналов() + БлокОчереди()
		+ БлокПодсказки();
	Возврат ПерфUI.Документ(Активный, "Журнал обмена", Тело, "", "wrap", Метаданные.Версия, "", Настройки);

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбменHTML",
			"Не удалось собрать страницу журнала обмена",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат ПерфUI.Документ(Активный, "Журнал обмена",
			"<p class='empty'>Страница не собрана: " + ПерфUI.Экранировать(ОписаниеОшибки())
				+ "</p>", "", "wrap", Метаданные.Версия, "", Настройки);
	КонецПопытки;

КонецФункции

Функция БлокСостояния(С) Экспорт

	Части = Новый Массив;
	Части.Добавить("<h2 style='font-size:14px;margin:12px 0 8px'>Состояние обмена</h2>");
	Части.Добавить("<div class='tiles'>");

	Части.Добавить(ПерфUI.Плитка("Состояние", С.Статус, "",
		?(ПустаяСтрока(С.Канал), "канал не выбран", "последний канал: " + С.Канал), "exchStatus"));
	Части.Добавить(ПерфUI.Плитка("В очереди", Формат(С.ВОчереди, "ЧГ=0"), "конвертов",
		"ждут отправки", "exchQueue"));
	Части.Добавить(ПерфUI.Плитка("Отправлено", Формат(С.Отправлено24ч, "ЧГ=0"), "за 24 ч",
		?(С.ПоследняяОтправка = Дата(1, 1, 1), "ещё не отправляли",
			"последняя: " + Формат(С.ПоследняяОтправка, "ДЛФ=DT")), "exchSent"));
	Части.Добавить(ПерфUI.Плитка("Ошибок", Формат(С.Ошибок, "ЧГ=0"), "конвертов",
		"ручной разбор нужен, если больше нуля", "exchErrors"));
	Если С.ОжидаетУтилиту > 0 Тогда
		Части.Добавить(ПерфUI.Плитка("Ждёт утилиту", Формат(С.ОжидаетУтилиту, "ЧГ=0"), "конвертов",
			"выгрузка в спул или канал DNS", "exchUtil"));
	КонецЕсли;

	Части.Добавить("</div>");
	Возврат СтрСоединить(Части, "");

КонецФункции

// Среда запуска: где исполняется код, вариант работы базы, ОС и возможности.
// Строка нужна, чтобы различие стендов не выглядело дефектом: в файловой ИБ
// «сервер» и клиент - один процесс, на Linux нет WMI и так далее.
Функция БлокСреды() Экспорт

	Попытка
		Среда = ПерфСреда.Определить();
	Исключение
		Возврат "";
	КонецПопытки;

	Возможности = Среда.Возможности;
	Части = Новый Массив;
	Части.Добавить("<h2 style='font-size:14px;margin:12px 0 8px'>Среда запуска</h2>");
	Части.Добавить("<div class='chips'>");
	Части.Добавить(ПерфUI.Бейдж("где код: " + Среда.ГдеКод));
	Части.Добавить(ПерфUI.Бейдж("база: " + Среда.ВариантРаботы));
	Части.Добавить(ПерфUI.Бейдж("ОС: " + Среда.ОС));
	Части.Добавить(ПерфUI.Бейдж("платформа: " + Среда.Платформа));
	Части.Добавить(ПерфUI.Бейдж("WMI: " + ?(Возможности.WMI, "есть", "нет"),
		?(Возможности.WMI, "ok", "")));
	// BSLLS:UsingHardcodePath-off (подпись чипа, а не путь к файлу)
	Части.Добавить(ПерфUI.Бейдж("/proc: " + ?(Возможности.Proc, "есть", "нет"),
		?(Возможности.Proc, "ok", "")));
	Части.Добавить(ПерфUI.Бейдж("pscp: " + ?(Возможности.Pscp, "есть", "нет"),
		?(Возможности.Pscp, "ok", "cancel")));
	Части.Добавить(ПерфUI.Бейдж("openssl: " + ?(Возможности.OpenSSL, "есть", "нет"),
		?(Возможности.OpenSSL, "ok", "cancel")));
	Если Среда.РежимКлиента <> "Неизвестно" Тогда
		Части.Добавить(ПерфUI.Бейдж("клиент: " + Среда.РежимКлиента));
	КонецЕсли;
	Части.Добавить(ПерфUI.Бейдж("профиль: " + Среда.Отпечаток));
	Части.Добавить("</div>");
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция БлокКаналов() Экспорт

	Заголовки = Новый Массив;
	Заголовки.Добавить("Канал");
	Заголовки.Добавить("Включён");
	Заголовки.Добавить("Проба");
	Заголовки.Добавить("Код");
	Заголовки.Добавить("Мс");
	Заголовки.Добавить("Причина");

	Строки = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Канал КАК Канал,
		|	Т.Разрешён КАК Разрешён,
		|	Т.Доступен КАК Доступен,
		|	Т.Код КАК Код,
		|	Т.Мс КАК Мс,
		|	Т.Причина КАК Причина,
		|	Т.ГоденДо КАК ГоденДо
		|ИЗ
		|	РегистрСведений.ПерфОбменПроба КАК Т
		|ГДЕ
		|	Т.Узел = &Узел
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.Приоритет");
	// Журнал показывает каналы, по которым отправляет сервер: пробы клиента
	// и внешней утилиты живут на карточке стенда.
	Запрос.УстановитьПараметр("Узел", "Сервер");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Массив;
		Строка.Добавить(ПерфUI.Экранировать(Выборка.Канал));
		Строка.Добавить(?(Выборка.Разрешён, ПерфUI.Бейдж("да", "ok"), ПерфUI.Бейдж("нет")));
		Если Выборка.Доступен И Выборка.ГоденДо > ТекущаяДатаСеанса() Тогда
			Строка.Добавить(ПерфUI.Бейдж("доступен", "ok"));
		Иначе
			Строка.Добавить(ПерфUI.Бейдж("недоступен", "err"));
		КонецЕсли;
		Строка.Добавить(Формат(Выборка.Код, "ЧГ=0"));
		Строка.Добавить(Формат(Выборка.Мс, "ЧЦ=6; ЧДЦ=0; ЧГ=0"));
		Строка.Добавить(ПерфUI.Экранировать(Выборка.Причина));
		Строки.Добавить(Строка);
	КонецЦикла;

	Право = Новый Массив;
	Право.Добавить(3);
	Право.Добавить(4);

	Возврат "<h2 style='font-size:14px;margin:16px 0 8px'>Каналы доставки</h2>"
		+ ПерфUI.Таблица(Заголовки, Строки, Право);

КонецФункции

Функция БлокОчереди() Экспорт

	Заголовки = Новый Массив;
	Заголовки.Добавить("Создан");
	Заголовки.Добавить("Вид");
	Заголовки.Добавить("Стенд");
	Заголовки.Добавить("Байт");
	Заголовки.Добавить("Статус");
	Заголовки.Добавить("Попыток");
	Заголовки.Добавить("Код");
	Заголовки.Добавить("Канал");
	Заголовки.Добавить("Текст ответа");

	Строки = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 30
		|
		|	Т.ДатаСоздания КАК ДатаСоздания,
		|	Т.Вид КАК Вид,
		|	Т.Стенд КАК Стенд,
		|	Т.РазмерБайт КАК РазмерБайт,
		|	Т.Статус КАК Статус,
		|	Т.Попыток КАК Попыток,
		|	Т.КодОтвета КАК КодОтвета,
		|	Т.Канал КАК Канал,
		|	Т.ТекстОтвета КАК ТекстОтвета
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаСоздания УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Массив;
		Строка.Добавить(Формат(Выборка.ДатаСоздания, "ДЛФ=DT"));
		Строка.Добавить(ПерфUI.Экранировать(Выборка.Вид));
		Строка.Добавить(ПерфUI.Экранировать(Выборка.Стенд));
		Строка.Добавить(Формат(Выборка.РазмерБайт, "ЧГ=0"));
		Состояние = ?(Выборка.Статус = "Отправлено", "ok",
			?(Выборка.Статус = "Ошибка", "err", ""));
		Строка.Добавить(ПерфUI.Бейдж(Выборка.Статус, Состояние));
		Строка.Добавить(Формат(Выборка.Попыток, "ЧГ=0"));
		Строка.Добавить(Формат(Выборка.КодОтвета, "ЧГ=0"));
		Строка.Добавить(ПерфUI.Экранировать(Выборка.Канал));
		Строка.Добавить(ПерфUI.Экранировать(Лев(Выборка.ТекстОтвета, 120)));
		Строки.Добавить(Строка);
	КонецЦикла;

	Право = Новый Массив;
	Право.Добавить(3);
	Право.Добавить(5);
	Право.Добавить(6);

	Возврат "<h2 style='font-size:14px;margin:16px 0 8px'>Очередь (последние 30)</h2>"
		+ ПерфUI.Таблица(Заголовки, Строки, Право);

КонецФункции

Функция БлокПодсказки() Экспорт

	Секрет = ПерфОбмен.СостояниеСекрета();
	Сертификат = ПерфОбмен.ПрочитатьСертификат();
	Адрес = СокрЛП(Константы.ПерфОбменАдрес.Получить());
	Путь = ПерфОбмен.БазовыйПуть();

	Части = Новый Массив;
	Части.Добавить("<h2 style='font-size:14px;margin:16px 0 8px'>Настройка</h2>");
	Части.Добавить("<div class='hints'>");
	Части.Добавить("<div class='hint'><b>Адрес приёма</b>"
		+ ПерфUI.Экранировать(?(ПустаяСтрока(Адрес), "не задан", Адрес + Путь + "/api/v1/ingest"))
		+ "</div>");
	Части.Добавить("<div class='hint'><b>Токен</b>"
		+ ПерфUI.Экранировать(?(Секрет.Есть, "задан, маска " + Секрет.Маска, "не задан"))
		+ "</div>");
	Части.Добавить("<div class='hint'><b>Ключ подписи</b>"
		+ ПерфUI.Экранировать(?(Секрет.КлючHMACЕсть, "задан", "нет: конверты уходят с sig=none"))
		+ "</div>");
	Части.Добавить("<div class='hint'><b>Сертификат портала</b>"
		+ ПерфUI.Экранировать(?(Сертификат.Есть,
			"в базе, отпечаток " + Лев(Сертификат.Отпечаток, 12), "нет: проверка TLS отключена (уровень B)"))
		+ "</div>");
	Части.Добавить("<div class='hint'><b>Что делает панель</b>"
		+ "Пункт палитры «Отправить очередь сейчас» отправляет один цикл, "
		+ "«Проба каналов» обновляет таблицу выше, «Журнал обмена» открывает эту страницу.</div>");
	Части.Добавить("</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

#КонецОбласти
