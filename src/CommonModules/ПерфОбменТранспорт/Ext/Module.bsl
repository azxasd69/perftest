// Транспорт обмена с порталом (ТЗ_доработка_интеграция.md, этапы Э2-Э6).
//
// Модуль отвечает только за доставку байтов: один адаптер на канал, единая
// структура результата, чтобы лестница в ПерфОбмен не знала различий транспортов.
// Настройки каналов живут в регистре ПерфОбменКанал, результаты проб - в
// ПерфОменПроба; подпись, конверты и статусы очереди остаются в ПерфОбмен.
//
// Модуль серверный, без директив компиляции: в общих модулях они не пишутся.

#Область НастройкиКаналов

// Перечень каналов в порядке приоритета (ТЗ 9.1). WEBDAV и FTP делят 5-й номер.
Функция ВсеКаналы() Экспорт

	Коды = Новый Массив;
	Коды.Добавить("HTTPS");
	Коды.Добавить("HTTPS8443");
	Коды.Добавить("PROXY");
	Коды.Добавить("HTTP80");
	Коды.Добавить("WEBDAV");
	Коды.Добавить("FTP");
	Коды.Добавить("SMTP");
	Коды.Добавить("SFTP");
	Коды.Добавить("DNS");
	Возврат Коды;

КонецФункции

// Типовые настройки канала: используются, пока администратор не поменял запись.
Функция ТиповыеНастройки(Код) Экспорт

	П = Новый Структура;
	П.Вставить("Канал", Код);
	П.Вставить("Включен", Ложь);
	П.Вставить("Хост", "");
	П.Вставить("Пользователь", "");
	П.Вставить("Защита", "");
	П.Вставить("ПутьВходящие", "");
	П.Вставить("ПутьИсходящие", "");
	П.Вставить("АдресОтправителя", "");
	П.Вставить("АдресПолучателя", "");
	П.Вставить("АдресПодтверждения", "");
	П.Вставить("ПассивныйРежим", Истина);
	П.Вставить("ЛимитБайт", 262144);
	П.Вставить("ДопустимыеВиды", "result,passport,history");
	П.Вставить("ПробаЗапрос", "");
	П.Вставить("Таймаут", 0);
	// Приоритет и порт нужны всем каналам: значения по умолчанию, ниже уточняются.
	П.Вставить("БазовыйПриоритет", 1);
	П.Вставить("Порт", 443);
	П.Вставить("Примечание", "");

	Если Код = "HTTPS" Тогда
		П.БазовыйПриоритет = 1;
		П.Порт = 443;
		П.Защита = "TLS";
		П.ПробаЗапрос = "/api/v1/meta";
	ИначеЕсли Код = "HTTPS8443" Тогда
		П.БазовыйПриоритет = 2;
		П.Порт = 8443;
		П.Защита = "TLS";
		П.ПробаЗапрос = "/api/v1/meta";
	ИначеЕсли Код = "PROXY" Тогда
		П.БазовыйПриоритет = 3;
		П.Порт = 443;
		П.Защита = "TLS";
		П.ПробаЗапрос = "/api/v1/meta";
	ИначеЕсли Код = "HTTP80" Тогда
		П.БазовыйПриоритет = 4;
		П.Порт = 80;
		П.Защита = "нет";
		П.ЛимитБайт = 262144;
		П.ПробаЗапрос = "/api/v1/meta";
	ИначеЕсли Код = "WEBDAV" Тогда
		П.БазовыйПриоритет = 5;
		П.Порт = 443;
		П.Защита = "TLS";
		П.ПутьВходящие = "/in";
		П.ПутьИсходящие = "/out";
		П.ПробаЗапрос = "PROPFIND /in";
	ИначеЕсли Код = "FTP" Тогда
		П.БазовыйПриоритет = 5;
		П.Порт = 21;
		П.Защита = "FTPS-явный";
		П.ПутьВходящие = "/in";
		П.ПутьИсходящие = "/out";
		П.ПробаЗапрос = "LIST";
	ИначеЕсли Код = "SMTP" Тогда
		П.БазовыйПриоритет = 6;
		П.Порт = 587;
		П.Защита = "STARTTLS";
		П.ПробаЗапрос = "NOOP";
		П.ЛимитБайт = 262144;
	ИначеЕсли Код = "SFTP" Тогда
		П.БазовыйПриоритет = 7;
		П.Порт = 22;
		П.Защита = "SSH";
		П.ПутьВходящие = "/in";
		П.ПробаЗапрос = "ls";
	ИначеЕсли Код = "DNS" Тогда
		П.БазовыйПриоритет = 8;
		П.Порт = 53;
		П.Защита = "нет";
		П.ЛимитБайт = 6144;
		П.ДопустимыеВиды = "result,history";
		П.ПробаЗапрос = "TXT";
	КонецЕсли;

	Возврат П;

КонецФункции

// Создание записей каналов при первом обращении. Все каналы выключены:
// защита от случайной отправки по незакрытому протоколу (ТЗ 9.1).
Функция ОбеспечитьКаналы() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Существующие = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Канал КАК Канал
		|ИЗ
		|	РегистрСведений.ПерфОбменКанал КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Существующие.Вставить(СокрЛП(Выборка.Канал), Истина);
	КонецЦикла;

	Создано = 0;
	Для Каждого Код Из ВсеКаналы() Цикл
		Если Существующие.Получить(Код) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		П = ТиповыеНастройки(Код);
		Менеджер = РегистрыСведений.ПерфОбменКанал.СоздатьМенеджерЗаписи();
		Менеджер.Канал = Код;
		Менеджер.Включен = П.Включен;
		Менеджер.БазовыйПриоритет = П.БазовыйПриоритет;
		Менеджер.Хост = П.Хост;
		Менеджер.Порт = П.Порт;
		Менеджер.Пользователь = П.Пользователь;
		Менеджер.Защита = П.Защита;
		Менеджер.ПутьВходящие = П.ПутьВходящие;
		Менеджер.ПутьИсходящие = П.ПутьИсходящие;
		Менеджер.АдресОтправителя = П.АдресОтправителя;
		Менеджер.АдресПолучателя = П.АдресПолучателя;
		Менеджер.АдресПодтверждения = П.АдресПодтверждения;
		Менеджер.ПассивныйРежим = П.ПассивныйРежим;
		Менеджер.ЛимитБайт = П.ЛимитБайт;
		Менеджер.ДопустимыеВиды = П.ДопустимыеВиды;
		Менеджер.ПробаЗапрос = П.ПробаЗапрос;
		Менеджер.Таймаут = П.Таймаут;
		Менеджер.Примечание = "типовая настройка; включить после проверки канала";
		Менеджер.Записать();
		Создано = Создано + 1;
	КонецЦикла;

	Если Создано > 0 Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-channels:" + Создано);
	КонецЕсли;
	Возврат Создано;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбменТранспорт.Каналы",
			"Не удалось создать настройки каналов",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат 0;
	КонецПопытки;

КонецФункции

// Параметры канала: запись регистра поверх типовых значений.
Функция ПараметрыКанала(Код) Экспорт

	П = ТиповыеНастройки(Код);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|
		|	Т.Канал КАК Канал,
		|	Т.Включен КАК Включен,
		|	Т.БазовыйПриоритет КАК БазовыйПриоритет,
		|	Т.Хост КАК Хост,
		|	Т.Порт КАК Порт,
		|	Т.Пользователь КАК Пользователь,
		|	Т.Защита КАК Защита,
		|	Т.ПутьВходящие КАК ПутьВходящие,
		|	Т.ПутьИсходящие КАК ПутьИсходящие,
		|	Т.АдресОтправителя КАК АдресОтправителя,
		|	Т.АдресПолучателя КАК АдресПолучателя,
		|	Т.АдресПодтверждения КАК АдресПодтверждения,
		|	Т.ПассивныйРежим КАК ПассивныйРежим,
		|	Т.ЛимитБайт КАК ЛимитБайт,
		|	Т.ДопустимыеВиды КАК ДопустимыеВиды,
		|	Т.ПробаЗапрос КАК ПробаЗапрос,
		|	Т.Таймаут КАК Таймаут,
		|	Т.Примечание КАК Примечание
		|ИЗ
		|	РегистрСведений.ПерфОбменКанал КАК Т
		|ГДЕ
		|	Т.Канал = &Канал");
	Запрос.УстановитьПараметр("Канал", Код);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		П.Включен = Выборка.Включен;
		П.БазовыйПриоритет = Выборка.БазовыйПриоритет;
		Если ЗначениеЗаполнено(Выборка.Хост) Тогда
			П.Хост = СокрЛП(Выборка.Хост);
		КонецЕсли;
		Если Выборка.Порт > 0 Тогда
			П.Порт = Выборка.Порт;
		КонецЕсли;
		П.Пользователь = СокрЛП(Выборка.Пользователь);
		Если ЗначениеЗаполнено(Выборка.Защита) Тогда
			П.Защита = СокрЛП(Выборка.Защита);
		КонецЕсли;
		П.ПутьВходящие = ?(ЗначениеЗаполнено(Выборка.ПутьВходящие), СокрЛП(Выборка.ПутьВходящие), П.ПутьВходящие);
		П.ПутьИсходящие = ?(ЗначениеЗаполнено(Выборка.ПутьИсходящие), СокрЛП(Выборка.ПутьИсходящие), П.ПутьИсходящие);
		П.АдресОтправителя = СокрЛП(Выборка.АдресОтправителя);
		П.АдресПолучателя = СокрЛП(Выборка.АдресПолучателя);
		П.АдресПодтверждения = СокрЛП(Выборка.АдресПодтверждения);
		П.ПассивныйРежим = Выборка.ПассивныйРежим;
		Если Выборка.ЛимитБайт > 0 Тогда
			П.ЛимитБайт = Выборка.ЛимитБайт;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ДопустимыеВиды) Тогда
			П.ДопустимыеВиды = СокрЛП(Выборка.ДопустимыеВиды);
		КонецЕсли;
		П.ПробаЗапрос = ?(ЗначениеЗаполнено(Выборка.ПробаЗапрос), СокрЛП(Выборка.ПробаЗапрос), П.ПробаЗапрос);
		П.Таймаут = Выборка.Таймаут;
		П.Примечание = СокрЛП(Выборка.Примечание);
	КонецЕсли;
	Возврат П;

КонецФункции

// Открытый FTP запрещён: защита от отправки паспорта открытым текстом (ТЗ 9.1).
Функция КаналРазрешён(Код) Экспорт

	П = ПараметрыКанала(Код);
	Если НЕ П.Включен Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Код = "FTP" И НРег(СокрЛП(П.Защита)) = "нет" Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-ftp-plaintext-denied");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Хост канала: свой или из общего адреса обмена.
Функция ХостКанала(Код) Экспорт

	П = ПараметрыКанала(Код);
	Если ЗначениеЗаполнено(П.Хост) Тогда
		Возврат П.Хост;
	КонецЕсли;
	Возврат ПерфОбмен.РазобратьАдрес(Константы.ПерфОбменАдрес.Получить()).Хост;

КонецФункции

// Прокси канала: только для PROXY, иначе Неопределено.
Функция ПроксиКанала(Код) Экспорт

	Если Код <> "PROXY" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПерфОбмен.ПроксиИзНастроек();

КонецФункции

#КонецОбласти

#Область Проба

// Проба всех разрешённых каналов: один проход, одна запись набора (ТЗ 6.3).
// Возвращает массив структур результата пробы.
Функция ПроверитьКаналы() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	ОбеспечитьКаналы();
	Пробы = Новый Массив;
	Для Каждого Код Из ВсеКаналы() Цикл
		Пробы.Добавить(ПробаКанала(Код));
	КонецЦикла;
	ЗаписатьПробы(Пробы);
	Возврат Пробы;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбменТранспорт.Проба",
			"Не удалось выполнить пробу каналов",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Массив;
	КонецПопытки;

КонецФункции

Функция ПробаКанала(Код) Экспорт

	П = ПараметрыКанала(Код);
	Результат = Новый Структура("Канал, Разрешён, Доступен, Код, Ответ, Мс, Причина",
		Код, Ложь, Ложь, 0, "", 0, "");

	Результат.Разрешён = КаналРазрешён(Код);
	Если НЕ Результат.Разрешён Тогда
		Результат.Причина = ?(П.Включен, "канал запрещён политикой", "канал выключен");
		Возврат Результат;
	КонецЕсли;

	Начало = ПерфСценарии.ТекущиеМс();
	Попытка
		Если Код = "HTTPS" ИЛИ Код = "HTTPS8443" ИЛИ Код = "PROXY" ИЛИ Код = "HTTP80" Тогда
			Ответ = ПерфОбмен.ВыполнитьЗапрос("GET", ПерфОбмен.БазовыйПуть() + "/api/v1/meta",
				Неопределено, "", П.Порт, ПроксиКанала(Код));
			Результат.Код = Ответ.КодСостояния;
			Результат.Ответ = Строка(Ответ.КодСостояния);
			Результат.Доступен = (Ответ.КодСостояния = 200 И Ответ.ЭтоЖсон);
			Если Ответ.КодСостояния = 200 И НЕ Ответ.ЭтоЖсон Тогда
				Результат.Причина = "ответ не JSON: по адресу нет приёмника";
			КонецЕсли;
		ИначеЕсли Код = "WEBDAV" Тогда
			Ответ = ПерфОбмен.ВыполнитьЗапрос("GET", П.ПутьВходящие + "/", Неопределено, "", П.Порт);
			Результат.Код = Ответ.КодСостояния;
			Результат.Ответ = Строка(Ответ.КодСостояния);
			Результат.Доступен = (Ответ.КодСостояния = 200 ИЛИ Ответ.КодСостояния = 207
				ИЛИ Ответ.КодСостояния = 301 ИЛИ Ответ.КодСостояния = 401);
			Если НЕ Результат.Доступен Тогда
				Результат.Причина = "каталог in/ недоступен";
			КонецЕсли;
		ИначеЕсли Код = "FTP" Тогда
			Соединение = Новый FTPСоединение(ХостКанала(Код), П.Порт, П.Пользователь,
				СекретКанала(Код), Неопределено, П.ПассивныйРежим, Таймаут(П));
			Соединение.УстановитьТекущийКаталог(П.ПутьВходящие);
			Соединение.Закрыть();
			Результат.Доступен = Истина;
			Результат.Код = 200;
			Результат.Ответ = "226";
		ИначеЕсли Код = "SMTP" Тогда
			Почта = Новый ИнтернетПочта;
			// BSLLS:TimeoutsInExternalResources-off
			Почта.Подключиться(ПочтовыйПрофиль(П, СекретКанала(Код)), ПротоколИнтернетПочты.SMTP);
			// BSLLS:TimeoutsInExternalResources-on
			Почта.Отключиться();
			Результат.Доступен = Истина;
			Результат.Код = 200;
			Результат.Ответ = "220";
		ИначеЕсли Код = "SFTP" Тогда
			Результат.Доступен = ЕстьВPath("pscp");
			Результат.Код = ?(Результат.Доступен, 200, 0);
			Результат.Ответ = ?(Результат.Доступен, "pscp", "нет клиента");
			Если НЕ Результат.Доступен Тогда
				Результат.Причина = "нет клиента pscp в PATH";
			КонецЕсли;
		ИначеЕсли Код = "DNS" Тогда
			// В платформе нет DNS-клиента для произвольных TXT: канал только утилитой.
			Результат.Доступен = Ложь;
			Результат.Причина = "выполняется только утилитой perf-push";
		КонецЕсли;
	Исключение
		Результат.Доступен = Ложь;
		Результат.Причина = ПерфОбмен.КраткоОшибки(ОписаниеОшибки());
	КонецПопытки;

	Результат.Мс = ПерфСценарии.ТекущиеМс() - Начало;
	Если НЕ Результат.Доступен И Результат.Причина = "" Тогда
		Результат.Причина = ?(Результат.Код = 0, "нет ответа", "код " + Строка(Результат.Код));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Запись набора проб: один вызов Записать(Истина) после всех проб (ТЗ 6.3).
Процедура ЗаписатьПробы(Пробы)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Узел");
	Таблица.Колонки.Добавить("Канал");
	Таблица.Колонки.Добавить("Откуда");
	Таблица.Колонки.Добавить("Процесс");
	Таблица.Колонки.Добавить("Способ");
	Таблица.Колонки.Добавить("БазовыйПриоритет");
	Таблица.Колонки.Добавить("Приоритет");
	Таблица.Колонки.Добавить("Разрешён");
	Таблица.Колонки.Добавить("Доступен");
	Таблица.Колонки.Добавить("БылОтказ");
	Таблица.Колонки.Добавить("Код");
	Таблица.Колонки.Добавить("Ответ");
	Таблица.Колонки.Добавить("Мс");
	Таблица.Колонки.Добавить("ПК");
	Таблица.Колонки.Добавить("Проверен");
	Таблица.Колонки.Добавить("ГоденДо");
	Таблица.Колонки.Добавить("Причина");

	Сейчас = ТекущаяДатаСеанса();
	Для Каждого Проба Из Пробы Цикл
		СтрокаПробы = Таблица.Добавить();
		СтрокаПробы.Узел = "Сервер";
		СтрокаПробы.Канал = Проба.Канал;
		СтрокаПробы.Откуда = "сервер " + ИмяКомпьютера();
		СтрокаПробы.Процесс = ИмяПроцессаПробы();
		СтрокаПробы.Способ = ?(Проба.Канал = "PROXY", "Прокси", "Прямой");
		СтрокаПробы.БазовыйПриоритет = ПриоритетКанала(Проба.Канал);
		// Вес: сначала номер канала, недоступный уходит в конец списка.
		СтрокаПробы.Приоритет = СтрокаПробы.БазовыйПриоритет + ?(Проба.Доступен, 0, 10);
		СтрокаПробы.Разрешён = Проба.Разрешён;
		СтрокаПробы.Доступен = Проба.Доступен;
		СтрокаПробы.БылОтказ = НЕ Проба.Доступен;
		СтрокаПробы.Код = Проба.Код;
		СтрокаПробы.Ответ = Лев(Проба.Ответ, 120);
		СтрокаПробы.Мс = Проба.Мс;
		СтрокаПробы.ПК = ИмяКомпьютера();
		СтрокаПробы.Проверен = Сейчас;
		СтрокаПробы.ГоденДо = Сейчас + 900;
		СтрокаПробы.Причина = Лев(Проба.Причина, 200);
	КонецЦикла;

	Набор = РегистрыСведений.ПерфОбменПроба.СоздатьНаборЗаписей();
	Набор.Загрузить(Таблица);
	Набор.Записать(Истина);

КонецПроцедуры

Функция ИмяПроцессаПробы() Экспорт

	// В файловой ИБ серверный код исполняется в процессе клиента (ТЗ 17).
	Возврат "1cv8";

КонецФункции

// Каналы, пригодные прямо сейчас: разрешены и недавно отвечали.
// Пустой массив означает "проб не было" - вызывающий использует HTTPS.
Функция ДоступныеКаналы() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Каналы = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|
		|	Т.Канал КАК Канал,
		|	Т.Приоритет КАК Приоритет
		|ИЗ
		|	РегистрСведений.ПерфОбменПроба КАК Т
		|ГДЕ
		|	Т.Доступен
		|	И Т.ГоденДо > &Сейчас
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.Приоритет");
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если КаналРазрешён(СокрЛП(Выборка.Канал)) Тогда
			Каналы.Добавить(СокрЛП(Выборка.Канал));
		КонецЕсли;
	КонецЦикла;
	Возврат Каналы;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбменТранспорт.Проба",
			"Не удалось прочитать пробы каналов",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Массив;
	КонецПопытки;

КонецФункции

Функция ПриоритетКанала(Код) Экспорт

	Возврат ПараметрыКанала(Код).БазовыйПриоритет;

КонецФункции

#КонецОбласти

#Область Отправка

// Единая структура результата канала: лестнице не важны различия транспортов.
Функция РезультатКанала(Успех, Код, Текст, Уровень, Канал, НужноУтилиту = Ложь,
	ЭтоЖсон = Ложь, ОжидаетсяJSON = Ложь, ТранспортнаяОшибка = Ложь) Экспорт

	// ТранспортнаяОшибка отличает сетевой сбой от отказа приёмника: в первом случае
	// конверт возвращается в очередь, во втором - помечается Ошибкой как окончательный.
	Возврат Новый Структура("Успех, Код, Текст, Уровень, Канал, НужноУтилиту, ЭтоЖсон, ОжидаетсяJSON, ТранспортнаяОшибка",
		Успех, Код, Текст, Уровень, Канал, НужноУтилиту, ЭтоЖсон, ОжидаетсяJSON, ТранспортнаяОшибка);

КонецФункции

// Лестница: каналы по приоритету, первый успех закрывает цикл.
// Отказ приёмника (4xx кроме 429) не повторяется на другом канале: это решение
// сервера, а не сбой транспорта (ТЗ 9.3).
Функция ОтправитьПакет(Тело, Подпись) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Каналы = ДоступныеКаналы();
	Если Каналы.Количество() = 0 Тогда
		Каналы = Новый Массив;
		Каналы.Добавить("HTTPS");
	КонецЕсли;

	Последний = Неопределено;
	Для Каждого Код Из Каналы Цикл
		Результат = Отправить(Код, Тело, Подпись);
		Если Результат.Успех Тогда
			Возврат Результат;
		КонецЕсли;
		Последний = Результат;
		Если Результат.Код >= 400 И Результат.Код < 500 И Результат.Код <> 429 Тогда
			Возврат Результат;
		КонецЕсли;
		ПерфСценарии.ЗаписатьМетку("exchange-skip:" + Код + ":" + Результат.Код);
	КонецЦикла;

	Если Последний = Неопределено Тогда
		Возврат РезультатКанала(Ложь, 0, "нет доступных каналов", "C", "HTTPS",
			Ложь, Ложь, Ложь, Истина);
	КонецЕсли;
	Возврат Последний;

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбменТранспорт.Отправка",
			"Сбой лестницы каналов",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат РезультатКанала(Ложь, 0, ПерфОбмен.КраткоОшибки(ОписаниеОшибки()), "C", "HTTPS",
			Ложь, Ложь, Ложь, Истина);
	КонецПопытки;

КонецФункции

Функция Отправить(Канал, Тело, Подпись) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	П = ПараметрыКанала(Канал);
	Если РазмерБайт(Тело) > П.ЛимитБайт Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-too-big:" + Канал + ":" + РазмерБайт(Тело));
		Возврат РезультатКанала(Ложь, 413, "тело больше лимита канала", "C", Канал);
	КонецЕсли;

	Если Канал = "HTTPS" ИЛИ Канал = "HTTPS8443" ИЛИ Канал = "PROXY" ИЛИ Канал = "HTTP80" Тогда
		Возврат ОтправитьHTTPКаналом(Канал, Тело, Подпись, П);
	ИначеЕсли Канал = "WEBDAV" Тогда
		Возврат ОтправитьWebDAV(Тело, П);
	ИначеЕсли Канал = "FTP" Тогда
		Возврат ОтправитьFTP(Тело, П);
	ИначеЕсли Канал = "SMTP" Тогда
		Возврат ОтправитьSMTP(Тело, П);
	ИначеЕсли Канал = "SFTP" Тогда
		Возврат ОтправитьSFTP(Тело, П);
	ИначеЕсли Канал = "DNS" Тогда
		Возврат ОтправитьDNS(Тело, П);
	КонецЕсли;
	Возврат РезультатКанала(Ложь, 0, "канал не реализован: " + Канал, "C", Канал);

	Исключение
		Возврат РезультатКанала(Ложь, 0, ПерфОбмен.КраткоОшибки(ОписаниеОшибки()), "C", Канал,
			Ложь, Ложь, Ложь, Истина);
	КонецПопытки;

КонецФункции

Функция ОтправитьHTTPКаналом(Канал, Тело, Подпись, П) Экспорт

	// HTTP 80 и почта не дают транспортной защиты: открытый JSON по ним запрещён
	// (ТЗ 8.4). Шифрование делает ПерфОбменШифр, здесь - проверка условия.
	Если Канал = "HTTP80" И НЕ ПерфОбменШифр.ЕстьOpenSSL() Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-cms:none");
		Возврат РезультатКанала(Ложь, 0, "нет openssl: канал требует CMS", "C", Канал, Ложь, Ложь, Истина);
	КонецЕсли;

	Ответ = ПерфОбмен.ВыполнитьЗапрос("POST", ПерфОбмен.БазовыйПуть() + "/api/v1/ingest",
		Тело, Подпись, П.Порт, ПроксиКанала(Канал));
	Возврат РезультатКанала(
		(Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300),
		Ответ.КодСостояния, Ответ.ТелоСтрокой, Ответ.Уровень, Канал,
		Ложь, Ответ.ЭтоЖсон, Истина);

КонецФункции

Функция ОтправитьWebDAV(Тело, П) Экспорт

	// Сначала .part, затем MOVE: приёмник видит либо целый файл, либо ничего
	// (ТЗ 9.8.1). Имя файла - идентификатор первого конверта пакета.
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8);
	Имя = "perftest-" + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMddHHmmss") + "-"
		+ Строка(Новый УникальныйИдентификатор()) + ".json";
	Путь = П.ПутьВходящие + "/" + Имя;

	Запрос = Новый HTTPЗапрос(Путь + ".part");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.УстановитьТело(Данные);
	Ответ = ПерфОбмен.ВыполнитьЗапросОбъект("PUT", Запрос, П.Порт);
	Если Ответ.КодСостояния < 200 ИЛИ Ответ.КодСостояния >= 300 Тогда
		Возврат РезультатКанала(Ложь, Ответ.КодСостояния, "PUT .part отклонён", "B", "WEBDAV");
	КонецЕсли;

	Перемещение = Новый HTTPЗапрос(Путь + ".part");
	Перемещение.Заголовки.Вставить("Destination", Путь);
	Ответ = ПерфОбмен.ВыполнитьЗапросОбъект("MOVE", Перемещение, П.Порт);
	Возврат РезультатКанала((Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300),
		Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку(), "B", "WEBDAV");

КонецФункции

Функция ОтправитьFTP(Тело, П) Экспорт

	Если НРег(СокрЛП(П.Защита)) = "нет" Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-ftp-plaintext-denied");
		Возврат РезультатКанала(Ложь, 0, "открытый FTP запрещён", "C", "FTP");
	КонецЕсли;

	Защита = Новый ЗащищенноеСоединениеOpenSSL();
	Соединение = Новый FTPСоединение(ХостКанала("FTP"), П.Порт, П.Пользователь,
		СекретКанала("FTP"), Неопределено, П.ПассивныйРежим, Таймаут(П), Защита);
	Имя = "perftest-" + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMddHHmmss") + "-"
		+ Строка(Новый УникальныйИдентификатор()) + ".json";
	Соединение.УстановитьТекущийКаталог(П.ПутьВходящие);
	Соединение.Записать(Имя + ".part", ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8));
	Соединение.Переместить(Имя + ".part", Имя);
	Соединение.Закрыть();
	Возврат РезультатКанала(Истина, 200, "226", "B", "FTP");

КонецФункции

Функция ОтправитьSMTP(Тело, П) Экспорт

	Если НЕ ПерфОбменШифр.ЕстьOpenSSL() Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-cms:none");
		Возврат РезультатКанала(Ложь, 0, "нет openssl: почта требует CMS", "C", "SMTP");
	КонецЕсли;
	Если ПустаяСтрока(П.АдресПолучателя) Тогда
		Возврат РезультатКанала(Ложь, 0, "не задан адрес получателя", "C", "SMTP");
	КонецЕсли;

	Шифрование = ПерфОбменШифр.Зашифровать(Тело);
	Если НЕ Шифрование.Успех Тогда
		Возврат РезультатКанала(Ложь, 0, Шифрование.Причина, "C", "SMTP");
	КонецЕсли;

	Сообщение = Новый ИнтернетПочтовоеСообщение;
	Сообщение.Тема = "perftest " + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMddHHmmss");
	Сообщение.Отправитель = П.АдресОтправителя;
	Сообщение.Получатели.Добавить(П.АдресПолучателя);
	Сообщение.Тексты.Добавить("Конверт обмена вложением в формате CMS.");

	// У типа ИнтернетПочтовоеВложение конструктора нет вообще: вложение создаётся
	// методом коллекции Добавить(<ДвоичныеДанные>, <Наименование>).
	Сообщение.Вложения.Добавить(ПолучитьДвоичныеДанныеИзBase64Строки(Шифрование.ДанныеBase64),
		"perftest.cms");

	Почта = Новый ИнтернетПочта;
	// BSLLS:TimeoutsInExternalResources-off
	Почта.Подключиться(ПочтовыйПрофиль(П, СекретКанала("SMTP")), ПротоколИнтернетПочты.SMTP);
	// BSLLS:TimeoutsInExternalResources-on
	Отклонённые = Почта.Послать(Сообщение, ОбработкаТекстаИнтернетПочтовогоСообщения.НеОбрабатывать,
		ПротоколИнтернетПочты.SMTP);
	Почта.Отключиться();
	Если ТипЗнч(Отклонённые) = Тип("Соответствие") И Отклонённые.Количество() > 0 Тогда
		ТекстОтклонения = "";
		Для Каждого КлючИЗначение Из Отклонённые Цикл
			ТекстОтклонения = ТекстОтклонения + КлючИЗначение.Ключ + ": " + КлючИЗначение.Значение + "; ";
		КонецЦикла;
		Возврат РезультатКанала(Ложь, 0, "получатель отклонён: " + ТекстОтклонения, "C", "SMTP");
	КонецЕсли;
	Возврат РезультатКанала(Истина, 200, "письмо отправлено", "C", "SMTP");

КонецФункции

Функция ОтправитьSFTP(Тело, П) Экспорт

	Если НЕ ЕстьВPath("pscp") Тогда
		Возврат РезультатКанала(Ложь, 0, "нет клиента pscp в PATH", "C", "SFTP");
	КонецЕсли;

	Локальный = КаталогСпула() + "sftp-" + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMddHHmmss")
		+ "-" + Строка(Новый УникальныйИдентификатор()) + ".json";
	Запись = Новый ЗаписьТекста(Локальный, КодировкаТекста.UTF8);
	Запись.Записать(Тело);
	Запись.Закрыть();

	Имя = "perftest-" + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMddHHmmss") + ".json";
	Команда = "pscp -batch -P " + Строка(П.Порт)
		+ " -l " + П.Пользователь
		+ ?(ПустаяСтрока(ОтпечатокХоста(П)) , "", " -hostkey " + ОтпечатокХоста(П))
		+ " """ + Локальный + """ " + ХостКанала("SFTP") + ":" + П.ПутьВходящие + "/" + Имя;
	Запуск = ЗапуститьСТаймаутом(Команда, Таймаут(П));
	УдалитьФайлы(Локальный);
	Если НЕ Запуск.Успех Тогда
		ПерфСценарии.ЗаписатьМетку("exchange-sftp:" + Запуск.Причина);
		Возврат РезультатКанала(Ложь, 0, Запуск.Причина, "B", "SFTP");
	КонецЕсли;
	Возврат РезультатКанала(Истина, 200, "передано по sftp", "B", "SFTP");

КонецФункции

Функция ОтправитьDNS(Тело, П) Экспорт

	// В платформе нет DNS-клиента для произвольных TXT: конверт уходит утилите.
	Возврат РезультатКанала(Ложь, 0, "канал выполняется утилитой perf-push", "C", "DNS", Истина);

КонецФункции

// Профиль почты по настройкам канала.
Функция ПочтовыйПрофиль(П, Пароль) Экспорт

	// BSLLS:TimeoutsInExternalResources-off
	Профиль = Новый ИнтернетПочтовыйПрофиль;
	// BSLLS:TimeoutsInExternalResources-on
	Профиль.АдресСервераSMTP = ХостКанала("SMTP");
	Профиль.ПортSMTP = П.Порт;
	Профиль.ПользовательSMTP = П.Пользователь;
	Профиль.ПарольSMTP = Пароль;
	Профиль.ИспользоватьSSLSMTP = (НРег(СокрЛП(П.Защита)) <> "нет");
	Если ЗначениеЗаполнено(П.АдресПодтверждения) Тогда
		Профиль.АдресСервераIMAP = ХостКанала("SMTP");
		Профиль.ПортIMAP = 993;
		Профиль.ПользовательIMAP = П.Пользователь;
		Профиль.ПарольIMAP = Пароль;
		Профиль.ИспользоватьSSLIMAP = Истина;
	КонецЕсли;
	Возврат Профиль;

КонецФункции

Функция Таймаут(П) Экспорт

	Если П.Таймаут > 0 Тогда
		Возврат П.Таймаут;
	КонецЕсли;
	ЗначениеТаймаута = Константы.ПерфОбменТаймаут.Получить();
	Возврат ?(ЗначениеТаймаута > 0, ЗначениеТаймаута, 30);

КонецФункции

// Размер строки в байтах UTF-8: лимиты каналов заданы в байтах.
Функция РазмерБайт(Текст) Экспорт

	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8).Размер();

КонецФункции

// Секрет канала: пароль FTP/SMTP/SFTP из регистра секретов по имени "Канал:<код>".
Функция СекретКанала(Код) Экспорт

	Секреты = ПерфОбмен.ПрочитатьСекреты();
	Имя = "Канал:" + Код;
	Если Секреты.Свойство(Имя) Тогда
		Возврат СокрЛП(Секреты[Имя]);
	КонецЕсли;
	Возврат "";

КонецФункции

// Отпечаток хоста SFTP для -hostkey: хранится тем же механизмом, что и пароль.
Функция ОтпечатокХоста(П) Экспорт

	Возврат СекретКанала("SFTPHostKey");

КонецФункции

#КонецОбласти

#Область Спул

Функция КаталогСпула() Экспорт

	Каталог = ПерфОбмен.КаталогСекрета() + "spool" + ПолучитьРазделительПути();
	Если НЕ ПерфОбмен.ФайлЕсть(Каталог) Тогда
		Попытка
			СоздатьКаталог(Каталог);
		Исключение
			ПерфСценарии.ЗаписатьМетку("exchange-spool-error:" + ПерфОбмен.КраткоОшибки(ОписаниеОшибки()));
		КонецПопытки;
	КонецЕсли;
	Возврат Каталог;

КонецФункции

Функция УтилитаНастроена() Экспорт

	Возврат ПерфОбмен.ФайлЕсть(КаталогСпула() + "out" + ПолучитьРазделительПути());

КонецФункции

// Ступень 2: выгрузка неотправленных конвертов в каталог спула.
// Файл пишется как .part и переименовывается: утилита не увидит недописанный JSON.
Функция ВыгрузитьВСпул(Максимум = 50) Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Каталог = КаталогСпула();
	Файлов = 0;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|
		|	Т.Идентификатор КАК Идентификатор,
		|	Т.Тело КАК Тело
		|ИЗ
		|	РегистрСведений.ПерфОчередьОбмена КАК Т
		|ГДЕ
		|	Т.Статус В (""Ожидает"", ""ОжидаетУтилиту"")
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаСоздания");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() И Файлов < Максимум Цикл
		Имя = Каталог + Выборка.Идентификатор + ".json";
		Временный = Имя + ".part";
		Попытка
			Запись = Новый ЗаписьТекста(Временный, КодировкаТекста.UTF8);
			Запись.Записать(Выборка.Тело);
			Запись.Закрыть();
			ПереместитьФайл(Временный, Имя);
		Исключение
			ПерфСценарии.ЗаписатьМетку("exchange-spool-write:" + Выборка.Идентификатор + ":"
				+ ПерфОбмен.КраткоОшибки(ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;
		ПерфОбмен.ОтметитьПоИдентификаторуПублично(Выборка.Идентификатор, "ОжидаетУтилиту",
			0, "в спуле");
		ПерфОбмен.ПометитьПризнакУтилиты(Выборка.Идентификатор);
		Файлов = Файлов + 1;
	КонецЦикла;
	ПерфСценарии.ЗаписатьМетку("exchange-spool:" + Файлов);
	Возврат Новый Структура("Файлов, Осталось", Файлов, ПерфОбмен.КоличествоВОчереди());

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбменТранспорт.Спул",
			"Не удалось выгрузить конверты в спул",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Файлов, Осталось", 0, 0);
	КонецПопытки;

КонецФункции

// Чтение подтверждений утилиты: файлы <id>.ack в out/.
Функция ПрочитатьПодтверждения(Путь = "") Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Каталог = ?(ПустаяСтрока(Путь), КаталогСпула() + "out" + ПолучитьРазделительПути(), Путь);
	Подтверждено = 0;
	Если НЕ ПерфОбмен.ФайлЕсть(Каталог) Тогда
		Возврат Новый Структура("Подтверждено", 0);
	КонецЕсли;

	Файлы = НайтиФайлы(Каталог, "*.ack");
	Для Каждого Файл Из Файлы Цикл
		Идентификатор = Лев(Файл.Имя, СтрДлина(Файл.Имя) - 4);
		Если СтрДлина(Идентификатор) < 5 Тогда
			Продолжить;
		КонецЕсли;
		ПерфОбмен.ОтметитьПоИдентификаторуПублично(Идентификатор, "Отправлено", 200, "ack");
		УдалитьФайлы(Файл.ПолноеИмя);
		Подтверждено = Подтверждено + 1;
	КонецЦикла;
	ПерфСценарии.ЗаписатьМетку("exchange-ack:" + Подтверждено);
	Возврат Новый Структура("Подтверждено", Подтверждено);

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбменТранспорт.Спул",
			"Не удалось прочитать подтверждения",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Подтверждено", 0);
	КонецПопытки;

КонецФункции

// Задание утилите: спул плюс файл channels.json с разрешёнными каналами
// (приложение Е ТЗ). Реализация утилиты - отдельный артефакт.
Функция СформироватьЗаданиеУтилите() Экспорт

	// Публичный метод не бросает: сбой уходит в журнал, наружу - безопасное значение.
	Попытка
	Каталог = КаталогСпула();
	Если НЕ ПерфОбмен.ФайлЕсть(Каталог + "out" + ПолучитьРазделительПути()) Тогда
		СоздатьКаталог(Каталог + "out" + ПолучитьРазделительПути());
	КонецЕсли;
	Список = Новый Массив;
	Для Каждого Код Из ВсеКаналы() Цикл
		Если КаналРазрешён(Код) Тогда
			Список.Добавить(Код);
		КонецЕсли;
	КонецЦикла;
	Запись = Новый ЗаписьТекста(Каталог + "channels.json", КодировкаТекста.UTF8);
	Запись.Записать("{""channels"":[""" + СтрСоединить(Список, """,""") + """],"
		+ """api"":""" + СокрЛП(Константы.ПерфОбменАдрес.Получить()) + ""","
		+ """api_path"":""" + ПерфОбмен.БазовыйПуть() + """}");
	Запись.Закрыть();
	Возврат ВыгрузитьВСпул();

	Исключение
		ПерфЖурнал.ЗаписатьОшибку("ПерфОбменТранспорт.Спул",
			"Не удалось сформировать задание утилите",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		Возврат Новый Структура("Файлов, Осталось", 0, 0);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ВнешниеПроцессы

// Запуск внешней программы с контролем результата.
// Платформа 8.3.27 не имеет ни ЗапуститьПриложениеАсин, ни ЖдатьЗавершения,
// а глобальной паузы в языке нет, поэтому ожидание синхронное: зависание
// ограничено таймаутами протокола и флагом -batch у pscp (без запроса пароля).
// Долгий запуск не блокирует навсегда: по превышении ТаймаутСек пишется маркер
// exchange-slow-external, чтобы это было видно в прогоне.
Функция ЗапуститьСТаймаутом(Команда, ТаймаутСек) Экспорт

	Попытка
		НачалоМс = ПерфСценарии.ТекущиеМс();
		КодВозврата = -1;
		ЗапуститьПриложение(Команда, , Истина, КодВозврата);
		Длительность = ПерфСценарии.ТекущиеМс() - НачалоМс;
		Если Длительность > ТаймаутСек * 1000 Тогда
			ПерфСценарии.ЗаписатьМетку("exchange-slow-external:" + Формат(Длительность, "ЧГ=0"));
		КонецЕсли;
		Если КодВозврата = 0 Тогда
			Возврат Новый Структура("Успех, Причина", Истина, "");
		КонецЕсли;
		Возврат Новый Структура("Успех, Причина",
			Ложь, "код возврата " + Формат(КодВозврата, "ЧГ=0"));
	Исключение
		Возврат Новый Структура("Успех, Причина", Ложь, ПерфОбмен.КраткоОшибки(ОписаниеОшибки()));
	КонецПопытки;

КонецФункции

// Есть ли программа в PATH. where.exe есть на всех поддерживаемых Windows.
Функция ЕстьВPath(Имя) Экспорт

	Попытка
		КодВозврата = -1;
		ЗапуститьПриложение("cmd /c where " + Имя, , Истина, КодВозврата);
		Возврат КодВозврата = 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти
