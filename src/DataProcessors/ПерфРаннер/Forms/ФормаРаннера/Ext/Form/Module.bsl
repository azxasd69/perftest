// Форма раннера «ПерфРаннер»: выбор сценариев, запуск, сводка медиан, CSV.

// Каталог сценариев переносится в таблицу формы: отметка «Выполнить»,
// представление, описание, порция, единица и число повторов.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КаталогСценариев = ПерфСценарии.СписокСценариев();
	Для Каждого Сценарий Из КаталогСценариев Цикл
		СтрокаСценария = Сценарии.Добавить();
		СтрокаСценария.Выполнить = Истина;
		СтрокаСценария.Имя = Сценарий.Имя;
		СтрокаСценария.Представление = Сценарий.Представление;
		СтрокаСценария.Описание = Сценарий.Описание;
		СтрокаСценария.Порция = Сценарий.Порция;
		СтрокаСценария.Единица = Сценарий.Единица;
		СтрокаСценария.Повторов = Сценарий.Повторов;
	КонецЦикла;

	Повторов = 3;
	ПутьCSV = ПутьCSVПоУмолчанию();
	ШапкаHTML = ШапкаРаннераИзКода();
	Статус = "Готов к запуску. Отметьте сценарии и нажмите «Запустить».";

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Баннер-шапка страницы: HTML собирается из кода, макет не используется.
&НаСервере
Функция ШапкаРаннераИзКода()
	Возврат "<!DOCTYPE html>
|<html>
|<head><meta charset='utf-8'><style>
|html{width:100%;height:100%}
|body{width:100%;height:100%;margin:0;padding:0;font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#111827;background:#F3F4F6}
|.band{background:#111827;padding:10px 24px}
|.band h1{margin:0 0 3px 0;font-size:16px;font-weight:600;color:#FFFFFF}
|.band .sub{color:#9CA3AF;font-size:12px;line-height:1.6}
|.band .sub b{color:#93C5FD;font-weight:600}
|.num{display:inline-block;background:#2563EB;color:#FFFFFF;border-radius:10px;padding:0 7px;font-size:11px;font-weight:600;margin-right:5px}
|</style></head>
|<body>
|<div class='band'>
|  <h1>Запуск тестов производительности (обработка)</h1>
|  <div class='sub'><span class='num'>1</span>отметьте сценарии | <span class='num'>2</span>«Запустить» | ключевое число - <b>медиана из трех прогонов</b> | CSV пишется в указанный файл</div>
|</div>
|</body>
|</html>";
КонецФункции

// CSV по умолчанию: временный каталог + отметка даты и времени.
&НаСервере
Функция ПутьCSVПоУмолчанию()
	Возврат КаталогВременныхФайлов() + "perftest_"
		+ Формат(ТекущаяДатаСеанса(), "ДФ=ггггММддЧЧммсс") + ".csv";
КонецФункции

// Серверная обертка над ПерфСценарии.ВыполнитьСценарий: прогон идет на сервере.
// Порция и число повторов передаются из таблицы формы.
&НаСервере
Функция ВыполнитьСценарийНаСервере(Знач ИмяСценария, Знач Порция, Знач ЧислоПовторов)
	Возврат ПерфСценарии.ВыполнитьСценарий(ИмяСценария, Порция, ЧислоПовторов);
КонецФункции

// Серверная обертка над ПерфСценарии.Медиана - считается на сервере.
&НаСервере
Функция МедианаНаСервере(Знач Числа)
	Возврат ПерфСценарии.Медиана(Числа);
КонецФункции

#КонецОбласти

// Последовательный прогон отмеченных сценариев: результаты построчно в
// таблицу, медиана - в сводку; в конце CSV. Форма показывает только статус.
&НаКлиенте
Процедура ЗапуститьПрогоны(Команда)

	Результаты.Очистить();
	Сводка.Очистить();

	Всего = 0;
	Для Каждого СтрокаСценария Из Сценарии Цикл
		Если СтрокаСценария.Выполнить Тогда
			Всего = Всего + 1;
		КонецЕсли;
	КонецЦикла;

	Если Всего = 0 Тогда
		Статус = "Не отмечен ни один сценарий.";
		Возврат;
	КонецЕсли;

	Номер = 0;
	Для Каждого СтрокаСценария Из Сценарии Цикл
		Если Не СтрокаСценария.Выполнить Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;
		Статус = "Выполняется (" + Номер + " из " + Всего + "): " + СтрокаСценария.Представление;
		Прогоны = ВыполнитьСценарийНаСервере(СтрокаСценария.Имя, СтрокаСценария.Порция, Повторов);

		ВремяПрогонов = Новый Массив;
		МедианаПорция = 0;
		Для Каждого СтрокаПрогона Из Прогоны Цикл
			НоваяСтрока = Результаты.Добавить();
			НоваяСтрока.Сценарий = СтрокаСценария.Имя;
			НоваяСтрока.Представление = СтрокаСценария.Представление;
			НоваяСтрока.Прогон = СтрокаПрогона.Прогон;
			НоваяСтрока.ВремяМс = СтрокаПрогона.ВремяМс;
			НоваяСтрока.Порция = СтрокаПрогона.Порция;
			НоваяСтрока.Единица = СтрокаПрогона.Единица;
			Если СтрокаПрогона.Порция > 0 Тогда
				НоваяСтрока.НаЕдиницуМс = СтрокаПрогона.ВремяМс / СтрокаПрогона.Порция * 1000;
			КонецЕсли;
			ВремяПрогонов.Добавить(СтрокаПрогона.ВремяМс);
			МедианаПорция = СтрокаПрогона.Порция;
		КонецЦикла;

		МедианаМс = МедианаНаСервере(ВремяПрогонов);
		СтрокаСводки = Сводка.Добавить();
		СтрокаСводки.Сценарий = СтрокаСценария.Имя;
		СтрокаСводки.Представление = СтрокаСценария.Представление;
		СтрокаСводки.МедианаМс = МедианаМс;
		СтрокаСводки.Единица = СтрокаСценария.Единица;
		Если МедианаПорция > 0 Тогда
			СтрокаСводки.НаЕдиницуМс = МедианаМс / МедианаПорция * 1000;
		КонецЕсли;
		Статус = "Выполнено (" + Номер + " из " + Всего + "): " + СтрокаСценария.Представление
			+ " - медиана " + Формат(МедианаМс, "ЧГ=") + " мс";
	КонецЦикла;

	ЗаписатьCSV(ПутьCSV);
	Статус = "Готово: " + Всего + " сценариев. CSV: " + ПутьCSV;

КонецПроцедуры

// Отметить все сценарии к выполнению.
&НаКлиенте
Процедура ОтметитьВсе(Команда)
	Для Каждого СтрокаСценария Из Сценарии Цикл
		СтрокаСценария.Выполнить = Истина;
	КонецЦикла;
КонецПроцедуры

// Снять отметки со всех сценариев.
&НаКлиенте
Процедура СнятьВсех(Команда)
	Для Каждого СтрокаСценария Из Сценарии Цикл
		СтрокаСценария.Выполнить = Ложь;
	КонецЦикла;
КонецПроцедуры

// CSV: шапка (версия платформы, конфигурация, дата), затем сводка медиан,
// затем каждый прогон. Разделитель - точка с запятой, кодировка UTF-8.
// Собирается и пишется на сервере: в тонком и веб-клиенте файловые методы
// синхронные и запрещены платформой.
&НаСервере
Процедура ЗаписатьCSV(ПутьCSV)
	// Сбой пишется в журнал и пробрасывается: поведение шага не меняется, причина видна.
	Попытка
	Если ПустаяСтрока(ПутьCSV) Тогда
		Возврат;
	КонецЕсли;
	ТекстCSV = ПерфСценарии.ЗаголовокCSV() + Символы.ПС
		+ "Сценарий;Представление;Прогон;ВремяМс;Порция;Единица;МедианаМс" + Символы.ПС;
	Для Каждого СтрокаСводки Из Сводка Цикл
		ТекстCSV = ТекстCSV + СтрокаСводки.Сценарий + ";" + СтрокаСводки.Представление + ";;"
			+ СтрокаСводки.МедианаМс + ";;" + СтрокаСводки.Единица + ";" + СтрокаСводки.МедианаМс
			+ Символы.ПС;
	КонецЦикла;
	Для Каждого СтрокаРезультата Из Результаты Цикл
		ТекстCSV = ТекстCSV + СтрокаРезультата.Сценарий + ";" + СтрокаРезультата.Представление + ";"
			+ СтрокаРезультата.Прогон + ";" + СтрокаРезультата.ВремяМс + ";"
			+ СтрокаРезультата.Порция + ";" + СтрокаРезультата.Единица + ";" + Символы.ПС;
	КонецЦикла;
	Если Не ПерфОбслуживание.ЗаписатьТекстовыйФайл(ПутьCSV, ТекстCSV) Тогда
		ВызватьИсключение "не удалось записать файл CSV";
	КонецЕсли;
	Исключение
		ПерфЖурнал.ЗаписатьОшибку("Форма.Раннер.ЗаписатьCSV",
			"Сбой выполнения: ЗаписатьCSV",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры
