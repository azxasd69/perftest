&НаКлиенте
Перем ПоследняяВерсияНастроек;

// Форма отчета: настройки предзаполняются по текущему сеансу (ТЗ отчетов, раздел 12).
// Заполняет списки выбора из регистров и сразу строит отчет.
// Настройки предзаполняются по текущему сеансу (ТЗ отчетов, §12).
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОтчетHTML = "";
	ЗаполнитьСпискиВыбора();
	// Настройки передает обработчик нажатия пункта меню: страница собирается
	// по значениям, прочитанным в момент клика, и не обращается к константам.
	Настройки = Неопределено;
	Если Параметры.Свойство("Настройки") Тогда
		Настройки = ПерфUI.ДополнитьНастройки(Параметры.Настройки);
	КонецЕсли;
	// Фильтр по версии платформы приходит при открытии формы: переход между
	// отчетами сохраняет его, пустая строка - все версии.
	Если Параметры.Свойство("ВерсияПлатформы") Тогда
		ВерсияПлатформы = СокрЛП(Параметры.ВерсияПлатформы);
	КонецЕсли;
	Построить(Настройки);
КонецПроцедуры

// «Сформировать»: перестроение отчета с текущими настройками формы.
&НаКлиенте
Процедура Сформировать(Команда)
	Построить();
КонецПроцедуры

// «К текущему сеансу»: сбрасывает настройки, чтобы отчет снова выбрал их сам.
&НаКлиенте
Процедура СброситьКСеансу(Команда)
	БазовыйСтенд = "";
	ВерсияПлатформы = "";
	Построить();
КонецПроцедуры

// Строит HTML на сервере, кладет его в поле документа поля HTML и
// запоминает фактические параметры (они пишутся и в маркер смоука).
&НаСервере
Процедура Построить(Знач Настройки = Неопределено)
	Ключ = ПерфОтчетыHTML.КлючСтраницы("ПерфТопКонфигураций", БазовыйСтенд + "|" + ВерсияПлатформы);
	Если ПерфОтчетыHTML.КэшПопадание(ОтчетHTML, Ключ) Тогда
		Возврат;
	КонецЕсли;
	// Весь HTML собирает общий модуль ПерфОтчетыHTML: форма только
	// передает настройки и показывает результат.
	Результат = ПерфОтчетыHTML.СобратьТопКонфигураций(БазовыйСтенд, Настройки, ВерсияПлатформы);
	ОтчетHTML = Результат.HTML + ПерфОтчетыHTML.МеткаКэша(Ключ);
	БазовыйСтенд = Результат.БазовыйСтенд;
	ВерсияПлатформы = Результат.ВерсияПлатформы;
	ЗаписатьПараметры(Результат);
КонецПроцедуры

// Пишет строку «params:<форма>;...» в perftest_params.log: по ней смоук-прогон
// проверяет, какие стенд и сценарий выбрал отчет.
&НаСервере
Процедура ЗаписатьПараметры(Результат)
	// Сбой пишется в журнал и пробрасывается: поведение шага не меняется, причина видна.
	Попытка
	Путь = КаталогВременныхФайлов() + "perftest_params.log";
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, Символы.ПС, Истина);
	Запись.Записать("params:ПерфТопКонфигураций;" + Результат.БазовыйСтенд + ";"
		+ Результат.СтендСравнения + ";" + Результат.Сценарий + ";" + Результат.ТекущийСтенд
		+ ";версия:" + Результат.ВерсияПлатформы + ";стенды:" + ПерфОтчетыHTML.СписокСтендов() + ";диаг:" + ПерфОтчетыHTML.ДиагностикаСтендов());
	Запись.Закрыть();
	Исключение
		ПерфЖурнал.ЗаписатьОшибку("Форма.ПерфТопКонфигураций.ЗаписатьПараметры",
			"Сбой выполнения: ЗаписатьПараметры",
			ПерфОбмен.КраткоОшибки(ОписаниеОшибки()),
			"Ошибка", "", "", "сервер");
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Списки выбора стендов (и сценария для истории) - из регистров, а не константами.
&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	Элементы.БазовыйСтенд.СписокВыбора.Очистить();
	Для Каждого Значение Из ПерфОтчетыHTML.СписокСтендовМассив() Цикл
		Элементы.БазовыйСтенд.СписокВыбора.Добавить(Значение, Значение);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ОпросМенюОтч", 1, Ложь);
	ПоследняяВерсияНастроек = ВерсияНастроекСервер();
КонецПроцедуры

&НаСервере
Процедура СохранитьТемуНаСервере(Знач Тема)

	ПерфUI.СохранитьТемуПриложения(Тема);

КонецПроцедуры

&НаСервере
Процедура СохранитьПанельНаСервере(Знач Значение)

	ПерфUI.СохранитьСостояниеПанели(Значение);

КонецПроцедуры

&НаКлиенте
Процедура ОпросМенюОтч()
	Попытка
		Мост = Элементы.ОтчетHTML.Документ.defaultView;
		Если Мост = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Текст = Мост.PF1C.take();
		Если ПустаяСтрока(Текст) Тогда
			Возврат;
		КонецЕсли;
		Для Каждого Команда Из СтрРазделить(Текст, "|") Цикл
			Части = СтрРазделить(СокрЛП(Команда), ":", Ложь);
			Если Части.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			Имя = НРег(СокрЛП(Части[0]));
			Если Имя = "open" Тогда
				ОчиститьПередПереходом();
				ПараметрыПерехода = Новый Структура("Настройки, ВерсияПлатформы",
					НастройкиДляПерехода(), ВерсияПлатформы);
				ОткрытьФорму("ОбщаяФорма." + СокрЛП(Части[1]), ПараметрыПерехода);
				// Страница, с которой ушли, закрывается: в приложении остается одно окно,
				// и в нем всегда свежая сборка, а не снимок прошлого перехода.
				ПодключитьОбработчикОжидания("ЗакрытьПослеПерехода", 0.3, Истина);
			ИначеЕсли Имя = "base" Тогда
				// Поле «базовый стенд» в шапке страницы: тот же реквизит формы.
				БазовыйСтенд = СокрЛП(Части[1]);
				Построить();
			ИначеЕсли Имя = "platform" Тогда
				// Поле «версия платформы» в шапке: пустое значение - все версии.
				ВерсияПлатформы = СокрЛП(Части[1]);
				Построить();
			ИначеЕсли Имя = "refresh" Тогда
				Сформировать(Неопределено);
			ИначеЕсли Имя = "reset" Тогда
				СброситьКСеансу(Неопределено);
			ИначеЕсли Имя = "nav" Тогда
				СохранитьПанельНаСервере(НРег(СокрЛП(Части[1])));
				// Форма уже показывает новое состояние: метка обновляется,
				// чтобы ближайшая активация окна не перестраивала страницу зря.
				ПоследняяВерсияНастроек = ВерсияНастроекСервер();
			ИначеЕсли Имя = "theme" Тогда
				СохранитьТемуНаСервере(НРег(СокрЛП(Части[1])));
				// Форма уже показывает новое состояние: метка обновляется,
				// чтобы ближайшая активация окна не перестраивала страницу зря.
				ПоследняяВерсияНастроек = ВерсияНастроекСервер();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизации()

	ПроверитьНастройкиИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиИнтерфейса()
	ТекущаяВерсия = ВерсияНастроекСервер();
	Если ТекущаяВерсия <> ПоследняяВерсияНастроек Тогда
		ПоследняяВерсияНастроек = ТекущаяВерсия;
		ОбновитьСтраницуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВерсияНастроекСервер()
	Возврат ПерфUI.ВерсияНастроек();
КонецФункции

&НаСервере
Процедура ОбновитьСтраницуНаСервере()
	Построить();
КонецПроцедуры

// Читает настройки оформления в момент нажатия пункта меню: снимок уходит
// в параметры открываемой формы, поэтому страница не читает константы повторно.
&НаСервере
Функция НастройкиДляПерехода()
	Возврат ПерфUI.ПрочитатьНастройки();
КонецФункции

// Переход по пункту меню начинается с чистого листа: очередь команд моста
// обнуляется, метка настроек сбрасывается, снимок HTML в форме стирается.
// Иначе новая страница может унаследовать команды и состояние прошлой.
&НаКлиенте
Процедура ОчиститьПередПереходом()

	Попытка
		Мост = Элементы.ОтчетHTML.Документ.defaultView;
		Если Мост <> Неопределено Тогда
			Мост.PF1C.clear();
		КонецЕсли;
	Исключение
		// Поле еще не создано - чистить нечего.
		СведенияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	ПоследняяВерсияНастроек = "";

КонецПроцедуры

// Закрытие отложено на такт: новая страница уже создана и показана,
// поэтому приложение не остается без окна и переход выглядит одним действием.
&НаКлиенте
Процедура ЗакрытьПослеПерехода()

	ОтключитьОбработчикОжидания("ЗакрытьПослеПерехода");
	Закрыть();

КонецПроцедуры
