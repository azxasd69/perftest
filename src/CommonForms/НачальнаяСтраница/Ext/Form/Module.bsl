|  var tr = document.createElement('tr');
|  tr.id = 'summaryEmpty';
|  tr.innerHTML = '<td colspan=8 class=empty>- пока нет завершенных карточек -</td>';
|  tb.appendChild(tr);
|  var g = document.getElementById('globalStatus');
|  if (g) { g.innerHTML = '-'; }
|}
|</script></head>
|<body>
|<header class='top'>
|  <h1>ПерфТест - панель тестов производительности</h1>
|  <div class='sub'>Начальная страница: 11 карточек тестов , запуск, ход, результат - по каждой карточке</div>
|  <div class='chips'>
|    <span class='chip'>Платформа: <b id='chipPlatform'>{{PlatformVersion}}</b></span>
|    <span class='chip'>Конфигурация: <b id='chipConfig'>{{ConfigVersion}}</b></span>
|    <span class='chip'>Режим ИБ: <b id='chipMode'>{{IbMode}}</b></span>
|    <span class='chip'>Стенд: <b id='chipStandValue'>{{StandValue}}</b></span>
|    <span class='chip'>Сеанс: <b id='chipUser'>{{UserName}}</b></span>
|    <span class='chip'>Дата: <b id='chipDate'>{{CurrentDate}}</b></span>
|  </div>
|  <div class='hints'>
|    <div class='hint'><b>Как пользоваться</b>Нажмите «Запустить» на нужной карточке - выполнится только ее сценарий. Кнопка «Запустить все последовательно» прогоняет все карточки по порядку.</div>
|    <div class='hint'><b>Ход выполнения</b>Во время прогона строка карточки в таблице ниже показывает чанки («Чанк 3 из 10: 412 мс, 30%») и повторы («Прогон 2 из 3: 4 501 мс»).</div>
|    <div class='hint'><b>Результаты</b>Успех начинается с «ОК:», ошибка - с «Ошибка:». Медиана и время на порцию пишутся в регистр ПерфРезультаты и в сводку ниже. Во время прогона кнопки заблокированы; «Остановить» отменяет текущий тест.</div>
|  </div>
|</header>
|<div class='wrap'>
|  <div class='runbar'><b id='globalStatus'>-</b></div>
|  <table class='pts'>
|    <tr><td class='pl' id='pn1'>1. ЦПУ: арифметика</td><td class='pb'><div class='pbg'><div class='pbar' id='pb1'></div></div></td><td class='pp' id='pt1'>0%</td></tr>
|    <tr><td class='pl' id='pn2'>2. ЦПУ: строки</td><td class='pb'><div class='pbg'><div class='pbar' id='pb2'></div></div></td><td class='pp' id='pt2'>0%</td></tr>
|    <tr><td class='pl' id='pn3'>3. ЦПУ: коллекции</td><td class='pb'><div class='pbg'><div class='pbar' id='pb3'></div></div></td><td class='pp' id='pt3'>0%</td></tr>
|    <tr><td class='pl' id='pn4'>4. Запись: справочник</td><td class='pb'><div class='pbg'><div class='pbar' id='pb4'></div></div></td><td class='pp' id='pt4'>0%</td></tr>
|    <tr><td class='pl' id='pn5'>5. Запись: транзакция</td><td class='pb'><div class='pbg'><div class='pbar' id='pb5'></div></div></td><td class='pp' id='pt5'>0%</td></tr>
|    <tr><td class='pl' id='pn6'>6. Запись: документы</td><td class='pb'><div class='pbg'><div class='pbar' id='pb6'></div></div></td><td class='pp' id='pt6'>0%</td></tr>
|    <tr><td class='pl' id='pn7'>7. Запросы</td><td class='pb'><div class='pbg'><div class='pbar' id='pb7'></div></div></td><td class='pp' id='pt7'>0%</td></tr>
|    <tr><td class='pl' id='pn8'>8. Сериализация: JSON</td><td class='pb'><div class='pbg'><div class='pbar' id='pb8'></div></div></td><td class='pp' id='pt8'>0%</td></tr>
|    <tr><td class='pl' id='pn9'>9. Сериализация: внутренняя</td><td class='pb'><div class='pbg'><div class='pbar' id='pb9'></div></div></td><td class='pp' id='pt9'>0%</td></tr>
|    <tr><td class='pl' id='pn10'>10. Память</td><td class='pb'><div class='pbg'><div class='pbar' id='pb10'></div></div></td><td class='pp' id='pt10'>0%</td></tr>
|    <tr><td class='pl' id='pn11'>11. Файлы I/O</td><td class='pb'><div class='pbg'><div class='pbar' id='pb11'></div></div></td><td class='pp' id='pt11'>0%</td></tr>
|  </table>
|  <div class='sumwrap'>
|    <h2>Сводка результатов</h2>
|    <table class='sum'>
|      <thead><tr><th>№</th><th>Сценарий</th><th>Стенд</th><th>Медиана, мс</th><th>мс/тыс.</th><th>Повторов</th><th>Мин...Макс, мс</th><th>Дата замера</th></tr></thead>
|      <tbody id='summaryBody'><tr id='summaryEmpty'><td colspan='8' class='empty'>- пока нет завершенных карточек -</td></tr></tbody>
|    </table>
|  </div>
|</div>
|</body>
|</html>";
КонецФункции

&НаСервере
Функция СобратьШапкуHTML()
	СтрокаСоединения = ВРег(СокрЛП(СтрокаСоединенияИнформационнойБазы()));
	РежимИБСтрока = ?(СтрНайти(СтрокаСоединения, "FILE=") > 0, "файловый", "серверный");
	СтендСтрока = СокрЛП(Стенд);
	ВерсияПлатформыСтрока = ПерфСценарии.ВерсияПлатформы();
	ИмяСеанса = СокрЛП(ИмяПользователя());
	ДатаСтрока = Формат(ТекущаяДатаСеанса(), "ДЛФ_D");
	Попытка
		Шапка = ШапкаЧерезDOM(ВерсияПлатформыСтрока, ИмяСеанса, ДатаСтрока, РежимИБСтрока, СтендСтрока);
		Если ПустаяСтрока(Шапка) Тогда
			ВызватьИсключение "Шапка не собрана";
		КонецЕсли;
	Исключение
		Шапка = ШапкаЧерезМакросы(ВерсияПлатформыСтрока, ИмяСеанса, ДатаСтрока, РежимИБСтрока, СтендСтрока);
	КонецПопытки;
	Возврат Шапка;
КонецФункции

&НаСервере
Функция ШапкаЧерезDOM(ВерсияПлатформыСтрока, ИмяСеанса, ДатаСтрока, РежимИБСтрока, СтендСтрока)
	Чтение = Новый ЧтениеHTML;
	Чтение.УстановитьСтроку(ШаблонШапкиHTML());
	Построитель = Новый ПостроительDOM;
	ДокументHTML = Построитель.Прочитать(Чтение);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipPlatform"), ВерсияПлатформыСтрока);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipConfig"), Метаданные.Версия);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipMode"), РежимИБСтрока);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipStandValue"), ?(ПустаяСтрока(СтендСтрока), "-", СтендСтрока));
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipUser"), ИмяСеанса);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipDate"), ДатаСтрока);
	Возврат ТекстДокументаHTML(ДокументHTML);
КонецФункции

&НаСервере
Функция ШапкаЧерезМакросы(ВерсияПлатформыСтрока, ИмяСеанса, ДатаСтрока, РежимИБСтрока, СтендСтрока)
	Текст = ШаблонШапкиHTML();
	Текст = СтрЗаменить(Текст, "{{PlatformVersion}}", ВерсияПлатформыСтрока);
	Текст = СтрЗаменить(Текст, "{{ConfigVersion}}", Метаданные.Версия);
	Текст = СтрЗаменить(Текст, "{{IbMode}}", РежимИБСтрока);
	Текст = СтрЗаменить(Текст, "{{StandValue}}", ?(ПустаяСтрока(СтендСтрока), "-", СтендСтрока));
	Текст = СтрЗаменить(Текст, "{{UserName}}", ИмяСеанса);
	Текст = СтрЗаменить(Текст, "{{CurrentDate}}", ДатаСтрока);
	Возврат Текст;
КонецФункции

&НаСервере
Функция НайтиВложенныйЭлемент(ДокументHTML, ТекущийЭлемент, ИщемИдентификатор)
	ОбходДерева = ДокументHTML.СоздатьОбходДерева(ТекущийЭлемент);
	ТекущийУзел = ОбходДерева.ТекущийУзел;
	Пока ТекущийУзел <> Неопределено Цикл
		ТекущийУзел = ОбходДерева.СледующийУзел();
		Если ТекущийУзел = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если ТекущийУзел.ТипУзла = ТипУзлаDOM.Элемент И ТекущийУзел.Идентификатор = ИщемИдентификатор Тогда
			Возврат ТекущийУзел;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура УстановитьТекстЭлемента(ДокументHTML, Элемент, Текст)
	Если Элемент = Неопределено Тогда
		ВызватьИсключение "Элемент не найден";
	КонецЕсли;
	Пока Элемент.ДочерниеУзлы.Количество() > 0 Цикл
		Элемент.УдалитьДочерний(Элемент.ДочерниеУзлы[0]);
	КонецЦикла;
	Элемент.ДобавитьДочерний(ДокументHTML.СоздатьТекстовыйУзел(Текст));
КонецПроцедуры

&НаСервере
Функция ТекстДокументаHTML(ДокументHTML)
	ЗаписьHTML = Новый ЗаписьHTML;
	ЗаписьHTML.УстановитьСтроку();
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументHTML, ЗаписьHTML);
	Возврат ЗаписьHTML.Закрыть();
КонецФункции

#КонецОбласти

#Область ЗапускКарточек

&НаКлиенте
Процедура ЗапуститьКарточку(НомерКарточки)
	// Защита от двойного клика: пока задание живо, второй запуск игнорируется.
	// Очередь сюда попадает уже с пустым УИД (СледующаяИзОчереди его сбрасывает).
	Если НЕ ПустаяСтрока(ОрчУИДЗадания) Тогда
		Возврат;
	КонецЕсли;
	Имя = ЭтотОбъект["Сц" + НомерКарточки + "Имя"];
	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;
	// Паспорт стенда к моменту замера: фон уже собирает его с открытия формы.
	// Здесь только барьер: дождаться фона (не более 3 с) и, если паспорта нет,
	// записать быструю фазу - без WMI, чтобы клик не завис на COM.
	Попытка
		Если ПустаяСтрока(ОрчПаспортКлиента) Тогда
			ОрчПаспортКлиента = СобратьПаспортКлиента(Ложь);
		КонецЕсли;
		// 0,5 с вместо 3: фон стартует при открытии формы, а при неготовности
		// Обеспечить пишет быструю фазу без WMI - ждать три секунды не за что.
		ПерфПаспорт.Обеспечить(Стенд, ОрчПаспортКлиента, 0.5);
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
	ОрчКарточка = НомерКарточки;
	ОрчПрогон = 0;
	ОрчПорция = 0;
	ОрчЕдиница = "";
	ОрчВремена = "";
	ЭтотОбъект["Сц" + НомерКарточки + "Результат"] = "";
	ЭтотОбъект["Сц" + НомерКарточки + "Статус"] = "Запуск фонового задания...";
	УстановитьДоступностьКнопок(Ложь);
	ПоказатьПрогрессHTML(НомерКарточки, 0, "0%");
	СтартПрогона();
КонецПроцедуры

&НаКлиенте
Процедура СтартПрогона()
	ОтключитьОбработчикОжидания("ОпросПрогрессаФон");
	ОрчРезультатВремяМс = 0;
	ОрчРезультатПорция = 0;
	ОрчРезультатЕдиница = "";
	ОрчУИДЗадания = ПерфСценарии.ЗапуститьСценарийФон(ЭтотОбъект["Сц" + ОрчКарточка + "Имя"], 0, 10);
	ПоказатьСтендHTML();
	ПоказатьСтатусHTML("Выполняется: карточка " + ОрчКарточка + " (" + ЭтотОбъект["Сц" + ОрчКарточка + "Имя"] + ")");
	ПодключитьОбработчикОжидания("ОпросПрогрессаФон", 1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОпросПрогрессаФон()
	Если ПустаяСтрока(ОрчУИДЗадания) Тогда
		Возврат;
	КонецЕсли;
	Статус = ПерфСценарии.СостояниеСценарийФон(ОрчУИДЗадания);
	Для Каждого Текст Из Статус.Сообщения Цикл
		ОбработатьСообщение(Текст);
	КонецЦикла;
	Если Статус.Состояние = "Завершено" Тогда
		ЗавершитьПрогон(Статус);
	ИначеЕсли Статус.Состояние = "Аварийно" Тогда
		ОстановитьОчередьОшибкой(Статус.Ошибка);
	Иначе
		// интервал < 1 секунды допустим только однократно - обработчик переподключает сам себя
		ПодключитьОбработчикОжидания("ОпросПрогрессаФон", 1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСообщение(Текст)
	Если СтрНайти(Текст, "РЕЗУЛЬТАТ:") = 1 Тогда
		ЧастиР = СтрРазделить(СтрЗаменить(Текст, "РЕЗУЛЬТАТ:", ""), ";", Ложь);
		Если ЧастиР.Количество() = 3 Тогда
			ОрчРезультатВремяМс = Число(ЧастиР[0]);
			ОрчРезультатПорция = Число(ЧастиР[1]);
			ОрчРезультатЕдиница = ЧастиР[2];
		КонецЕсли;
	ИначеЕсли СтрНайти(Текст, "Чанк ") = 1 Тогда
		ЭтотОбъект["Сц" + ОрчКарточка + "Статус"] = "Прогон " + (ОрчПрогон + 1) + " из " + Повторов + ": " + Текст;
		Процент = ПроцентИзСообщения(Текст);
		Если Процент >= 0 Тогда
			ПоказатьПрогрессHTML(ОрчКарточка, Процент, Формат(Процент, "ЧГ=") + "%");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроцентИзСообщения(Текст)
	Позиция = СтрНайти(Текст, "(");
	Если Позиция = 0 Тогда
		Возврат -1;
	КонецЕсли;
	Фрагмент = СокрЛП(СтрЗаменить(Сред(Текст, Позиция + 1), "%)", ""));
	Если ПустаяСтрока(Фрагмент) Тогда
		Возврат -1;
	КонецЕсли;
	Попытка
		Возврат Число(Фрагмент);
	Исключение
		Возврат -1;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ЗавершитьПрогон(Статус)
	Если Статус.Состояние <> "Завершено" Тогда
		ОстановитьОчередьОшибкой("Фоновое задание не вернуло результат");
		Возврат;
	КонецЕсли;
	РезультатПрогона = Статус;
	НомерКарточки = ОрчКарточка;
	Если ОрчРезультатВремяМс = 0 Тогда
		ОстановитьОчередьОшибкой("Фоновое задание не вернуло результат");
		Возврат;
	КонецЕсли;
	ОрчПорция = ОрчРезультатПорция;
	ОрчЕдиница = ОрчРезультатЕдиница;
	ОрчПрогон = ОрчПрогон + 1;
	ЭтотОбъект["Сц" + НомерКарточки + "Статус"] = "Прогон " + ОрчПрогон + " из " + Повторов + ": "

		+ Формат(ОрчРезультатВремяМс, "ЧГ=0") + " мс";
	ПоказатьСтатусHTML("Выполняется: карточка " + НомерКарточки + " - прогон " + ОрчПрогон + " из " + Повторов);
	ОрчВремена = ОрчВремена + ?(ПустаяСтрока(ОрчВремена), "", ";") + Формат(ОрчРезультатВремяМс, "ЧГ=0");
	ДобавитьСтрокуРезультата(НомерКарточки, ОрчПрогон);
	Если ОрчПрогон < Повторов Тогда
		СтартПрогона();
		Возврат;
	КонецЕсли;
	ЗавершитьКарточку(НомерКарточки);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуРезультата(НомерКарточки, НомерПрогона)
	СтрокаПрогона = Результаты.Добавить();
	СтрокаПрогона.Сценарий = ЭтотОбъект["Сц" + НомерКарточки + "Имя"];
	СтрокаПрогона.Представление = "";
	СтрокаПрогона.Прогон = НомерПрогона;
	СтрокаПрогона.ВремяМс = ОрчРезультатВремяМс;
	СтрокаПрогона.Порция = ОрчРезультатПорция;
	СтрокаПрогона.Единица = ОрчРезультатЕдиница;
	Если ОрчРезультатПорция > 0 Тогда
		СтрокаПрогона.НаЕдиницуМс = ОрчРезультатВремяМс / ОрчРезультатПорция * 1000;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьКарточку(НомерКарточки)
	Итог = ПерфСценарии.ЗаписатьРезультат(Стенд, ЭтотОбъект["Сц" + НомерКарточки + "Имя"], "",
		ОрчПорция, ОрчЕдиница, ОрчВремена, Повторов, ОрчПаспортКлиента);
	МедианаМс = Итог.МедианаМс;
	НаЕдиницу = Итог.НаЕдиницуМс;
	МинМаксСтрока = Формат(Итог.МинМс, "ЧГ=") + "..." + Формат(Итог.МаксМс, "ЧГ=");
	ЭтотОбъект["Сц" + НомерКарточки + "Статус"] = "Готово";
	ЭтотОбъект["Сц" + НомерКарточки + "Результат"] = "ОК: медиана " + Формат(МедианаМс, "ЧГ=")
		+ " мс (" + Формат(НаЕдиницу, "ЧДЦ=2; ЧГ=") + " мс/тыс. " + ОрчЕдиница + ")";
	СтрокаСводки = Сводка.Добавить();
	СтрокаСводки.Сценарий = ЭтотОбъект["Сц" + НомерКарточки + "Имя"];
	СтрокаСводки.Представление = "";
	СтрокаСводки.МедианаМс = МедианаМс;
	СтрокаСводки.НаЕдиницуМс = НаЕдиницу;
	СтрокаСводки.Единица = ОрчЕдиница;
	ПоказатьПрогрессHTML(НомерКарточки, 100, "100%");
	ДобавитьСтрокуСводкиHTML(НомерКарточки, МедианаМс, НаЕдиницу, МинМаксСтрока);
	ПоказатьСтатусHTML("Готово: карточка " + НомерКарточки);
	ПоказатьРезультатКарточкиHTML(НомерКарточки, "ok",
		"ОК: медиана " + Формат(МедианаМс, "ЧГ=") + " мс (" + Формат(НаЕдиницу, "ЧДЦ=2; ЧГ=")
		+ " мс/тыс. " + ОрчЕдиница + ")", МедианаМс, МинМаксСтрока);
	СледующаяИзОчереди();
КонецПроцедуры

&НаКлиенте
Процедура СледующаяИзОчереди()
	ОрчУИДЗадания = "";
	Части = СтрРазделить(ОрчОчередь, ",", Ложь);
	Если Части.Количество() = 0 Тогда
		УстановитьДоступностьКнопок(Истина);
		Возврат;
	КонецЕсли;
	Следующая = Число(Части[0]);
	Остальные = Новый Массив;
	Для Индекс = 1 По Части.Количество() - 1 Цикл
		Остальные.Добавить(Части[Индекс]);
	КонецЦикла;
	ОрчОчередь = СтрСоединить(Остальные, ",");
	ЗапуститьКарточку(Следующая);
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьОчередьОшибкой(ТекстОшибки)
	ОрчОчередь = "";
	ОрчУИДЗадания = "";
	ЭтотОбъект["Сц" + ОрчКарточка + "Статус"] = "Ошибка";
	ЭтотОбъект["Сц" + ОрчКарточка + "Результат"] = "Ошибка: " + ТекстОшибки;
	ПоказатьСтатусHTML("Остановлено на карточке " + ОрчКарточка + ": " + ТекстОшибки);
	УстановитьДоступностьКнопок(Истина);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКнопок(Доступность)
	// Элементов в форме нет; визуальную блокировку рисует HTML. Повторный
	// запуск отсекает проверка ОрчУИДЗадания в ЗапуститьКарточку: обращение
	// к мосту отсюда блокировало клиент при старте очереди.
	Если Доступность И ПустаяСтрока(ОрчОчередь) Тогда
		// ничего не делаем: кнопки остаются доступными, защита - по УИД
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОстановитьТест(Команда)
	ОтключитьОбработчикОжидания("ОпросПрогрессаФон");
	Если НЕ ПустаяСтрока(ОрчУИДЗадания) Тогда
		ПерфСценарии.ОтменитьСценарийФон(ОрчУИДЗадания);
	КонецЕсли;
	ОрчОчередь = "";
	ОрчУИДЗадания = "";
	ЭтотОбъект["Сц" + ОрчКарточка + "Статус"] = "Отменено";
	ЭтотОбъект["Сц" + ОрчКарточка + "Результат"] = "Отмена: тест остановлен пользователем";
	ПоказатьСтатусHTML("Отменено: карточка " + ОрчКарточка);
	УстановитьДоступностьКнопок(Истина);
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗапуститьВсе(Команда)
	Результаты.Очистить();
	Сводка.Очистить();
	СброситьСводкуHTML();
	Очередь = Новый Массив;
	Для Н = 1 По 11 Цикл
		Если ПустаяСтрока(ЭтотОбъект["Сц" + Н + "Имя"]) Тогда
			Продолжить;
		КонецЕсли;
		Очередь.Добавить(Строка(Н));
	КонецЦикла;
	ОрчОчередь = СтрСоединить(Очередь, ",");
	СледующаяИзОчереди();
КонецПроцедуры

&НаКлиенте
Функция СобратьПаспортКлиента(СПодробностями = Истина)

	// Вся логика - в общем клиентском модуле: одинаково для формы и автопрогона.
	Попытка
		Возврат ПерфПаспортКлиент.СтрокаКлиента(СПодробностями);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ОбъектОкнаHTML()
	МостHTML = Элементы.ШапкаHTML.Документ.parentWindow;
	Если МостHTML = Неопределено Тогда
		МостHTML = Элементы.ШапкаHTML.Документ.defaultView;
	КонецЕсли;
	Возврат МостHTML;
КонецФункции

&НаКлиенте
Процедура ПоказатьПрогрессHTML(НомерКарточки, Процент, Текст)
	Попытка
		МостHTML = Элементы.ШапкаHTML.Документ.defaultView;
		Если МостHTML <> Неопределено Тогда
			МостHTML.SetProgress(НомерКарточки, Процент, Текст);
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтатусHTML(Текст)
	Попытка
		МостHTML = Элементы.ШапкаHTML.Документ.defaultView;
		Если МостHTML <> Неопределено Тогда
			МостHTML.SetGlobalStatus(Текст);
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтендHTML()
	Попытка
		МостHTML = Элементы.ШапкаHTML.Документ.defaultView;
		Если МостHTML <> Неопределено Тогда
			МостHTML.SetStandChip(Стенд);
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуСводкиHTML(НомерКарточки, МедианаМс, НаЕдиницу, МинМаксСтрока)
	Попытка
		МостHTML = Элементы.ШапкаHTML.Документ.defaultView;
		Если МостHTML <> Неопределено Тогда
			МостHTML.AddSummaryRow(НомерКарточки, ЭтотОбъект["Сц" + НомерКарточки + "Имя"],
				?(ПустаяСтрока(Стенд), "-", Стенд),
				Формат(МедианаМс, "ЧГ="), Формат(НаЕдиницу, "ЧДЦ=2; ЧГ="),
				Формат(Повторов, "ЧГ="), МинМаксСтрока,
				Формат(ТекущаяДата(), "ДЛФ_DT")); // BSLLS:DeprecatedCurrentDate-off (ТекущаяДатаСеанса недоступна в тонком клиенте - e321966b)
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СброситьСводкуHTML()
	Попытка
		МостHTML = Элементы.ШапкаHTML.Документ.defaultView;
		Если МостHTML <> Неопределено Тогда
			МостHTML.ResetSummary();
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры
