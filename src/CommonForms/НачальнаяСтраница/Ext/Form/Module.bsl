#Область ДиагностикаДвижкаHTML

// Фоновый сбор паспорта при старте: пользователь ничего не ждет. Быстрая фаза
// (без COM) уходит в фоновое задание сразу, полная - следом в том же задании.
&НаКлиенте
Процедура НачатьСборПаспортаФоном()

	Попытка
		ОрчПаспортКлиента = СобратьПаспортКлиента(Ложь);
		ПерфПаспорт.ЗапуститьСборФон(ОрчПаспортКлиента);
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
	// WMI клиента добирается отдельным шагом, уже после отрисовки формы.
	ПодключитьОбработчикОжидания("ДобратьКлиентаWMI", 2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ДобратьКлиентаWMI()

	ОтключитьОбработчикОжидания("ДобратьКлиентаWMI");
	Попытка
		Полная = СобратьПаспортКлиента(Истина);
		Если НЕ ПустаяСтрока(Полная) Тогда
			ОрчПаспортКлиента = Полная;
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СостояниеОпроса = 0;
	ПодключитьОбработчикОжидания("ОпросМоста", 2, Ложь); // 2 с в покое; сам переключит на 0,25 при прогоне
	НачатьСборПаспортаФоном();
	// Метка версии ставится до раннего выхода: иначе при обычном запуске
	// она оставалась пустой и первая же активация окна перестраивала страницу.
	ПоследняяВерсияНастроек = ВерсияНастроекСервер();
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПриАктивизации()

	ПроверитьНастройкиИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиИнтерфейса()
	ТекущаяВерсия = ВерсияНастроекСервер();
	Если ТекущаяВерсия <> ПоследняяВерсияНастроек Тогда
		ПоследняяВерсияНастроек = ТекущаяВерсия;
		ОбновитьСтраницуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВерсияНастроекСервер()
	Возврат ПерфUI.ВерсияНастроек();
КонецФункции

&НаСервере
Процедура ОбновитьСтраницуНаСервере()
	СвежиеНастройки = ПерфUI.ПрочитатьНастройки();
	ШапкаHTML = ПерфКокпит.Страница(Стенд, Повторов,
		ПерфСценарии.СписокСценариев(),
		ПерфСценарии.ВерсияПлатформы(), Метаданные.Версия, СвежиеНастройки);
	СкрытьЭлементыКокпита();
КонецПроцедуры

// Читает настройки оформления в момент нажатия пункта меню: снимок уходит
// в параметры открываемой формы, поэтому страница не читает константы повторно.
&НаСервере
Функция НастройкиДляПерехода()
	Возврат ПерфUI.ПрочитатьНастройки();
КонецФункции

// Переход по пункту меню начинается с чистого листа: очередь команд моста
// обнуляется, метка настроек сбрасывается, снимок HTML в форме стирается.
// Иначе новая страница может унаследовать команды и состояние прошлой.
&НаКлиенте
Процедура ОчиститьПередПереходом()

	Попытка
		Мост = Элементы.ШапкаHTML.Документ.defaultView;
		Если Мост <> Неопределено Тогда
			Мост.PF1C.clear();
		КонецЕсли;
	Исключение
		// Поле еще не создано - чистить нечего.
		СведенияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	ПоследняяВерсияНастроек = "";

КонецПроцедуры

// Закрытие отложено на такт: новая страница уже создана и показана,
// поэтому приложение не остается без окна и переход выглядит одним действием.
&НаКлиенте
Процедура ЗакрытьПослеПерехода()

	ОтключитьОбработчикОжидания("ЗакрытьПослеПерехода");
	Закрыть();

КонецПроцедуры
