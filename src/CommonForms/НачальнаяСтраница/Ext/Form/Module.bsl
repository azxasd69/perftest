&НаСервере
Функция СобратьШапкуHTML()
	СтрокаСоединения = ВРег(СокрЛП(СтрокаСоединенияИнформационнойБазы()));
	РежимИБСтрока = ?(СтрНайти(СтрокаСоединения, "FILE=") > 0, "файловый", "серверный");
	СтендСтрока = СокрЛП(Стенд);
	ВерсияПлатформыСтрока = ПерфСценарии.ВерсияПлатформы();
	ИмяСеанса = СокрЛП(ИмяПользователя());
	ДатаСтрока = Формат(ТекущаяДатаСеанса(), "ДЛФ_D");
	Попытка
		Шапка = ШапкаЧерезDOM(ВерсияПлатформыСтрока, ИмяСеанса, ДатаСтрока, РежимИБСтрока, СтендСтрока);
		Если ПустаяСтрока(Шапка) Тогда
			ВызватьИсключение "Шапка не собрана";
		КонецЕсли;
	Исключение
		Шапка = ШапкаЧерезМакросы(ВерсияПлатформыСтрока, ИмяСеанса, ДатаСтрока, РежимИБСтрока, СтендСтрока);
	КонецПопытки;
	Возврат Шапка;
КонецФункции

&НаСервере
Функция ШапкаЧерезDOM(ВерсияПлатформыСтрока, ИмяСеанса, ДатаСтрока, РежимИБСтрока, СтендСтрока)
	Чтение = Новый ЧтениеHTML;
	Чтение.УстановитьСтроку(ШаблонШапкиHTML());
	Построитель = Новый ПостроительDOM;
	ДокументHTML = Построитель.Прочитать(Чтение);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipPlatform"), ВерсияПлатформыСтрока);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipConfig"), Метаданные.Версия);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipMode"), РежимИБСтрока);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipStandValue"), ?(ПустаяСтрока(СтендСтрока), "-", СтендСтрока));
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipUser"), ИмяСеанса);
	УстановитьТекстЭлемента(ДокументHTML, НайтиВложенныйЭлемент(ДокументHTML, ДокументHTML, "chipDate"), ДатаСтрока);
	Возврат ТекстДокументаHTML(ДокументHTML);
КонецФункции

&НаСервере
Функция ШапкаЧерезМакросы(ВерсияПлатформыСтрока, ИмяСеанса, ДатаСтрока, РежимИБСтрока, СтендСтрока)
	Текст = ШаблонШапкиHTML();
	Текст = СтрЗаменить(Текст, "{{PlatformVersion}}", ВерсияПлатформыСтрока);
	Текст = СтрЗаменить(Текст, "{{ConfigVersion}}", Метаданные.Версия);
	Текст = СтрЗаменить(Текст, "{{IbMode}}", РежимИБСтрока);
	Текст = СтрЗаменить(Текст, "{{StandValue}}", ?(ПустаяСтрока(СтендСтрока), "-", СтендСтрока));
	Текст = СтрЗаменить(Текст, "{{UserName}}", ИмяСеанса);
	Текст = СтрЗаменить(Текст, "{{CurrentDate}}", ДатаСтрока);
	Возврат Текст;
КонецФункции

&НаСервере
Функция НайтиВложенныйЭлемент(ДокументHTML, ТекущийЭлемент, ИщемИдентификатор)
	ОбходДерева = ДокументHTML.СоздатьОбходДерева(ТекущийЭлемент);
	ТекущийУзел = ОбходДерева.ТекущийУзел;
	Пока ТекущийУзел <> Неопределено Цикл
		ТекущийУзел = ОбходДерева.СледующийУзел();
		Если ТекущийУзел = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если ТекущийУзел.ТипУзла = ТипУзлаDOM.Элемент И ТекущийУзел.Идентификатор = ИщемИдентификатор Тогда
			Возврат ТекущийУзел;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура УстановитьТекстЭлемента(ДокументHTML, Элемент, Текст)
	Если Элемент = Неопределено Тогда
		ВызватьИсключение "Элемент не найден";
	КонецЕсли;
	Пока Элемент.ДочерниеУзлы.Количество() > 0 Цикл
		Элемент.УдалитьДочерний(Элемент.ДочерниеУзлы[0]);
	КонецЦикла;
	Элемент.ДобавитьДочерний(ДокументHTML.СоздатьТекстовыйУзел(Текст));
КонецПроцедуры

&НаСервере
Функция ТекстДокументаHTML(ДокументHTML)
	ЗаписьHTML = Новый ЗаписьHTML;
	ЗаписьHTML.УстановитьСтроку();
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументHTML, ЗаписьHTML);
	Возврат ЗаписьHTML.Закрыть();
КонецФункции

#КонецОбласти

#Область ЗапускКарточек

&НаКлиенте
Процедура ЗапуститьКарточку(НомерКарточки)
	Имя = ЭтаФорма["Сц" + НомерКарточки + "Имя"];
	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ОрчПаспортКлиента) Тогда
		ОрчПаспортКлиента = СобратьПаспортКлиента(); // один раз, вне замера
	КонецЕсли;
	ОрчКарточка = НомерКарточки;
	ОрчПрогон = 0;
	ОрчПорция = 0;
	ОрчЕдиница = "";
	ОрчВремена = "";
	ЭтаФорма["Сц" + НомерКарточки + "Результат"] = "";
	ЭтаФорма["Сц" + НомерКарточки + "Статус"] = "Запуск фонового задания...";
	УстановитьДоступностьКнопок(Ложь);
	ПоказатьПрогрессHTML(НомерКарточки, 0, "0%");
	СтартПрогона();
КонецПроцедуры

&НаКлиенте
Процедура СтартПрогона()
	ОтключитьОбработчикОжидания("ОпросПрогрессаФон");
	ОрчРезультатВремяМс = 0;
	ОрчРезультатПорция = 0;
	ОрчРезультатЕдиница = "";
	ОрчУИДЗадания = ПерфСценарии.ЗапуститьСценарийФон(ЭтаФорма["Сц" + ОрчКарточка + "Имя"], 0, 10);
	ПоказатьСтендHTML();
	ПоказатьСтатусHTML("Выполняется: карточка " + ОрчКарточка + " (" + ЭтаФорма["Сц" + ОрчКарточка + "Имя"] + ")");
	ПодключитьОбработчикОжидания("ОпросПрогрессаФон", 0.3, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОпросПрогрессаФон()
	Если ПустаяСтрока(ОрчУИДЗадания) Тогда
		Возврат;
	КонецЕсли;
	Статус = ПерфСценарии.СостояниеСценарийФон(ОрчУИДЗадания);
	Для Каждого Текст Из Статус.Сообщения Цикл
		ОбработатьСообщение(Текст);
	КонецЦикла;
	Если Статус.Состояние = "Завершено" Тогда
		ЗавершитьПрогон(Статус);
	ИначеЕсли Статус.Состояние = "Аварийно" Тогда
		ОстановитьОчередьОшибкой(Статус.Ошибка);
	Иначе
		// интервал < 1 секунды допустим только однократно - обработчик переподключает сам себя
		ПодключитьОбработчикОжидания("ОпросПрогрессаФон", 0.3, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСообщение(Текст)
	Если СтрНайти(Текст, "РЕЗУЛЬТАТ:") = 1 Тогда
		ЧастиР = СтрРазделить(СтрЗаменить(Текст, "РЕЗУЛЬТАТ:", ""), ";", Ложь);
		Если ЧастиР.Количество() = 3 Тогда
			ОрчРезультатВремяМс = Число(ЧастиР[0]);
			ОрчРезультатПорция = Число(ЧастиР[1]);
			ОрчРезультатЕдиница = ЧастиР[2];
		КонецЕсли;
	ИначеЕсли СтрНайти(Текст, "Чанк ") = 1 Тогда
		ЭтаФорма["Сц" + ОрчКарточка + "Статус"] = "Прогон " + (ОрчПрогон + 1) + " из " + Повторов + ": " + Текст;
		Процент = ПроцентИзСообщения(Текст);
		Если Процент >= 0 Тогда
			ПоказатьПрогрессHTML(ОрчКарточка, Процент, Формат(Процент, "ЧГ=") + "%");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроцентИзСообщения(Текст)
	Позиция = СтрНайти(Текст, "(");
	Если Позиция = 0 Тогда
		Возврат -1;
	КонецЕсли;
	Фрагмент = СокрЛП(СтрЗаменить(Сред(Текст, Позиция + 1), "%)", ""));
	Если ПустаяСтрока(Фрагмент) Тогда
		Возврат -1;
	КонецЕсли;
	Попытка
		Возврат Число(Фрагмент);
	Исключение
		Возврат -1;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ЗавершитьПрогон(Статус)
	Если Статус.Состояние <> "Завершено" Тогда
		ОстановитьОчередьОшибкой("Фоновое задание не вернуло результат");
		Возврат;
	КонецЕсли;
	РезультатПрогона = Статус;
	НомерКарточки = ОрчКарточка;
	Если ОрчРезультатВремяМс = 0 Тогда
		ОстановитьОчередьОшибкой("Фоновое задание не вернуло результат");
		Возврат;
	КонецЕсли;
	ОрчПорция = ОрчРезультатПорция;
	ОрчЕдиница = ОрчРезультатЕдиница;
	ОрчПрогон = ОрчПрогон + 1;
	ЭтаФорма["Сц" + НомерКарточки + "Статус"] = "Прогон " + ОрчПрогон + " из " + Повторов + ": "

		+ Формат(ОрчРезультатВремяМс, "ЧГ=0") + " мс";
	ПоказатьСтатусHTML("Выполняется: карточка " + НомерКарточки + " - прогон " + ОрчПрогон + " из " + Повторов);
	ОрчВремена = ОрчВремена + ?(ПустаяСтрока(ОрчВремена), "", ";") + Формат(ОрчРезультатВремяМс, "ЧГ=0");
	ДобавитьСтрокуРезультата(НомерКарточки, ОрчПрогон);
	Если ОрчПрогон < Повторов Тогда
		СтартПрогона();
		Возврат;
	КонецЕсли;
	ЗавершитьКарточку(НомерКарточки);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуРезультата(НомерКарточки, НомерПрогона)
	СтрокаПрогона = Результаты.Добавить();
	СтрокаПрогона.Сценарий = ЭтаФорма["Сц" + НомерКарточки + "Имя"];
	СтрокаПрогона.Представление = "";
	СтрокаПрогона.Прогон = НомерПрогона;
	СтрокаПрогона.ВремяМс = ОрчРезультатВремяМс;
	СтрокаПрогона.Порция = ОрчРезультатПорция;
	СтрокаПрогона.Единица = ОрчРезультатЕдиница;
	Если ОрчРезультатПорция > 0 Тогда
		СтрокаПрогона.НаЕдиницуМс = ОрчРезультатВремяМс / ОрчРезультатПорция * 1000;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьКарточку(НомерКарточки)
	Итог = ПерфСценарии.ЗаписатьРезультат(Стенд, ЭтаФорма["Сц" + НомерКарточки + "Имя"], "",
		ОрчПорция, ОрчЕдиница, ОрчВремена, Повторов, ОрчПаспортКлиента);
	МедианаМс = Итог.МедианаМс;
	НаЕдиницу = Итог.НаЕдиницуМс;
	МинМаксСтрока = Формат(Итог.МинМс, "ЧГ=") + "..." + Формат(Итог.МаксМс, "ЧГ=");
	ЭтаФорма["Сц" + НомерКарточки + "Статус"] = "Готово";
	ЭтаФорма["Сц" + НомерКарточки + "Результат"] = "ОК: медиана " + Формат(МедианаМс, "ЧГ=")
		+ " мс (" + Формат(НаЕдиницу, "ЧДЦ=2; ЧГ=") + " мс/тыс. " + ОрчЕдиница + ")";
	СтрокаСводки = Сводка.Добавить();
	СтрокаСводки.Сценарий = ЭтаФорма["Сц" + НомерКарточки + "Имя"];
	СтрокаСводки.Представление = "";
	СтрокаСводки.МедианаМс = МедианаМс;
	СтрокаСводки.НаЕдиницуМс = НаЕдиницу;
	СтрокаСводки.Единица = ОрчЕдиница;
	ПоказатьПрогрессHTML(НомерКарточки, 100, "100%");
	ДобавитьСтрокуСводкиHTML(НомерКарточки, МедианаМс, НаЕдиницу, МинМаксСтрока);
	ПоказатьСтатусHTML("Готово: карточка " + НомерКарточки);
	СледующаяИзОчереди();
КонецПроцедуры

&НаКлиенте
Процедура СледующаяИзОчереди()
	ОрчУИДЗадания = "";
	Части = СтрРазделить(ОрчОчередь, ",", Ложь);
	Если Части.Количество() = 0 Тогда
		УстановитьДоступностьКнопок(Истина);
		Возврат;
	КонецЕсли;
	Следующая = Число(Части[0]);
	Остальные = Новый Массив;
	Для Индекс = 1 По Части.Количество() - 1 Цикл
		Остальные.Добавить(Части[Индекс]);
	КонецЦикла;
	ОрчОчередь = СтрСоединить(Остальные, ",");
	ЗапуститьКарточку(Следующая);
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьОчередьОшибкой(ТекстОшибки)
	ОрчОчередь = "";
	ОрчУИДЗадания = "";
	ЭтаФорма["Сц" + ОрчКарточка + "Статус"] = "Ошибка";
	ЭтаФорма["Сц" + ОрчКарточка + "Результат"] = "Ошибка: " + ТекстОшибки;
	ПоказатьСтатусHTML("Остановлено на карточке " + ОрчКарточка + ": " + ТекстОшибки);
	УстановитьДоступностьКнопок(Истина);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКнопок(Доступность)
	Для Н = 1 По 11 Цикл
		Элементы["КнопкаЗапустить" + Н].Доступность = Доступность;
	КонецЦикла;
	Элементы.КнопкаЗапуститьВсе.Доступность = Доступность;
	Элементы.КнопкаОстановить.Доступность = НЕ Доступность;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОстановитьТест(Команда)
	ОтключитьОбработчикОжидания("ОпросПрогрессаФон");
	Если НЕ ПустаяСтрока(ОрчУИДЗадания) Тогда
		ПерфСценарии.ОтменитьСценарийФон(ОрчУИДЗадания);
	КонецЕсли;
	ОрчОчередь = "";
	ОрчУИДЗадания = "";
	ЭтаФорма["Сц" + ОрчКарточка + "Статус"] = "Отменено";
	ЭтаФорма["Сц" + ОрчКарточка + "Результат"] = "Отмена: тест остановлен пользователем";
	ПоказатьСтатусHTML("Отменено: карточка " + ОрчКарточка);
	УстановитьДоступностьКнопок(Истина);
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗапуститьВсе(Команда)
	Результаты.Очистить();
	Сводка.Очистить();
	СброситьСводкуHTML();
	Очередь = Новый Массив;
	Для Н = 1 По 11 Цикл
		Если ПустаяСтрока(ЭтаФорма["Сц" + Н + "Имя"]) Тогда
			Продолжить;
		КонецЕсли;
		Очередь.Добавить(Строка(Н));
	КонецЦикла;
	ОрчОчередь = СтрСоединить(Очередь, ",");
	СледующаяИзОчереди();
КонецПроцедуры

&НаКлиенте
Функция WMIПервыйКлиент(Сервис, ЗапросWMI)
	Попытка
		Выборка = Сервис.ExecQuery(ЗапросWMI);
		Для Каждого Элемент Из Выборка Цикл
			Возврат Элемент;
		КонецЦикла;
	Исключение
		Возврат Неопределено; // WMI-запрос не выполнен
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция АптаймКлиента(WMIDate)
	Попытка
		С = Лев(СокрЛП(WMIDate), 14);
		Если СтрДлина(С) < 14 Тогда
			Возврат "";
		КонецЕсли;
		ДатаЗагрузки = Дата(Число(Лев(С, 4)), Число(Сред(С, 5, 2)), Число(Сред(С, 7, 2)),
			Число(Сред(С, 9, 2)), Число(Сред(С, 11, 2)), Число(Сред(С, 13, 2)));
		ВсегоСек = ТекущаяДата() - ДатаЗагрузки; // BSLLS:DeprecatedCurrentDate-off (ТекущаяДатаСеанса недоступна в тонком клиенте - живой прогон e321966b)
		Возврат Цел(ВсегоСек / 86400) + " дн "
			+ Цел((ВсегоСек % 86400) / 3600) + " ч "
			+ Цел((ВсегоСек % 3600) / 60) + " мин";
	Исключение
		Возврат ""; // WMI-дату не разобрали
	КонецПопытки;
КонецФункции

// Паспорт клиента для регистра ПерфСтенды: платформенные факты + WMI (COM - толстый клиент).
&НаКлиенте
Функция СобратьПаспортКлиента()
	Части = Новый Массив;
	Попытка
		СИ = Новый СистемнаяИнформация; // это тип с конструктором по умолчанию, а не глобальное свойство
		Части.Добавить("ОС=" + СокрЛП(СИ.ВерсияОС));
		Части.Добавить("ЦПУ=" + СокрЛП(СИ.Процессор));
		Части.Добавить("ПамятьМб=" + Формат(Окр(СИ.ОперативнаяПамять / 1048576, 0), "ЧГ=0")); // в байтах
		Части.Добавить("Платформа=" + Строка(СИ.ТипПлатформы));
	Исключение
		Части.Добавить("СИНедоступен=1"); // характеристики платформы не собраны
	КонецПопытки;
	Попытка
		Локатор = Новый COMОбъект("WbemScripting.SWbemLocator"); // BSLLS:UsingObjectNotAvailableUnix-off (конфигурация только Windows)
		Сервис = Локатор.ConnectServer(".", "root\cimv2");
		ОС = WMIПервыйКлиент(Сервис, "SELECT Caption, Version, BuildNumber, FreePhysicalMemory, LastBootUpTime FROM Win32_OperatingSystem");
		ЦПУ = WMIПервыйКлиент(Сервис, "SELECT Name, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed, LoadPercentage FROM Win32_Processor");
		ПК = WMIПервыйКлиент(Сервис, "SELECT Name, Manufacturer, Model, TotalPhysicalMemory FROM Win32_ComputerSystem");
		Если ОС <> Неопределено Тогда
			Части.Добавить("ОС=" + СокрЛП(ОС.Caption) + " v" + СокрЛП(ОС.Version) + " build " + СокрЛП(ОС.BuildNumber));
			Части.Добавить("СвободнаМб=" + Формат(Окр(ОС.FreePhysicalMemory / 1024, 0), "ЧГ=0"));
			Части.Добавить("Аптайм=" + АптаймКлиента(ОС.LastBootUpTime));
		КонецЕсли;
		Если ЦПУ <> Неопределено Тогда
			Части.Добавить("ЦПУ=" + СокрЛП(ЦПУ.Name));
			Части.Добавить("ЦПУПотоки=" + ЦПУ.NumberOfCores + " ядер / " + ЦПУ.NumberOfLogicalProcessors + " потоков");
			Части.Добавить("ЦПУМГц=" + Формат(ЦПУ.MaxClockSpeed, "ЧГ=0"));
			Части.Добавить("ЦПУЗагрузкаПроц=" + Формат(ЦПУ.LoadPercentage, "ЧГ=0"));
		КонецЕсли;
		Если ПК <> Неопределено Тогда
			ПКМодель = СокрЛП(ПК.Manufacturer) + ?(ПустаяСтрока(СокрЛП(ПК.Model)), "", " " + СокрЛП(ПК.Model));
			Части.Добавить("ПК=" + СокрЛП(ПК.Name) + ?(ПустаяСтрока(ПКМодель), "", " (" + ПКМодель + ")"));
			Части.Добавить("ПамятьМб=" + Формат(Окр(ПК.TotalPhysicalMemory / 1048576, 0), "ЧГ=0"));
		КонецЕсли;
	Исключение
		Части.Добавить("WМИКлиентНедоступен=1"); // COM на клиенте не работает (например, тонкий клиент)
	КонецПопытки;
	Возврат СтрСоединить(Части, ";");
КонецФункции

&НаКлиенте
Функция ОбъектОкнаHTML()
	МостHTML = Элементы.ШапкаHTML.Документ.parentWindow;
	Если МостHTML = Неопределено Тогда
		МостHTML = Элементы.ШапкаHTML.Документ.defaultView;
	КонецЕсли;
	Возврат МостHTML;
КонецФункции

&НаКлиенте
Процедура ПоказатьПрогрессHTML(НомерКарточки, Процент, Текст)
	Попытка
		МостHTML = ОбъектОкнаHTML();
		Если МостHTML <> Неопределено Тогда
			МостHTML.SetProgress(НомерКарточки, Процент, Текст);
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтатусHTML(Текст)
	Попытка
		МостHTML = ОбъектОкнаHTML();
		Если МостHTML <> Неопределено Тогда
			МостHTML.SetGlobalStatus(Текст);
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтендHTML()
	Попытка
		МостHTML = ОбъектОкнаHTML();
		Если МостHTML <> Неопределено Тогда
			МостHTML.SetStandChip(Стенд);
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуСводкиHTML(НомерКарточки, МедианаМс, НаЕдиницу, МинМаксСтрока)
	Попытка
		МостHTML = ОбъектОкнаHTML();
		Если МостHTML <> Неопределено Тогда
			МостHTML.AddSummaryRow(НомерКарточки, ЭтаФорма["Сц" + НомерКарточки + "Имя"],
				?(ПустаяСтрока(Стенд), "-", Стенд),
				Формат(МедианаМс, "ЧГ="), Формат(НаЕдиницу, "ЧДЦ=2; ЧГ="),
				Формат(Повторов, "ЧГ="), МинМаксСтрока,
				Формат(ТекущаяДата(), "ДЛФ_DT")); // BSLLS:DeprecatedCurrentDate-off (ТекущаяДатаСеанса недоступна в тонком клиенте - e321966b)
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

