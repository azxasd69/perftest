// Начальная страница «ПерфТест»: карточная панель тестов (ТЗ v1.1, раздел 8).
//
// Каждая карточка - отдельный тест: кнопка запуска, текстовый ход выполнения
// («Прогон r из N: X мс»), результат («ОК: медиана ... мс (Y мс/тыс. ед.)»).
// Логика прогонов - только в ПерфСценарии (сервер); форма оркестрирует.
// HTML-шапка собирается через DOM (статья infostart.ru/1c/articles/2675965).

&НаКлиенте
Перем ДиагностикаСкрыла;
&НаКлиенте
Перем СостояниеОпроса;

// ПРОБА МОСТА: клик по элементу с id exportedInterfaceEventElement должен поднять ПриНажатии.
Функция ДобавитьПробуМоста(Текст)
	Скрипт = "<span id='exportedInterfaceEventElement' style='display:none'>e</span>"
		+ "<scr" + "ipt>setTimeout(function(){var e=document.getElementById('exportedInterfaceEventElement');"
		+ "if(e){e.click();}},1500);</scr" + "ipt>";
	Возврат СтрЗаменить(Текст, "</body>", Скрипт + "</body>");
КонецФункции

&НаСервере
Процедура ЗаписатьКомандуВЛог(Команда)
	ЗаписатьСтрокуВЛогКокпита("команда: " + Команда);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультатКарточкиHTML(Номер, Итог, Текст, Медиана, МинМакс)
	Попытка
		Мост = ОбъектОкнаHTML();
		Если Мост = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Мост.PF1C.done(Номер, Итог, Текст, Медиана);
		Мост.PF1C.logRow(Номер, ЭтаФорма["Сц" + Номер + "Имя"], Стенд,
			Формат(Медиана, "ЧГ="), "", Повторов, МинМакс,
			Формат(ТекущаяДата(), "ДЛФ=DT")); // BSLLS:DeprecatedCurrentDate-off (в клиенте нет ТекущаяДатаСеанса)
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьНачалоКарточкиHTML(Номер)
	Попытка
		Мост = ОбъектОкнаHTML();
		Если Мост = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Мост.PF1C.state(Номер, "run");
		Мост.PF1C.lock(Истина);
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОпросМоста()
	СостояниеОпроса = СостояниеОпроса + 1;
	Попытка
		Мост = ОбъектОкнаHTML();
		Если Мост = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ОчередьКоманд = Мост.PF1C.take();
	Исключение
		Возврат;
	КонецПопытки;
	Если ПустаяСтрока(ОчередьКоманд) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ТекстКоманды Из СтрРазделить(ОчередьКоманд, "|") Цикл
		ЗаписатьКомандуВЛог(ТекстКоманды);
		ВыполнитьКомандуКокпита(ТекстКоманды);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандуКокпита(Команда)
	Части = СтрРазделить(СокрЛП(Команда), ":", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Имя = НРег(СокрЛП(Части[0]));
	Аргумент = ?(Части.Количество() > 1, Части[1], "");
	Если Имя = "run" Тогда
		ЗапуститьКарточку(Число(Аргумент));
	ИначеЕсли Имя = "all" Тогда
		КомандаЗапуститьВсе(Неопределено);
	ИначеЕсли Имя = "stop" Тогда
		КомандаОстановитьТест(Неопределено);
	ИначеЕсли Имя = "stand" Тогда
		Стенд = СокрЛП(Аргумент);
		ПоказатьСтендHTML();
		ПоказатьСтатусHTML("Стенд: <b>" + Стенд + "</b>");
	ИначеЕсли Имя = "rep" Тогда
		Попытка
			Новое = Число(Аргумент);
			Если Новое > 0 Тогда
				Повторов = Новое;
			КонецЕсли;
		Исключение
			ПоказатьСтатусHTML("Повторов: нужно число");
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	Текст = "";
	Попытка
		Для Каждого К Из ДанныеСобытия Цикл
			Текст = Текст + К.Ключ + "=[" + Строка(К.Значение) + "];";
		КонецЦикла;
	Исключение
		Текст = "нет структуры: " + Строка(ДанныеСобытия);
	КонецПопытки;
	Попытка
		Запись = Новый ЗаписьТекста(КаталогВременныхФайлов() + "pf-bridge.log", "UTF-8"); // BSLLS:UsingHardcodePath-off
		Запись.ЗаписатьСтроку(Текст);
		Запись.Закрыть();
	Исключение
		Текст = Текст + "|ошибка записи";
	КонецПопытки;
КонецПроцедуры

// Прячет все элементы формы: кокпит живет в одном поле HTML.
&НаСервере
Процедура СкрытьЭлементыКокпита()
	// Элементов в форме нет: единственный элемент - поле HTML.
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСтрокуВЛогКокпита(Текст)
	Попытка
		Запись = Новый ЗаписьТекста(КаталогВременныхФайлов() + "pf-cockpit.log", "UTF-8", , Истина); // BSLLS:UsingHardcodePath-off
		Запись.ЗаписатьСтроку(Текст);
		Запись.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НомерКарточки = 0;
	Для Каждого Сценарий Из ПерфСценарии.СписокСценариев() Цикл
		НомерКарточки = НомерКарточки + 1;
		ЭтаФорма["Сц" + НомерКарточки + "Имя"] = Сценарий.Имя;
		ЭтаФорма["Сц" + НомерКарточки + "Описание"] = ТекстСути(НомерКарточки);
		ЭтаФорма["Сц" + НомерКарточки + "Реализация"] = ТекстРеализации(НомерКарточки);
		ЭтаФорма["Сц" + НомерКарточки + "Статус"] = "-";
		ЭтаФорма["Сц" + НомерКарточки + "Результат"] = "";
	КонецЦикла;

	ОрчКарточка = 0;
	ОрчПрогон = 0;
	ОрчПорция = 0;
	ОрчЕдиница = "";
	ОрчУИДЗадания = "";
	ОрчВремена = "";
	ОрчОчередь = "";
	ОрчРезультатВремяМс = 0;
	ОрчРезультатПорция = 0;
	ОрчРезультатЕдиница = "";
	ОрчПаспортКлиента = "";
	Повторов = 3;
	Стенд = "";
	// Кокпит по шаблону index-v3: страница целиком в HTML, элементы 1С скрыты.
	СценарииКокпита = ПерфСценарии.СписокСценариев();
	ШапкаHTML = ПерфКокпит.Страница(Стенд, Повторов, СценарииКокпита,
		ПерфСценарии.ВерсияПлатформы(), "1.18.1");
	СкрытьЭлементыКокпита();

КонецПроцедуры

#Область СлужебныеТекстыКарточек

&НаСервере
Функция ТекстСути(НомерКарточки)
	Если НомерКарточки = 1 Тогда
		Возврат "Суть: скорость исполнения встроенного языка на чистой арифметике - базовый потолок CPU без обращений к данным ИБ.";
	ИначеЕсли НомерКарточки = 2 Тогда
		Возврат "Суть: конвейер строковых операций - буферизация конкатенации через массив и поиск подстроки в строке 3,4 МБ.";
	ИначеЕсли НомерКарточки = 3 Тогда
		Возврат "Суть: менеджер памяти и хеш-таблицы встроенных коллекций - аллокации, вставки, полный обход.";
	ИначеЕсли НомерКарточки = 4 Тогда
		Возврат "Суть: скорость точечной записи в файловую ИБ (dbeng8.dll в процессе клиента): транзакция на каждый объект и сброс страниц на диск - здесь заметны заменённые библиотеки.";
	ИначеЕсли НомерКарточки = 5 Тогда
		Возврат "Суть: те же 1 000 записей в одной большой транзакции; показывает цену пообъектных транзакций (контраст с карточкой 4).";
	ИначеЕсли НомерКарточки = 6 Тогда
		Возврат "Суть: полный конвейер документа: объект + табличная часть + обработка проведения + движения регистра накопления + индексы.";
	ИначеЕсли НомерКарточки = 7 Тогда
		Возврат "Суть: планировщик и исполнитель запросов: построение плана, чтение индексов, агрегация СУММА/КОЛИЧЕСТВО.";
	ИначеЕсли НомерКарточки = 8 Тогда
		Возврат "Суть: скорость сериализации в JSON и обратного разбора - обмены, HTTP-сервисы, интеграции.";
	ИначеЕсли НомерКарточки = 9 Тогда
		Возврат "Суть: внутренняя сериализация платформы (ЗначениеВСтрокуВнутр) - хранилища настроек, передачи клиент-сервер.";
	ИначеЕсли НомерКарточки = 10 Тогда
		Возврат "Суть: аллокатор платформы на больших объёмах - рост рабочего набора на сотни МБ, стоимость создания и освобождения.";
	ИначеЕсли НомерКарточки = 11 Тогда
		Возврат "Суть: файловый ввод-вывод средствами платформы (ЗаписьТекста/ЧтениеТекста, UTF-8) сквозь кэш записи ОС.";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервере
Функция ТекстРеализации(НомерКарточки)
	Если НомерКарточки = 1 Тогда
		Возврат "Реализация: цикл 3 000 000 итераций: умножение, деление, сравнение, присваивание; аккумулятор фиктивный (защита от выбрасывания вычислений).";
	ИначеЕсли НомерКарточки = 2 Тогда
		Возврат "Реализация: буфер-массив на 200 000 сегментов «0123456789abcdef+N», СтрСоединить в одну строку, затем 50 000 вызовов СтрНайти со сдвигом позиции.";
	ИначеЕсли НомерКарточки = 3 Тогда
		Возврат "Реализация: 1 500 000 добавлений параллельно в Массив и Соответствие, затем обход Соответствия с накоплением суммы; коллекции освобождаются.";
	ИначеЕсли НомерКарточки = 4 Тогда
		Возврат "Реализация: 1 000 элементов справочника «Номенклатура (тест)», каждый - СоздатьЭлемент, Записать(); очистка тестовых элементов перед прогоном (вне замера).";
	ИначеЕсли НомерКарточки = 5 Тогда
		Возврат "Реализация: НачатьТранзакцию, 1 000 записей, ЗафиксироватьТранзакцию; при ошибке - ОтменитьТранзакцию.";
	ИначеЕсли НомерКарточки = 6 Тогда
		Возврат "Реализация: 200 документов «Поступление (тест)» по 5 строк, каждый - Записать(Проведение), 1 000 движений в регистре; номенклатура/склад готовятся вне замера.";
	ИначеЕсли НомерКарточки = 7 Тогда
		Возврат "Реализация: 20 пакетов по два запроса: остатки виртуальной таблицы регистра накопления с группировкой и группировка по справочнику; данные создаются при нехватке (вне замера).";
	ИначеЕсли НомерКарточки = 8 Тогда
		Возврат "Реализация: 20 000 структур «имя-цена-признак»: ЗаписатьJSON в строку, затем ПрочитатьJSON обратно; построение массива вне замера.";
	ИначеЕсли НомерКарточки = 9 Тогда
		Возврат "Реализация: массив 200 000 чисел; три полных цикла ЗначениеВСтрокуВнутр -> ЗначениеИзСтрокиВнутр.";
	ИначеЕсли НомерКарточки = 10 Тогда
		Возврат "Реализация: 3 000 000 коротких строк «элемент-N» в массив, замер построения, затем освобождение.";
	ИначеЕсли НомерКарточки = 11 Тогда
		Возврат "Реализация: запись 200 000 строк по ~120 символов (~24 МБ) во временный файл, построчное чтение с подсчётом длины, удаление файла.";
	КонецЕсли;
	Возврат "";
КонецФункции

