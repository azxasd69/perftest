&НаКлиенте
Перем ПоследняяВерсияНастроек;

// Страница журнала обмена: собирается на сервере общим модулем ПерфОбменHTML.
// Кнопки страницы - обычные команды формы, мост HTML здесь не нужен: журнал
// только читает состояние, действия идут из палитры кокпита.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Настройки каналов создаются при первом обращении (ТЗ § 6.7): без них
	// таблица каналов пустая, а лестница отправки знает только HTTPS.
	ПерфОбменТранспорт.ОбеспечитьКаналы();
	ОтчетHTML = "";
	Настройки = Неопределено;
	Если Параметры.Свойство("Настройки") Тогда
		Настройки = ПерфUI.ДополнитьНастройки(Параметры.Настройки);
	КонецЕсли;
	Построить(Настройки);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Состояние обмена меняется фоном: страница обновляется сама, но не чаще
	// интервала опроса, иначе HTML-поле перерисовывается постоянно.
	ПоказатьЧипОбмена();
	// Боковое меню и кнопки страницы живут в HTML: клики складываются в очередь
	// моста PF1C, и её надо вычитывать - иначе пункты меню не реагируют.
	ПодключитьОбработчикОжидания("ОпросМенюОтч", 1, Ложь);
	ПоследняяВерсияНастроек = ВерсияНастроекСервер();
КонецПроцедуры

&НаКлиенте
Процедура ОпросМенюОтч()
	Попытка
		Мост = Элементы.ОтчетHTML.Документ.defaultView;
		Если Мост = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Текст = Мост.PF1C.take();
		Если ПустаяСтрока(Текст) Тогда
			Возврат;
		КонецЕсли;
		Для Каждого Команда Из СтрРазделить(Текст, "|") Цикл
			Части = СтрРазделить(СокрЛП(Команда), ":", Ложь);
			Если Части.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			Имя = НРег(СокрЛП(Части[0]));
			Если Имя = "open" Тогда
				ОчиститьПередПереходом();
				ПараметрыПерехода = Новый Структура("Настройки", НастройкиДляПерехода());
				ОткрытьФорму("ОбщаяФорма." + СокрЛП(Части[1]), ПараметрыПерехода);
				// Одно окно в приложении: страница, с которой ушли, закрывается.
				ПодключитьОбработчикОжидания("ЗакрытьПослеПерехода", 0.3, Истина);
			ИначеЕсли Имя = "refresh" Тогда
				ОбновитьЖурнал(Неопределено);
			ИначеЕсли Имя = "nav" Тогда
				СохранитьПанельНаСервере(НРег(СокрЛП(Части[1])));
				ПоследняяВерсияНастроек = ВерсияНастроекСервер();
			ИначеЕсли Имя = "theme" Тогда
				СохранитьТемуНаСервере(НРег(СокрЛП(Части[1])));
				ПоследняяВерсияНастроек = ВерсияНастроекСервер();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизации()

	ПроверитьНастройкиИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиИнтерфейса()
	ТекущаяВерсия = ВерсияНастроекСервер();
	Если ТекущаяВерсия <> ПоследняяВерсияНастроек Тогда
		ПоследняяВерсияНастроек = ТекущаяВерсия;
		Построить();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВерсияНастроекСервер()
	Возврат ПерфUI.ВерсияНастроек();
КонецФункции

&НаСервере
Функция НастройкиДляПерехода()
	Возврат ПерфUI.ПрочитатьНастройки();
КонецФункции

&НаСервере
Процедура СохранитьТемуНаСервере(Знач Тема)
	ПерфUI.СохранитьТемуПриложения(Тема);
КонецПроцедуры

&НаСервере
Процедура СохранитьПанельНаСервере(Знач Значение)
	ПерфUI.СохранитьСостояниеПанели(Значение);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПередПереходом()

	Попытка
		Мост = Элементы.ОтчетHTML.Документ.defaultView;
		Если Мост <> Неопределено Тогда
			Мост.PF1C.clear();
		КонецЕсли;
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	ПоследняяВерсияНастроек = "";

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПослеПерехода()

	ОтключитьОбработчикОжидания("ЗакрытьПослеПерехода");
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЖурнал(Команда)
	Построить();
	ПоказатьЧипОбмена();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСейчас(Команда)
	Результат = ОтправитьНаСервере();
	Построить();
	ПоказатьСтатус(Результат);
КонецПроцедуры

&НаКлиенте
Процедура ПробаКаналов(Команда)
	Результат = ПробаНаСервере();
	Построить();
	ПоказатьСтатус(Результат);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВСпул(Команда)
	Результат = СпулНаСервере();
	Построить();
	ПоказатьСтатус(Результат);
КонецПроцедуры

&НаСервере
Процедура Построить(Знач Настройки = Неопределено)
	ОтчетHTML = ПерфОбменHTML.Страница("ПерфОбменЖурнал", Настройки);
КонецПроцедуры

&НаСервере
Функция ОтправитьНаСервере()
	Итог = ПерфОбмен.ОтправитьОчередь();
	Возврат "Отправлено " + Формат(Итог.Отправлено, "ЧГ=0")
		+ ", ошибок " + Формат(Итог.Ошибок, "ЧГ=0")
		+ ", осталось " + Формат(Итог.Осталось, "ЧГ=0")
		+ ?(Итог.Код = 0, "", ", код " + Формат(Итог.Код, "ЧГ=0"))
		+ ?(ПустаяСтрока(Итог.Канал), "", ", канал " + Итог.Канал);
КонецФункции

&НаСервере
Функция ПробаНаСервере()
	Пробы = ПерфОбменТранспорт.ПроверитьКаналы();
	Доступно = 0;
	Для Каждого Проба Из Пробы Цикл
		Если Проба.Доступен Тогда
			Доступно = Доступно + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат "Проба каналов: доступно " + Формат(Доступно, "ЧГ=0")
		+ " из " + Формат(Пробы.Количество(), "ЧГ=0");
КонецФункции

&НаСервере
Функция СпулНаСервере()
	Итог = ПерфОбмен.ВыгрузитьВСпул();
	Возврат "В спул выгружено " + Формат(Итог.Файлов, "ЧГ=0")
		+ ", осталось в очереди " + Формат(Итог.Осталось, "ЧГ=0");
КонецФункции

&НаКлиенте
Процедура ПоказатьСтатус(Текст)
	Попытка
		Мост = Элементы.ОтчетHTML.Документ.defaultView;
		Если Мост <> Неопределено Тогда
			Мост.SetGlobalStatus(Текст);
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЧипОбмена()
	Попытка
		Состояние = СостояниеОбменаНаСервере();
		Мост = Элементы.ОтчетHTML.Документ.defaultView;
		Если Мост <> Неопределено Тогда
			Мост.SetExchangeChip(Состояние);
		КонецЕсли;
	Исключение
		ИгнорируемаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СостояниеОбменаНаСервере()
	Возврат ПерфОбмен.СостояниеОбмена().Статус;
КонецФункции
