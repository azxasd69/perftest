// Форма отчёта: настройки предзаполняются по текущему сеансу (ТЗ отчётов, раздел 12).
// Заполняет списки выбора из регистров и сразу строит отчёт.
// Настройки предзаполняются по текущему сеансу (ТЗ отчётов, §12).
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьСпискиВыбора();
	Построить();
КонецПроцедуры

// «Сформировать»: перестроение отчёта с текущими настройками формы.
&НаКлиенте
Процедура Сформировать(Команда)
	Построить();
КонецПроцедуры

// «К текущему сеансу»: сбрасывает настройки, чтобы отчёт снова выбрал их сам.
&НаКлиенте
Процедура СброситьКСеансу(Команда)
	БазовыйСтенд = "";
	СтендСравнения = "";
	Построить();
КонецПроцедуры

// Строит HTML на сервере, кладёт его в поле документа поля HTML и
// запоминает фактические параметры (они пишутся и в маркер смоука).
&НаСервере
Процедура Построить()
	// Весь HTML собирает общий модуль ПерфОтчетыHTML: форма только
	// передаёт настройки и показывает результат.
	Результат = ПерфОтчетыHTML.СобратьСравнениеСтендов(БазовыйСтенд, СтендСравнения);
	ОтчетHTML = Результат.HTML;
	БазовыйСтенд = Результат.БазовыйСтенд;
	СтендСравнения = Результат.СтендСравнения;
	ЗаписатьПараметры(Результат);
КонецПроцедуры

// Пишет строку «params:<форма>;...» в perftest_params.log: по ней смоук-прогон
// проверяет, какие стенд и сценарий выбрал отчёт.
&НаСервере
Процедура ЗаписатьПараметры(Результат)
	Путь = КаталогВременныхФайлов() + "perftest_params.log";
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, Символы.ПС, Истина);
	Запись.Записать("params:ПерфСравнениеСтендов;" + Результат.БазовыйСтенд + ";"
		+ Результат.СтендСравнения + ";" + Результат.Сценарий + ";" + Результат.ТекущийСтенд
		+ ";стенды:" + ПерфОтчетыHTML.СписокСтендов() + ";диаг:" + ПерфОтчетыHTML.ДиагностикаСтендов());
	Запись.Закрыть();
КонецПроцедуры

// Списки выбора стендов (и сценария для истории) - из регистров, а не константами.
&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	Элементы.БазовыйСтенд.СписокВыбора.Очистить();
	Для Каждого Значение Из ПерфОтчетыHTML.СписокСтендовМассив() Цикл
		Элементы.БазовыйСтенд.СписокВыбора.Добавить(Значение, Значение);
	КонецЦикла;
	Элементы.СтендСравнения.СписокВыбора.Очистить();
	Для Каждого Значение Из ПерфОтчетыHTML.СписокСтендовМассив() Цикл
		Элементы.СтендСравнения.СписокВыбора.Добавить(Значение, Значение);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ОпросМенюОтч", 1, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОпросМенюОтч()
	Попытка
		Мост = Элементы.ОтчетHTML.Документ.defaultView;
		Если Мост = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Текст = Мост.PF1C.take();
		Если ПустаяСтрока(Текст) Тогда
			Возврат;
		КонецЕсли;
		Части = СтрРазделить(Текст, ":", Ложь);
		Если Части.Количество() > 1 И НРег(СокрЛП(Части[0])) = "open" Тогда
			ОткрытьФорму("ОбщаяФорма." + СокрЛП(Части[1]));
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры
