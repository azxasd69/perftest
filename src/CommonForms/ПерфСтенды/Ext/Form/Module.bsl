&НаКлиенте
Перем ПоследняяВерсияНастроек;

// Признак идущей пробы: повторное нажатие кнопки не запускает вторую.
&НаКлиенте
Перем ПробаИдёт;

// Форма карточки стенда «ПерфТест».
//
// Вся разметка собирается на сервере (ПерфСтендыHTML + ПерфUI.Документ), форма
// только показывает HTML и обрабатывает команды моста:
//   stand:<имя>  - переключить карточку на другой стенд;
//   open:<форма> - перейти на другую страницу (боковая панель, кнопки шапки).
// Переключателя темы на карточке нет: тема определяется приложением.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОтчетHTML = "";

	// Служебный режим: форма открыта с параметром ПробаКлиента - при открытии
	// выполняется проба каналов с этого рабочего места (головная проверка без мыши).
	ПробаКлиента = (Параметры.Свойство("ПробаКлиента") = Истина);
	Настройки = Неопределено;
	Если Параметры.Свойство("Настройки") Тогда
		Настройки = ПерфUI.ДополнитьНастройки(Параметры.Настройки);
	КонецЕсли;
	Построить(Настройки);

КонецПроцедуры

// Перестраивает HTML карточки для текущего значения реквизита Стенд.
&НаСервере
Процедура Построить(Знач Настройки = Неопределено)

	// Пробы каналов обновляются вне замера: свежесть входит в ключ, иначе
	// плитки доступности остались бы снимком прошлой пробы.
	Ключ = ПерфОтчетыHTML.КлючСтраницы("ПерфСтенды", Стенд + "|" + ПерфСтендыHTML.ВерсияПроб());
	Если ПерфОтчетыHTML.КэшПопадание(ОтчетHTML, Ключ) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Страница = ПерфСтендыHTML.СтраницаСтенда(Стенд, Настройки);
	Исключение
		// Карточка - вспомогательный экран: сбой сбора не должен закрывать форму.
		Страница = ПерфСтендыHTML.СтраницаСтенда("", Настройки);
	КонецПопытки;
	ОтчетHTML = Страница + ПерфОтчетыHTML.МеткаКэша(Ключ);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Переменная модуля до первого присваивания равна Неопределено, а проверка
	// «Если ПробаИдёт» на таком значении падает (ошибка 20:19:14).
	ПробаИдёт = Ложь;
	ПодключитьОбработчикОжидания("ОпросМостаСтенда", 1, Ложь);
	Если ПробаКлиента Тогда
		ПодключитьОбработчикОжидания("ПробаИЗакрытие", 0.5, Истина);
	КонецЕсли;

	ПоследняяВерсияНастроек = ВерсияНастроекСервер();
КонецПроцедуры

// Забирает команды из HTML (мост PF1C) и выполняет их.
&НаСервере
Процедура СохранитьТемуНаСервере(Знач Тема)

	ПерфUI.СохранитьТемуПриложения(Тема);

КонецПроцедуры

&НаСервере
Процедура СохранитьПанельНаСервере(Знач Значение)

	ПерфUI.СохранитьСостояниеПанели(Значение);

КонецПроцедуры

&НаКлиенте
Процедура ОпросМостаСтенда()

	Попытка
		Мост = Элементы.ОтчетHTML.Документ.defaultView;
		Если Мост = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Текст = Мост.PF1C.take();
	Исключение
		Возврат;
	КонецПопытки;

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Команда Из СтрРазделить(Текст, "|") Цикл
		Части = СтрРазделить(СокрЛП(Команда), ":", Ложь);
		Если Части.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя = НРег(СокрЛП(Части[0]));
		Аргумент = ?(Части.Количество() > 1, СокрЛП(Части[1]), "");
		Если Имя = "nav" Тогда
			СохранитьПанельНаСервере(НРег(Аргумент));
			// Форма уже показывает новое состояние: метка обновляется,
			// чтобы ближайшая активация окна не перестраивала страницу зря.
			ПоследняяВерсияНастроек = ВерсияНастроекСервер();
		ИначеЕсли Имя = "theme" Тогда
			СохранитьТемуНаСервере(НРег(Аргумент));
			// Форма уже показывает новое состояние: метка обновляется,
			// чтобы ближайшая активация окна не перестраивала страницу зря.
			ПоследняяВерсияНастроек = ВерсияНастроекСервер();
		ИначеЕсли Имя = "open" И НЕ ПустаяСтрока(Аргумент) Тогда
			ОчиститьПередПереходом();
			ОткрытьФорму("ОбщаяФорма." + Аргумент,
				Новый Структура("Настройки", НастройкиДляПерехода()));
			// Страница, с которой ушли, закрывается: в приложении остается одно окно,
			// и в нем всегда свежая сборка, а не снимок прошлого перехода.
			ПодключитьОбработчикОжидания("ЗакрытьПослеПерехода", 0.3, Истина);
		ИначеЕсли Имя = "stand" И НЕ ПустаяСтрока(Аргумент) Тогда
			Стенд = Аргумент;
			Построить();
		ИначеЕсли Имя = "refresh" Тогда
			ОбновитьПаспорт();
		ИначеЕсли Имя = "probe" Тогда
			ПробаСРабочегоМеста();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// «Обновить»: паспорт собирается заново (клиентская часть - на клиенте,
// серверная - на сервере) и страница перестраивается уже на новых данных.
&НаКлиенте
Процедура ОбновитьПаспорт()

	КлиентСтрока = "";
	Попытка
		КлиентСтрока = ПерфПаспортКлиент.СтрокаКлиента(Истина);
	Исключение
		// Без клиентской части паспорт соберется только по серверу.
		КлиентСтрока = "";
	КонецПопытки;
	ПересобратьПаспорт(КлиентСтрока);

КонецПроцедуры

&НаСервере
Процедура ПересобратьПаспорт(КлиентСтрока)

	Данные = ПерфСтендыHTML.ДанныеСтенда(Стенд);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПерфПаспорт.Записать(Данные.Стенд, КлиентСтрока, Истина, "Полный");
	Построить();

КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизации()

	ПроверитьНастройкиИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиИнтерфейса()
	ТекущаяВерсия = ВерсияНастроекСервер();
	Если ТекущаяВерсия <> ПоследняяВерсияНастроек Тогда
		ПоследняяВерсияНастроек = ТекущаяВерсия;
		ОбновитьСтраницуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВерсияНастроекСервер()
	Возврат ПерфUI.ВерсияНастроек();
КонецФункции

&НаСервере
Процедура ОбновитьСтраницуНаСервере()
	Построить();
КонецПроцедуры

// Читает настройки оформления в момент нажатия пункта меню: снимок уходит
// в параметры открываемой формы, поэтому страница не читает константы повторно.
&НаСервере
Функция НастройкиДляПерехода()
	Возврат ПерфUI.ПрочитатьНастройки();
КонецФункции

// Переход по пункту меню начинается с чистого листа: очередь команд моста
// обнуляется, метка настроек сбрасывается, снимок HTML в форме стирается.
// Иначе новая страница может унаследовать команды и состояние прошлой.
&НаКлиенте
Процедура ОчиститьПередПереходом()

	Попытка
		Мост = Элементы.ОтчетHTML.Документ.defaultView;
	Исключение
		// Поле еще не создано - чистить нечего, мост остаётся пустым.
		Мост = Неопределено;
	КонецПопытки;
	Если Мост <> Неопределено Тогда
		Мост.PF1C.clear();
	КонецЕсли;
	ПоследняяВерсияНастроек = "";

КонецПроцедуры

// Закрытие отложено на такт: новая страница уже создана и показана,
// поэтому приложение не остается без окна и переход выглядит одним действием.
&НаКлиенте
Процедура ЗакрытьПослеПерехода()

	ОтключитьОбработчикОжидания("ЗакрытьПослеПерехода");
	Закрыть();

КонецПроцедуры

// Проба каналов с рабочего места: запросы выполняет клиентский модуль
// (ПерфПробаКлиент), запись узла "Клиент" и пересборку страницы - сервер.
&НаКлиенте
Процедура ПробаСРабочегоМеста()

	// После переподключения клиента переменная снова Неопределено; проверять ее
	// через ЗначениеЗаполнено нельзя - для Булево функция всегда возвращает Истина,
	// и проба не запускалась бы вовсе.
	Если ТипЗнч(ПробаИдёт) = Тип("Булево") И ПробаИдёт Тогда
		// Повторное нажатие во время пробы не запускает вторую.
		Возврат;
	КонецЕсли;
	Если НЕ ПерфСредаКлиент.ПробаДоступна() Тогда
		// В веб-клиенте HTTP-объектов нет: проба возможна только из толстого
		// или тонкого клиента, поэтому кнопка explains причину и выходит.
		Сообщить("Проба каналов недоступна в веб-клиенте: нужен толстый или тонкий клиент.");
		Возврат;
	КонецЕсли;
	ПробаИдёт = Истина;
	Попытка
		Результаты = ПерфПробаКлиент.ПроверитьИЗаписать();
		ПробаИдёт = Ложь;
	Исключение
		ПробаИдёт = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	ПерфСценарии.ЗаписатьМетку("probe-done:" + ?(Результаты = Неопределено, "none",
		Строка(Результаты.Количество())));
	Если Результаты <> Неопределено Тогда
		ОбновитьСтраницуНаСервере();
	КонецЕсли;

КонецПроцедуры

// Служебный режим: проба каналов с рабочего места и закрытие страницы.
&НаКлиенте
Процедура ПробаИЗакрытие()

	ОтключитьОбработчикОжидания("ПробаИЗакрытие");
	ПробаСРабочегоМеста();
	Закрыть();

КонецПроцедуры
