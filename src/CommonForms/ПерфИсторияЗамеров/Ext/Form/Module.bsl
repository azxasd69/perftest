// Форма отчёта: настройки предзаполняются по текущему сеансу (ТЗ отчётов, раздел 12).
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьСпискиВыбора();
	Построить();
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	Построить();
КонецПроцедуры

&НаКлиенте
Процедура СброситьКСеансу(Команда)
	Стенд = "";
	Сценарий = "";
	Построить();
КонецПроцедуры

&НаСервере
Процедура Построить()
	Результат = ПерфОтчетыHTML.СобратьИсториюЗамеров(Стенд, Сценарий);
	ОтчетHTML = Результат.HTML;
	Стенд = Результат.БазовыйСтенд;
	Сценарий = Результат.Сценарий;
	ЗаписатьПараметры(Результат);
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПараметры(Результат)
	Путь = КаталогВременныхФайлов() + "perftest_params.log";
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, Символы.ПС, Истина);
	Запись.Записать("params:ПерфИсторияЗамеров;" + Результат.БазовыйСтенд + ";"
		+ Результат.СтендСравнения + ";" + Результат.Сценарий + ";" + Результат.ТекущийСтенд
		+ ";стенды:" + ПерфОтчетыHTML.СписокСтендов() + ";диаг:" + ПерфОтчетыHTML.ДиагностикаСтендов());
	Запись.Закрыть();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	Элементы.Стенд.СписокВыбора.Очистить();
	Для Каждого Значение Из ПерфОтчетыHTML.СписокСтендовМассив() Цикл
		Элементы.Стенд.СписокВыбора.Добавить(Значение, Значение);
	КонецЦикла;
	Элементы.Сценарий.СписокВыбора.Очистить();
	Для Каждого Значение Из ПерфОтчетыHTML.СписокСценариевМассив() Цикл
		Элементы.Сценарий.СписокВыбора.Добавить(Значение, Значение);
	КонецЦикла;
КонецПроцедуры
